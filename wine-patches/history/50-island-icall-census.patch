+
+/* Patch 50: record where one indirect dispatch actually went, then call it.
+ * Wraps the function-pointer expression, not the call, so the argument list and
+ * the return value are untouched:
+ *     MGS2_P50_CALL(3, tex->texture_ops->texture_load_location)(tex, ...)
+ * Sites are numbered in one list; see the census core in cs.c. */
+void mgs2_p50_icall(unsigned int site, const void *target);
+#define MGS2_P50_CALL(site, fp) (mgs2_p50_icall((site), (const void *)(fp)), (fp))
+
+/* The instrumented sites, on the paths of the four entries that carry the
+ * frame. Keep in step with MGS2_P50_SITES. */
+#define MGS2_P50_BUFFER_PREPARE          0
+#define MGS2_P50_BUFFER_UNLOAD           1
+#define MGS2_P50_TEXTURE_LOAD            2
+#define MGS2_P50_TEXTURE_UNLOAD          3
+#define MGS2_P50_TEXTURE_PREPARE         4
+#define MGS2_P50_TEXTURE_UPLOAD_BLT      5
+#define MGS2_P50_TEXTURE_DOWNLOAD_BLT    6
+#define MGS2_P50_TEXTURE_UPLOAD_BO       7
+#define MGS2_P50_RESOURCE_SUBRES_COUNT   8
+#define MGS2_P50_RESOURCE_SUBRES_DESC    9
+#define MGS2_P50_RESOURCE_UNLOAD        10
+#define MGS2_P50_PARENT_DESTROYED       11
