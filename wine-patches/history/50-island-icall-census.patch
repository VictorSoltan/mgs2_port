diff -ruN old/dlls/wined3d/cs.c new/dlls/wined3d/cs.c
--- old/dlls/wined3d/cs.c	2026-08-15 20:37:32.936075693 +0300
+++ new/dlls/wined3d/cs.c	2026-08-15 20:37:32.896566536 +0300
