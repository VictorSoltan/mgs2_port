+/* ---------------------------------------------------------------------------
+ * Patch 50: indirect-call target census.
+ *
+ * The native ARM island cannot yet take the four functions that carry the frame
+ * -- wined3d_buffer_load, wined3d_texture_load_location,
+ * wined3d_rendertarget_view_load_location, mgs2_batch_flush -- because their
+ * closures dispatch through function pointers held in WineD3D objects, and a
+ * static analysis cannot say what those pointers hold. "Cannot be armed" was
+ * concluded from that and was withdrawn; this measures it instead.
+ *
+ * It runs in the GUEST DLL on purpose. The hot roots are not armed, so in the
+ * island they never execute and there is nothing to observe; in the x86 build
+ * they run every frame, against the same objects and therefore the same pointer
+ * values the island would see.
+ *
+ * Memory only, bounded, published at present like every other census here.
+ * Each site keeps a handful of distinct targets, classified once on first sight
+ * and counted thereafter, so the hot path is a short scan and an increment.
+ *
+ * Classes: 1 Box86 bridge (a CC 'S' 'C' thunk -- native code the island can
+ * reach by unwrapping), 2 inside wined3d.dll itself (the island has its own ARM
+ * copy of that function), 3 some other module (needs identifying), 0 unknown.
+ * Only class 3 can turn out to require calling back into the emulator.
+ */
+#define MGS2_P50_MAGIC 0x30355250 /* PR50 */
+#define MGS2_P50_SITES 16
+#define MGS2_P50_TARGETS 8
+
+struct mgs2_p50_target
+{
+    unsigned int addr;
+    unsigned int cls;
+    unsigned int calls;
+};
+
+struct mgs2_p50_site
+{
+    unsigned int calls;
+    unsigned int distinct;
+    unsigned int overflow;
+    struct mgs2_p50_target targets[MGS2_P50_TARGETS];
+};
+
+struct mgs2_p50_public
+{
+    unsigned int magic, version, size_words, signature, enabled;
+    LONG publish_sequence;
+    unsigned int presents;
+    unsigned int module_base, module_end;
+    struct mgs2_p50_site sites[MGS2_P50_SITES];
+};
+
+struct mgs2_p50_public mgs2_island_icall_census =
+{
+    MGS2_P50_MAGIC, 1,
+    sizeof(struct mgs2_p50_public) / sizeof(unsigned int),
+    ~MGS2_P50_MAGIC,
+};
+
+static struct mgs2_p50_site mgs2_p50_live[MGS2_P50_SITES];
+static unsigned int mgs2_p50_base, mgs2_p50_end;
+
+static void mgs2_p50_init_range(void)
+{
+    MEMORY_BASIC_INFORMATION mbi;
+    IMAGE_DOS_HEADER *dos;
+    IMAGE_NT_HEADERS *nt;
+
+    if (mgs2_p50_base)
+        return;
+    if (!VirtualQuery((const void *)(ULONG_PTR)mgs2_p50_init_range, &mbi, sizeof(mbi)))
+        return;
+    dos = mbi.AllocationBase;
+    if (!dos || dos->e_magic != IMAGE_DOS_SIGNATURE)
+        return;
+    nt = (IMAGE_NT_HEADERS *)((char *)dos + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE)
+        return;
+    mgs2_p50_base = (unsigned int)(ULONG_PTR)dos;
+    mgs2_p50_end = mgs2_p50_base + nt->OptionalHeader.SizeOfImage;
+}
+
+/* One classification per distinct target, never per call. A Box86 bridge is a
+ * 0xCC 'S' 'C' thunk whose body holds the native function; that byte pattern is
+ * Box86's own signature and cannot be the prologue of real i386 code here. */
+static unsigned int mgs2_p50_classify(const void *target)
+{
+    const unsigned char *p = target;
+
+    if (!p)
+        return 0;
+    if (p[0] == 0xcc && p[1] == 'S' && p[2] == 'C')
+        return 1;
+    if ((unsigned int)(ULONG_PTR)p >= mgs2_p50_base
+            && (unsigned int)(ULONG_PTR)p < mgs2_p50_end)
+        return 2;
+    return 3;
+}
+
+void mgs2_p50_icall(unsigned int site, const void *target)
+{
+    struct mgs2_p50_site *s;
+    unsigned int i, addr;
+
+    if (site >= MGS2_P50_SITES || !mgs2_submit_census_on())
+        return;
+    mgs2_p50_init_range();
+    s = &mgs2_p50_live[site];
+    ++s->calls;
+    addr = (unsigned int)(ULONG_PTR)target;
+    for (i = 0; i < s->distinct; ++i)
+    {
+        if (s->targets[i].addr == addr)
+        {
+            ++s->targets[i].calls;
+            return;
+        }
+    }
+    if (s->distinct == MGS2_P50_TARGETS)
+    {
+        ++s->overflow;
+        return;
+    }
+    i = s->distinct++;
+    s->targets[i].addr = addr;
+    s->targets[i].cls = mgs2_p50_classify(target);
+    s->targets[i].calls = 1;
+}
+
+static void mgs2_p50_publish(void)
+{
+    if (!mgs2_submit_census_on())
+        return;
+    ++mgs2_island_icall_census.presents;
+    mgs2_island_icall_census.enabled = 1;
+    mgs2_island_icall_census.module_base = mgs2_p50_base;
+    mgs2_island_icall_census.module_end = mgs2_p50_end;
+    InterlockedIncrement(&mgs2_island_icall_census.publish_sequence);
+    memcpy(mgs2_island_icall_census.sites, mgs2_p50_live, sizeof(mgs2_p50_live));
+    InterlockedIncrement(&mgs2_island_icall_census.publish_sequence);
+}
+
 static void wined3d_cs_exec_nop(struct wined3d_cs *cs, const void *data)
 {
 }
@@ -2166,6 +2308,7 @@
     cs_gl_info_for_proof = &wined3d_adapter_gl_const(cs->c.device->adapter)->gl_info;
     mgs2_p40_publish(&cs->state);
     mgs2_p46_publish();
+    mgs2_p50_publish();
