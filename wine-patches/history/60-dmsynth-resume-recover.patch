+/*
+ * Patch 35 -- self-heal a stalled synth sink transport.
+ *
+ * The timing thread used to wait on the DirectSound notification event with no
+ * timeout.  The buffer is started once with DSBPLAY_LOOPING and every position
+ * published afterwards depends on that single transport staying alive.  If it
+ * stops, or the notifications stop arriving, the thread stays alive but blocked
+ * forever: sink->play_pos never advances again, the render thread keeps writing
+ * into a buffer nothing plays, and there is no path back short of restarting
+ * the game.  The user-visible defect is gameplay SFX that disappear after the
+ * console suspends and resumes, and less often after a death or a transition.
+ *
+ * Wait with a timeout instead, and use the expiry as a watchdog tick.  Two
+ * different failures have to be handled, because DirectSound reports them
+ * differently:
+ *
+ *   - The buffer is stopped or lost.  Restore it if needed, then Play with
+ *     DSBPLAY_LOOPING again; this is the documented recovery path.
+ *   - The buffer still reports DSBSTATUS_PLAYING while its play position no
+ *     longer advances.  Wine maintains that flag for the secondary buffer
+ *     itself, whatever the mixer and the endpoint below it are doing, so a
+ *     device that stopped advancing across a suspend is invisible in the
+ *     status word.  After MGS2_DMSYNTH_WATCHDOG_STALL consecutive ticks with
+ *     an unchanged play position, re-arm the transport once with Stop + Play.
+ *
+ * This is not polling.  While notifications arrive -- BUFFER_SUBDIVISIONS per
+ * buffer, 200 ms apart at this sink's format -- the loop is woken by the event
+ * exactly as before and the timeout does not expire.  In the broken state it
+ * costs one GetStatus per tick, and nothing is logged per tick, so it does not
+ * repeat the mistake of measuring an audio thread by writing to it.
+ *
+ * sink->written is deliberately not touched here.  The render thread already
+ * resynchronises it against the published play position in its own underrun
+ * check, so a re-armed transport is caught up by the thread that owns that
+ * field rather than by racing it from this one.
+ *
+ * Both knobs default to on, and MGS2_DMSYNTH_WATCHDOG_MS=0 restores the exact
+ * pre-patch INFINITE wait, so the control arm for this patch is the same binary
+ * with one variable set.  MGS2_DMSYNTH_WATCHDOG_STALL=0 keeps the watchdog but
+ * disables the stall re-arm, which is the reasoned rather than measured half:
+ * the status-only recovery cannot heal a mixer that stopped advancing, and no
+ * capture of the resumed device exists yet.
+ */
+#define SINK_WATCHDOG_MS 250
+#define SINK_WATCHDOG_STALL 4
+
+static DWORD sink_watchdog_timeout(void)
+{
+    static int watchdog_ms = -1;
+
+    if (watchdog_ms < 0)
+        watchdog_ms = mgs2_env_int("MGS2_DMSYNTH_WATCHDOG_MS", SINK_WATCHDOG_MS, 0, 5000);
+
+    return watchdog_ms ? (DWORD)watchdog_ms : INFINITE;
+}
+
+static DWORD sink_watchdog_stall_ticks(void)
+{
+    static int stall_ticks = -1;
+
+    if (stall_ticks < 0)
+        stall_ticks = mgs2_env_int("MGS2_DMSYNTH_WATCHDOG_STALL", SINK_WATCHDOG_STALL, 0, 64);
+
+    return stall_ticks;
+}
+
+/* Bring a stopped, lost or stalled transport back, and change nothing when the
+ * buffer is simply playing and late with its notification.  *rearmed reports
+ * whether the transport was actually restarted, so the caller can start its
+ * stall detection over instead of measuring against a stale baseline. */
+static HRESULT sink_watchdog_recover(IDirectSoundBuffer *buffer, BOOL stalled, BOOL *rearmed)
+{
+    DWORD status = 0;
+    HRESULT hr;
+
+    *rearmed = FALSE;
+
+    if (FAILED(hr = IDirectSoundBuffer_GetStatus(buffer, &status))
+            || (status & DSBSTATUS_BUFFERLOST))
+    {
+        /* A lost buffer can fail the status query as well, so try the
+         * documented recovery once and restart it below. */
+        if (FAILED(hr = IDirectSoundBuffer_Restore(buffer)))
+            return hr;
+        status = 0;
+    }
+
+    if (!(status & DSBSTATUS_PLAYING))
+    {
+        TRACE("Restarting stopped sink buffer %p\n", buffer);
+        if (FAILED(hr = IDirectSoundBuffer_Play(buffer, 0, 0, DSBPLAY_LOOPING)))
+            return hr;
+
+        *rearmed = TRUE;
+        return S_OK;
+    }
+
+    if (!stalled)
+        return S_OK;
+
+    TRACE("Re-arming stalled sink buffer %p\n", buffer);
+    if (FAILED(hr = IDirectSoundBuffer_Stop(buffer)))
+        return hr;
+
+    if (FAILED(hr = IDirectSoundBuffer_Play(buffer, 0, 0, DSBPLAY_LOOPING)))
+        return hr;
+
+    *rearmed = TRUE;
+    return S_OK;
+}
