+/* Patch 48: the island entry marker, and why it has to be target-conditional.
+ *
+ * The marker is an x86 instruction -- an eight-byte multi-byte NOP whose
+ * displacement spells "MGS" plus the entry id -- that Box86 matches in the
+ * guest prologue to route the call to the native ARM implementation.
+ *
+ * These same sources are also compiled for armhf to build that native island.
+ * There a bare `.byte` directive emits the eight bytes straight into the ARM
+ * instruction stream, right after the prologue. As Thumb they decode as
+ * `subs r7, r1, #4` / `lsls r4, r0, #2` / `bx r9`: the third halfword, 0x474d,
+ * is a branch to whatever r9 happens to hold. Every marked function in the ARM
+ * build therefore branched to a garbage address before executing any of its own
+ * body. Measured on the device as an unhandled illegal instruction at the
+ * island bridge's own post-wrapper address, with no abort stub ever reached.
+ *
+ * Emit the marker only for the i386 target, which is the only place it is an
+ * instruction at all. The i386 output is unchanged from the previous
+ * unconditional form. */
+#ifdef __i386__
+#define MGS2_ISLAND_MARK(id) __asm__ __volatile__(".byte 0x0f,0x1f,0x84,0x00,0x4d,0x47,0x53," #id)
+#else
+#define MGS2_ISLAND_MARK(id) ((void)0)
+#endif
+
 /* Patch 43: the island entry point. Box86 replaces this with native ARM when
  * MGS2_BOX86_ISLAND_FFP=1; otherwise it is an ordinary call to the function
  * below, so selecting the island can never change behaviour on its own. */
