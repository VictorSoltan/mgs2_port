-                if (++spin_count >= WINED3D_CS_SPIN_COUNT)
+                if (++spin_count >= mgs2_cs_spin_count())
                 {
                     if (poll)
                         poll = WINED3D_CS_QUERY_POLL_INTERVAL - 1;
@@ -5343,6 +5483,7 @@
         mgs2_p39_busy();
         mgs2_p39_packet();
 
+        ++mgs2_cs_deadlock_census.executes;   /* counted, never ringed */
         run = wined3d_cs_execute_next(cs, queue);
     }
 
