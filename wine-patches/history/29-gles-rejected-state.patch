@@ -888,6 +896,15 @@

 static void line_antialias(const struct wined3d_rasterizer_state *r, const struct wined3d_gl_info *gl_info)
 {
+    /* GLES has no line smoothing at all: the enum does not exist, so both calls
+     * below are rejected outright. Unlike depth clamp this has no capability bit
+     * to clear, so the guard has to live here. Measured on the device 2026-08-13:
+     * 9,938 rejected calls in a two-minute run. Skipping them changes nothing the
+     * driver was going to do -- MGS2 never asks for line antialiasing, and if it
+     * did, GLES could not provide it. */
+    if (gl_info->is_gles)
+        return;
+
     if (r && r->desc.line_antialias)
     {
         gl_info->gl_ops.gl.p_glEnable(GL_LINE_SMOOTH);
