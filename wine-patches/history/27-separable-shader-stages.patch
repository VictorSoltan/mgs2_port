+/* Kept outside Wine's desktop-version capability table deliberately.  The
+ * mounted opengl32 facade exposes GLES 3.2 entry points through wglGetProcAddress;
+ * if one is unavailable we retain the ordinary monolithic program path. */
+static PFN_glProgramParameteri mgs2_glProgramParameteri;
+static PFN_glGenProgramPipelines mgs2_glGenProgramPipelines;
+static PFN_glDeleteProgramPipelines mgs2_glDeleteProgramPipelines;
+static PFN_glUseProgramStages mgs2_glUseProgramStages;
+static PFN_glBindProgramPipeline mgs2_glBindProgramPipeline;
+static PFN_glActiveShaderProgram mgs2_glActiveShaderProgram;
+static PFN_glValidateProgramPipeline mgs2_glValidateProgramPipeline;
+static PFN_glGetProgramPipelineiv mgs2_glGetProgramPipelineiv;
+static PFN_glGetProgramPipelineInfoLog mgs2_glGetProgramPipelineInfoLog;
+
+/* wined3d fills gl_ops.ext from a hand-maintained list in load_gl_funcs(), and
+ * the ARB_separate_shader_objects entry points are not in it -- reading the
+ * table alone returned NULL for all eight, so the candidate disabled itself on
+ * every pair and measured as doing nothing at all.  Resolve the same way
+ * mgs_get_gl_func() does: wglGetProcAddress() serves extension spellings,
+ * while these are GL 4.1 core and therefore reachable as ordinary opengl32
+ * exports. */
+static void *mgs2_get_gl_func(const char *name)
+{
+    static HMODULE opengl32;
+    void *pointer;
+
+    if ((pointer = (void *)wglGetProcAddress(name)))
+        return pointer;
+
+    if (!opengl32)
+        opengl32 = GetModuleHandleA("opengl32.dll");
+    return opengl32 ? (void *)GetProcAddress(opengl32, name) : NULL;
+}
+
+#define MGS2_RESOLVE_GL(f) \
+    do { \
+        if (!mgs2_##f && !(mgs2_##f = gl_info->gl_ops.ext.p_##f)) \
+            mgs2_##f = mgs2_get_gl_func(#f); \
+    } while (0)
+
+static BOOL mgs2_resolve_separable(const struct wined3d_gl_info *gl_info)
+{
+    static BOOL reported;
+
+    MGS2_RESOLVE_GL(glProgramParameteri);
+    MGS2_RESOLVE_GL(glGenProgramPipelines);
+    MGS2_RESOLVE_GL(glDeleteProgramPipelines);
+    MGS2_RESOLVE_GL(glUseProgramStages);
+    MGS2_RESOLVE_GL(glBindProgramPipeline);
+    MGS2_RESOLVE_GL(glActiveShaderProgram);
+    MGS2_RESOLVE_GL(glValidateProgramPipeline);
+    MGS2_RESOLVE_GL(glGetProgramPipelineiv);
+    /* Diagnostic only; not required for the path to work. */
+    MGS2_RESOLVE_GL(glGetProgramPipelineInfoLog);
+
+    if (!reported)
+    {
+        reported = TRUE;
+        ERR("separable entry points: ProgramParameteri=%p GenProgramPipelines=%p "
+                "DeleteProgramPipelines=%p UseProgramStages=%p BindProgramPipeline=%p "
+                "ActiveShaderProgram=%p ValidateProgramPipeline=%p GetProgramPipelineiv=%p\n",
+                mgs2_glProgramParameteri, mgs2_glGenProgramPipelines,
+                mgs2_glDeleteProgramPipelines, mgs2_glUseProgramStages,
+                mgs2_glBindProgramPipeline, mgs2_glActiveShaderProgram,
+                mgs2_glValidateProgramPipeline, mgs2_glGetProgramPipelineiv);
+    }
+
+    return mgs2_glProgramParameteri && mgs2_glGenProgramPipelines && mgs2_glDeleteProgramPipelines
+            && mgs2_glUseProgramStages && mgs2_glBindProgramPipeline && mgs2_glActiveShaderProgram
+            && mgs2_glValidateProgramPipeline && mgs2_glGetProgramPipelineiv;
+}
+
+/* Bounded, memory-only transition probe, read from outside the process through
+ * /proc/<pid>/mem by harness/gpu_transition_probe.py.  The hot thread only
+ * stores into a fixed ring: no file, no debug channel, no allocation.  Rule 2
+ * of this project exists because logging from a hot thread changed the very
+ * timings being judged. */
+#define MGS2_PROBE_MAGIC 0x32555047
+#define MGS2_PROBE_CAPACITY 512
+
+#define MGS2_PROBE_OP_LINK_PROGRAM 5
+#define MGS2_PROBE_OP_COMPILE_SHADER 6
+#define MGS2_PROBE_OP_LINK_SEPARABLE_STAGE 8
+#define MGS2_PROBE_OP_VALIDATE_PIPELINE 9
+#define MGS2_PROBE_OP_SLOW_BIND 10
+
+struct mgs2_probe_event
+{
+    LONG commit;
+    unsigned int op;
+    unsigned int tid;
+    unsigned int duration_us;
+    unsigned int a;
+    unsigned int b;
+    unsigned int c;
+    unsigned int d;
+    unsigned int object;
+};
+
+struct mgs2_probe_ring
+{
+    unsigned int magic;
+    unsigned int version;
+    unsigned int capacity;
+    LONG next_sequence;
+    struct mgs2_probe_event events[MGS2_PROBE_CAPACITY];
+};
+
+struct mgs2_probe_ring mgs2_gpu_probe = {MGS2_PROBE_MAGIC, 1, MGS2_PROBE_CAPACITY, 0};
+static BOOL mgs2_probe_enabled;
+static LONGLONG mgs2_probe_frequency;
+
+static LONGLONG mgs2_probe_now(void)
+{
+    LARGE_INTEGER now;
+
+    if (!mgs2_probe_enabled)
+        return 0;
+    QueryPerformanceCounter(&now);
+    return now.QuadPart;
+}
+
+static void mgs2_probe_record(unsigned int op, LONGLONG start, unsigned int a,
+        unsigned int b, unsigned int c, unsigned int d, unsigned int object)
+{
+    struct mgs2_probe_event *event;
+    LARGE_INTEGER now;
+    LONG sequence;
+
+    if (!mgs2_probe_enabled || !mgs2_probe_frequency)
+        return;
+
+    QueryPerformanceCounter(&now);
+    sequence = InterlockedIncrement(&mgs2_gpu_probe.next_sequence);
+    event = &mgs2_gpu_probe.events[(sequence - 1) % MGS2_PROBE_CAPACITY];
+    event->op = op;
+    event->tid = GetCurrentThreadId();
+    event->duration_us = (unsigned int)((now.QuadPart - start) * 1000000 / mgs2_probe_frequency);
+    event->a = a;
+    event->b = b;
+    event->c = c;
+    event->d = d;
+    event->object = object;
+    /* Published last, so the reader never accepts a half-written slot. */
+    InterlockedExchange(&event->commit, sequence);
+}
