+            sizeof(d3d8_mgs2_projected.mask_projected_run));
     if (d3d8_mgs2_projected.frames < D3D8_MGS2_PROJECTED_REPORT_FRAMES)
         return;
 
@@ -2699,6 +2736,35 @@ static void d3d8_mgs2_projected_census_present(struct d3d8_device *device)
             d3d8_mgs2_projected.net_same_dirty,
             d3d8_mgs2_projected.changed_without_dirty,
             d3d8_mgs2_projected.light_overflow);
+    for (rank = 0; rank < D3D8_MGS2_PROJECTED_TOP_MIXED; ++rank)
+    {
+        ULONGLONG best_count = 0, projected, removed;
+        unsigned int best_mask = 0;
+        char groups[D3D8_MGS2_FP_GROUP_COUNT + 1];
+
+        for (mask = 1; mask < D3D8_MGS2_PROJECTED_MASK_COUNT; ++mask)
+        {
+            if (emitted[mask] || !(mask & (mask - 1)))
+                continue;
+            if (d3d8_mgs2_projected.mask_boundaries[mask] > best_count)
+            {
+                best_count = d3d8_mgs2_projected.mask_boundaries[mask];
+                best_mask = mask;
+            }
+        }
+        if (!best_count)
+            break;
+
+        emitted[best_mask] = TRUE;
+        projected = d3d8_mgs2_projected.mask_projected_draws[best_mask];
+        removed = d3d8_mgs2_projected.actual_batches > projected
+                ? d3d8_mgs2_projected.actual_batches - projected : 0;
+        d3d8_mgs2_projected_mask_name(best_mask, groups);
+        fprintf(stderr, "MGS2PROJECTED_MIXED: rank=%u mask=0x%02x groups=%s "
