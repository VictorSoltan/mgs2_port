+#define D3D8_MGS2_PROJECTED_TOP_MIXED 8
 struct d3d8_mgs2_fingerprint
 {
     ULONGLONG lo, hi;
@@ -2293,8 +2295,11 @@ static struct
     D3DPRIMITIVETYPE last_primitive;
