     for (i = 0; i <= D3D8_MGS2_BREAK_STREAM_VB; ++i)
         d3d8_mgs2_projected.projected_draws[i] = 0;
+    memset(d3d8_mgs2_projected.mask_projected_draws, 0,
+            sizeof(d3d8_mgs2_projected.mask_projected_draws));
 }
 
