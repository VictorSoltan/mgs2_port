     }
 
     for (i = 0; i <= D3D8_MGS2_BREAK_STREAM_VB; ++i)
@@ -2631,6 +2650,21 @@ static void d3d8_mgs2_projected_draw(struct d3d8_device *device,
         }
     }
 
+    for (i = 0; i < D3D8_MGS2_PROJECTED_MASK_COUNT; ++i)
