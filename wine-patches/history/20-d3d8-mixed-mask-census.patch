@@ -2582,6 +2587,18 @@ static enum d3d8_mgs2_projected_break d3d8_mgs2_projected_classify(unsigned int
     return D3D8_MGS2_BREAK_WORLD_ONLY + group;
 }
 
+static void d3d8_mgs2_projected_mask_name(unsigned int mask,
+        char name[D3D8_MGS2_FP_GROUP_COUNT + 1])
+{
+    static const char group_names[D3D8_MGS2_FP_GROUP_COUNT] = {'W', 'M', 'T', 'R', 'C', 'V'};
+    unsigned int i, length = 0;
+
+    for (i = 0; i < ARRAY_SIZE(group_names); ++i)
+        if (mask & (1u << i))
+            name[length++] = group_names[i];
+    name[length] = '\0';
+}
+
 static void d3d8_mgs2_projected_draw(struct d3d8_device *device,
         D3DPRIMITIVETYPE primitive_type, BOOL batchable)
 {
@@ -2613,6 +2630,8 @@ static void d3d8_mgs2_projected_draw(struct d3d8_device *device,
                 ++d3d8_mgs2_projected.changed_without_dirty;
         }
         ++d3d8_mgs2_projected.boundaries[kind];
+        if (compatible)
