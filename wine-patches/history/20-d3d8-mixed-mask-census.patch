+        }
+    }
+
     if (!batchable)
         ++d3d8_mgs2_projected.actual_batches;
     memcpy(d3d8_mgs2_projected.last_draw, d3d8_mgs2_projected.current,
@@ -2649,7 +2683,8 @@ static void d3d8_mgs2_projected_batch_flushed(unsigned int source_draws)
 
 static void d3d8_mgs2_projected_census_present(struct d3d8_device *device)
 {
-    unsigned int i;
+    BOOL emitted[D3D8_MGS2_PROJECTED_MASK_COUNT] = {0};
+    unsigned int i, mask, rank;
     double frames;
 
     if (!d3d8_mgs2_projected_census_on())
@@ -2659,6 +2694,8 @@ static void d3d8_mgs2_projected_census_present(struct d3d8_device *device)
     d3d8_mgs2_projected.have_last_draw = FALSE;
