+/*
+ * MGS2 mutes DirectMusic channels while changing gameplay state.  On native
+ * DirectMusic the following transition restores the channel curve, but this
+ * title can leave Wine's FluidSynth channel at CC7/CC11 zero after closing the
+ * map or ending an alert.  The port opts into a narrow safety net: allow the
+ * mute itself, and restore only when the game subsequently asks that same
+ * channel to sound a positive-velocity note.  Existing non-zero controller
+ * values are never changed.
+ */
+static BOOL mgs2_dmsynth_unmute_notes_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+        enabled = mgs2_env_int("MGS2_DMSYNTH_UNMUTE_NOTES", 0, 0, 1);
+    return enabled;
+}
+
 static BOOL dmsynth_state_enabled(void)
 {
     static int enabled = -1;
@@ -554,6 +572,35 @@
     return event->midi[0] & 0x0f;
 }
 
+static void mgs2_dmsynth_unmute_note(struct synth *This, const struct event *event,
+        unsigned int chan, BYTE status)
+{
+    int volume = -1, expression = -1, restored = 0;
+
+    if (!mgs2_dmsynth_unmute_notes_enabled() || !event->midi[2]) return;
+
+    if (fluid_synth_get_cc(This->fluid_synth, chan, 0x07 /* VOLUME_MSB */, &volume) == FLUID_OK
+            && volume == 0)
+    {
+        fluid_synth_cc(This->fluid_synth, chan, 0x07 /* VOLUME_MSB */, 100);
+        restored |= 1;
+    }
+    if (fluid_synth_get_cc(This->fluid_synth, chan, 0x0b /* EXPRESSION_MSB */, &expression) == FLUID_OK
+            && expression == 0)
+    {
+        fluid_synth_cc(This->fluid_synth, chan, 0x0b /* EXPRESSION_MSB */, 127);
+        restored |= 2;
+    }
+
+    if (restored && dmsynth_state_enabled())
+    {
+        int active = fluid_synth_get_active_voice_count(This->fluid_synth);
+        dmsynth_state_record(This, DMSYNTH_STATE_NOTE_UNMUTE,
+                event->channel_group, chan, status, volume, expression,
+                restored, active, active, -1, -1, -1);
+    }
+}
