+/* MGS2: the yield on the empty-queue path is Wine policy, not Windows semantics.
+ * It was added in 2005 "for nicer behavior" and a patch removing it was proposed
+ * within months; Windows' PM_NOYIELD means something else entirely (it controls
+ * releasing threads blocked in WaitForInputIdle). MGS2's main loop drains the
+ * queue thousands of times per rendered frame, and each empty poll costs three
+ * syscalls inside NtYieldExecution -- around 390 000 a second on this device.
+ *
+ *   MGS2_EMPTY_PEEK_YIELD=full   stock behaviour (default)
+ *   MGS2_EMPTY_PEEK_YIELD=fast   sched_yield() directly, skipping the getrusage pair
+ *   MGS2_EMPTY_PEEK_YIELD=none   never yield on the empty path
+ *   MGS2_EMPTY_PEEK_YIELD=<N>    yield once per N consecutive empty polls
+ *
+ * Measured, 120 s gameplay windows: stock 6.21 fps, cheap-yield 11.82 fps,
+ * no-yield-at-all 6.29 fps. Removing the yield entirely buys nothing -- the
+ * main thread then never gives the CPU up and wined3d_cs and the wineserver
+ * round-trips starve by exactly as much as the main thread gains. The yield has
+ * to happen; it just must not cost three syscalls. Hence "fast": win32u is a
+ * Unix library, so it can call sched_yield() itself instead of going through
+ * NtYieldExecution, leaving that function's semantics intact for every other
+ * caller.
+ *
+ * Only the yield is affected. The window-surface flush and both thunk-lock
+ * callbacks still run every time, so sent-message delivery and surface
+ * synchronisation are untouched.
+ *
+ * MGS2_EMPTY_PEEK_STATS=1 reports the empty-poll rate. Combined with the frame
+ * counter it gives polls-per-frame, which is the measurement that distinguishes
+ * a time-bounded spin (polls scale up when each one gets cheaper, frame time
+ * unchanged) from a fixed-iteration loop (polls constant, frames get faster).
+ */
+#define MGS_PEEK_YIELD_NONE  0
+#define MGS_PEEK_YIELD_FULL  1
+#define MGS_PEEK_YIELD_FAST  2
+
+static int mgs_empty_peek_mode(void)
+{
+    static int mode = -1;
+    if (mode == -1)
+    {
+        const char *s = getenv( "MGS2_EMPTY_PEEK_YIELD" );
+        if (!s || !strcmp( s, "full" )) mode = MGS_PEEK_YIELD_FULL;
+        else if (!strcmp( s, "fast" )) mode = MGS_PEEK_YIELD_FAST;
+        else if (!strcmp( s, "none" )) mode = MGS_PEEK_YIELD_NONE;
+        else mode = MGS_PEEK_YIELD_FULL;
+    }
+    return mode;
+}
+
+/* Rate limiting is orthogonal to which yield primitive is used: "fast" and
+ * "256" can be combined as MGS2_EMPTY_PEEK_YIELD=fast with
+ * MGS2_EMPTY_PEEK_EVERY=256. */
+static int mgs_empty_peek_every(void)
+{
+    static int every = -1;
+    if (every == -1)
+    {
+        const char *s = getenv( "MGS2_EMPTY_PEEK_EVERY" );
+        if (!s || (every = atoi( s )) < 1) every = 1;
+    }
+    return every;
+}
+
+static void mgs_empty_peek_count(void)
+{
+    static unsigned int polls, enabled = 2;
+    static LARGE_INTEGER last;
+    LARGE_INTEGER now;
+    LONGLONG ms;
+
+    if (enabled == 2) enabled = getenv( "MGS2_EMPTY_PEEK_STATS" ) ? 1 : 0;
+    if (!enabled) return;
+    if (++polls < 50000) return;
+    NtQueryPerformanceCounter( &now, NULL );
+    if (last.QuadPart)
+    {
+        ms = (now.QuadPart - last.QuadPart) / 10000;
+        ERR( "MGS2 empty peek: %u polls in %s ms\n", polls, wine_dbgstr_longlong(ms) );
+    }
+    last = now;
+    polls = 0;
+}
+
 /***********************************************************************
  *           NtUserPeekMessage  (win32u.@)
  */
@@ -3483,7 +3566,19 @@
                 params.locks = *(DWORD *)ret_ptr;
                 params.restore = TRUE;
             }
-            NtYieldExecution();
+            {
+                int mode = mgs_empty_peek_mode();
+                static unsigned int empty_polls;
+
+                mgs_empty_peek_count();
+                if (mode != MGS_PEEK_YIELD_NONE &&
+                    ++empty_polls >= (unsigned int)mgs_empty_peek_every())
+                {
+                    empty_polls = 0;
+                    if (mode == MGS_PEEK_YIELD_FAST) sched_yield();
+                    else NtYieldExecution();
+                }
+            }
