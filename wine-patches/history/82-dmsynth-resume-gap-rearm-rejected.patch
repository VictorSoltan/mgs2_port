     DWORD watchdog_ticks = 0;
     BOOL started = FALSE;
@@ -848,6 +865,8 @@
         goto done;
     }
 
+    last_wall_time = sink_wall_time();
+
     for (;;)
     {
         HANDLE handles[] = {sink->timing_stop_event, buffer_event};
