+/* A resumed DirectSound transport and the DirectMusic sample timeline are two
+ * separate clocks. Re-arming only the transport can leave the next synth
+ * render many seconds behind the master clock: newly queued gameplay notes
+ * then wait for that suspended interval while music on other buffers remains
+ * current.
+ *
+ * Consume the recovery marker on the render thread, which owns sink->written.
+ * Re-anchor the reference/sample mapping so the next byte to render is at the
+ * live DirectSound write lead, and shift already queued MIDI events by the same
+ * amount. A 250 ms gate makes an ordinary watchdog re-arm a no-op here; only a
+ * materially stale timeline is rebased. The synth queue lock also serialises
+ * RefTimeToSample() plus insertion in synth_PlayBuffer(). */
+#define SINK_TIMELINE_REBASE_MIN_100NS (250 * (REFERENCE_TIME)10000)
+
+static void synth_sink_rebase_timeline(struct synth_sink *sink, IDirectMusicSynth *synth,
+        const DSBCAPS *caps, const WAVEFORMATEX *format)
+{
+    REFERENCE_TIME written_time, desired_latency, current_latency, shift;
+    REFERENCE_TIME master_time;
+    LONGLONG shift_samples = 0;
+    DWORD write_latency;
+
+    if (!InterlockedExchange(&sink->timeline_rebase_pending, 0)) return;
+    if (FAILED(IReferenceClock_GetTime(sink->master_clock, &master_time)))
+    {
+        InterlockedExchange(&sink->timeline_rebase_pending, 1);
+        return;
+    }
+
+    synth_timeline_lock(synth);
+    EnterCriticalSection(&sink->cs);
+
+    write_latency = (sink->write_pos - sink->play_pos + caps->dwBufferBytes)
+            % caps->dwBufferBytes + sink_jitter_bytes(format);
+    desired_latency = (REFERENCE_TIME)write_latency * 10000000 / format->nAvgBytesPerSec;
+    written_time = ((REFERENCE_TIME)sink->written / format->nBlockAlign)
+            * 10000000 / format->nSamplesPerSec;
+    current_latency = sink->activate_time + written_time - master_time;
+    shift = desired_latency - current_latency;
+
+    if (shift > SINK_TIMELINE_REBASE_MIN_100NS)
+    {
+        shift_samples = shift * format->nSamplesPerSec / 10000000;
+        sink->activate_time += shift;
+        sink->latency = desired_latency;
+        sink->latency_time = master_time + desired_latency;
+    }
+
+    LeaveCriticalSection(&sink->cs);
+    if (shift_samples)
+        synth_timeline_shift_events_locked(synth, shift_samples);
+    synth_timeline_unlock(synth);
+}
