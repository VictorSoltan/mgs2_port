+++ wine-11.0/dlls/dmime/performance.c
@@ -30,6 +30,61 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(dmime);
 
+struct dmime_state_data dmime_state_data =
+{
+    .magic = DMIME_STATE_MAGIC,
+    .version = DMIME_STATE_VERSION,
+    .header_words = 12,
+    .record_words = sizeof(struct dmime_state_record) / sizeof(DWORD),
+    .event_count = DMIME_STATE_EVENTS,
+    .signature = ~DMIME_STATE_MAGIC,
+};
+
+static BOOL dmime_state_enabled(void)
+{
+    static LONG enabled = -1;
+    char text[8];
+    DWORD len;
+
+    if (enabled != -1) return enabled;
+    len = GetEnvironmentVariableA("MGS2_DMIME_STATE", text, sizeof(text));
+    enabled = len && len < sizeof(text) && text[0] != '0';
+    InterlockedExchange(&dmime_state_data.enabled, enabled);
+    return enabled;
+}
+
+void dmime_state_record(DWORD event, DWORD pmsg_type, DWORD pchannel_before,
+        DWORD pchannel_after, DWORD track_id, DWORD flags, DWORD value1, DWORD value2,
+        DWORD value3, DWORD value4)
+{
+    struct dmime_state_record *record;
+    LONG sequence;
+
+    if (!dmime_state_enabled()) return;
+
+    sequence = InterlockedIncrement(&dmime_state_data.write_sequence);
+    record = &dmime_state_data.records[(sequence - 1) % DMIME_STATE_EVENTS];
+    InterlockedExchange(&record->sequence, 0);
+    record->tick = GetTickCount();
+    record->event = event;
+    record->pmsg_type = pmsg_type;
+    record->pchannel_before = pchannel_before;
+    record->pchannel_after = pchannel_after;
+    record->track_id = track_id;
+    record->flags = flags;
+    record->value1 = value1;
+    record->value2 = value2;
+    record->value3 = value3;
+    record->value4 = value4;
+    InterlockedExchange(&record->sequence, sequence);
+
+    if (event <= DMIME_STATE_STAMP_FAIL) InterlockedIncrement(&dmime_state_data.stamp_count);
+    else if (event == DMIME_STATE_PMSG) InterlockedIncrement(&dmime_state_data.pmsg_count);
+    else if (event == DMIME_STATE_MIDI_PORT || event == DMIME_STATE_MIDI_DROP)
+        InterlockedIncrement(&dmime_state_data.midi_count);
+    else if (event >= DMIME_STATE_PATH_ACTIVATE) InterlockedIncrement(&dmime_state_data.path_count);
+}
