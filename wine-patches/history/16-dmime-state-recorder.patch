 typedef struct IDirectMusicAudioPathImpl IDirectMusicAudioPathImpl;
 struct midi_parser;
 
+/* Bounded MGS2 transition recorder. It is intentionally memory-only: the
+ * affected code runs on DirectMusic's message/audio paths, so stderr tracing
+ * changes the failure it is meant to diagnose. */
+#define DMIME_STATE_MAGIC 0x31544d44 /* DMT1 */
+#define DMIME_STATE_VERSION 1
+#define DMIME_STATE_EVENTS 256
+
+enum dmime_state_event
+{
+    DMIME_STATE_STAMP_IN = 1,
+    DMIME_STATE_STAMP_OUT,
+    DMIME_STATE_STAMP_FAIL,
+    DMIME_STATE_PMSG,
+    DMIME_STATE_MIDI_PORT,
+    DMIME_STATE_MIDI_DROP,
+    DMIME_STATE_CURVE_START,
+    DMIME_STATE_CURVE_END,
+    DMIME_STATE_CURVE_RESET,
+    DMIME_STATE_PATH_ACTIVATE,
+    DMIME_STATE_PATH_VOLUME,
+    DMIME_STATE_PATH_CONVERT,
+    DMIME_STATE_PLAYSEGMENT,
+};
+
+struct dmime_state_record
+{
+    volatile LONG sequence;
+    DWORD tick, event, pmsg_type, pchannel_before, pchannel_after, track_id, flags;
+    DWORD value1, value2, value3, value4;
+};
+
+struct dmime_state_data
+{
+    DWORD magic, version, header_words, record_words, event_count, signature;
+    volatile LONG enabled, write_sequence, stamp_count, pmsg_count, midi_count, path_count;
+    struct dmime_state_record records[DMIME_STATE_EVENTS];
+};
+
+extern struct dmime_state_data dmime_state_data;
+extern void dmime_state_record(DWORD event, DWORD pmsg_type, DWORD pchannel_before,
+        DWORD pchannel_after, DWORD track_id, DWORD flags, DWORD value1, DWORD value2,
+        DWORD value3, DWORD value4);
+
 /*****************************************************************************
  * ClassFactory
