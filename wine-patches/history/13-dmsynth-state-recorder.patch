+static BOOL dmsynth_state_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+        enabled = mgs2_env_int("MGS2_DMSYNTH_STATE", 0, 0, 1);
+    if (enabled)
+        dmsynth_sinkprobe_state.runtime.enabled = 1;
+    return enabled;
+}
+
+static void dmsynth_state_update_max(volatile LONG *target, LONG value)
+{
+    LONG current = *target;
+
+    while (value > current)
+    {
+        LONG previous = InterlockedCompareExchange(target, value, current);
+        if (previous == current) break;
+        current = previous;
+    }
+}
+
+static LONG dmsynth_state_reset_serial(void)
+{
+    struct dmsynth_runtime_state *state =
+            (struct dmsynth_runtime_state *)&dmsynth_sinkprobe_state.runtime;
+
+    return state->open_reset_count + state->midi_reset_count;
+}
+
+static void dmsynth_state_record(struct synth *This, DWORD type, DWORD group,
+        DWORD channel, DWORD status, DWORD data1, DWORD data2, LONG result,
+        DWORD voices_before, DWORD voices_after, LONG sfont, LONG bank,
+        LONG program)
+{
+    struct dmsynth_runtime_state *state =
+            (struct dmsynth_runtime_state *)&dmsynth_sinkprobe_state.runtime;
+    struct dmsynth_state_record *record;
+    LONG sequence;
+
+    if (!dmsynth_state_enabled()) return;
+
+    sequence = InterlockedIncrement(&state->write_sequence);
+    record = &state->records[(sequence - 1) & (DMSYNTH_STATE_EVENTS - 1)];
+    InterlockedExchange(&record->sequence, 0);
+    MemoryBarrier();
+    record->tick = GetTickCount();
+    record->type = type;
+    record->synth = (DWORD)(ULONG_PTR)This;
+    record->reset_serial = dmsynth_state_reset_serial();
+    record->group = group;
+    record->channel = channel;
+    record->status = status;
+    record->data1 = data1;
+    record->data2 = data2;
+    record->result = result;
+    record->voices_before = voices_before;
+    record->voices_after = voices_after;
+    record->sfont = sfont;
+    record->bank = bank;
+    record->program = program;
+    MemoryBarrier();
+    InterlockedExchange(&record->sequence, sequence);
+
+    state->last_tick = record->tick;
+    state->last_render_synth = (LONG)(ULONG_PTR)This;
+    state->active_voices = voices_after;
+    dmsynth_state_update_max(&state->max_active_voices, max(voices_before, voices_after));
+}
+
+static void dmsynth_state_update_render(struct synth *This, LONG voices)
+{
+    struct dmsynth_runtime_state *state =
+            (struct dmsynth_runtime_state *)&dmsynth_sinkprobe_state.runtime;
+
+    if (!dmsynth_state_enabled()) return;
+    state->last_tick = GetTickCount();
+    state->last_render_synth = (LONG)(ULONG_PTR)This;
+    state->active_voices = voices;
+    dmsynth_state_update_max(&state->max_active_voices, voices);
+}
+
