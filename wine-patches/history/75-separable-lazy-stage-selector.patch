+    /*
+     * Program-local cache of the FFP texture matrices this program was last
+     * given.
+     *
+     * Uniform values are state of a linked GL program and survive glUseProgram,
+     * but wined3d re-dirties a program's constants every time it becomes
+     * current, so the same matrix is uploaded again and again. Measured on this
+     * device: 331 redundant uploads per frame standing still, 410 in combat,
+     * ~96-97% of all calls to shader_glsl_ffp_vertex_texmatrix_uniform().
+     *
+     * The cache lives here and nowhere else on purpose. This struct IS one
+     * linked GL program, so (program, texture stage) is the natural key, with no
+     * hash table, no allocation on the hot path and no lookup by GLuint.
+     *
+     * A newly linked program gets a fresh entry, so its cache starts invalid by
+     * construction: all four allocation sites in this file use
+     * calloc(1, sizeof(*entry)) -- checked, not assumed -- and none of the four
+     * glLinkProgram() calls relinks an id that a live entry already holds, so
+     * there is no in-place relink to invalidate on. glUseProgram does not
+     * invalidate anything either: uniform values belong to the program.
+     */
+    uint32_t mgs_texmatrix_valid_mask;
+    struct wined3d_matrix mgs_texmatrix_cache[WINED3D_MAX_FFP_TEXTURES];
+};
