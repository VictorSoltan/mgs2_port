     for (i = 0; i < op->count; ++i)
     {
         struct wined3d_draw_parameters parameters;
@@ -3203,7 +3440,10 @@
 static inline void mgs2_cs_dispatch(struct wined3d_cs *cs, enum wined3d_cs_op opcode, const void *data)
 {
     if (opcode != WINED3D_CS_OP_DRAW && opcode != WINED3D_CS_OP_DRAW_BATCH)
+    {
+        mgs2_submit_census_barrier();
         mgs2_batch_flush();
+    }
     wined3d_cs_op_handlers[opcode](cs, data);
 }
 
