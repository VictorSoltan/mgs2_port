Patch 37 -- bounded memory-only submission census for the reinforcement scene.

This diagnostic patch records source indexed/non-indexed draws, exact adjacent
indexed ranges, conservative CSMT barriers, and final GL submissions. It writes
no log, allocates no memory in the hot path, and is off unless
MGS2_REINFORCEMENT_CENSUS=1. Read it externally with
harness/reinforcement_submit_census.py.

--- a/dlls/wined3d/cs.c
+++ b/dlls/wined3d/cs.c
@@ -665,6 +665,239 @@
     return packet;
 }
 
+/* Bounded, memory-only census for the reinforcement renderer profile. Source
+ * draws and final GL submissions are counted by the CSMT consumer. The public
+ * snapshot is copied only at Present and is read externally through
+ * /proc/<pid>/mem; there is no hot-thread output, allocation, or timestamping. */
+#define MGS2_SUBMIT_CENSUS_MAGIC 0x31534352 /* RCS1 */
+
+struct mgs2_submit_census_payload
+{
+    unsigned int cs_presents;
+    unsigned int source_draws;
+    unsigned int source_nonindexed;
+    unsigned int source_indexed;
+    unsigned int source_direct_packets;
+    unsigned int source_batch_packets;
+    unsigned int indexed_trianglelist;
+    unsigned int indexed_strip;
+    unsigned int indexed_other;
+    unsigned int indexed_adjacent_pairs;
+    unsigned int indexed_mergeable_list_pairs;
+    unsigned int indexed_candidate_strip_pairs;
+    unsigned int break_after_other_draw;
+    unsigned int break_state;
+    unsigned int break_primitive;
+    unsigned int break_ib;
+    unsigned int break_format_offset;
+    unsigned int break_base;
+    unsigned int break_instanced;
+    unsigned int break_gap;
+    unsigned int break_unsupported;
+    unsigned int final_draws;
+    unsigned int final_arrays;
+    unsigned int final_elements;
+    unsigned int final_batch_elements;
+    unsigned int final_instanced;
+    unsigned int final_other;
+};
+
+struct mgs2_submit_census_public
+{
+    unsigned int magic;
+    unsigned int version;
+    unsigned int size_words;
+    unsigned int signature;
+    unsigned int enabled;
+    LONG publish_sequence;
+    struct mgs2_submit_census_payload counters;
+};
+
+struct mgs2_submit_census_public mgs2_reinforcement_submit_census =
+{
+    MGS2_SUBMIT_CENSUS_MAGIC,
+    1,
+    sizeof(struct mgs2_submit_census_public) / sizeof(unsigned int),
+    ~MGS2_SUBMIT_CENSUS_MAGIC,
+};
+
+static struct
+{
+    struct mgs2_submit_census_payload counters;
+    unsigned int epoch;
+    BOOL previous_valid;
+    BOOL previous_indexed;
+    enum wined3d_primitive_type previous_primitive;
+    struct wined3d_buffer *previous_ib;
+    enum wined3d_format_id previous_format;
+    unsigned int previous_index_offset;
+    int previous_base;
+    unsigned int previous_start;
+    unsigned int previous_count;
+    unsigned int previous_instance_count;
+    unsigned int previous_epoch;
+} mgs2_submit_census_live;
+
+static BOOL mgs2_submit_census_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv("MGS2_REINFORCEMENT_CENSUS");
+
+        enabled = value && strcmp(value, "0");
+        mgs2_reinforcement_submit_census.enabled = enabled;
+    }
+    return enabled;
+}
+
+static void mgs2_submit_census_present(void)
+{
+    if (!mgs2_submit_census_on())
+        return;
+
+    ++mgs2_submit_census_live.counters.cs_presents;
+    InterlockedIncrement(&mgs2_reinforcement_submit_census.publish_sequence);
+    mgs2_reinforcement_submit_census.counters = mgs2_submit_census_live.counters;
+    InterlockedIncrement(&mgs2_reinforcement_submit_census.publish_sequence);
+}
+
+static void mgs2_submit_census_barrier(void)
+{
+    if (mgs2_submit_census_on())
+        ++mgs2_submit_census_live.epoch;
+}
+
+static void mgs2_submit_census_packet(BOOL batch)
+{
+    if (!mgs2_submit_census_on())
+        return;
+    if (batch)
+        ++mgs2_submit_census_live.counters.source_batch_packets;
+    else
+        ++mgs2_submit_census_live.counters.source_direct_packets;
+}
+
+static void mgs2_submit_census_source_draw(const struct wined3d_state *state,
+        enum wined3d_primitive_type primitive_type, const struct wined3d_draw_parameters *parameters)
+{
+    const struct wined3d_direct_draw_parameters *direct;
+    struct mgs2_submit_census_payload *c;
+
+    if (!mgs2_submit_census_on())
+        return;
+
+    c = &mgs2_submit_census_live.counters;
+    ++c->source_draws;
+    if (!parameters->indexed)
+    {
+        ++c->source_nonindexed;
+    }
+    else if (primitive_type == WINED3D_PT_TRIANGLELIST)
+    {
+        ++c->source_indexed;
+        ++c->indexed_trianglelist;
+    }
+    else if (primitive_type == WINED3D_PT_TRIANGLESTRIP)
+    {
+        ++c->source_indexed;
+        ++c->indexed_strip;
+    }
+    else
+    {
+        ++c->source_indexed;
+        ++c->indexed_other;
+    }
+
+    if (parameters->indexed && !parameters->indirect)
+    {
+        direct = &parameters->u.direct;
+        if (!mgs2_submit_census_live.previous_valid || !mgs2_submit_census_live.previous_indexed)
+        {
+            if (mgs2_submit_census_live.previous_valid)
+                ++c->break_after_other_draw;
+        }
+        else
+        {
+            ++c->indexed_adjacent_pairs;
+            if (mgs2_submit_census_live.previous_epoch != mgs2_submit_census_live.epoch)
+                ++c->break_state;
+            else if (mgs2_submit_census_live.previous_primitive != primitive_type)
+                ++c->break_primitive;
+            else if (mgs2_submit_census_live.previous_ib != state->index_buffer)
+                ++c->break_ib;
+            else if (mgs2_submit_census_live.previous_format != state->index_format
+                    || mgs2_submit_census_live.previous_index_offset != state->index_offset)
+                ++c->break_format_offset;
+            else if (mgs2_submit_census_live.previous_base != direct->base_vertex_idx)
+                ++c->break_base;
+            else if (mgs2_submit_census_live.previous_instance_count || direct->instance_count)
+                ++c->break_instanced;
+            else if (mgs2_submit_census_live.previous_start
+                    + mgs2_submit_census_live.previous_count != direct->start_idx)
+                ++c->break_gap;
+            else if (primitive_type == WINED3D_PT_TRIANGLELIST)
+                ++c->indexed_mergeable_list_pairs;
+            else if (primitive_type == WINED3D_PT_TRIANGLESTRIP)
+                ++c->indexed_candidate_strip_pairs;
+            else
+                ++c->break_unsupported;
+        }
+    }
+
+    mgs2_submit_census_live.previous_valid = TRUE;
+    mgs2_submit_census_live.previous_indexed = parameters->indexed;
+    mgs2_submit_census_live.previous_primitive = primitive_type;
+    mgs2_submit_census_live.previous_ib = state->index_buffer;
+    mgs2_submit_census_live.previous_format = state->index_format;
+    mgs2_submit_census_live.previous_index_offset = state->index_offset;
+    mgs2_submit_census_live.previous_epoch = mgs2_submit_census_live.epoch;
+    if (!parameters->indirect)
+    {
+        direct = &parameters->u.direct;
+        mgs2_submit_census_live.previous_base = direct->base_vertex_idx;
+        mgs2_submit_census_live.previous_start = direct->start_idx;
+        mgs2_submit_census_live.previous_count = direct->index_count;
+        mgs2_submit_census_live.previous_instance_count = direct->instance_count;
+    }
+    else
+    {
+        mgs2_submit_census_live.previous_base = 0;
+        mgs2_submit_census_live.previous_start = 0;
+        mgs2_submit_census_live.previous_count = 0;
+        mgs2_submit_census_live.previous_instance_count = 1;
+    }
+}
+
+void mgs2_submit_census_gl_draw(unsigned int kind, unsigned int count)
+{
+    struct mgs2_submit_census_payload *c;
+
+    if (!mgs2_submit_census_on() || !count)
+        return;
+    c = &mgs2_submit_census_live.counters;
+    c->final_draws += count;
+    switch (kind)
+    {
+        case MGS2_SUBMIT_GL_ARRAYS:
+            c->final_arrays += count;
+            break;
+        case MGS2_SUBMIT_GL_ELEMENTS:
+            c->final_elements += count;
+            break;
+        case MGS2_SUBMIT_GL_BATCH_ELEMENTS:
+            c->final_batch_elements += count;
+            break;
+        case MGS2_SUBMIT_GL_INSTANCED:
+            c->final_instanced += count;
+            break;
+        default:
+            c->final_other += count;
+            break;
+    }
+}
+
