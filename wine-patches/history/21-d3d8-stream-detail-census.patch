+static unsigned int d3d8_mgs2_projected_stream_diff(
+        const struct wined3d_stateblock_state *state)
+{
+    unsigned int i, mask = 0;
+
+    for (i = 0; i < ARRAY_SIZE(state->streams); ++i)
+    {
+        const struct wined3d_stream_state *current = &state->streams[i];
+        const struct wined3d_stream_state *last = &d3d8_mgs2_projected.last_streams[i];
+
+        if (current->buffer != last->buffer)
+            mask |= D3D8_MGS2_STREAM_DIFF_BUFFER;
+        if (current->offset != last->offset)
+            mask |= D3D8_MGS2_STREAM_DIFF_OFFSET;
+        if (current->stride != last->stride)
+            mask |= D3D8_MGS2_STREAM_DIFF_STRIDE;
+        if (current->frequency != last->frequency || current->flags != last->flags)
+            mask |= D3D8_MGS2_STREAM_DIFF_FREQUENCY;
+    }
+    if (state->index_buffer != d3d8_mgs2_projected.last_index_buffer
+            || state->index_format != d3d8_mgs2_projected.last_index_format)
+        mask |= D3D8_MGS2_STREAM_DIFF_INDEX;
+    if (state->base_vertex_index != d3d8_mgs2_projected.last_base_vertex_index)
+        mask |= D3D8_MGS2_STREAM_DIFF_BASE;
+    return mask;
+}
+
+static void d3d8_mgs2_projected_stream_snapshot(
+        const struct wined3d_stateblock_state *state)
+{
+    memcpy(d3d8_mgs2_projected.last_streams, state->streams,
+            sizeof(d3d8_mgs2_projected.last_streams));
+    d3d8_mgs2_projected.last_index_buffer = state->index_buffer;
+    d3d8_mgs2_projected.last_index_format = state->index_format;
+    d3d8_mgs2_projected.last_base_vertex_index = state->base_vertex_index;
+}
+
+static void d3d8_mgs2_projected_stream_mask_name(unsigned int mask, char name[7])
+{
+    static const char component_names[6] = {'B', 'O', 'S', 'F', 'I', 'X'};
+    unsigned int i, length = 0;
+
+    for (i = 0; i < ARRAY_SIZE(component_names); ++i)
+        if (mask & (1u << i))
+            name[length++] = component_names[i];
+    if (!length)
+        name[length++] = '-';
+    name[length] = '\0';
+}
