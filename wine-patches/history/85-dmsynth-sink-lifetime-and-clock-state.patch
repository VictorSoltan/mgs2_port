+    DWORD ret;
+
+    if (FAILED(hr = IReferenceClock_GetTime(sink->master_clock, &master_time)))
+    {
+        ERR("Failed to get master clock time, hr %#lx\n", hr);
+        return hr;
+    }
+
+    timeout = synth_sink_update_write_position(sink, caps, format, master_time);
+
     ret = WaitForSingleObject(sink->render_stop_event, timeout);
     if (ret == WAIT_FAILED)
     {
@@ -577,7 +590,8 @@ static HRESULT synth_sink_write_data(struct synth_sink *sink, IDirectSoundBuffer
     {
         sinkprobe_lock(sink, hr, NULL, 0, NULL, 0);
         sink->probe_record = -1;
-        ERR("IDirectSoundBuffer_Lock failed, hr %#lx\n", hr);
+        if (hr != DSERR_BUFFERLOST)
+            ERR("IDirectSoundBuffer_Lock failed, hr %#lx\n", hr);
         return hr;
     }
     sinkprobe_lock(sink, hr, data1, size1, data2, size2);
@@ -598,7 +612,8 @@ static HRESULT synth_sink_write_data(struct synth_sink *sink, IDirectSoundBuffer
     {
