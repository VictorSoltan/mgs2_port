+    /* A recovered transport can move the DirectSound write lead by almost a
+     * whole buffer. Resynchronise written before deriving the sample clock. */
+    synth_sink_update_write_position(sink, caps, format, master_time);
+
     synth_timeline_lock(synth);
     EnterCriticalSection(&sink->cs);
 
@@ -844,8 +863,15 @@ struct timing_thread_params
     struct synth_sink *sink;
     IDirectSoundBuffer *buffer;
