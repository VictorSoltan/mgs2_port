+static void mgs_sfx_producer_note_play(IDirectSoundBufferImpl *dsb, void *caller, DWORD flags)
+{
+    BufferMemory *memory;
+    MgsSfxWriteEvent *event;
+    char dir[MAX_PATH], path[MAX_PATH];
+    DWORD i, playing;
+    FILE *raw;
+
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb)) return;
+
+    memory = dsb->buffer;
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    mgs_prod_arm_if_marked(dsb->device);
+    if (mgs_prod_log)
+    {
+        fprintf(mgs_prod_log, "PLAY tick=%lu caller=%p iface=%ld parent=%ld memory=%ld "
+                "generation=%ld object=%p data=%p sec_mixpos=%lu api_pos=%lu state=%lu "
+                "volume=%ld pan=%ld frequency=%lu flags=%#lx written_mask=%016llx:%016llx "
+                "position_pending=%u position_caller=%p position=%lu writes=%lu dropped=%lu\n",
+                GetTickCount(), caller, dsb->mgs_prod_iface_id,
+                dsb->mgs_prod_parent_iface_id, memory->mgs_prod_memory_id,
+                memory->mgs_prod_generation, dsb, memory->memory, dsb->sec_mixpos,
+                dsb->sec_mixpos, dsb->state, dsb->volpan.lVolume, dsb->volpan.lPan,
+                dsb->freq, flags,
+                (unsigned long long)memory->mgs_prod_written_mask[1],
+                (unsigned long long)memory->mgs_prod_written_mask[0],
+                dsb->mgs_prod_position_pending, dsb->mgs_prod_position_caller,
+                dsb->mgs_prod_position, memory->mgs_prod_write_count,
+                memory->mgs_prod_write_dropped);
+        for (i = 0; i < memory->mgs_prod_write_count; ++i)
+        {
+            event = &memory->mgs_prod_writes[i];
+            fprintf(mgs_prod_log, "WRITE generation=%lu lock_caller=%p unlock_caller=%p "
+                    "request_cursor=%lu request_bytes=%lu flags=%#lx "
+                    "region1=%lu+%lu region2=%lu+%lu\n",
+                    event->generation, event->lock_caller, event->unlock_caller,
+                    event->request_cursor, event->request_bytes, event->flags,
+                    event->offset1, event->bytes1, event->offset2, event->bytes2);
+        }
+        mgs_prod_log_pool_states(dsb->device, &playing);
+        fprintf(mgs_prod_log, "PLAYING_POOL_MEMBERS=%lu\n", playing);
+
+        if (memory->mgs_prod_dumped_generation != memory->mgs_prod_generation)
+        {
+            mgs_prod_output_dir(dir, sizeof(dir));
+            snprintf(path, sizeof(path), "%s\\memory-%ld-generation-%ld.raw", dir,
+                    memory->mgs_prod_memory_id, memory->mgs_prod_generation);
+            raw = fopen(path, "wb");
+            if (raw)
+            {
+                fwrite(memory->memory, dsb->buflen, 1, raw);
+                fclose(raw);
+                memory->mgs_prod_dumped_generation = memory->mgs_prod_generation;
+                fprintf(mgs_prod_log, "RAW memory=%ld generation=%ld path=%s bytes=%lu\n",
+                        memory->mgs_prod_memory_id, memory->mgs_prod_generation,
+                        path, dsb->buflen);
+            }
+        }
+        fflush(mgs_prod_log);
+        if (!--mgs_prod_remaining)
+        {
+            fprintf(mgs_prod_log, "END tick=%lu reason=max_plays\n", GetTickCount());
+            fclose(mgs_prod_log);
+            mgs_prod_log = NULL;
+        }
+    }
+
+    memory->mgs_prod_written_mask[0] = 0;
+    memory->mgs_prod_written_mask[1] = 0;
+    memory->mgs_prod_write_count = 0;
+    memory->mgs_prod_write_dropped = 0;
+    dsb->mgs_prod_position_pending = FALSE;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
