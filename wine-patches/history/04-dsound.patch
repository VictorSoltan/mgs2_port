+static BOOL mgs_sfx_make_tone(IDirectSoundBufferImpl *dsb)
+{
+    static LONG used;
+    const DWORD sample_count = min(dsb->buflen / sizeof(SHORT), 8820);
+    SHORT *samples = (SHORT *)dsb->buffer->memory;
+    DWORD i;
+
+    if (InterlockedCompareExchange(&used, 1, 0)) return FALSE;
+
+    memset(samples, 0, dsb->buflen);
+    for (i = 0; i < sample_count; ++i)
+        samples[i] = (SHORT)(sin(6.28318530717958647692 * 1000.0 * i / 44100.0) * 0x2000);
+
+    dsb->sec_mixpos = 0;
+    dsb->freqAccNum = 0;
+    dsb->use_committed = FALSE;
+    dsb->committed_mixpos = 0;
+    dsb->volpan.lVolume = DSBVOLUME_MAX;
+    dsb->volpan.lPan = 0;
+    DSOUND_RecalcVolPan(&dsb->volpan);
+    dsb->mgs_sfx_tone_hold_until = GetTickCount() + 250;
+    return TRUE;
+}
+
+static BOOL mgs_sfx_tone_holds_volume(const IDirectSoundBufferImpl *dsb)
+{
+    return dsb->mgs_sfx_tone_hold_until
+            && (LONG)(GetTickCount() - dsb->mgs_sfx_tone_hold_until) < 0;
+}
+
+static BOOL mgs_sfx_reset_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        char value[2];
+        DWORD len = GetEnvironmentVariableA("MGS2_SFX_RESET", value, sizeof(value));
+
+        enabled = len && len < sizeof(value) && value[0] != '0';
+    }
+
+    return enabled;
+}
