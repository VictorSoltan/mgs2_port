+static BOOL mgs_prod_arm_if_marked(DirectSoundDevice *device)
+{
+    static const char marker[] = "Z:\\tmp\\mgs2-sfx-arm";
+    char dir[MAX_PATH], path[MAX_PATH];
+    DWORD attributes;
+
+    if (mgs_prod_log) return TRUE;
+    attributes = GetFileAttributesA(marker);
+    if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY))
+        return FALSE;
+
+    DeleteFileA(marker);
+    mgs_prod_output_dir(dir, sizeof(dir));
+    CreateDirectoryA(dir, NULL);
+    snprintf(path, sizeof(path), "%s\\producer.log", dir);
+    mgs_prod_log = fopen(path, "wt");
+    if (!mgs_prod_log) return FALSE;
+
+    ++mgs_prod_capture_number;
+    mgs_prod_remaining = 12;
+    fprintf(mgs_prod_log, "MGS2_SFX_PRODUCER capture=%ld pid=%lu tick=%lu max_plays=%lu\n",
+            mgs_prod_capture_number, GetCurrentProcessId(), GetTickCount(), mgs_prod_remaining);
+    mgs_prod_log_pool(device, TRUE);
+    fflush(mgs_prod_log);
+    return TRUE;
+}
