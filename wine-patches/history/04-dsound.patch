+static void mgs_prod_log_pool(DirectSoundDevice *device, BOOL reset_dumps)
+{
+    IDirectSoundBufferImpl *dsb;
+    int i;
+
+    AcquireSRWLockShared(&device->buffer_list_lock);
+    for (i = 0; i < device->nrofbuffers; ++i)
+    {
+        dsb = device->buffers[i];
+        if (!mgs_sfx_voice(dsb)) continue;
+        AcquireSRWLockShared(&dsb->lock);
+        if (reset_dumps) dsb->buffer->mgs_prod_dumped_generation = -1;
+        fprintf(mgs_prod_log, "POOL iface=%ld parent=%ld memory=%ld object=%p data=%p "
+                "create_caller=%p caps=%#lx state=%lu generation=%ld\n",
+                dsb->mgs_prod_iface_id, dsb->mgs_prod_parent_iface_id,
+                dsb->buffer->mgs_prod_memory_id, dsb, dsb->buffer->memory,
+                dsb->mgs_prod_create_caller, dsb->dsbd.dwFlags, dsb->state,
+                dsb->buffer->mgs_prod_generation);
+        ReleaseSRWLockShared(&dsb->lock);
+    }
+    ReleaseSRWLockShared(&device->buffer_list_lock);
+}
