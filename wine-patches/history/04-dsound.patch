+static ULONGLONG mgs_prod_bit_range(DWORD first, DWORD last)
+{
+    ULONGLONG lower = first ? (~(ULONGLONG)0 << first) : ~(ULONGLONG)0;
+    ULONGLONG upper = last == 63 ? ~(ULONGLONG)0 : (((ULONGLONG)1 << (last + 1)) - 1);
+
+    return lower & upper;
+}
+
+static void mgs_prod_mark_range(BufferMemory *memory, DWORD offset, DWORD bytes)
+{
+    DWORD first, last;
+
+    if (!bytes || offset >= 32576) return;
+    if (bytes > 32576 - offset) bytes = 32576 - offset;
+    first = offset / 256;
+    last = (offset + bytes - 1) / 256;
+    if (first < 64)
+        memory->mgs_prod_written_mask[0] |= mgs_prod_bit_range(first, min(last, 63));
+    if (last >= 64)
+        memory->mgs_prod_written_mask[1] |= mgs_prod_bit_range(max(first, 64) - 64, last - 64);
+}
