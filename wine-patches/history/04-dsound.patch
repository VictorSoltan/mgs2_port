+static void mgs_prod_reset_iface_history(IDirectSoundBufferImpl *dsb)
+{
+    dsb->mgs_prod_lock_caller = NULL;
+    dsb->mgs_prod_lock_cursor = 0;
+    dsb->mgs_prod_lock_bytes = 0;
+    dsb->mgs_prod_lock_flags = 0;
+    dsb->mgs_prod_lock_offset1 = 0;
+    dsb->mgs_prod_lock_bytes1 = 0;
+    dsb->mgs_prod_lock_offset2 = 0;
+    dsb->mgs_prod_lock_bytes2 = 0;
+    dsb->mgs_prod_position_pending = FALSE;
+    dsb->mgs_prod_position_caller = NULL;
+    dsb->mgs_prod_position = 0;
+}
+
+void mgs_sfx_producer_note_create(IDirectSoundBufferImpl *dsb, void *caller)
+{
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb)) return;
+
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    if (!dsb->buffer->mgs_prod_memory_id)
+        dsb->buffer->mgs_prod_memory_id = ++mgs_prod_next_memory_id;
+    dsb->mgs_prod_iface_id = ++mgs_prod_next_iface_id;
+    dsb->mgs_prod_parent_iface_id = 0;
+    dsb->mgs_prod_create_caller = caller;
+    mgs_prod_reset_iface_history(dsb);
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
+
+void mgs_sfx_producer_note_duplicate(IDirectSoundBufferImpl *dsb,
+        IDirectSoundBufferImpl *source, void *caller)
+{
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(source)) return;
+
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    if (!source->buffer->mgs_prod_memory_id)
+        source->buffer->mgs_prod_memory_id = ++mgs_prod_next_memory_id;
+    if (!source->mgs_prod_iface_id)
+        source->mgs_prod_iface_id = ++mgs_prod_next_iface_id;
+    dsb->mgs_prod_iface_id = ++mgs_prod_next_iface_id;
+    dsb->mgs_prod_parent_iface_id = source->mgs_prod_iface_id;
+    dsb->mgs_prod_create_caller = caller;
+    mgs_prod_reset_iface_history(dsb);
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
