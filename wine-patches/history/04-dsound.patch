+ * region containing the live mixing cursor, but let the application replace
+ * it immediately.  New Wine preserves the old write-lead-sized chunk and
+ * keeps mixing that copy.  MGS2 aggressively rewrites and reuses secondary
+ * buffers, so retain a narrow A/B switch for the older CrossOver semantics. */
+static BOOL mgs_cx17_lock_semantics_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1) enabled = mgs_sfx_env_on("MGS2_DSOUND_CX17_LOCK");
+    return enabled;
+}
