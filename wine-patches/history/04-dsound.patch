+static void mgs_prod_log_pool_states(DirectSoundDevice *device, DWORD *playing)
+{
+    IDirectSoundBufferImpl *dsb;
+    int i;
+
+    *playing = 0;
+    fprintf(mgs_prod_log, "POOL_STATES");
+    AcquireSRWLockShared(&device->buffer_list_lock);
+    for (i = 0; i < device->nrofbuffers; ++i)
+    {
+        dsb = device->buffers[i];
+        if (!mgs_sfx_voice(dsb)) continue;
+        AcquireSRWLockShared(&dsb->lock);
+        if (dsb->state == STATE_STARTING || dsb->state == STATE_PLAYING) ++*playing;
+        fprintf(mgs_prod_log, " %ld:%lu", dsb->mgs_prod_iface_id, dsb->state);
+        ReleaseSRWLockShared(&dsb->lock);
+    }
+    ReleaseSRWLockShared(&device->buffer_list_lock);
+    fputc('\n', mgs_prod_log);
+}
