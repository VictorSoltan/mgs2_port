+static DWORD mgs_sfx_decode_vag(const BYTE *source, DWORD bytes, DWORD start, SHORT *output)
+{
+    static const double coeff[5][2] = {
+        { 0.0, 0.0 }, { 60.0 / 64.0, 0.0 }, { 115.0 / 64.0, -52.0 / 64.0 },
+        { 98.0 / 64.0, -55.0 / 64.0 }, { 122.0 / 64.0, -60.0 / 64.0 }
+    };
+    double s1 = 0.0, s2 = 0.0;
+    DWORD offset, samples = 0;
+
+    for (offset = start; offset + 16 <= bytes; offset += 16)
+    {
+        DWORD i;
+        BYTE header = source[offset], flags = source[offset + 1];
+        int predictor = header >> 4, shift = header & 0x0f;
+
+        if (predictor > 4 || shift > 12 || flags > 7) break;
+        for (i = 0; i < 14; ++i)
+        {
+            BYTE packed = source[offset + 2 + i];
+            int nibbles[2] = { packed & 0x0f, packed >> 4 };
+            DWORD n;
+
+            for (n = 0; n < 2; ++n)
+            {
+                int value = nibbles[n];
+                double decoded;
+
+                if (value & 8) value -= 16;
+                decoded = ((value << 12) >> shift) + s1 * coeff[predictor][0]
+                        + s2 * coeff[predictor][1];
+                if (decoded > 32767.0) decoded = 32767.0;
+                if (decoded < -32768.0) decoded = -32768.0;
+                output[samples++] = (SHORT)decoded;
+                s2 = s1;
+                s1 = decoded;
+            }
+        }
+        if (flags & 1) break;
+    }
+    return samples;
+}
