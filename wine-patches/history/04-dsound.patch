+static void mgs_sfx_producer_note_position(IDirectSoundBufferImpl *dsb, void *caller, DWORD position)
+{
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb)) return;
+
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    dsb->mgs_prod_position_pending = TRUE;
+    dsb->mgs_prod_position_caller = caller;
+    dsb->mgs_prod_position = position;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
