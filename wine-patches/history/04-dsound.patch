+/* MGS2 creates a pool of 32576-byte 44.1 kHz mono secondary buffers for its
+ * short effects.  They are the only buffers for which a Play-time inspection
+ * is useful: scanning one is cheap, while doing the same work on every Unlock
+ * made the RG353VS unplayable. */
+static BOOL mgs_sfx_voice(const IDirectSoundBufferImpl *dsb)
+{
+    return dsb->buflen == 32576 && dsb->pwfx
+            && dsb->pwfx->nSamplesPerSec == 44100
+            && dsb->pwfx->nChannels == 1
+            && dsb->pwfx->wBitsPerSample == 16
+            && (dsb->dsbd.dwFlags & DSBCAPS_LOCDEFER);
+}
+
+static DWORD mgs_sfx_nonzero_bytes(const BYTE *memory, DWORD bytes)
+{
+    DWORD i, nonzero = 0;
+
+    for (i = 0; i < bytes; ++i)
+        nonzero += memory[i] != 0;
+
+    return nonzero;
+}
+
+/* The first mix fragment says whether that instant is audible, but it can
+ * legitimately be an attack or a gap.  This Play-time pass gives the peak of
+ * the complete, already-decoded PCM effect.  It reads only 16K samples per
+ * effect, not the hot mixer path. */
+static DWORD mgs_sfx_peak_abs(const BYTE *memory, DWORD bytes)
+{
+    const SHORT *samples = (const SHORT *)memory;
+    DWORD i, count = bytes / sizeof(*samples), peak = 0;
+
+    for (i = 0; i < count; ++i)
+    {
+        int sample = samples[i];
+        DWORD magnitude = sample < 0 ? -sample : sample;
+
+        if (magnitude > peak) peak = magnitude;
+    }
+
+    return peak;
+}
+
+struct mgs_sfx_stats
+{
+    DWORD nonzero_bytes, first_nonzero, last_nonzero, pcm_peak;
+    double pcm_rms;
+    DWORD vag_offset, vag_valid, vag_total, vag_end_blocks;
+};
+
+static void mgs_sfx_analyse(const BYTE *memory, DWORD bytes, struct mgs_sfx_stats *stats)
+{
+    const SHORT *samples = (const SHORT *)memory;
+    DWORD i, sample_count = bytes / sizeof(*samples), best_score = 0;
+    double squares = 0.0;
+
+    memset(stats, 0, sizeof(*stats));
+    stats->first_nonzero = bytes;
+    for (i = 0; i < bytes; ++i)
+    {
+        if (memory[i])
+        {
+            ++stats->nonzero_bytes;
+            if (stats->first_nonzero == bytes) stats->first_nonzero = i;
+            stats->last_nonzero = i;
+        }
+    }
+    for (i = 0; i < sample_count; ++i)
+    {
+        int sample = samples[i];
+        DWORD magnitude = sample < 0 ? -sample : sample;
+
+        if (magnitude > stats->pcm_peak) stats->pcm_peak = magnitude;
+        squares += (double)sample * sample;
+    }
+    if (sample_count) stats->pcm_rms = sqrt(squares / sample_count) / 32768.0;
+
+    /* A VAG packet has a 4-bit predictor (0..4), a 4-bit shift (0..12), and
+     * a small flags byte. Score every byte alignment but skip all-zero tail
+     * packets: otherwise padding would falsely look like perfect VAG. */
+    for (i = 0; i < 16; ++i)
+    {
+        DWORD offset, valid = 0, total = 0, end_blocks = 0;
+        DWORD score;
+
+        for (offset = i; offset + 16 <= bytes; offset += 16)
+        {
+            DWORD j;
+            BOOL all_zero = TRUE;
+
+            for (j = 0; j < 16; ++j)
+                if (memory[offset + j]) { all_zero = FALSE; break; }
+            if (all_zero) continue;
+
+            ++total;
+            if ((memory[offset] >> 4) <= 4 && (memory[offset] & 0x0f) <= 12
+                    && memory[offset + 1] <= 7)
+            {
+                ++valid;
+                if (memory[offset + 1] & 1) ++end_blocks;
+            }
+        }
+        score = total ? valid * 1000 / total : 0;
+        if (score > best_score)
+        {
+            best_score = score;
+            stats->vag_offset = i;
+            stats->vag_valid = valid;
+            stats->vag_total = total;
+            stats->vag_end_blocks = end_blocks;
+        }
+    }
+}
