+static void mgs_sfx_producer_note_lock(IDirectSoundBufferImpl *dsb, void *caller,
+        DWORD request_cursor, DWORD request_bytes, DWORD flags,
+        const void *p1, DWORD bytes1, const void *p2, DWORD bytes2)
+{
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb)) return;
+
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    dsb->mgs_prod_lock_caller = caller;
+    dsb->mgs_prod_lock_cursor = request_cursor;
+    dsb->mgs_prod_lock_bytes = request_bytes;
+    dsb->mgs_prod_lock_flags = flags;
+    dsb->mgs_prod_lock_offset1 = p1 ? (const BYTE *)p1 - dsb->buffer->memory : 0;
+    dsb->mgs_prod_lock_bytes1 = bytes1;
+    dsb->mgs_prod_lock_offset2 = p2 ? (const BYTE *)p2 - dsb->buffer->memory : 0;
+    dsb->mgs_prod_lock_bytes2 = bytes2;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
+
+static void mgs_sfx_producer_note_unlock(IDirectSoundBufferImpl *dsb, void *caller,
+        const void *p1, DWORD bytes1, const void *p2, DWORD bytes2)
+{
+    BufferMemory *memory;
+    MgsSfxWriteEvent *event;
+    DWORD index, offset1, offset2;
+
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb) || (!bytes1 && !bytes2)) return;
+
+    memory = dsb->buffer;
+    offset1 = p1 ? (const BYTE *)p1 - memory->memory : 0;
+    offset2 = p2 ? (const BYTE *)p2 - memory->memory : 0;
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    ++memory->mgs_prod_generation;
+    mgs_prod_mark_range(memory, offset1, bytes1);
+    mgs_prod_mark_range(memory, offset2, bytes2);
+    if (memory->mgs_prod_write_count < MGS_SFX_WRITE_HISTORY)
+        index = memory->mgs_prod_write_count++;
+    else
+    {
+        index = MGS_SFX_WRITE_HISTORY - 1;
+        ++memory->mgs_prod_write_dropped;
+    }
+    event = &memory->mgs_prod_writes[index];
+    event->generation = memory->mgs_prod_generation;
+    event->lock_caller = dsb->mgs_prod_lock_caller;
+    event->unlock_caller = caller;
+    event->request_cursor = dsb->mgs_prod_lock_cursor;
+    event->request_bytes = dsb->mgs_prod_lock_bytes;
+    event->flags = dsb->mgs_prod_lock_flags;
+    event->offset1 = offset1;
+    event->bytes1 = bytes1;
+    event->offset2 = offset2;
+    event->bytes2 = bytes2;
+    dsb->mgs_prod_lock_caller = NULL;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
