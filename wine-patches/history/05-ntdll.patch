--- a/dlls/ntdll/unix/sync.c	2026-01-13 17:56:07.000000000 +0200
+++ b/dlls/ntdll/unix/sync.c	2026-08-02 14:57:02.425727567 +0300
@@ -2391,6 +2391,53 @@
 }
 
 
+/* MGS2: NtYieldExecution costs three syscalls, not one.  The getrusage() pair
+ * exists only so the function can report STATUS_NO_YIELD_PERFORMED, which has a
+ * single consumer in the whole tree (SwitchToThread).  Under box86 on this
+ * device the game's message loop drives ~1000 yields a second, so those two
+ * extra syscalls -- each of which memsets a struct rusage in the kernel -- are
+ * pure overhead.
+ *
+ *   MGS2_YIELD=full   stock behaviour (default)
+ *   MGS2_YIELD=fast   sched_yield() only, always report a yield happened
+ *   MGS2_YIELD=none   no syscall at all
+ *
+ * MGS2_YIELD_STATS=1 reports the call rate so the cost can be attributed.
+ */
+static int mgs_yield_mode(void)
+{
+    static int mode = -1;
+    if (mode == -1)
+    {
+        const char *s = getenv( "MGS2_YIELD" );
+        if (s && !strcmp( s, "fast" )) mode = 1;
+        else if (s && !strcmp( s, "none" )) mode = 2;
+        else mode = 0;
+    }
+    return mode;
+}
+
+static void mgs_yield_count(void)
+{
+    static unsigned int calls, enabled = 2;
+    static struct timespec last;
+    struct timespec now;
+    long long ms;
+
+    if (enabled == 2) enabled = getenv( "MGS2_YIELD_STATS" ) ? 1 : 0;
+    if (!enabled) return;
+    if (++calls < 50000) return;
+    clock_gettime( CLOCK_MONOTONIC, &now );
+    if (last.tv_sec)
+    {
+        ms = (now.tv_sec - last.tv_sec) * 1000 + (now.tv_nsec - last.tv_nsec) / 1000000;
+        fprintf( stderr, "MGS2 yield: %u calls in %lld ms = %lld/s\n",
+                 calls, ms, ms > 0 ? calls * 1000LL / ms : -1 );
+    }
+    last = now;
+    calls = 0;
+}
+
 /******************************************************************
  *		NtYieldExecution (NTDLL.@)
  */
@@ -2401,6 +2448,12 @@
     struct rusage u1, u2;
     int ret;
 
+    mgs_yield_count();
+    switch (mgs_yield_mode())
+    {
+    case 2: return STATUS_SUCCESS;
+    case 1: sched_yield(); return STATUS_SUCCESS;
+    }
     ret = getrusage( RUSAGE_THREAD, &u1 );
 #endif
     sched_yield();
