+static void mgs_route_port_note(void *port)
+{
+    int i;
+
+    if (!port) { mgs_route_no_port++; return; }
+    for (i = 0; i < ARRAY_SIZE(mgs_route_port); i++)
+    {
+        if (!mgs_route_port[i].port) mgs_route_port[i].port = port;
+        if (mgs_route_port[i].port == port) { mgs_route_port[i].count++; return; }
+    }
+}
