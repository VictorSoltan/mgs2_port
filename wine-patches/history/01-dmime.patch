+/* Each audio path owns a local PChannel namespace.  Map it to a disjoint
+ * performance range without overwriting adjacent channels in the same block. */
+static HRESULT performance_set_channel(struct performance *This, DWORD channel_num,
+        IDirectMusicPort *port, DWORD midi_group, DWORD midi_channel)
+{
+    DWORD block_num = channel_num / 16;
+    struct channel_block *block;
+    struct wine_rb_entry *entry;
+    struct channel *channel;
+
+    if ((entry = wine_rb_get(&This->channel_blocks, &block_num)))
+        block = WINE_RB_ENTRY_VALUE(entry, struct channel_block, entry);
+    else
+    {
+        if (!(block = calloc(1, sizeof(*block)))) return E_OUTOFMEMORY;
+        block->block_num = block_num;
+        wine_rb_put(&This->channel_blocks, &block_num, &block->entry);
+    }
+
+    channel = block->channels + channel_num % 16;
+    if (channel->port) IDirectMusicPort_Release(channel->port);
+    channel->midi_group = midi_group;
+    channel->midi_channel = midi_channel;
+    if ((channel->port = port)) IDirectMusicPort_AddRef(channel->port);
+    return S_OK;
+}
+
+static HRESULT performance_allocate_audio_path_channels(struct performance *This,
+        IDirectMusicPort *port, DWORD count, DWORD *base)
+{
+    DWORD i, channel_base, absolute;
+    HRESULT hr;
+
+    if (!count || count > MAXDWORD - This->next_audio_path_pchannel) return E_INVALIDARG;
+    channel_base = This->next_audio_path_pchannel;
+    for (i = 0; i < count; ++i)
+    {
+        absolute = channel_base + i;
+        if (FAILED(hr = performance_set_channel(This, absolute, port,
+                absolute / 16 + 1, absolute % 16)))
+            return hr;
+    }
+
+    This->next_audio_path_pchannel += count;
+    *base = channel_base;
+    return S_OK;
+}
