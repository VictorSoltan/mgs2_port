+static LONG mgs_sechain_budget;
+
+static BOOL mgs_sechain_on(void)
+{
+    static int on = -1;
+    if (on == -1)
+    {
+        char buf[8];
+        DWORD len = GetEnvironmentVariableA("MGS2_SECHAIN", buf, sizeof(buf));
+        on = (len && len < sizeof(buf) && buf[0] != '0');
+    }
+    return on;
+}
+
+static BOOL mgs_sechain_take(void)
+{
+    return mgs_sechain_on() && InterlockedIncrement(&mgs_sechain_budget) <= 400;
+}
+
+static void mgs_sechain_pmsg(const char *stage, const DMUS_PMSG *msg, void *extra, HRESULT hr)
+{
+    if (!mgs_sechain_take()) return;
+
+    if (msg->dwType == DMUS_PMSGT_MIDI)
+    {
+        const DMUS_MIDI_PMSG *midi = (const DMUS_MIDI_PMSG *)msg;
+
+        ERR("MGS2 SECHAIN %s tick=%lu MIDI pchannel=%lu flags=%#lx tool=%p graph=%p "
+                "status=%#x b1=%#x b2=%#x extra=%p hr=%#lx\n", stage, GetTickCount(),
+                msg->dwPChannel, msg->dwFlags, msg->pTool, msg->pGraph,
+                midi->bStatus, midi->bByte1, midi->bByte2, extra, hr);
+    }
+    else if (msg->dwType == DMUS_PMSGT_NOTE)
+    {
+        const DMUS_NOTE_PMSG *note = (const DMUS_NOTE_PMSG *)msg;
+
+        ERR("MGS2 SECHAIN %s tick=%lu NOTE pchannel=%lu flags=%#lx tool=%p graph=%p "
+                "noteflags=%#x midivalue=%u velocity=%u duration=%ld offset=%d extra=%p hr=%#lx\n",
+                stage, GetTickCount(), msg->dwPChannel, msg->dwFlags, msg->pTool, msg->pGraph,
+                note->bFlags, note->bMidiValue, note->bVelocity, note->mtDuration,
+                note->nOffset, extra, hr);
+    }
+    else
+    {
+        ERR("MGS2 SECHAIN %s tick=%lu type=%lu pchannel=%lu flags=%#lx tool=%p graph=%p "
+                "extra=%p hr=%#lx\n", stage, GetTickCount(), msg->dwType, msg->dwPChannel,
+                msg->dwFlags, msg->pTool, msg->pGraph, extra, hr);
+    }
+}
