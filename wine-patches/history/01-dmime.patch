+/* MGS2 creates many duplicate audio paths.  Keeping only the first two active
+ * preserves PChannel blocks 0 and 1 (music and effects) without starting a
+ * synth/DirectSound render thread for every duplicate path.  Opt-in so normal
+ * DirectMusic behaviour remains unchanged. */
+static DWORD mgs_audio_path_limit(void)
+{
+    static LONG value = -1;
+    char text[16];
+    char *p;
+    DWORD len;
+    DWORD parsed = 0;
+
+    if (value != -1) return value;
+    len = GetEnvironmentVariableA("MGS2_DMIME_PATH_LIMIT", text, sizeof(text));
+    if (len && len < sizeof(text))
+    {
+        p = text;
+        while (*p >= '0' && *p <= '9')
+        {
+            parsed = min(parsed * 10 + *p - '0', 64);
+            ++p;
+        }
+    }
+    value = parsed;
+    return value;
+}
+
+static DWORD mgs_audio_paths_active;
+
+static BOOL mgs_audio_path_activate(BOOL requested)
+{
+    DWORD limit = mgs_audio_path_limit();
+
+    if (!requested || !limit) return requested;
+    return mgs_audio_paths_active++ < limit;
+}
+
+static BOOL mgs_shared_audio_path_port_enabled(void)
+{
+    static LONG value = -1;
+    char text[8];
+    DWORD len;
+
+    if (value != -1) return value;
+    len = GetEnvironmentVariableA("MGS2_DMIME_SHAREDGROUPS", text, sizeof(text));
+    value = len && len < sizeof(text) && text[0] != '0';
+    return value;
+}
+
+/* The shared port must own every channel group the PChannel allocation below
+ * can name, or the last audio paths route to a group the port does not have.
+ * MGS2 reserves 34 PChannels (thirteen one-channel 3D paths and one 21-channel
+ * stereo path), which is three groups; four is the default so the layout has
+ * room without a second port. */
+static DWORD mgs_shared_audio_path_groups(void)
+{
+    static LONG value = -1;
+    char text[8];
+    DWORD len, parsed = 0;
+    char *p;
+
+    if (value != -1) return value;
+    len = GetEnvironmentVariableA("MGS2_DMIME_SHAREDGROUP_COUNT", text, sizeof(text));
+    if (len && len < sizeof(text))
+    {
+        p = text;
+        while (*p >= '0' && *p <= '9')
+        {
+            parsed = min(parsed * 10 + *p - '0', 16);
+            ++p;
+        }
+    }
+    value = parsed ? parsed : 4;
+    return value;
+}
