+/* Routing census, behind MGS2_DM_ROUTE=1.
+ *
+ * MGS2's effects are silent while its streamed music plays, and perf_dmport_create
+ * rebuilds the PChannel map from block 0 on every audio path, so all fourteen paths
+ * claim the same channels and the last one created owns the routing. Before fixing
+ * that, this establishes whether the game sends any note or MIDI traffic at all --
+ * if it does not, the whole routing theory is moot.
+ *
+ * Counters only, reported once a second. The device is CPU-bound and an earlier
+ * probe that did per-sample work on a hot path made the game unplayable.
+ */
+static LONG mgs_route_type[16];
+static struct { void *port; LONG count; } mgs_route_port[16];
+static LONG mgs_route_no_port;
+
+/*
+ * MGS2_SECHAIN=1: follow one SE message across the boundaries inside dmime.
+ *
+ * A probe in dmsynth's Render showed no note-on with velocity above zero during
+ * a whole run of menu clicks, while the game's own instrumentation caught
+ * 90 3c 7f leaving it.  So the message is lost between the two, and the stages
+ * that can lose it are the tool dispatch, the PChannel resolution and the pack
+ * into the port buffer.  This records each stage for the same message.
+ *
+ * Budget-bounded, not rate-bounded: two clicks in the menu are all the test
+ * needs, and a bound by count cannot degrade into per-render logging.
