+static void mgs_route_tick(DWORD type)
+{
+    static DWORD last;
+    DWORD now;
+    int i;
+
+    if (type < ARRAY_SIZE(mgs_route_type)) mgs_route_type[type]++;
+
+    now = GetTickCount();
+    if (now - last < 1000) return;
+    last = now;
+
+    ERR("MGS2 route types: midi=%ld note=%ld patch=%ld curve=%ld wave=%ld notif=%ld stop=%ld\n",
+        mgs_route_type[DMUS_PMSGT_MIDI], mgs_route_type[DMUS_PMSGT_NOTE],
+        mgs_route_type[DMUS_PMSGT_PATCH], mgs_route_type[DMUS_PMSGT_CURVE],
+        mgs_route_type[DMUS_PMSGT_WAVE], mgs_route_type[DMUS_PMSGT_NOTIFICATION],
+        mgs_route_type[DMUS_PMSGT_STOP]);
+    for (i = 0; i < ARRAY_SIZE(mgs_route_port) && mgs_route_port[i].port; i++)
+    {
+        if (!mgs_route_port[i].count) continue;
+        ERR("MGS2 route port %p got %ld\n", mgs_route_port[i].port, mgs_route_port[i].count);
+        mgs_route_port[i].count = 0;
+    }
+    if (mgs_route_no_port) ERR("MGS2 route unrouted %ld\n", mgs_route_no_port);
+    memset(mgs_route_type, 0, sizeof(mgs_route_type));
+    mgs_route_no_port = 0;
+}
