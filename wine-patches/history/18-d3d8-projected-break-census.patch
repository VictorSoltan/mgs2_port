+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_NET_STATE_SAME],
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_NET_STATE_SAME] / frames,
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_WORLD_ONLY],
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_WORLD_ONLY] / frames,
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_MATERIAL_ONLY],
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_MATERIAL_ONLY] / frames,
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_TEXTURE_ONLY],
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_TEXTURE_ONLY] / frames,
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_RS_TSS_SAMPLER],
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_RS_TSS_SAMPLER] / frames,
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_SHADER_CONSTANTS],
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_SHADER_CONSTANTS] / frames,
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_STREAM_VB],
+            d3d8_mgs2_projected.projected_draws[D3D8_MGS2_BREAK_STREAM_VB] / frames);
+    fprintf(stderr, "MGS2PROJECTED_BREAKS: same=%I64u world=%I64u material=%I64u texture=%I64u "
+            "rstss=%I64u shader=%I64u stream=%I64u resource=%I64u hard=%I64u mixed=%I64u "
+            "same_dirty=%I64u changed_clean=%I64u light_overflow=%u\n",
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_NET_STATE_SAME],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_WORLD_ONLY],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_MATERIAL_ONLY],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_TEXTURE_ONLY],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_RS_TSS_SAMPLER],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_SHADER_CONSTANTS],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_STREAM_VB],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_RESOURCE_MUTATION],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_HARD_ORDER_BARRIER],
+            d3d8_mgs2_projected.boundaries[D3D8_MGS2_BREAK_MIXED_STATE],
+            d3d8_mgs2_projected.net_same_dirty,
+            d3d8_mgs2_projected.changed_without_dirty,
+            d3d8_mgs2_projected.light_overflow);
+    fflush(stderr);
+
+    d3d8_mgs2_projected.frames = 0;
+    d3d8_mgs2_projected.source_draws = 0;
+    d3d8_mgs2_projected.actual_batches = 0;
+    d3d8_mgs2_projected.net_same_dirty = 0;
+    d3d8_mgs2_projected.changed_without_dirty = 0;
+    memset(d3d8_mgs2_projected.boundaries, 0, sizeof(d3d8_mgs2_projected.boundaries));
+    for (i = 0; i <= D3D8_MGS2_BREAK_STREAM_VB; ++i)
+        d3d8_mgs2_projected.projected_draws[i] = 0;
+}
