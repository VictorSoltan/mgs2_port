+/* Projected batch-break census.
+ *
+ * The older barrier census above observes individual redundant setters. It
+ * cannot see a sequence such as A -> B -> A between two draws, although the
+ * effective state at both draw boundaries is identical. Keep a reversible
+ * 128-bit fingerprint instead: each setter XORs out the old slot hash and
+ * XORs in the new one. Six independent groups let the draw boundary classify
+ * both exact net equality and a single liftable state family.
+ *
+ * This is diagnostic-only, off by default, integer-only on the draw path, and
+ * emits two aggregate lines after exactly 300 Presents. It never changes the
+ * existing dirty/apply/flush decisions. */
+#define D3D8_MGS2_PROJECTED_REPORT_FRAMES 300
+#define D3D8_MGS2_PROJECTED_LIGHTS 64
+struct d3d8_mgs2_fingerprint
+{
+    ULONGLONG lo, hi;
+};
+
+enum d3d8_mgs2_projected_break
+{
+    D3D8_MGS2_BREAK_NET_STATE_SAME,
+    D3D8_MGS2_BREAK_WORLD_ONLY,
+    D3D8_MGS2_BREAK_MATERIAL_ONLY,
+    D3D8_MGS2_BREAK_TEXTURE_ONLY,
+    D3D8_MGS2_BREAK_RS_TSS_SAMPLER,
+    D3D8_MGS2_BREAK_SHADER_CONSTANTS,
+    D3D8_MGS2_BREAK_STREAM_VB,
+    D3D8_MGS2_BREAK_RESOURCE_MUTATION,
+    D3D8_MGS2_BREAK_HARD_ORDER_BARRIER,
+    D3D8_MGS2_BREAK_MIXED_STATE,
+    D3D8_MGS2_BREAK_COUNT,
+};
+
+enum d3d8_mgs2_pending_barrier
+{
+    D3D8_MGS2_PENDING_BARRIER_NONE,
+    D3D8_MGS2_PENDING_BARRIER_RESOURCE,
+    D3D8_MGS2_PENDING_BARRIER_HARD,
+};
+
+static struct
+{
+    struct d3d8_device *device;
+    struct d3d8_mgs2_fingerprint current[D3D8_MGS2_FP_GROUP_COUNT];
+    struct d3d8_mgs2_fingerprint last_draw[D3D8_MGS2_FP_GROUP_COUNT];
+    DWORD light_indices[D3D8_MGS2_PROJECTED_LIGHTS];
+    unsigned int light_count;
+    BOOL light_overflow;
+    BOOL fingerprint_valid;
+    BOOL have_last_draw;
+    BOOL last_batchable;
+    D3DPRIMITIVETYPE last_primitive;
+    enum d3d8_mgs2_pending_barrier pending_barrier;
+    unsigned int projected_run[D3D8_MGS2_BREAK_STREAM_VB + 1];
+    ULONGLONG boundaries[D3D8_MGS2_BREAK_COUNT];
+    ULONGLONG projected_draws[D3D8_MGS2_BREAK_STREAM_VB + 1];
+    ULONGLONG source_draws, actual_batches;
+    ULONGLONG net_same_dirty, changed_without_dirty;
+    unsigned int frames;
+} d3d8_mgs2_projected;
+
+static BOOL d3d8_mgs2_projected_census_on(void)
+{
+    static int on = -1;
+
+    if (on == -1)
+        on = d3d8_mgs2_env_on("MGS2_D3D8_PROJECTED_BREAK_CENSUS", FALSE);
+    return on;
+}
+
+static ULONGLONG d3d8_mgs2_fingerprint_hash(ULONGLONG seed, ULONGLONG slot,
+        const void *value, size_t size)
+{
+    const BYTE *bytes = value;
+    size_t i;
+
+    seed ^= slot + 0x9e3779b97f4a7c15ull + (seed << 6) + (seed >> 2);
+    for (i = 0; i < size; ++i)
+    {
+        seed ^= bytes[i];
+        seed *= 0x100000001b3ull;
+    }
+    seed ^= seed >> 33;
+    seed *= 0xff51afd7ed558ccdull;
+    seed ^= seed >> 33;
+    return seed;
+}
+
+static struct d3d8_mgs2_fingerprint d3d8_mgs2_fingerprint_slot(
+        enum d3d8_mgs2_fingerprint_group group, ULONGLONG slot,
+        const void *value, size_t size)
+{
+    struct d3d8_mgs2_fingerprint fp;
+
+    slot ^= (ULONGLONG)group << 56;
+    fp.lo = d3d8_mgs2_fingerprint_hash(0xcbf29ce484222325ull, slot, value, size);
+    fp.hi = d3d8_mgs2_fingerprint_hash(0x84222325cbf29ce4ull,
+            slot ^ 0xd6e8feb86659fd93ull, value, size);
+    return fp;
+}
+
+static void d3d8_mgs2_fingerprint_add(enum d3d8_mgs2_fingerprint_group group,
+        ULONGLONG slot, const void *value, size_t size)
+{
+    struct d3d8_mgs2_fingerprint fp = d3d8_mgs2_fingerprint_slot(group, slot, value, size);
+
+    d3d8_mgs2_projected.current[group].lo ^= fp.lo;
+    d3d8_mgs2_projected.current[group].hi ^= fp.hi;
+}
+
+static BOOL d3d8_mgs2_fingerprint_equal(const struct d3d8_mgs2_fingerprint *a,
+        const struct d3d8_mgs2_fingerprint *b)
+{
+    return a->lo == b->lo && a->hi == b->hi;
+}
+
+static void d3d8_mgs2_projected_set_device(struct d3d8_device *device)
+{
+    if (d3d8_mgs2_projected.device == device)
+        return;
+
+    memset(&d3d8_mgs2_projected, 0, sizeof(d3d8_mgs2_projected));
+    d3d8_mgs2_projected.device = device;
+}
+
+static void d3d8_mgs2_fingerprint_track_light(struct d3d8_device *device, DWORD index)
+{
+    unsigned int i;
+
+    if (!d3d8_mgs2_projected_census_on())
+        return;
+    d3d8_mgs2_projected_set_device(device);
+    for (i = 0; i < d3d8_mgs2_projected.light_count; ++i)
+        if (d3d8_mgs2_projected.light_indices[i] == index)
+            return;
+    if (d3d8_mgs2_projected.light_count == ARRAY_SIZE(d3d8_mgs2_projected.light_indices))
+    {
+        d3d8_mgs2_projected.light_overflow = TRUE;
+        return;
+    }
+    d3d8_mgs2_projected.light_indices[d3d8_mgs2_projected.light_count++] = index;
+}
+
+static void d3d8_mgs2_fingerprint_resync(struct d3d8_device *device)
+{
+    const struct wined3d_stateblock_state *state;
+    unsigned int i, j;
+
+    if (!d3d8_mgs2_projected_census_on())
+        return;
+    d3d8_mgs2_projected_set_device(device);
+    state = device->stateblock_state;
+    memset(d3d8_mgs2_projected.current, 0, sizeof(d3d8_mgs2_projected.current));
+
+    for (i = 0; i <= WINED3D_HIGHEST_TRANSFORM_STATE; ++i)
+        d3d8_mgs2_fingerprint_add(i >= WINED3D_TS_WORLD
+                ? D3D8_MGS2_FP_WORLD : D3D8_MGS2_FP_SHADER_CONSTANTS,
+                D3D8_MGS2_FP_SLOT_TRANSFORM_BASE + i,
+                &state->transforms[i], sizeof(state->transforms[i]));
+
+    d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_SHADER_CONSTANTS,
+            D3D8_MGS2_FP_SLOT_VERTEX_DECL,
+            &state->vertex_declaration, sizeof(state->vertex_declaration));
+    d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_SHADER_CONSTANTS,
+            D3D8_MGS2_FP_SLOT_VS, &state->vs, sizeof(state->vs));
+    d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_SHADER_CONSTANTS,
+            D3D8_MGS2_FP_SLOT_PS, &state->ps, sizeof(state->ps));
+    for (i = 0; i < ARRAY_SIZE(state->vs_consts_f); ++i)
+        d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_SHADER_CONSTANTS,
+                D3D8_MGS2_FP_SLOT_VS_CONST_BASE + i,
+                &state->vs_consts_f[i], sizeof(state->vs_consts_f[i]));
+    for (i = 0; i < ARRAY_SIZE(state->ps_consts_f); ++i)
+        d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_SHADER_CONSTANTS,
+                D3D8_MGS2_FP_SLOT_PS_CONST_BASE + i,
+                &state->ps_consts_f[i], sizeof(state->ps_consts_f[i]));
+    for (i = 0; i < ARRAY_SIZE(state->clip_planes); ++i)
+        d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_SHADER_CONSTANTS,
+                D3D8_MGS2_FP_SLOT_CLIP_BASE + i,
+                &state->clip_planes[i], sizeof(state->clip_planes[i]));
+
+    d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_MATERIAL,
+            D3D8_MGS2_FP_SLOT_MATERIAL, &state->material, sizeof(state->material));
+    for (i = 0; i < d3d8_mgs2_projected.light_count; ++i)
+    {
+        struct
+        {
+            struct wined3d_light light;
+            BOOL enabled;
+        } value;
+        HRESULT hr;
+
+        memset(&value, 0, sizeof(value));
+        hr = wined3d_stateblock_get_light(device->state,
+                d3d8_mgs2_projected.light_indices[i], &value.light, &value.enabled);
+        if (SUCCEEDED(hr))
+            d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_MATERIAL,
+                    D3D8_MGS2_FP_SLOT_LIGHT_BASE + d3d8_mgs2_projected.light_indices[i],
+                    &value, sizeof(value));
+    }
+
+    for (i = 0; i < ARRAY_SIZE(state->textures); ++i)
+        d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_TEXTURE,
+                D3D8_MGS2_FP_SLOT_TEXTURE_BASE + i,
+                &state->textures[i], sizeof(state->textures[i]));
+
+    for (i = 0; i < ARRAY_SIZE(state->rs); ++i)
+        d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_RS_TSS_SAMPLER,
+                D3D8_MGS2_FP_SLOT_RS_BASE + i, &state->rs[i], sizeof(state->rs[i]));
+    d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_RS_TSS_SAMPLER,
+            D3D8_MGS2_FP_SLOT_ALPHA_COVERAGE,
+            &state->alpha_to_coverage, sizeof(state->alpha_to_coverage));
+    for (i = 0; i < ARRAY_SIZE(state->texture_states); ++i)
+        for (j = 0; j < ARRAY_SIZE(state->texture_states[i]); ++j)
+            d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_RS_TSS_SAMPLER,
+                    D3D8_MGS2_FP_SLOT_TSS_BASE + i * 256 + j,
+                    &state->texture_states[i][j], sizeof(state->texture_states[i][j]));
+    for (i = 0; i < ARRAY_SIZE(state->sampler_states); ++i)
+        for (j = 0; j < ARRAY_SIZE(state->sampler_states[i]); ++j)
+            d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_RS_TSS_SAMPLER,
+                    D3D8_MGS2_FP_SLOT_SAMPLER_BASE + i * 256 + j,
+                    &state->sampler_states[i][j], sizeof(state->sampler_states[i][j]));
+    d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_RS_TSS_SAMPLER,
+            D3D8_MGS2_FP_SLOT_VIEWPORT, &state->viewport, sizeof(state->viewport));
+    d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_RS_TSS_SAMPLER,
+            D3D8_MGS2_FP_SLOT_SCISSOR, &state->scissor_rect, sizeof(state->scissor_rect));
+
+    for (i = 0; i < ARRAY_SIZE(state->streams); ++i)
+        d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_STREAM_VB,
+                D3D8_MGS2_FP_SLOT_STREAM_BASE + i,
+                &state->streams[i], sizeof(state->streams[i]));
+    {
+        struct
+        {
+            struct wined3d_buffer *buffer;
+            enum wined3d_format_id format;
+            int base_vertex_index;
+        } value;
+
+        memset(&value, 0, sizeof(value));
+        value.buffer = state->index_buffer;
+        value.format = state->index_format;
+        value.base_vertex_index = state->base_vertex_index;
+        d3d8_mgs2_fingerprint_add(D3D8_MGS2_FP_STREAM_VB,
+                D3D8_MGS2_FP_SLOT_INDEX, &value, sizeof(value));
+    }
+    d3d8_mgs2_projected.fingerprint_valid = TRUE;
+}
+
+static void d3d8_mgs2_fingerprint_replace(struct d3d8_device *device,
+        enum d3d8_mgs2_fingerprint_group group, ULONGLONG slot,
+        const void *old_value, const void *new_value, size_t size)
+{
+    struct d3d8_mgs2_fingerprint old_fp, new_fp;
+
+    if (!d3d8_mgs2_projected_census_on() || device->recording)
+        return;
+    d3d8_mgs2_fingerprint_ensure(device);
+    old_fp = d3d8_mgs2_fingerprint_slot(group, slot, old_value, size);
+    new_fp = d3d8_mgs2_fingerprint_slot(group, slot, new_value, size);
+    d3d8_mgs2_projected.current[group].lo ^= old_fp.lo ^ new_fp.lo;
+    d3d8_mgs2_projected.current[group].hi ^= old_fp.hi ^ new_fp.hi;
+}
+
+static void d3d8_mgs2_fingerprint_ensure(struct d3d8_device *device)
+{
+    if (d3d8_mgs2_projected_census_on()
+            && (!d3d8_mgs2_projected.fingerprint_valid
+            || d3d8_mgs2_projected.device != device))
+        d3d8_mgs2_fingerprint_resync(device);
+}
+
+static void d3d8_mgs2_fingerprint_light_changed(struct d3d8_device *device, DWORD index,
+        const struct wined3d_light *old_light, BOOL old_enabled, BOOL old_present,
+        const struct wined3d_light *new_light, BOOL new_enabled, BOOL new_present)
+{
+    struct
+    {
+        struct wined3d_light light;
+        BOOL enabled;
+    } old_value, new_value;
+    struct d3d8_mgs2_fingerprint fp;
+
+    if (!d3d8_mgs2_projected_census_on() || device->recording)
+        return;
+    d3d8_mgs2_fingerprint_ensure(device);
+    memset(&old_value, 0, sizeof(old_value));
+    memset(&new_value, 0, sizeof(new_value));
+    if (old_present)
+    {
+        old_value.light = *old_light;
+        old_value.enabled = old_enabled;
+        fp = d3d8_mgs2_fingerprint_slot(D3D8_MGS2_FP_MATERIAL,
+                D3D8_MGS2_FP_SLOT_LIGHT_BASE + index, &old_value, sizeof(old_value));
+        d3d8_mgs2_projected.current[D3D8_MGS2_FP_MATERIAL].lo ^= fp.lo;
+        d3d8_mgs2_projected.current[D3D8_MGS2_FP_MATERIAL].hi ^= fp.hi;
+    }
+    if (new_present)
+    {
+        new_value.light = *new_light;
+        new_value.enabled = new_enabled;
+        fp = d3d8_mgs2_fingerprint_slot(D3D8_MGS2_FP_MATERIAL,
+                D3D8_MGS2_FP_SLOT_LIGHT_BASE + index, &new_value, sizeof(new_value));
+        d3d8_mgs2_projected.current[D3D8_MGS2_FP_MATERIAL].lo ^= fp.lo;
+        d3d8_mgs2_projected.current[D3D8_MGS2_FP_MATERIAL].hi ^= fp.hi;
+    }
+}
+
+void d3d8_mgs2_projected_barrier(struct d3d8_device *device, BOOL resource_mutation)
+{
+    if (!d3d8_mgs2_projected_census_on())
+        return;
+    d3d8_mgs2_projected_set_device(device);
+    if (!d3d8_mgs2_projected.have_last_draw)
+        return;
+    if (!resource_mutation || d3d8_mgs2_projected.pending_barrier == D3D8_MGS2_PENDING_BARRIER_HARD)
+        d3d8_mgs2_projected.pending_barrier = D3D8_MGS2_PENDING_BARRIER_HARD;
+    else
+        d3d8_mgs2_projected.pending_barrier = D3D8_MGS2_PENDING_BARRIER_RESOURCE;
+}
+
+static unsigned int d3d8_mgs2_projected_diff_mask(void)
+{
+    unsigned int i, mask = 0;
+
+    for (i = 0; i < D3D8_MGS2_FP_GROUP_COUNT; ++i)
+        if (!d3d8_mgs2_fingerprint_equal(&d3d8_mgs2_projected.current[i],
+                &d3d8_mgs2_projected.last_draw[i]))
+            mask |= 1u << i;
+    return mask;
+}
+
+static enum d3d8_mgs2_projected_break d3d8_mgs2_projected_classify(unsigned int diff_mask)
+{
+    unsigned int group;
+
+    if (!diff_mask)
+        return D3D8_MGS2_BREAK_NET_STATE_SAME;
+    if (diff_mask & (diff_mask - 1))
+        return D3D8_MGS2_BREAK_MIXED_STATE;
+    group = wined3d_bit_scan(&diff_mask);
+    return D3D8_MGS2_BREAK_WORLD_ONLY + group;
+}
+
+static void d3d8_mgs2_projected_draw(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, BOOL batchable)
+{
+    enum d3d8_mgs2_projected_break kind = D3D8_MGS2_BREAK_HARD_ORDER_BARRIER;
+    unsigned int i, diff_mask = 0;
+    BOOL compatible = FALSE;
+
+    if (!d3d8_mgs2_projected_census_on())
+        return;
+    d3d8_mgs2_fingerprint_ensure(device);
+    ++d3d8_mgs2_projected.source_draws;
+
+    if (d3d8_mgs2_projected.have_last_draw)
+    {
+        if (d3d8_mgs2_projected.pending_barrier == D3D8_MGS2_PENDING_BARRIER_RESOURCE)
+            kind = D3D8_MGS2_BREAK_RESOURCE_MUTATION;
+        else if (d3d8_mgs2_projected.pending_barrier == D3D8_MGS2_PENDING_BARRIER_HARD
+                || !batchable || !d3d8_mgs2_projected.last_batchable
+                || primitive_type != d3d8_mgs2_projected.last_primitive)
+            kind = D3D8_MGS2_BREAK_HARD_ORDER_BARRIER;
+        else
+        {
+            diff_mask = d3d8_mgs2_projected_diff_mask();
+            kind = d3d8_mgs2_projected_classify(diff_mask);
+            compatible = TRUE;
+            if (!diff_mask && d3d8_mgs2_state_dirty)
+                ++d3d8_mgs2_projected.net_same_dirty;
+            else if (diff_mask && !d3d8_mgs2_state_dirty)
+                ++d3d8_mgs2_projected.changed_without_dirty;
+        }
+        ++d3d8_mgs2_projected.boundaries[kind];
+    }
+
+    for (i = 0; i <= D3D8_MGS2_BREAK_STREAM_VB; ++i)
+    {
+        unsigned int allowed = i ? 1u << (i - 1) : 0;
+        BOOL merge = d3d8_mgs2_projected.have_last_draw && compatible
+                && (!diff_mask || diff_mask == allowed)
+                && d3d8_mgs2_projected.projected_run[i] < D3D8_MGS2_DRAW_BATCH_MAX;
+
+        if (merge)
+            ++d3d8_mgs2_projected.projected_run[i];
+        else
+        {
+            ++d3d8_mgs2_projected.projected_draws[i];
+            d3d8_mgs2_projected.projected_run[i] = 1;
+        }
+    }
+
+    if (!batchable)
+        ++d3d8_mgs2_projected.actual_batches;
+    memcpy(d3d8_mgs2_projected.last_draw, d3d8_mgs2_projected.current,
+            sizeof(d3d8_mgs2_projected.last_draw));
+    d3d8_mgs2_projected.have_last_draw = TRUE;
+    d3d8_mgs2_projected.last_batchable = batchable;
+    d3d8_mgs2_projected.last_primitive = primitive_type;
+    d3d8_mgs2_projected.pending_barrier = D3D8_MGS2_PENDING_BARRIER_NONE;
+}
+
+static void d3d8_mgs2_projected_batch_flushed(unsigned int source_draws)
+{
+    if (source_draws && d3d8_mgs2_projected_census_on())
+        ++d3d8_mgs2_projected.actual_batches;
+}
+
+static void d3d8_mgs2_projected_census_present(struct d3d8_device *device)
+{
+    unsigned int i;
