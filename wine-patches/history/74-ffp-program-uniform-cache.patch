+ * warm-up and not the optimisation.
+ */
+#define MGS2_TEXMATRIX_MAGIC 0x314D5854u /* TXM1 */
+struct mgs2_texmatrix_stats_public
+{
+    unsigned int magic, version, size_words, signature;
+    volatile unsigned int enabled;
+    unsigned int attempted, skipped, executed;
+    unsigned int cold_miss, changed_miss, program_cache_resets;
+    unsigned int per_tex_attempted[WINED3D_MAX_FFP_TEXTURES];
+    unsigned int per_tex_skipped[WINED3D_MAX_FFP_TEXTURES];
+};
+
+/* Bisection switch, compiled in for one experiment: the owner sees the frame
+ * height jumping on this build and not on production, so the skip has to be
+ * separated from everything else the build changed -- the regenerated class-B
+ * registry, the new island binary and the A/B tick in present. With this set,
+ * the cache is still filled and the A/B still flips arms and prints blocks, but
+ * no upload is ever skipped. If the artefact survives that, it is not the cache. */
+static const BOOL mgs2_texmatrix_skip_disabled = TRUE;
+
+struct mgs2_texmatrix_stats_public mgs2_texmatrix_stats =
+{
+    MGS2_TEXMATRIX_MAGIC, 1,
+    sizeof(struct mgs2_texmatrix_stats_public) / sizeof(unsigned int),
+    ~MGS2_TEXMATRIX_MAGIC,
+    1,
+};
+
+/*
+ * Same-process ABBA, driven from the swapchain's own present.
+ *
+ * The presenter in winewayland.drv already has an A/B harness, and the first
+ * attempt drove this flag from there by locating the record in memory. That was
+ * a mistake twice over: the scan ran inside the probe context wined3d builds to
+ * enumerate pixel formats and killed adapter initialisation, and once deferred
+ * it silently found nothing. The frame counter this needs is right here --
+ * swapchain_gl_present() is called once per displayed frame -- so the A/B lives
+ * where the optimisation lives and crosses no module boundary.
+ *
+ * The block line is printed in the exact format harness/present_ab_read.py
+ * already parses, so the reducer, its ABBA pairing, its depth and stability
+ * filters and its negative control are reused unchanged. Arm A ("sync") is
+ * always the incumbent: skipping disabled.
+ */
+void mgs2_texmatrix_ab_present(void);
+
+/*
+ * `enabled` has exactly one owner: mgs2_texmatrix_ab_present(). An earlier
+ * version also seeded it lazily from MGS2_GL_TEXMATRIX_SHADOW on the first
+ * uniform upload, and whichever of the two ran first won -- which is why the
+ * first block came out labelled as the wrong arm. The env variable is read once,
+ * in the A/B initialiser, and nowhere else.
+ */
+
+void mgs2_texmatrix_ab_present(void)
+{
+    static const unsigned int arm[4] = { 0, 1, 1, 0 };
+    static int block_len = -1, settle, seen, block;
+    static double stamp[1024];
+    static unsigned int nstamp;
+    static double ms_per_tick;
+    LARGE_INTEGER qpc;
+    double now, iv[1024];
+    unsigned int i, k, n;
+
+    if (block_len < 0)
+    {
+        const char *v = getenv("MGS2_PRESENT_AB");
+        const char *w = getenv("MGS2_PRESENT_AB_SETTLE");
+
+        /* Default 12, not 0. getenv() on the PE side did not see
+         * MGS2_PRESENT_AB even though the Unix-side presenter did, and a
+         * silently disabled A/B in a build whose only purpose is the A/B is a
+         * waste of a run. The variable still overrides when it does arrive. */
+        block_len = (v && *v) ? atoi(v) : 12;
+        settle = (w && *w) ? atoi(w) : 1;
+        if (block_len < 2) block_len = 12;
+        if (settle < 0) settle = 0;
+        mgs2_texmatrix_stats.enabled = 0;   /* block 0 is arm A, skip off */
+        ERR("MGS2 texmatrix A/B: %d-frame blocks, settle %d, arm A = cache off "
+            "(MGS2_PRESENT_AB said %s)\n", block_len, settle, v ? v : "nothing");
+    }
+    if (!block_len) return;
+
+    /* QueryPerformanceCounter, not clock_gettime: this is the PE side. */
+    if (ms_per_tick == 0.0)
+    {
+        LARGE_INTEGER freq;
+
+        QueryPerformanceFrequency(&freq);
+        ms_per_tick = freq.QuadPart ? 1000.0 / (double)freq.QuadPart : 0.0;
+        if (ms_per_tick == 0.0) { block_len = 0; return; }
+    }
+    QueryPerformanceCounter(&qpc);
+    now = (double)qpc.QuadPart * ms_per_tick;
+
+    /* Timestamps first; intervals are differences between consecutive ones, so
+     * a block of N stamps yields N-1 frame times. The settle frames after an
+     * arm flip are dropped: the first frame of a new arm straddles both. */
+    if (seen >= settle && nstamp < ARRAY_SIZE(stamp))
+        stamp[nstamp++] = now;
+    ++seen;
+    if (seen < block_len) return;
+
+    n = nstamp > 1 ? nstamp - 1 : 0;
+    if (n)
+    {
+        double span = stamp[nstamp - 1] - stamp[0], sum = 0.0;
+
+        for (i = 0; i < n; ++i)
+        {
+            iv[i] = stamp[i + 1] - stamp[i];
+            sum += iv[i];
+        }
+        for (i = 0; i + 1 < n; ++i)
+            for (k = 0; k + 1 < n - i; ++k)
+                if (iv[k] > iv[k + 1])
+                {
+                    double t = iv[k]; iv[k] = iv[k + 1]; iv[k + 1] = t;
+                }
+
+        ERR("MGS2 PRESENT A/B block=%u arm=%s frames=%u span=%.1f fps=%.3f "
+            "ft_mean=%.2f p50=%.2f p95=%.2f p99=%.2f ftmax=%.2f "
+            "readback=0.000 wait=0.000 pixel=0.000 gpucopy=0.000 copy=0.000 "
+            "acquire=0.000 slow=0/0/0/0 drop=0 tick=%.0f\n",
+            block, mgs2_texmatrix_stats.enabled ? "async" : "sync",
+            n, span, n * 1000.0 / span, sum / n,
+            iv[n / 2], iv[(n * 95) / 100], iv[(n * 99) / 100], iv[n - 1], now);
+    }
+
+    ++block;
+    seen = 0;
+    nstamp = 0;
+    mgs2_texmatrix_stats.enabled = arm[block & 3];
+}
