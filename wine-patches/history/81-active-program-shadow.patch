         mgs2_asp_stats.lazy = 1;            /* production, on in both arms */
         mgs2_lca_stats.enabled = 1;         /* P77 stays on; P80 is the variable */
-        ERR("MGS2 texmatrix A/B: %d-frame blocks, settle %d, arm A = cache off "
-            "(MGS2_PRESENT_AB said %s)\n", block_len, settle, v ? v : "nothing");
+        ERR("MGS2 A/B: %d-frame blocks, settle %d, arm A = P81 active-program skip OFF "
+            "(MGS2_PRESENT_AB said %s, MGS2_GL_APS said %s)\n", block_len, settle,
+            v ? v : "nothing", getenv("MGS2_GL_APS") ? getenv("MGS2_GL_APS") : "nothing");
     }
     if (!block_len) return;
 
@@ -690,11 +785,17 @@
     nstamp = 0;
     mgs2_lca_stats.enabled = 1;                    /* P77: production, on in both arms */
     mgs2_ab_arm = arm[block & 3];
-    /* Nothing is wired to the arm right now: P77 ships on in both arms and P80
-     * was removed on its measurement. The next candidate assigns itself here,
-     * and mgs2_ab_arm stays the single thing everything else labels a sample
-     * with -- pinning a cache on while FRM1 still derived the arm from it is
-     * what produced a whole combat window of "arm A 0 frames / arm B 538". */
+    /* P81 is what is wired to the arm now -- the invitation the previous comment
+     * left. P77 still ships on in both arms and P80 was removed on its
+     * measurement. mgs2_ab_arm stays the single thing everything else labels a
+     * sample with: pinning a cache on while FRM1 still derived the arm from it
+     * is what produced a whole combat window of "arm A 0 frames / arm B 538".
+     *
+     * MGS2_GL_APS takes it back for a run that wants one steady arm. Note the
+     * harness itself cannot be disabled by environment -- block_len falls back
+     * to 12 for any value below 2 -- so pinning here is the only way to get a
+     * build that does not alternate. */
+    if (mgs2_aps_pin() < 0) mgs2_aps_stats.enabled = mgs2_ab_arm;
 }
 
 struct glsl_program_key
@@ -891,6 +992,70 @@
 static PFN_glGetProgramPipelineiv mgs2_glGetProgramPipelineiv;
 static PFN_glGetProgramPipelineInfoLog mgs2_glGetProgramPipelineInfoLog;
 
+/* P81. Called only from the two P75A sites, and only when P75A wants a
+ * selection at all. */
+static void mgs2_select_uniform_program(struct glsl_shader_prog_link *prog,
+        GLuint program, BOOL vs)
+{
+    static int verify = -1;
+    int pin;
+    BOOL same, on;
+
+    ++mgs2_aps_stats.attempted;
+    if (vs) ++mgs2_aps_stats.vs_attempted;
+    else ++mgs2_aps_stats.ps_attempted;
+
+    if (verify < 0)
+    {
+        const char *v = getenv("MGS2_GL_APS_VERIFY");
+
+        verify = v && *v && strcmp(v, "0");
+    }
+    /* A pinned run overrides the harness, in whichever copy of this file is
+     * executing; an unpinned one follows whatever the presenter last wrote,
+     * which in the island's copy is never. Published into the struct so a
+     * capture shows the arm each copy was actually running. */
+    pin = mgs2_aps_pin();
+    on = pin >= 0 ? (BOOL)pin : (BOOL)mgs2_aps_stats.enabled;
+    if (pin >= 0) mgs2_aps_stats.enabled = pin;
+    /* Read the real state and compare, before deciding anything on the shadow.
+     * First attempt as well as every 4096th: a broken invariant should not need
+     * four thousand calls to show itself. */
+    if (verify && mgs2_glGetProgramPipelineiv
+            && (mgs2_aps_stats.attempted == 1 || !(mgs2_aps_stats.attempted & 0xfff)))
+    {
+        GLint actual = 0;
+
+        MGS2_LOCAL(mgs2_glGetProgramPipelineiv)(prog->pipeline_id, GL_ACTIVE_PROGRAM, &actual);
+        ++mgs2_aps_stats.verified;
+        if ((GLuint)actual != prog->mgs2_active_uniform_program)
+        {
+            ++mgs2_aps_stats.mismatch;
+            ERR("P81: pipeline %u active program is %d, shadow says %u -- disabling the skip.\n",
+                    prog->pipeline_id, actual, prog->mgs2_active_uniform_program);
+            /* Fail safe: from here the selector is always called, so the rest of
+             * the run is correct and the counter says the run is not a result. */
+            mgs2_aps_stats.enabled = 0;
+            prog->mgs2_active_uniform_program = (GLuint)actual;
+        }
+    }
+
+    same = prog->mgs2_active_uniform_program == program;
+    if (same) ++mgs2_aps_stats.redundant;
+    if (same && on)
+    {
+        ++mgs2_aps_stats.skipped;
+        return;
+    }
+
+    MGS2_LOCAL(mgs2_glActiveShaderProgram)(prog->pipeline_id, program);
+    /* Recorded on BOTH arms. An arm that started with a stale shadow would
+     * measure the warm-up rather than the optimisation -- the same reason the
+     * light cache updates its entries whether or not the skip is armed. */
+    prog->mgs2_active_uniform_program = program;
+    ++mgs2_aps_stats.executed;
+}
+
