+     * this is the only place a pinned P81 arm can be applied. */
+    if (mgs2_aps_pin() >= 0) mgs2_aps_stats.enabled = mgs2_aps_pin();
+
     if (!mgs2_asp_ab_enabled) return;
 
     if (block_len < 0)
@@ -633,8 +727,9 @@
