 /*
+ * P81: and of the selections P75A lets through, skip the ones that select a
+ * program which is already this pipeline's active program.
+ *
+ * This candidate is not a guess about cost. P75A removed ~1380 of ~1572
+ * glActiveShaderProgram calls per combat frame and that measured -14.80 ms/f,
+ * which prices THIS call on THIS driver at ~10.7 us. About 192 survive per
+ * frame because an upload really does follow them, so the ceiling here is
+ * 192 x 10.7 us ~= 2.05 ms/f and any real redundancy in them is worth taking.
+ *
+ * Why it is safe: glActiveShaderProgram(pipeline, program) sets which program
+ * subsequent glUniform* calls write into, as state of the PIPELINE object.
+ * Setting the same program again is semantically a no-op. There is no payload,
+ * no value comparison and no cached uniform -- the earlier shadow candidates
+ * failed on cached VALUES under a wrong key, and this caches a SELECTOR under
+ * the object that GL itself scopes it to.
+ *
+ * `redundant` is counted whether or not the skip is enabled, so one census run
+ * gives the redundancy rate with the behaviour unchanged. `skipped` is what the
+ * enabled arm actually removed. `attempted` counts only what P75A let through,
+ * which is the population this can act on -- P75A's own avoided_vs/avoided_ps
+ * are the rest.
+ *
+ * The invariant is checkable rather than argued: MGS2_GL_APS_VERIFY=1 asks GL
+ * for GL_ACTIVE_PROGRAM and compares. A mismatch disables the skip for the rest
+ * of the run and is counted, so a correctness run reports mismatch=0 instead of
+ * resting on a source audit. Not production: glGet* can be expensive.
+ */
+#define MGS2_APS_MAGIC 0x31535041u /* APS1 */
+struct mgs2_aps_stats_public
+{
+    unsigned int magic, version, size_words, signature;
+    volatile unsigned int enabled;
+    unsigned int attempted;      /* reached P81, i.e. P75A did not avoid it */
+    unsigned int redundant;      /* ...and the program was already active */
+    unsigned int skipped;        /* ...and the skip was armed, so it was not called */
+    unsigned int executed;
+    unsigned int vs_attempted, ps_attempted;
+    unsigned int verified;       /* GL_ACTIVE_PROGRAM read back and compared */
+    unsigned int mismatch;       /* ...and disagreed with the shadow. Must be 0. */
+};
+struct mgs2_aps_stats_public mgs2_aps_stats =
+{
+    MGS2_APS_MAGIC, 1,
+    sizeof(struct mgs2_aps_stats_public) / sizeof(unsigned int),
+    ~MGS2_APS_MAGIC,
+    0,   /* census only until a number exists; see mgs2_aps_pin() */
+};
+
+/* MGS2_GL_APS pins the skip for a whole run: 0 census only (behaviour identical
+ * to FINALPLAY14), 1 on. Unset leaves the ABBA harness owning it.
+ *
+ * The pin is not a convenience, it is the only arm BOTH copies of this file can
+ * follow. Box86's island links a second native ARM copy of glsl_shader.c, and
+ * mgs2_texmatrix_ab_present() -- which writes mgs2_aps_stats.enabled -- runs on
+ * the PE side only, because the present path is not a routed entry. So under the
+ * ABBA the island's copy stays at its static 0 for the whole run while the PE
+ * copy alternates. If context_apply_draw_state reaches shader_glsl_load_constants
+ * natively, that half of the work never sees arm B and the ABBA can only
+ * UNDER-report. getenv() works in both copies, which is why the helper consults
+ * this directly rather than reading the struct the presenter writes.
+ *
+ * Which copy actually does the work is not a guess to make here: the census
+ * publishes one record per copy and harness/gl_census_delta.py prints them
+ * separately. Read that before choosing between the ABBA and two pinned runs. */
+static int mgs2_aps_pin(void)
+{
+    static int pinned = -2;
+
+    if (pinned == -2)
+    {
+        const char *v = getenv("MGS2_GL_APS");
+
+        pinned = (v && *v) ? atoi(v) : -1;
+        if (pinned > 1) pinned = 1;
+    }
+    return pinned;
+}
+
+/*
  * The A/B alternates arms every 12 frames, and with -14.8 ms between them that
  * alternation is VISIBLE as a ~1 Hz stutter -- the owner reported exactly that
  * while the measurement was running. A steady build must therefore not carry
@@ -615,6 +704,11 @@
     mgs2_frm.arm = mgs2_ab_arm ? 1 : 0;
     ++mgs2_frm.arm_frames[mgs2_frm.arm];
 
