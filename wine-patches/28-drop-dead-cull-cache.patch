-static BOOL d3d8_mgs2_cull_aabb(struct d3d8_vertexbuffer *buffer,
-        const struct d3d8_vertex_declaration *declaration, unsigned int left,
+/* The model-space AABB is computed on every call. A 256x4 set-associative cache
+ * keyed on (identity, generation, declaration, range, stride, position_offset)
+ * used to sit in front of this loop; it was removed on 2026-08-12 after its own
+ * telemetry measured cache_hit=0 against cache_miss=112800 over 300 frames.
+ * MGS2 re-uploads its dynamic vertex buffers every frame -- that is why the
+ * cached DISCARD shadow exists at all -- so mgs2_geometry_generation is bumped
+ * on the writable Unlock before any entry can ever be reused. The cache could
+ * not hit by construction. It only cost one hash plus up to four key comparisons
+ * per tested draw (376 per frame measured) and 72 KB of BSS. */
+static BOOL d3d8_mgs2_cull_aabb(struct d3d8_vertexbuffer *buffer, unsigned int left,
         unsigned int vertex_count, unsigned int stride, unsigned int position_offset,
         float min_value[3], float max_value[3])
