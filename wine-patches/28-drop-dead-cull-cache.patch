-    set = d3d8_mgs2_cull_cache_set(buffer->mgs2_geometry_identity,
-            buffer->mgs2_geometry_generation, left, vertex_count, stride,
-            position_offset, declaration);
-    victim = &d3d8_mgs2_cull_cache[set][0];
-    for (way = 0; way < D3D8_MGS2_CULL_CACHE_WAYS; ++way)
