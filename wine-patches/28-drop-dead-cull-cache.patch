-        if (entry->valid && entry->identity == buffer->mgs2_geometry_identity
-                && entry->generation == buffer->mgs2_geometry_generation
-                && entry->declaration == declaration && entry->left == left
-                && entry->vertex_count == vertex_count && entry->stride == stride
-                && entry->position_offset == position_offset)
-        {
-            memcpy(min_value, entry->min, sizeof(entry->min));
-            memcpy(max_value, entry->max, sizeof(entry->max));
-            entry->stamp = ++d3d8_mgs2_cull_cache_stamp;
-            return TRUE;
-        }
-        if (!entry->valid || (victim->valid && entry->stamp < victim->stamp))
-            victim = entry;
-    }
-
     for (i = 0; i < vertex_count; ++i)
     {
         memcpy(position, buffer->mgs2_snapshot + left + i * stride + position_offset,
@@ -2295,17 +2250,6 @@
         }
     }

-    victim->identity = buffer->mgs2_geometry_identity;
-    victim->generation = buffer->mgs2_geometry_generation;
-    victim->declaration = declaration;
-    victim->left = left;
-    victim->vertex_count = vertex_count;
-    victim->stride = stride;
-    victim->position_offset = position_offset;
-    memcpy(victim->min, min_value, sizeof(victim->min));
