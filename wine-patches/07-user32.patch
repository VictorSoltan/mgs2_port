+/* MGS2: the engine drains the message queue thousands of times per rendered
+ * frame -- measured at ~130 000 empty polls a second, which is where most of
+ * this port's kernel time goes. MGSHDFix carries a BusyLoopFix for the same
+ * loop in the Master Collection build, so the behaviour is a known trait of
+ * this engine rather than anything the port introduced.
+ *
+ * Two stages, both off by default:
+ *
+ *   MGS2_PEEK_STATS=1        histogram the callers, so the hot one can be named
+ *                            before anything is changed
+ *   MGS2_PEEK_HOT=<hex>      restrict the wait to that one return address
+ *   MGS2_PEEK_WAIT=<N>       after N consecutive empty polls from the hot
+ *                            caller, wait for a message instead of spinning
+ *   MGS2_PEEK_WAIT_MS=<ms>   how long to wait (default 1, as MGSHDFix uses)
+ *
+ * Waiting rather than yielding is the point. Measurement showed that making
+ * the yield cheaper only lets the loop spin faster, and that removing it
+ * entirely is worth nothing because other threads then starve; neither touches
+ * the polling itself. A real wait removes the PeekMessage call, the window
+ * surface flush, both thunk-lock callbacks and the translated loop body along
+ * with the syscalls.
+ *
+ * This lives in the PE user32, not in the Unix win32u: PE rebuilds from this
+ * tree work (the shipping wined3d is one), while two independently rebuilt
+ * win32u.so both hang the game at eglInitialize.
+ */
+#define MGS_PEEK_SLOTS 24
+
+struct mgs_peek_caller
+{
+    void *ret;
+    unsigned int calls;
+    unsigned int empty;
+    unsigned int streak;
+    unsigned int max_streak;
+};
+
+static struct mgs_peek_caller mgs_peek_callers[MGS_PEEK_SLOTS];
+static unsigned int mgs_peek_overflow;
+static DWORD mgs_peek_last_report;
+/* Plain statics, not thread-locals: MinGW would need emutls, and PeekMessage
+ * traffic here is overwhelmingly one thread. A miscount from another thread
+ * costs a diagnostic sample, nothing more. */
+static int mgs_peek_in_ansi;
+
+static int mgs_peek_env_int( const char *name, int fallback, int base )
+{
+    char buf[32];
+    DWORD len = GetEnvironmentVariableA( name, buf, sizeof(buf) );
+    if (!len || len >= sizeof(buf)) return fallback;
+    return (int)strtoul( buf, NULL, base );
+}
+
+static int mgs_peek_stats_on(void)
+{
+    static int on = -1;
+    if (on == -1) on = mgs_peek_env_int( "MGS2_PEEK_STATS", 0, 10 );
+    return on;
+}
+
+static void *mgs_peek_hot_caller(void)
+{
+    static void *hot = (void *)-1;
+    if (hot == (void *)-1) hot = (void *)(ULONG_PTR)mgs_peek_env_int( "MGS2_PEEK_HOT", 0, 16 );
+    return hot;
+}
+
+static unsigned int mgs_peek_wait_every(void)
+{
+    static int every = -1;
+    if (every == -1) every = mgs_peek_env_int( "MGS2_PEEK_WAIT", 0, 10 );
+    return every < 0 ? 0 : (unsigned int)every;
+}
+
+static DWORD mgs_peek_wait_ms(void)
+{
+    static int ms = -1;
+    if (ms == -1) ms = mgs_peek_env_int( "MGS2_PEEK_WAIT_MS", 1, 10 );
+    return ms < 0 ? 1 : (DWORD)ms;
+}
+
+static struct mgs_peek_caller *mgs_peek_slot( void *ret )
+{
+    unsigned int i;
+
+    for (i = 0; i < MGS_PEEK_SLOTS; i++)
+    {
+        if (mgs_peek_callers[i].ret == ret) return &mgs_peek_callers[i];
+        if (!mgs_peek_callers[i].ret)
+        {
+            mgs_peek_callers[i].ret = ret;
+            return &mgs_peek_callers[i];
+        }
+    }
+    mgs_peek_overflow++;
+    return NULL;
+}
+
+/* Report on a timer, never per call -- logging every poll would cost more than
+ * the loop being measured. */
+static void mgs_peek_report( void )
+{
+    DWORD now = GetTickCount();
+    unsigned int i;
+
+    if (now - mgs_peek_last_report < 5000) return;
+    mgs_peek_last_report = now;
+
+    for (i = 0; i < MGS_PEEK_SLOTS; i++)
+    {
+        struct mgs_peek_caller *c = &mgs_peek_callers[i];
+        if (!c->ret || !c->calls) continue;
+        ERR( "MGS2 peek caller %p: %u calls, %u empty (%u%%), longest empty run %u\n",
+             c->ret, c->calls, c->empty, c->calls ? c->empty * 100 / c->calls : 0,
+             c->max_streak );
+        c->calls = c->empty = c->max_streak = 0;
+    }
+    if (mgs_peek_overflow)
+    {
+        ERR( "MGS2 peek: %u calls from callers beyond the %u tracked slots\n",
+             mgs_peek_overflow, MGS_PEEK_SLOTS );
+        mgs_peek_overflow = 0;
+    }
+}
+
+/* MGS2: is there a deadline to sleep to at all?
+ *
+ * The loop runs roughly 3 500 iterations per rendered frame, each an empty
+ * PeekMessage followed by the game's per-iteration routine at 0x8a41d0. If
+ * those iterations are uniformly tiny, the loop is spinning on a timer and a
+ * deadline-aware wait could reclaim nearly all of it. If their durations vary
+ * widely, the game is doing real work between polls and there is nothing to
+ * sleep for -- in which case the present fixed 1 ms wait is already the wrong
+ * instrument and a cleverer one would not help either.
+ *
+ * MGS2_PEEK_HIST=1 buckets the interval between consecutive empty polls and
+ * prints the distribution every five seconds. Measure it with the wait off
+ * (MGS2_PEEK_WAIT=0), otherwise the wait itself dictates the interval.
+ */
+static void mgs_peek_interval(void)
+{
+    static unsigned int buckets[8], total, enabled = 2;
+    static LARGE_INTEGER prev, last_report;
+    LARGE_INTEGER now;
+    LONGLONG us;
+
+    if (enabled == 2) enabled = mgs_peek_env_int( "MGS2_PEEK_HIST", 0, 10 ) ? 1 : 0;
+    if (!enabled) return;
+
+    NtQueryPerformanceCounter( &now, NULL );
+    if (prev.QuadPart)
+    {
+        us = (now.QuadPart - prev.QuadPart) / 10;   /* 100 ns ticks -> microseconds */
+        if (us < 5)          buckets[0]++;
+        else if (us < 20)    buckets[1]++;
+        else if (us < 50)    buckets[2]++;
+        else if (us < 200)   buckets[3]++;
+        else if (us < 1000)  buckets[4]++;
+        else if (us < 5000)  buckets[5]++;
+        else if (us < 20000) buckets[6]++;
+        else                 buckets[7]++;
+        total++;
+    }
+    prev = now;
+
+    if (last_report.QuadPart && (now.QuadPart - last_report.QuadPart) < 50000000) return;
+    last_report = now;
+    if (!total) return;
+    ERR( "MGS2 peek intervals over %u polls: <5us=%u <20us=%u <50us=%u <200us=%u "
+         "<1ms=%u <5ms=%u <20ms=%u >=20ms=%u\n", total, buckets[0], buckets[1],
+         buckets[2], buckets[3], buckets[4], buckets[5], buckets[6], buckets[7] );
+    memset( buckets, 0, sizeof(buckets) );
+    total = 0;
+}
+
+static void mgs_peek_account( void *ret, BOOL got_message )
+{
+    struct mgs_peek_caller *c;
+    unsigned int every;
+
+    if (mgs_peek_stats_on())
+    {
+        if ((c = mgs_peek_slot( ret )))
+        {
+            c->calls++;
+            if (got_message) c->streak = 0;
+            else
+            {
+                c->empty++;
+                if (++c->streak > c->max_streak) c->max_streak = c->streak;
+            }
+        }
+        mgs_peek_report();
+    }
+
+    if (!got_message && (!mgs_peek_hot_caller() || ret == mgs_peek_hot_caller()))
+        mgs_peek_interval();
+
+    if (got_message || !(every = mgs_peek_wait_every())) return;
+    if (mgs_peek_hot_caller() && ret != mgs_peek_hot_caller()) return;
+
+    {
+        static unsigned int empties;
+        if (++empties < every) return;
+        empties = 0;
+        /* Wait for input or the timeout, whichever comes first. This is the
+         * whole fix: the thread stops burning the CPU between messages.
+         * MWMO_INPUTAVAILABLE so a message that arrived before the wait began
+         * is not missed. */
+        NtUserMsgWaitForMultipleObjectsEx( 0, NULL, mgs_peek_wait_ms(), QS_ALLINPUT,
+                                           MWMO_INPUTAVAILABLE );
+    }
+}
+
