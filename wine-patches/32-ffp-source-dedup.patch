+static uint64_t mgs2_glsl_source_hash(const char *text, size_t *size)
+{
+    uint64_t hash = 14695981039346656037ull;
+    const unsigned char *p = (const unsigned char *)text;
+
+    while (*p)
+    {
+        hash ^= *p++;
+        hash *= 1099511628211ull;
+    }
+    *size = p - (const unsigned char *)text;
+    return hash;
+}
+
+static struct mgs2_ffp_vs_source *mgs2_get_ffp_vs_source(struct shader_glsl_priv *priv,
+        const struct wined3d_gl_info *gl_info, const char *text)
+{
+    struct mgs2_ffp_vs_source *source;
+    size_t size;
+    uint64_t hash;
+
+    hash = mgs2_glsl_source_hash(text, &size);
+    if (priv->mgs2_ffp_source_dedup_enabled)
+    {
+        LIST_FOR_EACH_ENTRY(source, &priv->mgs2_ffp_vs_sources, struct mgs2_ffp_vs_source, entry)
+        {
+            if (source->hash == hash && source->size == size && !memcmp(source->text, text, size + 1))
+                return source;
+        }
+    }
+
+    if (!(source = calloc(1, sizeof(*source))))
+        return NULL;
+    if (!(source->text = malloc(size + 1)))
+    {
+        free(source);
+        return NULL;
+    }
+    memcpy(source->text, text, size + 1);
+    source->hash = hash;
+    source->size = size;
+    source->shader_id = GL_EXTCALL(glCreateShader(GL_VERTEX_SHADER));
+    shader_glsl_compile(gl_info, source->shader_id, source->text);
+    list_add_head(&priv->mgs2_ffp_vs_sources, &source->entry);
+    return source;
+}
