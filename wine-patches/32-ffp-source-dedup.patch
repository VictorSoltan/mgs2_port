+/* The normal FFP caches are keyed by the complete D3D settings structures.
+ * MGS2 reaches multiple settings keys that generate byte-identical GLSL.  On
+ * this Mali driver each of those aliases used to compile a new shader and,
+ * more importantly, link a new separable stage program on first use.  Keep the
+ * generated source as the canonical key and let all settings descriptors point
+ * at one GL shader / stage-program owner.  Exact length + memcmp is the
+ * correctness check; the hash is only a cheap rejection filter. */
+struct mgs2_ffp_vs_source
+{
+    struct list entry;
+    uint64_t hash;
+    size_t size;
+    char *text;
+    GLuint shader_id;
+    GLuint stage_program;
+    struct glsl_vs_program stage;
+};
+
+struct mgs2_ffp_ps_source
+{
+    struct list entry;
+    uint64_t hash;
+    size_t size;
+    char *text;
+    GLuint shader_id;
     GLuint stage_program;
     struct glsl_ps_program stage;
-    struct list linked_programs;
 };

