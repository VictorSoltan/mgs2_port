+static void mgs2_free_ffp_source_caches(struct shader_glsl_priv *priv,
+        const struct wined3d_gl_info *gl_info)
+{
+    struct mgs2_ffp_vs_source *vs, *vs2;
+    struct mgs2_ffp_ps_source *ps, *ps2;
+
+    LIST_FOR_EACH_ENTRY_SAFE(vs, vs2, &priv->mgs2_ffp_vs_sources, struct mgs2_ffp_vs_source, entry)
+    {
+        if (vs->stage_program)
+            GL_EXTCALL(glDeleteProgram(vs->stage_program));
+        GL_EXTCALL(glDeleteShader(vs->shader_id));
+        list_remove(&vs->entry);
+        free(vs->text);
+        free(vs);
+    }
+    LIST_FOR_EACH_ENTRY_SAFE(ps, ps2, &priv->mgs2_ffp_ps_sources, struct mgs2_ffp_ps_source, entry)
+    {
+        if (ps->stage_program)
+            GL_EXTCALL(glDeleteProgram(ps->stage_program));
+        GL_EXTCALL(glDeleteShader(ps->shader_id));
+        list_remove(&ps->entry);
+        free(ps->text);
+        free(ps);
+    }
+}
