+static unsigned int d3d8_mgs2_cull_cache_set(ULONGLONG identity, ULONGLONG generation,
+        unsigned int left, unsigned int vertex_count, unsigned int stride,
+        unsigned int position_offset, const struct d3d8_vertex_declaration *declaration)
+{
+    ULONGLONG hash = identity ^ (generation * 0x9e3779b97f4a7c15ull);
+
+    hash ^= (ULONGLONG)(ULONG_PTR)declaration;
+    hash ^= (ULONGLONG)left << 32 | vertex_count;
+    hash ^= (ULONGLONG)stride << 32 | position_offset;
+    hash ^= hash >> 33;
+    hash *= 0xff51afd7ed558ccdull;
+    hash ^= hash >> 33;
+    return hash & (D3D8_MGS2_CULL_CACHE_SETS - 1);
+}
+
+static BOOL d3d8_mgs2_cull_aabb(struct d3d8_vertexbuffer *buffer,
+        const struct d3d8_vertex_declaration *declaration, unsigned int left,
+        unsigned int vertex_count, unsigned int stride, unsigned int position_offset,
+        float min_value[3], float max_value[3])
+{
+    struct d3d8_mgs2_cull_cache_entry *entry, *victim;
+    unsigned int set, way, i, axis;
+    float position[3];
+
+    set = d3d8_mgs2_cull_cache_set(buffer->mgs2_geometry_identity,
+            buffer->mgs2_geometry_generation, left, vertex_count, stride,
+            position_offset, declaration);
+    victim = &d3d8_mgs2_cull_cache[set][0];
+    for (way = 0; way < D3D8_MGS2_CULL_CACHE_WAYS; ++way)
+    {
+        entry = &d3d8_mgs2_cull_cache[set][way];
+        if (entry->valid && entry->identity == buffer->mgs2_geometry_identity
+                && entry->generation == buffer->mgs2_geometry_generation
+                && entry->declaration == declaration && entry->left == left
+                && entry->vertex_count == vertex_count && entry->stride == stride
+                && entry->position_offset == position_offset)
+        {
+            memcpy(min_value, entry->min, sizeof(entry->min));
+            memcpy(max_value, entry->max, sizeof(entry->max));
+            entry->stamp = ++d3d8_mgs2_cull_cache_stamp;
+            ++d3d8_mgs2_visibility_cull_stats.cache_hits;
+            return TRUE;
+        }
+        if (!entry->valid || (victim->valid && entry->stamp < victim->stamp))
+            victim = entry;
+    }
+
+    ++d3d8_mgs2_visibility_cull_stats.cache_misses;
+    for (i = 0; i < vertex_count; ++i)
+    {
+        memcpy(position, buffer->mgs2_snapshot + left + i * stride + position_offset,
+                sizeof(position));
+        if (!isfinite(position[0]) || !isfinite(position[1]) || !isfinite(position[2]))
+        {
+            ++d3d8_mgs2_visibility_cull_stats.nonfinite;
+            return FALSE;
+        }
+        for (axis = 0; axis < 3; ++axis)
+        {
+            if (!i || position[axis] < min_value[axis]) min_value[axis] = position[axis];
+            if (!i || position[axis] > max_value[axis]) max_value[axis] = position[axis];
+        }
+    }
+
+    victim->identity = buffer->mgs2_geometry_identity;
+    victim->generation = buffer->mgs2_geometry_generation;
+    victim->declaration = declaration;
+    victim->left = left;
+    victim->vertex_count = vertex_count;
+    victim->stride = stride;
+    victim->position_offset = position_offset;
+    memcpy(victim->min, min_value, sizeof(victim->min));
+    memcpy(victim->max, max_value, sizeof(victim->max));
+    victim->stamp = ++d3d8_mgs2_cull_cache_stamp;
+    victim->valid = TRUE;
+    return TRUE;
+}
+
+static BOOL d3d8_mgs2_visibility_should_cull(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, unsigned int start_vertex, unsigned int vertex_count)
+{
+    const struct wined3d_stateblock_state *state = device->stateblock_state;
+    struct d3d8_vertex_declaration *declaration;
+    struct d3d8_vertexbuffer *buffer;
+    unsigned int stream_idx, stride, left, position_offset, corner, axis, clip_and = 0x3f;
+    float min_value[3], max_value[3], object[4], world[4], view[4], clip[4];
+
+    if (!d3d8_mgs2_visibility_cull_enabled())
+        return FALSE;
+    if (state->vs)
+    {
+        ++d3d8_mgs2_visibility_cull_stats.custom_shader;
+        return FALSE;
+    }
+    if (state->rs[WINED3D_RS_VERTEXBLEND]
+            || state->rs[WINED3D_RS_INDEXEDVERTEXBLENDENABLE])
+    {
+        ++d3d8_mgs2_visibility_cull_stats.vertex_blend;
+        return FALSE;
+    }
+    if (!d3d8_mgs2_vbo_source(device, primitive_type, start_vertex, vertex_count,
+            &stream_idx, &buffer, &stride, &left) || !buffer->mgs2_geometry_identity)
+    {
+        ++d3d8_mgs2_visibility_cull_stats.source_unsupported;
+        return FALSE;
+    }
+    declaration = wined3d_vertex_declaration_get_parent(state->vertex_declaration);
+    if (!d3d8_mgs2_visibility_position_offset(declaration, stream_idx, &position_offset)
+            || position_offset > stride || sizeof(float) * 3 > stride - position_offset)
+    {
+        ++d3d8_mgs2_visibility_cull_stats.position_unsupported;
+        return FALSE;
+    }
+    if (buffer->mgs2_geometry_valid_overflow)
+    {
+        ++d3d8_mgs2_visibility_cull_stats.validity_overflow;
+        return FALSE;
+    }
+    if (!d3d8_mgs2_geometry_range_valid(buffer, left, left + vertex_count * stride))
+    {
+        ++d3d8_mgs2_visibility_cull_stats.invalid_coverage;
+        return FALSE;
+    }
+    if (!d3d8_mgs2_cull_aabb(buffer, declaration, left, vertex_count, stride,
+            position_offset, min_value, max_value))
+        return FALSE;
+
+    ++d3d8_mgs2_visibility_cull_stats.tested;
+    for (corner = 0; corner < 8; ++corner)
+    {
+        for (axis = 0; axis < 3; ++axis)
+            object[axis] = corner & (1u << axis) ? max_value[axis] : min_value[axis];
+        object[3] = 1.0f;
+        d3d8_mgs2_visibility_transform(world, object,
+                &state->transforms[WINED3D_TS_WORLD]);
+        d3d8_mgs2_visibility_transform(view, world,
+                &state->transforms[WINED3D_TS_VIEW]);
+        d3d8_mgs2_visibility_transform(clip, view,
+                &state->transforms[WINED3D_TS_PROJECTION]);
+        if (!isfinite(clip[0]) || !isfinite(clip[1])
+                || !isfinite(clip[2]) || !isfinite(clip[3]))
+        {
+            ++d3d8_mgs2_visibility_cull_stats.nonfinite;
+            return FALSE;
+        }
+        clip_and &= d3d8_mgs2_visibility_clip_code(clip);
+    }
+    if (!clip_and)
+        return FALSE;
+    ++d3d8_mgs2_visibility_cull_stats.culled;
+    return TRUE;
+}
+
+static BOOL d3d8_mgs2_visibility_cull_stats_on(void)
+{
+    static int on = -1;
+
+    if (on == -1)
+        on = d3d8_mgs2_env_on("MGS2_D3D8_VISIBILITY_CULL_STATS", FALSE);
+    return on;
+}
+
+static void d3d8_mgs2_visibility_cull_present(void)
+{
+    static DWORD last_poll;
+    DWORD now = GetTickCount();
+
+    if (d3d8_mgs2_visibility_cull_live() && now - last_poll >= 1000)
+    {
+        FILE *file;
+
+        last_poll = now;
+        if ((file = fopen("Z:\\tmp\\mgs2-visibility-cull", "r")))
+        {
+            int c = fgetc(file);
+
+            fclose(file);
+            if ((c == '0' || c == '1') && d3d8_mgs2_visibility_cull_state != c - '0')
+            {
+                d3d8_mgs2_visibility_cull_state = c - '0';
+                memset(&d3d8_mgs2_visibility_cull_stats, 0,
+                        sizeof(d3d8_mgs2_visibility_cull_stats));
+                memset(d3d8_mgs2_cull_cache, 0, sizeof(d3d8_mgs2_cull_cache));
+                d3d8_mgs2_cull_cache_stamp = 0;
+                fprintf(stderr, "MGS2CULL: switched to %d\n", d3d8_mgs2_visibility_cull_state);
+                fflush(stderr);
+            }
+        }
+    }
+
+    if (!d3d8_mgs2_visibility_cull_stats_on())
+        return;
+    if (++d3d8_mgs2_visibility_cull_stats.frames < 300)
+        return;
+    fprintf(stderr, "MGS2CULL: enabled=%d frames=%u tested=%I64u %.2f/f culled=%I64u %.2f/f "
+            "cache_hit=%I64u cache_miss=%I64u custom_vs=%I64u blend=%I64u position=%I64u "
+            "source_bad=%I64u invalid=%I64u overflow=%I64u nonfinite=%I64u\n",
+            d3d8_mgs2_visibility_cull_enabled(), d3d8_mgs2_visibility_cull_stats.frames,
+            d3d8_mgs2_visibility_cull_stats.tested,
+            d3d8_mgs2_visibility_cull_stats.tested / 300.0,
+            d3d8_mgs2_visibility_cull_stats.culled,
+            d3d8_mgs2_visibility_cull_stats.culled / 300.0,
+            d3d8_mgs2_visibility_cull_stats.cache_hits,
+            d3d8_mgs2_visibility_cull_stats.cache_misses,
+            d3d8_mgs2_visibility_cull_stats.custom_shader,
+            d3d8_mgs2_visibility_cull_stats.vertex_blend,
+            d3d8_mgs2_visibility_cull_stats.position_unsupported,
+            d3d8_mgs2_visibility_cull_stats.source_unsupported,
+            d3d8_mgs2_visibility_cull_stats.invalid_coverage,
+            d3d8_mgs2_visibility_cull_stats.validity_overflow,
+            d3d8_mgs2_visibility_cull_stats.nonfinite);
+    fflush(stderr);
+    memset(&d3d8_mgs2_visibility_cull_stats, 0, sizeof(d3d8_mgs2_visibility_cull_stats));
+}
