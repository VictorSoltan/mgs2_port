+/*
+ * MGS2-specific fast paths and their counters.
+ *
+ * Two costs showed up on an RK3566 handheld running this game through Box86:
+ * every redundant SetRenderState still took the global wined3d mutex and walked
+ * into the stateblock, and every draw re-uploaded every bound managed texture
+ * whether or not its contents had changed. Both are avoidable without changing
+ * observable D3D8 behaviour. Counters are aggregate, one line per second, never
+ * per call -- per-call logging on this device has already cost more than it
+ * measured.
+ */
+static LONG d3d8_mgs2_counters[D3D8_MGS2_COUNTER_COUNT];
+
+static BOOL d3d8_mgs2_env_on(const char *name, BOOL def)
+{
+    char value[8];
+    DWORD len = GetEnvironmentVariableA(name, value, sizeof(value));
+
+    if (!len || len >= sizeof(value)) return def;
+    return value[0] != '0';
+}
+
+BOOL d3d8_mgs2_statefast(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_STATEFAST", TRUE);
+    return on;
+}
+
+BOOL d3d8_mgs2_managed_dirty(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_MANAGED_DIRTY", TRUE);
+    return on;
+}
+
+BOOL d3d8_mgs2_stats(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_STATS", FALSE);
+    return on;
+}
+
+/* Which rung of the no-op ladder is active, re-read from a file about once a
+ * second so all four rungs can be measured in one run, on one scene.
+ *
+ * An environment variable cannot do this. It is fixed at process start, which
+ * would mean four launches -- and worse, rung A draws nothing at all, so the
+ * menus needed to load the save are invisible and the scene cannot be reached
+ * blind. Reading a rung file instead means: load the save, stand still, then
+ * flip the rung from outside while the scene and the thermal state hold.
+ *
+ * One CreateFile per second against a tmpfs path, so leaving this compiled in
+ * costs nothing measurable next to ~10 500 draws a second. The env knobs still
+ * win when set, for a run that is deliberately pinned from the start.
+ */
+static char d3d8_mgs2_ladder_rung(void)
+{
+    static char cached = '0';
+    static DWORD last;
+    DWORD now = GetTickCount();
+
+    if (!last || now - last >= 1000)
+    {
+        char path[MAX_PATH], buf[8] = {0};
+        DWORD got = 0;
+        HANDLE h;
+
+        last = now ? now : 1;
+        if (!GetEnvironmentVariableA("MGS2_LADDER_FILE", path, sizeof(path)))
+            strcpy(path, "Z:\\tmp\\mgs2-ladder");
+        h = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                NULL, OPEN_EXISTING, 0, NULL);
+        if (h != INVALID_HANDLE_VALUE)
+        {
+            ReadFile(h, buf, sizeof(buf) - 1, &got, NULL);
+            CloseHandle(h);
+        }
+        cached = (buf[0] == 'A' || buf[0] == 'B' || buf[0] == 'C') ? buf[0] : '0';
+    }
+    return cached;
+}
+
+BOOL d3d8_mgs2_noop_draw(void)
+{
+    static int env = -1;
+    if (env == -1) env = d3d8_mgs2_env_on("MGS2_D3D8_NOOP_DRAW", FALSE);
+    return env || d3d8_mgs2_ladder_rung() == 'A';
+}
+
+BOOL d3d8_mgs2_noop_submit(void)
+{
+    static int env = -1;
+    if (env == -1) env = d3d8_mgs2_env_on("MGS2_D3D8_NOOP_SUBMIT", FALSE);
+    return env || d3d8_mgs2_ladder_rung() == 'B';
+}
+
+void d3d8_mgs2_count(unsigned int which)
+{
+    if (which < D3D8_MGS2_COUNTER_COUNT) d3d8_mgs2_counters[which]++;
+}
+
+void d3d8_mgs2_add(unsigned int which, unsigned int amount)
+{
+    if (which < D3D8_MGS2_COUNTER_COUNT) d3d8_mgs2_counters[which] += amount;
+}
+
+void d3d8_mgs2_report(void)
+{
+    static DWORD last;
+    DWORD now;
+
+    if (!d3d8_mgs2_stats()) return;
+    now = GetTickCount();
+    if (now - last < 1000) return;
+    last = now;
+
+    ERR("MGS2 D3D8STAT tick=%lu draws=%ld up_draws=%ld | rs %ld/%ld redundant | "
+        "tss %ld/%ld | samp %ld/%ld | managed scan=%ld skipped=%ld upload=%ld | "
+        "sysmem vb %ld draws %ld streams %ldKB, ib %ld draws %ldKB\n",
+        now, d3d8_mgs2_counters[D3D8_MGS2_DRAW], d3d8_mgs2_counters[D3D8_MGS2_DRAW_UP],
+        d3d8_mgs2_counters[D3D8_MGS2_RS_REDUNDANT], d3d8_mgs2_counters[D3D8_MGS2_RS_CALL],
+        d3d8_mgs2_counters[D3D8_MGS2_TSS_REDUNDANT], d3d8_mgs2_counters[D3D8_MGS2_TSS_CALL],
+        d3d8_mgs2_counters[D3D8_MGS2_SAMP_REDUNDANT], d3d8_mgs2_counters[D3D8_MGS2_SAMP_CALL],
+        d3d8_mgs2_counters[D3D8_MGS2_MANAGED_SCAN], d3d8_mgs2_counters[D3D8_MGS2_MANAGED_SKIPPED],
+        d3d8_mgs2_counters[D3D8_MGS2_MANAGED_UPLOAD],
+        d3d8_mgs2_counters[D3D8_MGS2_SYSMEM_VB_DRAW], d3d8_mgs2_counters[D3D8_MGS2_SYSMEM_VB_STREAM],
+        d3d8_mgs2_counters[D3D8_MGS2_SYSMEM_VB_BYTES] / 1024,
+        d3d8_mgs2_counters[D3D8_MGS2_SYSMEM_IB_DRAW],
+        d3d8_mgs2_counters[D3D8_MGS2_SYSMEM_IB_BYTES] / 1024);
+    memset(d3d8_mgs2_counters, 0, sizeof(d3d8_mgs2_counters));
+}
