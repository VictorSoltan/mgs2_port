+    D3D8_MGS2_TSS_CALL, D3D8_MGS2_TSS_REDUNDANT,
+    D3D8_MGS2_SAMP_CALL, D3D8_MGS2_SAMP_REDUNDANT,
+    D3D8_MGS2_DRAW, D3D8_MGS2_DRAW_UP,
