+/*
+ * MGS2-specific fast paths and their counters.
+ *
+ * Two costs showed up on an RK3566 handheld running this game through Box86:
+ * every redundant SetRenderState still took the global wined3d mutex and walked
+ * into the stateblock, and every draw re-uploaded every bound managed texture
+ * whether or not its contents had changed. Both are avoidable without changing
+ * observable D3D8 behaviour. Counters are aggregate, one line per second, never
+ * per call -- per-call logging on this device has already cost more than it
+ * measured.
+ */
+static LONG d3d8_mgs2_counters[D3D8_MGS2_COUNTER_COUNT];
+
+static BOOL d3d8_mgs2_env_on(const char *name, BOOL def)
+{
+    char value[8];
+    DWORD len = GetEnvironmentVariableA(name, value, sizeof(value));
+
+    if (!len || len >= sizeof(value)) return def;
+    return value[0] != '0';
+}
+
+BOOL d3d8_mgs2_statefast(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_STATEFAST", TRUE);
+    return on;
+}
+
+BOOL d3d8_mgs2_managed_dirty(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_MANAGED_DIRTY", TRUE);
+    return on;
+}
+
+BOOL d3d8_mgs2_stats(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_STATS", FALSE);
+    return on;
+}
+
+void d3d8_mgs2_count(unsigned int which)
+{
+    if (which < D3D8_MGS2_COUNTER_COUNT) d3d8_mgs2_counters[which]++;
+}
+
+void d3d8_mgs2_report(void)
+{
+    static DWORD last;
+    DWORD now;
+
+    if (!d3d8_mgs2_stats()) return;
+    now = GetTickCount();
+    if (now - last < 1000) return;
+    last = now;
+
+    ERR("MGS2 D3D8STAT tick=%lu draws=%ld up_draws=%ld | rs %ld/%ld redundant | "
+        "tss %ld/%ld | samp %ld/%ld | managed scan=%ld skipped=%ld upload=%ld\n",
+        now, d3d8_mgs2_counters[D3D8_MGS2_DRAW], d3d8_mgs2_counters[D3D8_MGS2_DRAW_UP],
+        d3d8_mgs2_counters[D3D8_MGS2_RS_REDUNDANT], d3d8_mgs2_counters[D3D8_MGS2_RS_CALL],
+        d3d8_mgs2_counters[D3D8_MGS2_TSS_REDUNDANT], d3d8_mgs2_counters[D3D8_MGS2_TSS_CALL],
+        d3d8_mgs2_counters[D3D8_MGS2_SAMP_REDUNDANT], d3d8_mgs2_counters[D3D8_MGS2_SAMP_CALL],
+        d3d8_mgs2_counters[D3D8_MGS2_MANAGED_SCAN], d3d8_mgs2_counters[D3D8_MGS2_MANAGED_SKIPPED],
+        d3d8_mgs2_counters[D3D8_MGS2_MANAGED_UPLOAD]);
+    memset(d3d8_mgs2_counters, 0, sizeof(d3d8_mgs2_counters));
+}
