+extern BOOL d3d8_mgs2_managed_dirty(void);
+extern BOOL d3d8_mgs2_stats(void);
+extern BOOL d3d8_mgs2_noop_draw(void);
+extern BOOL d3d8_mgs2_noop_submit(void);
+extern void d3d8_mgs2_count(unsigned int which);
+extern void d3d8_mgs2_add(unsigned int which, unsigned int amount);
+extern void d3d8_mgs2_report(void);
