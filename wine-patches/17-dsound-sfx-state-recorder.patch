+__declspec(dllexport) volatile struct mgs2_sfx_state_data mgs2_sfx_state_data =
+{
+    .magic = MGS2_SFX_STATE_MAGIC,
+    .version = MGS2_SFX_STATE_VERSION,
+    .header_words = MGS2_SFX_STATE_HEADER_WORDS,
+    .record_words = MGS2_SFX_STATE_RECORD_WORDS,
+    .event_count = MGS2_SFX_STATE_EVENTS,
+    .signature = ~MGS2_SFX_STATE_MAGIC,
+};
+
+static BOOL mgs2_sfx_state_enabled(void)
+{
+    static LONG enabled = -1;
+    char value[8];
+    DWORD length;
+
+    if (enabled != -1) return enabled;
+    length = GetEnvironmentVariableA("MGS2_SFX_STATE", value, sizeof(value));
+    enabled = length && length < sizeof(value) && value[0] != '0';
+    InterlockedExchange(&mgs2_sfx_state_data.enabled, enabled);
+    return enabled;
+}
+
+void mgs2_sfx_state_record(IDirectSoundBufferImpl *buffer, DWORD event,
+        DWORD arg0, DWORD arg1, DWORD arg2, HRESULT result)
+{
+    struct mgs2_sfx_state_record *record;
+    LONG sequence;
+
+    if (!mgs2_sfx_state_enabled() || !mgs_sfx_voice(buffer)) return;
+
+    sequence = InterlockedIncrement(&mgs2_sfx_state_data.write_sequence);
+    record = (struct mgs2_sfx_state_record *)&mgs2_sfx_state_data.records[
+            (sequence - 1) % MGS2_SFX_STATE_EVENTS];
+    InterlockedExchange(&record->sequence, 0);
+    record->tick = GetTickCount();
+    record->event = event;
+    record->object = (DWORD)(ULONG_PTR)buffer;
+    record->memory = buffer->buffer ? (DWORD)(ULONG_PTR)buffer->buffer->memory : 0;
+    record->state = buffer->state;
+    record->playflags = buffer->playflags;
+    record->sec_mixpos = buffer->sec_mixpos;
+    record->writelead = buffer->writelead;
+    record->committed_mixpos = buffer->committed_mixpos;
+    record->committed_flags = (buffer->use_committed ? 1 : 0)
+            | (buffer->buffer && buffer->buffer->lockedbytes ? 2 : 0);
+    record->volume = buffer->volpan.lVolume;
+    record->pan = buffer->volpan.lPan;
+    record->frequency = buffer->freq;
+    record->arg0 = arg0;
+    record->arg1 = arg1;
+    record->arg2 = arg2;
+    record->result = result;
+    InterlockedExchange(&record->sequence, sequence);
+    InterlockedExchange(&mgs2_sfx_state_data.last_tick, record->tick);
+    if (event == MGS2_SFX_STATE_LOCK || event == MGS2_SFX_STATE_UNLOCK)
+        InterlockedIncrement(&mgs2_sfx_state_data.lock_count);
+    else
+        InterlockedIncrement(&mgs2_sfx_state_data.control_count);
+}
