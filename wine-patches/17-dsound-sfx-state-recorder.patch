+/* The MGS2 gameplay effects reuse a small pool of 32,576-byte, 44.1 kHz mono
+ * deferred secondary buffers.  A missing punch normally changes controls on a
+ * looping member of that pool rather than starting a new buffer.  Keep the
+ * capture wholly in process memory: formatted output from this path is itself
+ * enough to disturb its timing on the RG353VS. */
+#define MGS2_SFX_STATE_MAGIC 0x31534653 /* SFS1 */
+#define MGS2_SFX_STATE_VERSION 1
+#define MGS2_SFX_STATE_EVENTS 4096
+#define MGS2_SFX_STATE_HEADER_WORDS 12
+#define MGS2_SFX_STATE_RECORD_WORDS 18
+
+enum mgs2_sfx_state_event
+{
+    MGS2_SFX_STATE_LOCK = 1,
+    MGS2_SFX_STATE_UNLOCK,
+    MGS2_SFX_STATE_POSITION,
+    MGS2_SFX_STATE_VOLUME,
+    MGS2_SFX_STATE_PAN,
+    MGS2_SFX_STATE_FREQUENCY,
+    MGS2_SFX_STATE_PLAY,
+    MGS2_SFX_STATE_STOP,
+};
+
+struct mgs2_sfx_state_record
+{
+    volatile LONG sequence;
+    DWORD tick, event, object, memory, state, playflags, sec_mixpos, writelead;
+    DWORD committed_mixpos, committed_flags, volume, pan, frequency;
+    DWORD arg0, arg1, arg2, result;
+};
+
+struct mgs2_sfx_state_data
+{
+    DWORD magic, version, header_words, record_words, event_count, signature;
+    volatile LONG enabled, write_sequence, lock_count, control_count, last_tick, flags;
+    struct mgs2_sfx_state_record records[MGS2_SFX_STATE_EVENTS];
+};
+
+extern __declspec(dllexport) volatile struct mgs2_sfx_state_data mgs2_sfx_state_data;
+void mgs2_sfx_state_record(IDirectSoundBufferImpl *buffer, DWORD event,
+        DWORD arg0, DWORD arg1, DWORD arg2, HRESULT result);
+
 float get_mono(const IDirectSoundBufferImpl *dsb, BYTE *base, DWORD channel);
 void put_mono2stereo(const IDirectSoundBufferImpl *dsb, DWORD pos, DWORD channel, float value);
