+/* Percentile by nearest rank on an already sorted array. */
+static double mgs_pct(const double *sorted, unsigned int n, double q)
+{
+    unsigned int i;
+    if (!n) return 0.0;
+    i = (unsigned int)(q * n);
+    if (i >= n) i = n - 1;
+    return sorted[i];
+}
