+/* See the comment at the marshalling site: settle fd ownership by observation
+ * rather than by belief, once the requests carrying them have gone out. */
+static void mgs_dmabuf_reconcile_fds(struct wayland_gl_drawable *gl)
+{
+    static BOOL reported;
+    int i, reclaimed = 0, consumed = 0;
+
+    wl_display_flush(process_wayland.wl_display);
+    for (i = 0; i < gl->dmabuf_count; i++)
+    {
+        struct mgs_dmabuf_buffer *b = &gl->dmabuf[i];
+
+        if (b->sendfd < 0) continue;
+        if (fcntl(b->sendfd, F_GETFD) >= 0) { close(b->sendfd); reclaimed++; }
+        else consumed++;
+        b->sendfd = -1;
+    }
+    if (!reported && (reclaimed || consumed))
+    {
+        ERR("MGS2 dmabuf: libwayland %s the fd it was handed "
+            "(%d reclaimed, %d consumed)\n",
+            reclaimed ? "duplicates" : "takes ownership of", reclaimed, consumed);
+        reported = TRUE;
+    }
+}
+
+static struct mgs_dmabuf_buffer *mgs_dmabuf_acquire(struct wayland_gl_drawable *gl)
+{
+    int i;
+
+    for (i = 0; i < gl->dmabuf_count; i++)
+        if (!gl->dmabuf[i].busy) return &gl->dmabuf[i];
+
+    wl_display_dispatch_queue_pending(process_wayland.wl_display, gl->wl_event_queue);
+    for (i = 0; i < gl->dmabuf_count; i++)
+        if (!gl->dmabuf[i].busy) return &gl->dmabuf[i];
+    return NULL;
+}
