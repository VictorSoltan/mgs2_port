+/*
+ * Where does a delivered frame's time actually sit, and does the part that
+ * quantises sit inside this function or outside it?
+ *
+ *   outside  from the presenter returning to the game calling it again --
+ *            the game, d3d8, wined3d and the CS thread
+ *   swap     eglSwapBuffers on the pbuffer
+ *   read     glFinish (when split) plus glReadPixels
+ *   commit   attach, damage, commit, flush
+ *
+ * Split by the multiple of the compositor period the frame landed on. If the
+ * step from k=1 to k=2 shows up in `outside`, the limiter is the game and no
+ * presenter change can move it. If it shows up in `swap`, it is EGL or the
+ * display pipeline, and dmabuf inherits it.
+ */
+static void mgs_stage_tick(struct wayland_gl_drawable *gl, double t_enter,
+                           double t_swapped, double t0, double t1, double now)
+{
+    double period = 1000.0 / 60.0;
+    double interval = gl->st_exit > 0.0 ? now - gl->st_exit : 0.0;
+    unsigned int k;
+
+    if (gl->st_exit > 0.0 && t_enter > 0.0)
+    {
+        double total = now - gl->st_exit;
+        k = (unsigned int)((total / period) + 0.5);
+        if (k < 1 || k > 4) k = 0;
+        gl->st_out[k]    += t_enter - gl->st_exit;
+        gl->st_swap[k]   += t_swapped - t_enter;
+        gl->st_read[k]   += (t1 > 0.0 ? t1 - t0 : 0.0);
+        gl->st_commit[k] += now - (t1 > 0.0 ? t1 : t0);
+        gl->st_total[k]  += total;
+        gl->st_n[k]++;
+        gl->st_frames++;
+    }
+    gl->st_exit = now;
+    (void)interval;
+
+    if (gl->st_frames < (unsigned int)mgs_cfg.stages) return;
+
+    for (k = 0; k < 5; k++)
+    {
+        double n = gl->st_n[k];
+        if (!n) continue;
+        ERR("MGS2 present stages: k=%u n=%u total=%.2f | outside=%.2f swap=%.2f "
+            "read=%.2f commit=%.2f\n",
+            k, gl->st_n[k], gl->st_total[k] / n, gl->st_out[k] / n,
+            gl->st_swap[k] / n, gl->st_read[k] / n, gl->st_commit[k] / n);
+        gl->st_out[k] = gl->st_swap[k] = gl->st_read[k] = 0.0;
+        gl->st_commit[k] = gl->st_total[k] = 0.0;
+        gl->st_n[k] = 0;
+    }
+    gl->st_frames = 0;
+}
