+/*
+ * Close the block if it is full, print it, flip the arm and start the next one.
+ * Called once per displayed frame from the timing tail of wayland_drawable_swap.
+ *
+ * Arm order is block%4 -> A B B A.  The first `ab_settle` frames after a flip
+ * are counted but not accumulated: switching arms leaves the async texture ring
+ * unprimed once and drops one presented frame, and neither belongs in either
+ * arm's mean.
+ */
+static void mgs_ab_tick(struct wayland_gl_drawable *gl, double now,
+                        double readback, double copy, double finish,
+                        double gpucopy, double acquire, double interval)
+{
+    static const BOOL arm_async[4] = { FALSE, TRUE, TRUE, FALSE };
+
+    if (readback < 0.0)
+    {
+        gl->ab_drop++;
+        gl->ab_seen++;
+        if (gl->ab_seen < (unsigned int)mgs_cfg.present_ab) return;
+    }
+    else if (gl->ab_seen >= (unsigned int)mgs_cfg.ab_settle)
+    {
+        if (!gl->ab_frames) gl->ab_t0 = now - (interval > 0.0 ? interval : 0.0);
+        gl->ab_frames++;
+        gl->ab_readback += readback;
+        gl->ab_copy     += copy;
+        gl->ab_finish   += finish;
+        gl->ab_gpucopy  += gpucopy;
+        gl->ab_acquire  += acquire;
+        if (interval > 0.0)
+        {
+            if (gl->ab_ft_n < MGS_AB_MAX) gl->ab_ft[gl->ab_ft_n++] = interval;
+            if (interval > 500.0)      gl->ab_slow[3]++;
+            else if (interval > 200.0) gl->ab_slow[2]++;
+            else if (interval > 100.0) gl->ab_slow[1]++;
+            else if (interval > 50.0)  gl->ab_slow[0]++;
+        }
+        gl->ab_seen++;
+        if (gl->ab_seen < (unsigned int)mgs_cfg.present_ab) return;
+    }
+    else
+    {
+        gl->ab_seen++;
+        if (gl->ab_seen < (unsigned int)mgs_cfg.present_ab) return;
+    }
+
+    mgs_report_ab(gl, now);
+    gl->ab_block++;
+    gl->ab_seen = gl->ab_frames = gl->ab_ft_n = 0;
+    gl->ab_readback = gl->ab_copy = gl->ab_finish = 0.0;
+    gl->ab_gpucopy = gl->ab_acquire = 0.0;
+    gl->ab_slow[0] = gl->ab_slow[1] = gl->ab_slow[2] = gl->ab_slow[3] = 0;
+    gl->ab_drop = 0;
+    if (mgs_cfg.ab_mode) mgs_cfg.dmabuf = arm_async[gl->ab_block & 3];
+    else                 mgs_cfg.async  = arm_async[gl->ab_block & 3];
+}
