+/*
+ * Making the compositor read a finished buffer, on a stack with no explicit sync.
+ *
+ * Checked on the device: sway advertises 42 globals and NOT ONE of them is an
+ * explicit-synchronization protocol -- no wp_linux_drm_syncobj_v1, no
+ * zwp_linux_explicit_synchronization_v1. So there is nowhere to hand an acquire
+ * fence even though the blob exports eglDupNativeFenceFDANDROID and Box86 wraps
+ * it. Correctness has to come from the implicit fence on the dma-buf.
+ *
+ * Mode 0 was the first version and it is simply wrong: it attaches and commits
+ * straight after glBlitFramebuffer, without ever submitting the blit. The
+ * command can still be sitting unflushed in the driver, so the GPU has not
+ * started, the kernel has attached no fence, and the compositor is free to
+ * scan out a buffer with the previous frame -- or half of it. The owner saw
+ * exactly that: the frame juddered.
+ *
+ * Mode 1 waits for the blit on the CPU. Correct, and measured useless: the blit
+ * depends on the whole frame, so waiting for it costs what the old glFinish
+ * cost (readback back to 6.5-17 ms, the entire win gone).
+ *
+ * Mode 2, the default, is the one that should be both: glFlush SUBMITS the blit
+ * without waiting for it. If the driver attaches an implicit fence at submission
+ * -- which is the normal behaviour for an imported dma-buf -- the compositor
+ * waits on that fence and the game does not wait at all.
+ */
+
+/*
+ * Mode 3, the one that is both correct and free.
+ *
+ * The compositor's only way to know our blit is unfinished is the implicit
+ * fence on the dma-buf's reservation object, and the blob does not put one
+ * there: with mode 2 (submit, do not wait) the picture tears exactly like vsync
+ * off, and the tearing is indifferent to the buffer count, so it is not a
+ * pacing problem. sway offers no explicit-synchronization protocol either --
+ * all 42 of its globals were enumerated and none of them is one.
+ *
+ * The kernel bridges precisely this gap. EGL_ANDROID_native_fence_sync hands us
+ * the GPU's write fence as a sync_file, and DMA_BUF_IOCTL_IMPORT_SYNC_FILE
+ * installs it into the buffer's reservation object as a WRITE fence. From then
+ * on the compositor's ordinary implicit synchronisation sees it and waits --
+ * and the wait happens on the compositor's side, not in this thread, which is
+ * the whole point. No protocol, no latency frame, no CPU stall.
+ */
+static unsigned int mgs_fence_create_fail, mgs_fence_dup_fail, mgs_fence_import_fail;
+
+static BOOL mgs_dmabuf_attach_fence(struct mgs_dmabuf_buffer *b)
+{
+    static const EGLAttrib attrs[] = {
+        EGL_SYNC_NATIVE_FENCE_FD_ANDROID, EGL_NO_NATIVE_FENCE_FD_ANDROID, EGL_NONE
+    };
+    struct mgs_dma_buf_import_sync_file req;
+    void *sync;
+    int fence_fd;
+
+    if (!p_mgs_eglDupNativeFenceFDANDROID) { mgs_fence_create_fail++; return FALSE; }
+
+    sync = funcs->p_eglCreateSync(egl->display, EGL_SYNC_NATIVE_FENCE_ANDROID, attrs);
+    if (!sync) { mgs_fence_create_fail++; return FALSE; }
+
+    /* The fence is only queryable once the work is submitted. */
+    funcs->p_glFlush();
+    fence_fd = p_mgs_eglDupNativeFenceFDANDROID(egl->display, sync);
+    funcs->p_eglDestroySync(egl->display, sync);
+    if (fence_fd < 0) { mgs_fence_dup_fail++; return FALSE; }
+
+    req.flags = MGS_DMA_BUF_SYNC_WRITE;
+    req.fd = fence_fd;
+    if (ioctl(b->fd, MGS_DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &req) < 0)
+    {
+        if (!mgs_fence_import_fail)
+            ERR("MGS2 dmabuf: IMPORT_SYNC_FILE failed (%s)\n", strerror(errno));
+        mgs_fence_import_fail++;
+        close(fence_fd);
+        return FALSE;
+    }
+    close(fence_fd);
+    return TRUE;
+}
+
+static void mgs_dmabuf_wait_blit(struct mgs_dmabuf_buffer *b)
+{
+    void *sync;
+
+    switch (mgs_cfg.dmabuf_sync)
+    {
+    case 0:
+        return;
+    case 2:
+        funcs->p_glFlush();
+        return;
+    case 3:
+        /*
+         * Fail CLOSED. Every earlier version of this fell back to a bare
+         * glFlush when anything went wrong, which is mode 2 -- the mode that
+         * was measured tearing. A rare fence failure must cost one slow frame,
+         * never a torn one, so the fallback is glFinish: the blit is complete
+         * before the buffer is handed over, whatever the compositor does next.
+         * The counters make the cost visible instead of silent; a performance
+         * run is only valid with all three at zero.
+         */
+        if (!mgs_dmabuf_attach_fence(b)) funcs->p_glFinish();
+        return;
+    default:
+        sync = funcs->p_eglCreateSync(egl->display, EGL_SYNC_FENCE, NULL);
+        if (!sync) { funcs->p_glFinish(); return; }
+        funcs->p_eglClientWaitSync(egl->display, sync, 0, 100000000ull /* 100 ms */);
+        funcs->p_eglDestroySync(egl->display, sync);
+        return;
+    }
+}
