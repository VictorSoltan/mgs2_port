+/*
+ * One line per A/B block.  Everything the reader needs is on it, including the
+ * counts it uses as controls, because a block whose numbers have to be joined
+ * across two lines is a block that gets mis-paired when the log is trimmed.
+ *
+ * `wait` is the arm's own GPU-wait figure and it is the manipulation check: on
+ * the sync arm it is gpu_finish (only meaningful with MGS2_GL_READ_SPLIT=1), on
+ * the async arm it is the readPixels of the frame the GPU finished a frame ago.
+ * If the async arm does not show that number collapsing, the run measured
+ * nothing and no fps difference from it may be quoted.
+ */
+static void mgs_report_ab(struct wayland_gl_drawable *gl, double now)
+{
+    static double sorted[MGS_AB_MAX];
+    double span = now - gl->ab_t0;
+    unsigned int n = gl->ab_frames, k = gl->ab_ft_n;
+    double inv;
+
+    if (!n || span <= 0.0)
+    {
+        ERR("MGS2 PRESENT A/B block=%u arm=%s VOID frames=%u span=%.1f drop=%u\n",
+            gl->ab_block, mgs_cfg.async ? "async" : "sync", n, span, gl->ab_drop);
+        return;
+    }
+    inv = 1.0 / n;
+    if (k > MGS_AB_MAX) k = MGS_AB_MAX;
+    memcpy(sorted, gl->ab_ft, k * sizeof(double));
+    qsort(sorted, k, sizeof(double), mgs_cmp_double);
+
+    ERR("MGS2 PRESENT A/B block=%u arm=%s frames=%u span=%.1f fps=%.3f "
+        "ft_mean=%.2f p50=%.2f p95=%.2f p99=%.2f ftmax=%.2f "
+        "readback=%.3f wait=%.3f pixel=%.3f gpucopy=%.3f copy=%.3f acquire=%.3f "
+        "slow=%u/%u/%u/%u drop=%u tick=%.0f\n",
+        gl->ab_block, mgs_cfg.async ? "async" : "sync", n, span, n * 1000.0 / span,
+        span / n, mgs_pct(sorted, k, 0.50), mgs_pct(sorted, k, 0.95),
+        mgs_pct(sorted, k, 0.99), k ? sorted[k - 1] : 0.0,
+        gl->ab_readback * inv,
+        (mgs_cfg.async ? gl->ab_readback - gl->ab_gpucopy : gl->ab_finish) * inv,
+        (gl->ab_readback - (mgs_cfg.async ? gl->ab_gpucopy : gl->ab_finish)) * inv,
+        gl->ab_gpucopy * inv, gl->ab_copy * inv, gl->ab_acquire * inv,
+        gl->ab_slow[0], gl->ab_slow[1], gl->ab_slow[2], gl->ab_slow[3],
