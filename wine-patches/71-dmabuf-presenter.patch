+/*
+ * MGS2_GL_DMABUF: stop moving the frame through the CPU at all.
+ *
+ * The shm presenter reads the finished frame back with glReadPixels into a
+ * wl_shm buffer. Measured on this device (docs/briefs/MGS2_PRESENT_GATE_2026-08-22.md)
+ * that costs 0.9 ms of actual copying and 3-7 ms of the CPU standing still
+ * waiting for the GPU, and an in-process ABBA showed the wait is on the critical
+ * path: removing it shortens the frame by 9.8 ms in a heavy scene.
+ *
+ * Here the frame is blitted GPU-to-GPU into a buffer the compositor can read
+ * directly, and only a file descriptor is handed over. Nothing waits, nothing is
+ * copied through the CPU, and unlike MGS2_GL_ASYNC there is no frame of latency,
+ * because the buffer being presented is this frame and not the previous one.
+ *
+ * The allocator is a kernel dma-heap rather than GBM, which was the obvious
+ * choice and is the wrong one on this box: there is no render node (only card0,
+ * driver rockchip-drm, and sway holds DRM master), the armhf libgbm is a 12 KB
+ * shim over libmali-hook, and Box86 exports no gbm_* wrappers at all. A dma-heap
+ * is open/ioctl/mmap -- syscalls the emulator passes straight through -- so this
+ * path adds no new emulator surface. linux,cma is the default because it is
+ * physically contiguous, which is what the display controller wants if the
+ * buffer is ever to be scanned out directly.
+ *
+ * Everything here was proved on the device before it was written:
+ * harness/dmabuf/dmabuf_import_probe.c (heap -> EGLImage -> complete FBO ->
+ * renders) and harness/dmabuf/scm_rights_probe.c (the FD survives SCM_RIGHTS
+ * through the emulated x86 libwayland-client and sway returns a wl_buffer).
+ */
+static void *(*p_mgs_eglCreateImageKHR)(void *, void *, unsigned int, void *, const int *);
+static int (*p_mgs_eglDupNativeFenceFDANDROID)(void *, void *);
+static unsigned int (*p_mgs_eglDestroyImageKHR)(void *, void *);
+static void (*p_mgs_glEGLImageTargetTexture2DOES)(unsigned int, void *);
+
+static int mgs_dma_heap_alloc(const char *heap, size_t len)
+{
+    struct mgs_dma_heap_alloc req;
+    char path[128];
+    int hfd, r;
+
+    snprintf(path, sizeof(path), "/dev/dma_heap/%s", heap);
+    if ((hfd = open(path, O_RDWR | O_CLOEXEC)) < 0)
+    {
+        ERR("MGS2 dmabuf: cannot open %s: %s\n", path, strerror(errno));
+        return -1;
+    }
+    memset(&req, 0, sizeof(req));
+    req.len = len;
+    req.fd_flags = O_RDWR | O_CLOEXEC;
+    r = ioctl(hfd, MGS_DMA_HEAP_IOCTL_ALLOC, &req);
+    close(hfd);
+    if (r < 0)
+    {
+        ERR("MGS2 dmabuf: ALLOC on %s failed: %s\n", heap, strerror(errno));
+        return -1;
+    }
+    return (int)req.fd;
+}
+
+static void mgs_dmabuf_release(void *data, struct wl_buffer *buffer)
+{
+    struct mgs_dmabuf_buffer *b = data;
+    (void)buffer;
+    b->busy = FALSE;
+}
+static const struct wl_buffer_listener mgs_dmabuf_buffer_listener = { mgs_dmabuf_release };
+
+static void mgs_dmabuf_global(void *data, struct wl_registry *reg, uint32_t name,
+                              const char *iface, uint32_t version)
+{
+    struct wayland_gl_drawable *gl = data;
+
+    if (strcmp(iface, "zwp_linux_dmabuf_v1")) return;
+    /* Bind at 3: version 3 is the highest this hand-written table describes, and
+     * binding above what the table covers is how a client earns a protocol
+     * error the first time the compositor sends an event it did not expect. */
+    gl->dmabuf_global = wl_registry_bind(reg, name, &mgs_zwp_linux_dmabuf_v1_interface,
+                                         version < 3 ? version : 3);
+    TRACE("MGS2 dmabuf: bound zwp_linux_dmabuf_v1 (compositor offers v%u)\n", version);
+}
+static void mgs_dmabuf_global_remove(void *d, struct wl_registry *r, uint32_t n)
+{ (void)d; (void)r; (void)n; }
+static const struct wl_registry_listener mgs_dmabuf_registry_listener =
+{ mgs_dmabuf_global, mgs_dmabuf_global_remove };
+
+static void mgs_dmabuf_teardown(struct wayland_gl_drawable *gl)
+{
+    BOOL have_ctx = funcs->p_eglGetCurrentContext() != EGL_NO_CONTEXT;
+    int i;
+
+    for (i = 0; i < gl->dmabuf_count; i++)
+    {
+        struct mgs_dmabuf_buffer *b = &gl->dmabuf[i];
+
+        if (b->wl_buffer) wl_buffer_destroy(b->wl_buffer);
+        if (b->image && p_mgs_eglDestroyImageKHR)
+            p_mgs_eglDestroyImageKHR(egl->display, b->image);
+        if (have_ctx)
+        {
+            if (b->fbo) funcs->p_glDeleteFramebuffers(1, &b->fbo);
+            if (b->tex) funcs->p_glDeleteTextures(1, &b->tex);
+        }
+        if (b->fd >= 0) close(b->fd);
+        if (b->sendfd >= 0) close(b->sendfd);
+        memset(b, 0, sizeof(*b));
+        b->fd = -1;
+        b->sendfd = -1;
+    }
+    gl->dmabuf_count = 0;
+    if (gl->dmabuf_registry)
+    {
+        wl_registry_destroy(gl->dmabuf_registry);
+        gl->dmabuf_registry = NULL;
+    }
+}
+
+/* Build the ring. Any failure is permanent for this drawable: it sets
+ * dmabuf_failed and the caller drops back to the shm path for good, because a
+ * presenter that retries an allocation every frame is worse than one that never
+ * had it. */
+static BOOL mgs_dmabuf_ensure(struct wayland_gl_drawable *gl)
+{
+    struct wl_registry *reg;
+    int i;
+
+    if (gl->dmabuf_failed) return FALSE;
+    if (gl->dmabuf_count && gl->dmabuf_width == gl->width
+        && gl->dmabuf_height == gl->height)
+        return TRUE;
+
+    mgs_dmabuf_teardown(gl);
+
+    if (!p_mgs_eglCreateImageKHR)
+    {
+        p_mgs_eglCreateImageKHR = (void *)funcs->p_eglGetProcAddress("eglCreateImageKHR");
+        p_mgs_eglDestroyImageKHR = (void *)funcs->p_eglGetProcAddress("eglDestroyImageKHR");
+        p_mgs_glEGLImageTargetTexture2DOES =
+            (void *)funcs->p_eglGetProcAddress("glEGLImageTargetTexture2DOES");
+        p_mgs_eglDupNativeFenceFDANDROID =
+            (void *)funcs->p_eglGetProcAddress("eglDupNativeFenceFDANDROID");
+    }
+    if (!p_mgs_eglCreateImageKHR || !p_mgs_glEGLImageTargetTexture2DOES)
+    {
+        ERR("MGS2 dmabuf: EGLImage entry points missing, staying on shm\n");
+        gl->dmabuf_failed = TRUE;
+        return FALSE;
+    }
+
+    /*
+     * Binding the global must not block this thread, and the first version of
+     * this code did exactly that with wl_display_roundtrip_queue. That hung the
+     * game: winewayland.drv keeps its own event thread inside
+     * wl_display_dispatch -> poll, libwayland serialises display access behind
+     * an internal mutex, and a blocking roundtrip issued from the wined3d CS
+     * thread deadlocks against it. The captured signature was one thread in an
+     * endless poll and the CS thread in FUTEX_WAIT_PRIVATE on a contended mutex.
+     *
+     * So: ask once, never wait. Until the global turns up, the caller presents
+     * through shm as it always did, and the ring is built on a later frame.
+     */
+    if (!gl->dmabuf_global)
+    {
+        if (!gl->dmabuf_registry)
+        {
+            reg = wl_display_get_registry(process_wayland.wl_display);
+            if (!reg) { gl->dmabuf_failed = TRUE; return FALSE; }
+            wl_proxy_set_queue((struct wl_proxy *)reg, gl->wl_event_queue);
+            wl_registry_add_listener(reg, &mgs_dmabuf_registry_listener, gl);
+            gl->dmabuf_registry = reg;
+            wl_display_flush(process_wayland.wl_display);
+        }
+        wl_display_dispatch_queue_pending(process_wayland.wl_display, gl->wl_event_queue);
+        if (!gl->dmabuf_global)
+        {
+            if (++gl->dmabuf_bind_tries > 300)
+            {
+                ERR("MGS2 dmabuf: no zwp_linux_dmabuf_v1 after 300 frames, "
+                    "staying on shm\n");
+                gl->dmabuf_failed = TRUE;
+            }
+            return FALSE;
+        }
+    }
+
+    for (i = 0; i < mgs_cfg.dmabuf_bufs; i++)
+    {
+        struct mgs_dmabuf_buffer *b = &gl->dmabuf[i];
+        const int stride = gl->width * 4;
+        struct wl_proxy *params;
+        int attrs[13], n = 0;
+        unsigned int status;
+
+        b->fd = mgs_dma_heap_alloc(mgs_cfg.dmabuf_heap, (size_t)stride * gl->height);
