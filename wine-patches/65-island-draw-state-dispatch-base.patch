@@ -424,6 +428,14 @@
  * exports. */
 static void *mgs2_get_gl_func(const char *name)
 {
+#ifdef MGS2_ISLAND_ARM
+    /* wglGetProcAddress() is a reverse guest call in the island and therefore
+     * returns an x86 opengl32 thunk.  Caching that address in these file-local
+     * separable pointers made the next native DRAW branch into x86 bytes.
+     * Resolve against the host GL exactly like the translated gl_ops table;
+     * NULL keeps the existing monolithic-program fallback intact. */
+    return mgs2_island_gl_by_name(name);
+#else
     static HMODULE opengl32;
     void *pointer;
 
@@ -433,6 +445,7 @@
     if (!opengl32)
