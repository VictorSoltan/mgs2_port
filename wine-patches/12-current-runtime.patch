+static double mgs2_batch_now_ms(void)
+{
+    static LARGE_INTEGER frequency;
+    LARGE_INTEGER counter;
+
+    if (!frequency.QuadPart)
+        QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&counter);
+    return frequency.QuadPart ? counter.QuadPart * 1000.0 / frequency.QuadPart : 0.0;
+}
+
+static int mgs2_batch_enabled(void)
+{
+    static int state = -1;
+    static DWORD last_poll;
+    DWORD now;
+    FILE *f;
+
+    if (state < 0)
+    {
+        const char *e = getenv("MGS2_BATCH");
+        state = e && *e != '0';
+    }
+
+    now = GetTickCount();
+    if (now - last_poll >= 1000)
+    {
+        last_poll = now;
+        if ((f = fopen("Z:\\tmp\\mgs2-batch", "r")))
+        {
+            int c = fgetc(f);
+            fclose(f);
+            if (c == '0' || c == '1')
+            {
+                int want = c - '0';
+                if (want != state)
+                {
+                    /* turning off with a run pending would drop that geometry */
+                    mgs2_batch_flush();
+                    if (mgs2_batch.restart_context)
+                        mgs2_batch_restart_end(mgs2_batch.restart_context,
+                                mgs2_batch.restart_context->gl_info);
+                    state = want;
+                    fprintf(stderr, "MGS2BATCH: switched to %d\n", state);
+                    fflush(stderr);
+                }
+            }
+        }
+    }
+    return state;
+}
