+/* Returns TRUE if the draw was absorbed into the pending run. */
+static BOOL mgs2_batch_append(struct wined3d_context_gl *context_gl,
+        GLenum mode, unsigned int first, unsigned int count)
+{
+    if (!count)
+        return FALSE;
+
+    if (mgs2_batch.n
+            && (mgs2_batch.mode != mode || mgs2_batch.context_gl != context_gl))
+    {
+        ++mgs2_batch.flush_incompat;
+        mgs2_batch_flush();
+    }
+
+    mgs2_batch.context_gl = context_gl;
+    mgs2_batch.mode = mode;
+    mgs2_batch.first[mgs2_batch.n] = first;
+    mgs2_batch.count[mgs2_batch.n] = count;
+    ++mgs2_batch.n;
+    ++mgs2_batch.draws_in;
+    if (first + count - 1 > mgs2_batch.max_index)
+        mgs2_batch.max_index = first + count - 1;
