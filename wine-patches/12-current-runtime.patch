+/* MGS2 batch census, conservative barrier. Declared here because submit() is defined
+ * above the census itself: every CSMT packet that is NOT a draw ends a run, even a
+ * redundant one, so the reported batch factor is a lower bound. Two plain unsigned
+ * ints, incremented on the producer thread only -- no locking, no logging. */
+static unsigned int mgs2_submitting_draw;
+static unsigned int mgs2_census_epoch;
+
+/* MGS2 CSMT queue profile. This is deliberately opt-in and reports only once
+ * per second. QPC is sampled around operations that already block; the regular
+ * submit path only records integer queue-depth counters. */
+static struct
+{
+    LONG present_waits, present_ticks;
+    LONG finish_waits[2], finish_ticks[2];
+    LONG map_reason[4];
+    LONG map_bind[5];
+    LONG map_access[3];
+    LONG map_rw[3];
+    LONG full_waits, full_ticks;
+    LONG idle_waits, idle_ticks;
+    LONG depth_samples, depth_units, depth_max_units;
+} mgs2_cs_profile;
+
+static BOOL mgs2_cs_profile_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv("MGS2_CSMT_PROFILE");
+        enabled = e && *e != '0';
+    }
+    return enabled;
+}
+
+static LONGLONG mgs2_cs_profile_now(void)
+{
+    LARGE_INTEGER counter;
+
+    QueryPerformanceCounter(&counter);
+    return counter.QuadPart;
+}
+
+static void mgs2_cs_profile_add_wait(LONG volatile *count, LONG volatile *ticks, LONGLONG start)
+{
+    LONGLONG elapsed = mgs2_cs_profile_now() - start;
+
+    InterlockedIncrement(count);
+    InterlockedAdd(ticks, elapsed > LONG_MAX ? LONG_MAX : (LONG)elapsed);
+}
+
+static void mgs2_cs_profile_depth(ULONG depth)
+{
+    LONG units = (depth + 15) / 16;
+    LONG old;
+
+    InterlockedIncrement(&mgs2_cs_profile.depth_samples);
+    InterlockedAdd(&mgs2_cs_profile.depth_units, units);
+    old = mgs2_cs_profile.depth_max_units;
+    while (units > old)
+    {
+        LONG seen = InterlockedCompareExchange(&mgs2_cs_profile.depth_max_units, units, old);
+        if (seen == old)
+            break;
+        old = seen;
+    }
+}
+
+static void mgs2_cs_profile_map_reason(unsigned int reason)
+{
+    if (mgs2_cs_profile_enabled() && reason < ARRAY_SIZE(mgs2_cs_profile.map_reason))
+        InterlockedIncrement(&mgs2_cs_profile.map_reason[reason]);
+}
