+static void mgs2_batch_poll_switch(const char *path, const char *name, int *state)
+{
+    FILE *f;
+    int c;
+
+    if (!(f = fopen(path, "r")))
+        return;
+    c = fgetc(f);
+    fclose(f);
+    if ((c == '0' || c == '1') && *state != c - '0')
+    {
+        *state = c - '0';
+        fprintf(stderr, "MGS2BATCH: switched %s to %d\n", name, *state);
+        fflush(stderr);
+    }
+}
