+            if (SUCCEEDED(hr)) hr = current;
+        }
+        else
+        {
+            if (FAILED(current = IDirectMusicPortDownload_Unload(entry->port, wave_download)))
+            {
+                WARN("Failed to unload wave download buffer, hr %#lx\n", current);
+                if (SUCCEEDED(hr)) hr = current;
+            }
+            IDirectMusicDownload_Release(wave_download);
+        }
+        list_remove(&downloaded_wave->entry);
+        free(downloaded_wave);
+    }
