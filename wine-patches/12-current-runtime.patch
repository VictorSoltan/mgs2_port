+/* MGS2: mechanism proof for draw batching.
+ *
+ * The census on the heavy Plant spot says every draw there is a NON-indexed
+ * TRIANGLESTRIP (idx=0, nonidx=13057, 99.8% strips), 91% of them covering vertex
+ * ranges that continue exactly where the previous draw ended, in conservative runs
+ * averaging 8.5 draws. Merging those runs is the only renderer lever left, since
+ * rung D showed the whole 52.75 ms is the glDraw* calls and their submission.
+ *
+ * Merging non-indexed strips is not possible directly: one glDrawArrays over the
+ * combined range would weld the strips together and invent triangles between them.
+ * glMultiDrawArrays and glMultiDrawElementsIndirect are both absent on this Mali,
+ * checked on the live context. What is left is to draw the strips as ONE indexed
+ * draw with GL_PRIMITIVE_RESTART_FIXED_INDEX separating them.
+ *
+ * Before writing that batcher, this proves the mechanism on a single strip: take one
+ * non-indexed strip and issue it as an indexed draw through a scratch element
+ * buffer. If one strip renders identically this way, merging is only concatenation
+ * with 0xFFFF between the pieces.
+ *
+ * Two things had to be established first, and both shape this code:
+ *   d3d8 passes WINED3D_NO_PRIMITIVE_RESTART (d3d8/directx.c:478), correctly, since
+ *   0xFFFF is a legal D3D8 index -- so restart is enabled here, locally, and only
+ *   because the census proved this game issues no indexed draws at all.
+ *   ARB_ES3_COMPATIBILITY is only promoted at GL 4.3 and this context reports 3.2, so
+ *   wined3d thinks restart is unavailable. On a real GLES 3.x context the token is
+ *   core since 3.0, which is what this checks.
+ * And GLES 3 forbids client-side index arrays, so a real buffer object is required --
+ * which the batcher would need anyway.
+ *
+ * MGS2_STRIP_AS_INDEXED=1. Off by default. Judge it on the picture, not the frame
+ * rate: it adds index generation and can only be slower than a plain glDrawArrays.
+ */
+static int mgs2_strip_as_indexed(void)
+{
+    static int cached = -1;
+
+    if (cached < 0)
+    {
+        const char *e = getenv("MGS2_STRIP_AS_INDEXED");
+        cached = e && *e != '0';
+    }
+    return cached;
+}
+
+/* Returns TRUE if the draw was issued here. */
+static BOOL mgs2_draw_strip_as_indexed(struct wined3d_context_gl *context_gl,
+        GLenum mode, unsigned int start_idx, unsigned int count)
+{
+    static GLuint scratch_bo;
+    static unsigned int scratch_size;
+    static void *indices;
+    static unsigned int indices_size;
+    static int reported;
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    unsigned int i, last = start_idx + count;
+    BOOL use16 = last <= 0x10000;   /* not "small": rpcndr.h typedefs that */
+    unsigned int stride = use16 ? 2 : 4;
+    unsigned int bytes = count * stride;
+    GLenum err = GL_NO_ERROR, err_enable = GL_NO_ERROR;
+    unsigned int err_pre = 0;
+
+    if (mode != GL_TRIANGLE_STRIP || !count)
+        return FALSE;
+
+    if (bytes > indices_size)
+    {
+        void *p = realloc(indices, bytes);
+        if (!p) return FALSE;
+        indices = p;
+        indices_size = bytes;
+    }
+    if (use16)
+        for (i = 0; i < count; ++i) ((GLushort *)indices)[i] = start_idx + i;
+    else
+        for (i = 0; i < count; ++i) ((GLuint *)indices)[i] = start_idx + i;
+
+    if (!scratch_bo)
+    {
+        GL_EXTCALL(glGenBuffers(1, &scratch_bo));
+        if (!scratch_bo) return FALSE;
+    }
+    wined3d_context_gl_bind_bo(context_gl, GL_ELEMENT_ARRAY_BUFFER, scratch_bo);
+    if (bytes > scratch_size)
+    {
+        GL_EXTCALL(glBufferData(GL_ELEMENT_ARRAY_BUFFER, bytes, indices, GL_DYNAMIC_DRAW));
+        scratch_size = bytes;
+    }
+    else
+    {
+        GL_EXTCALL(glBufferSubData(GL_ELEMENT_ARRAY_BUFFER, 0, bytes, indices));
+    }
+
+    /* The error queue has to be drained first, or this measures somebody else's
+     * error: with WINEDEBUG=-all nothing calls glGetError, and this stack raises
+     * GL_INVALID_OPERATION on every draw from glAlphaFunc, so errors accumulate.
+     * The first attempt at this proof read a stale 0x500 and looked like a failure.
+     * Each step is then checked separately, because "it errored" is useless without
+     * knowing which call did. */
+    if (!reported)
+    {
+        GLenum drained;
+        unsigned int guard = 0;
+
+        while ((drained = gl_info->gl_ops.gl.p_glGetError()) != GL_NO_ERROR && ++guard < 64)
+            ;
+        err_pre = guard;
+    }
+
+    gl_info->gl_ops.gl.p_glEnable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+    if (!reported) err_enable = gl_info->gl_ops.gl.p_glGetError();
+    gl_info->gl_ops.gl.p_glDrawElements(mode, count,
+            use16 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, NULL);
+    if (!reported) err = gl_info->gl_ops.gl.p_glGetError();
+    gl_info->gl_ops.gl.p_glDisable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+
+    if (!reported)
+    {
+        reported = 1;
+        fprintf(stderr, "MGS2STRIP: strip as indexed: count=%u start=%u %s | "
+                "drained %u stale errors | glEnable(PRIMITIVE_RESTART_FIXED_INDEX) err=0x%x %s | "
+                "glDrawElements err=0x%x %s\n",
+                count, start_idx, use16 ? "16bit" : "32bit", err_pre,
+                err_enable, err_enable == GL_NO_ERROR ? "OK" : "REJECTED",
+                err, err == GL_NO_ERROR ? "OK" : "FAILED");
+        fflush(stderr);
+    }
+    return TRUE;
+}
