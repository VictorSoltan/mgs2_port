+    if (!d3d8_mgs2_barrier_census_on())
+        return;
+
+    ++d3d8_mgs2_barrier_census.redundant[kind];
+    if (d3d8_mgs2_pending.count)
+    {
+        ++d3d8_mgs2_barrier_census.pending[kind];
+        d3d8_mgs2_barrier_census.pending_draws[kind] += d3d8_mgs2_pending.count;
+    }
+}
+
+void d3d8_mgs2_barrier_census_present(void)
+{
+    DWORD now;
+
+    if (!d3d8_mgs2_barrier_census_on())
+        return;
+
+    ++d3d8_mgs2_barrier_census.frames;
+    now = GetTickCount();
+    if (now - d3d8_mgs2_barrier_census.last_report < 1000)
+        return;
+    d3d8_mgs2_barrier_census.last_report = now;
+
+    ERR("MGS2BARRIER: frames=%u rs=%llu/%llu/%llu/%llu tss=%llu/%llu/%llu/%llu "
+            "samp=%llu/%llu/%llu/%llu\n", d3d8_mgs2_barrier_census.frames,
+            d3d8_mgs2_barrier_census.calls[D3D8_MGS2_BARRIER_RS],
+            d3d8_mgs2_barrier_census.redundant[D3D8_MGS2_BARRIER_RS],
+            d3d8_mgs2_barrier_census.pending[D3D8_MGS2_BARRIER_RS],
+            d3d8_mgs2_barrier_census.pending_draws[D3D8_MGS2_BARRIER_RS],
+            d3d8_mgs2_barrier_census.calls[D3D8_MGS2_BARRIER_TSS],
+            d3d8_mgs2_barrier_census.redundant[D3D8_MGS2_BARRIER_TSS],
+            d3d8_mgs2_barrier_census.pending[D3D8_MGS2_BARRIER_TSS],
+            d3d8_mgs2_barrier_census.pending_draws[D3D8_MGS2_BARRIER_TSS],
+            d3d8_mgs2_barrier_census.calls[D3D8_MGS2_BARRIER_SAMPLER],
+            d3d8_mgs2_barrier_census.redundant[D3D8_MGS2_BARRIER_SAMPLER],
+            d3d8_mgs2_barrier_census.pending[D3D8_MGS2_BARRIER_SAMPLER],
+            d3d8_mgs2_barrier_census.pending_draws[D3D8_MGS2_BARRIER_SAMPLER]);
+
+    memset(&d3d8_mgs2_barrier_census, 0, sizeof(d3d8_mgs2_barrier_census));
+    d3d8_mgs2_barrier_census.last_report = now;
+}
+
+#define D3D8_MGS2_VB_CENSUS_MAX_BUFFERS 64
+static struct
+{
+    struct d3d8_vertexbuffer *buffer;
+    unsigned int left, right;
+} d3d8_mgs2_vb_census_dirty[D3D8_MGS2_VB_CENSUS_MAX_BUFFERS];
+static struct
+{
+    ULONGLONG locks, unlocks, upload_commands, upload_bytes;
+    ULONGLONG locks_without_draw, merged_commands, merged_bytes, overflow;
+    unsigned int locks_since_draw, dirty_count, frames;
+    DWORD last_report;
+} d3d8_mgs2_vb_census;
+
+static BOOL d3d8_mgs2_vb_census_on(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_VB_CENSUS", FALSE);
+    return on;
+}
+
+/* Census for the proposed non-indexed expanded-VBO batcher. Keep this to
+ * integer accounting on DrawPrimitive and one report per second on Present;
+ * the normal production path never enters it. */
+static struct
+{
+    ULONGLONG draws, strips, stream_count[4], compatible;
+    ULONGLONG no_buffer, no_snapshot, bad_stride, out_of_range;
+    ULONGLONG source_vertices, expanded_vertices;
+    ULONGLONG source_bytes, expanded_bytes, stride_sum;
+    unsigned int stride_min, stride_max, frames;
+    DWORD last_report;
+} d3d8_mgs2_vbo_census;
+
+static BOOL d3d8_mgs2_vbo_census_on(void)
+{
+    static int on = -1;
+    if (on == -1) on = d3d8_mgs2_env_on("MGS2_D3D8_VBO_CENSUS", FALSE);
+    return on;
+}
+
+static void d3d8_mgs2_vbo_census_draw(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, unsigned int start_vertex, unsigned int vertex_count)
+{
+    const struct wined3d_stateblock_state *state = device->stateblock_state;
+    const struct wined3d_stream_state *stream;
+    struct d3d8_vertex_declaration *decl;
+    struct d3d8_vertexbuffer *buffer;
+    ULONGLONG left, source_bytes, expanded_vertices;
+    unsigned int map, stream_idx = 0, stream_count = 0, stride;
+
+    if (!d3d8_mgs2_vbo_census_on()) return;
+    ++d3d8_mgs2_vbo_census.draws;
+    if (primitive_type == D3DPT_TRIANGLESTRIP)
+        ++d3d8_mgs2_vbo_census.strips;
+
+    if (!state->vertex_declaration)
+    {
+        ++d3d8_mgs2_vbo_census.stream_count[0];
+        return;
+    }
+    decl = wined3d_vertex_declaration_get_parent(state->vertex_declaration);
+    map = decl->stream_map;
+    while (map)
+    {
+        stream_idx = wined3d_bit_scan(&map);
+        ++stream_count;
+    }
+    ++d3d8_mgs2_vbo_census.stream_count[min(stream_count, 3u)];
+    if (primitive_type != D3DPT_TRIANGLESTRIP || stream_count != 1 || vertex_count < 3)
+        return;
+
+    stream = &state->streams[stream_idx];
+    if (!stream->buffer)
+    {
+        ++d3d8_mgs2_vbo_census.no_buffer;
+        return;
+    }
+    buffer = wined3d_buffer_get_parent(stream->buffer);
+    if (!buffer->mgs2_snapshot)
+    {
+        ++d3d8_mgs2_vbo_census.no_snapshot;
+        return;
+    }
+    if (!(stride = stream->stride))
+    {
+        ++d3d8_mgs2_vbo_census.bad_stride;
+        return;
+    }
+
+    left = (ULONGLONG)stream->offset + (ULONGLONG)start_vertex * stride;
+    source_bytes = (ULONGLONG)vertex_count * stride;
+    if (left > buffer->mgs2_snapshot_size || source_bytes > buffer->mgs2_snapshot_size - left)
+    {
+        ++d3d8_mgs2_vbo_census.out_of_range;
+        return;
+    }
+
+    expanded_vertices = (ULONGLONG)(vertex_count - 2) * 3;
+    ++d3d8_mgs2_vbo_census.compatible;
+    d3d8_mgs2_vbo_census.source_vertices += vertex_count;
+    d3d8_mgs2_vbo_census.expanded_vertices += expanded_vertices;
+    d3d8_mgs2_vbo_census.source_bytes += source_bytes;
+    d3d8_mgs2_vbo_census.expanded_bytes += expanded_vertices * stride;
+    d3d8_mgs2_vbo_census.stride_sum += stride;
+    if (!d3d8_mgs2_vbo_census.stride_min || stride < d3d8_mgs2_vbo_census.stride_min)
+        d3d8_mgs2_vbo_census.stride_min = stride;
+    d3d8_mgs2_vbo_census.stride_max = max(d3d8_mgs2_vbo_census.stride_max, stride);
+}
+
+void d3d8_mgs2_vbo_census_present(void)
+{
+    DWORD now;
+    double frames, compatible;
+
+    if (!d3d8_mgs2_vbo_census_on()) return;
+    ++d3d8_mgs2_vbo_census.frames;
+    now = GetTickCount();
+    if (now - d3d8_mgs2_vbo_census.last_report < 1000) return;
+    d3d8_mgs2_vbo_census.last_report = now;
+    frames = d3d8_mgs2_vbo_census.frames ? d3d8_mgs2_vbo_census.frames : 1.0;
+    compatible = d3d8_mgs2_vbo_census.compatible ? d3d8_mgs2_vbo_census.compatible : 1.0;
+    fprintf(stderr, "MGS2VBOCENSUS: frames=%u draws=%I64u %.1f/f strips=%I64u "
+            "streams=%I64u/%I64u/%I64u/%I64u compatible=%I64u %.1f/f "
+            "reject=%I64u/%I64u/%I64u/%I64u stride=%.1f/%u/%u "
+            "src=%I64uKB %.1fKB/f expanded=%I64uKB %.1fKB/f vertices=%I64u/%I64u\n",
+            d3d8_mgs2_vbo_census.frames,
+            d3d8_mgs2_vbo_census.draws, d3d8_mgs2_vbo_census.draws / frames,
+            d3d8_mgs2_vbo_census.strips,
+            d3d8_mgs2_vbo_census.stream_count[0], d3d8_mgs2_vbo_census.stream_count[1],
+            d3d8_mgs2_vbo_census.stream_count[2], d3d8_mgs2_vbo_census.stream_count[3],
+            d3d8_mgs2_vbo_census.compatible, d3d8_mgs2_vbo_census.compatible / frames,
+            d3d8_mgs2_vbo_census.no_buffer, d3d8_mgs2_vbo_census.no_snapshot,
+            d3d8_mgs2_vbo_census.bad_stride, d3d8_mgs2_vbo_census.out_of_range,
+            d3d8_mgs2_vbo_census.stride_sum / compatible,
+            d3d8_mgs2_vbo_census.stride_min, d3d8_mgs2_vbo_census.stride_max,
+            d3d8_mgs2_vbo_census.source_bytes / 1024,
+            d3d8_mgs2_vbo_census.source_bytes / 1024.0 / frames,
+            d3d8_mgs2_vbo_census.expanded_bytes / 1024,
+            d3d8_mgs2_vbo_census.expanded_bytes / 1024.0 / frames,
+            d3d8_mgs2_vbo_census.source_vertices, d3d8_mgs2_vbo_census.expanded_vertices);
+    fflush(stderr);
+    memset(&d3d8_mgs2_vbo_census, 0, sizeof(d3d8_mgs2_vbo_census));
+    d3d8_mgs2_vbo_census.last_report = now;
+}
+
+void d3d8_mgs2_vb_census_lock(struct d3d8_vertexbuffer *buffer)
+{
+    if (!d3d8_mgs2_vb_census_on()) return;
+    ++d3d8_mgs2_vb_census.locks;
+    ++d3d8_mgs2_vb_census.locks_since_draw;
+}
+
+void d3d8_mgs2_vb_census_unlock(struct d3d8_vertexbuffer *buffer,
+        unsigned int offset, unsigned int size, BOOL written, BOOL uploads)
+{
+    unsigned int i;
+
+    if (!d3d8_mgs2_vb_census_on()) return;
+    ++d3d8_mgs2_vb_census.unlocks;
+    if (!written) return;
+
+    if (uploads)
+    {
+        ++d3d8_mgs2_vb_census.upload_commands;
+        d3d8_mgs2_vb_census.upload_bytes += size;
+    }
+    for (i = 0; i < d3d8_mgs2_vb_census.dirty_count; ++i)
+    {
+        if (d3d8_mgs2_vb_census_dirty[i].buffer != buffer) continue;
+        d3d8_mgs2_vb_census_dirty[i].left = min(d3d8_mgs2_vb_census_dirty[i].left, offset);
+        d3d8_mgs2_vb_census_dirty[i].right = max(d3d8_mgs2_vb_census_dirty[i].right, offset + size);
+        return;
+    }
+    if (i == ARRAY_SIZE(d3d8_mgs2_vb_census_dirty))
+    {
+        ++d3d8_mgs2_vb_census.overflow;
+        return;
+    }
+    d3d8_mgs2_vb_census_dirty[i].buffer = buffer;
+    d3d8_mgs2_vb_census_dirty[i].left = offset;
+    d3d8_mgs2_vb_census_dirty[i].right = offset + size;
+    ++d3d8_mgs2_vb_census.dirty_count;
+}
+
+void d3d8_mgs2_vb_census_upload(unsigned int size)
+{
+    if (!d3d8_mgs2_vb_census_on()) return;
+    ++d3d8_mgs2_vb_census.upload_commands;
+    d3d8_mgs2_vb_census.upload_bytes += size;
+}
+
+void d3d8_mgs2_vb_census_draw(void)
+{
+    unsigned int i;
+
+    if (!d3d8_mgs2_vb_census_on()) return;
+    if (d3d8_mgs2_vb_census.locks_since_draw > 1)
+        d3d8_mgs2_vb_census.locks_without_draw += d3d8_mgs2_vb_census.locks_since_draw - 1;
+    d3d8_mgs2_vb_census.locks_since_draw = 0;
+    d3d8_mgs2_vb_census.merged_commands += d3d8_mgs2_vb_census.dirty_count;
+    for (i = 0; i < d3d8_mgs2_vb_census.dirty_count; ++i)
+        d3d8_mgs2_vb_census.merged_bytes += d3d8_mgs2_vb_census_dirty[i].right
+                - d3d8_mgs2_vb_census_dirty[i].left;
+    d3d8_mgs2_vb_census.dirty_count = 0;
+}
+
+void d3d8_mgs2_vb_census_present(void)
+{
+    DWORD now;
+    double frames;
+
+    if (!d3d8_mgs2_vb_census_on()) return;
+    d3d8_mgs2_vb_census_draw();
+    ++d3d8_mgs2_vb_census.frames;
+    now = GetTickCount();
+    if (now - d3d8_mgs2_vb_census.last_report < 1000) return;
+    d3d8_mgs2_vb_census.last_report = now;
+    frames = d3d8_mgs2_vb_census.frames ? d3d8_mgs2_vb_census.frames : 1.0;
+    fprintf(stderr, "MGS2VBCENSUS: frames=%u locks=%I64u %.1f/f unlocks=%I64u %.1f/f "
+            "uploads=%I64u %.1f/f bytes=%I64uKB %.1fKB/f nodraw_extra=%I64u "
+            "merged_cmds=%I64u merged_bytes=%I64uKB overflow=%I64u\n",
+            d3d8_mgs2_vb_census.frames,
+            d3d8_mgs2_vb_census.locks, d3d8_mgs2_vb_census.locks / frames,
+            d3d8_mgs2_vb_census.unlocks, d3d8_mgs2_vb_census.unlocks / frames,
+            d3d8_mgs2_vb_census.upload_commands, d3d8_mgs2_vb_census.upload_commands / frames,
+            d3d8_mgs2_vb_census.upload_bytes / 1024,
+            d3d8_mgs2_vb_census.upload_bytes / 1024.0 / frames,
+            d3d8_mgs2_vb_census.locks_without_draw,
+            d3d8_mgs2_vb_census.merged_commands,
+            d3d8_mgs2_vb_census.merged_bytes / 1024,
+            d3d8_mgs2_vb_census.overflow);
+    fflush(stderr);
+    memset(&d3d8_mgs2_vb_census, 0, sizeof(d3d8_mgs2_vb_census));
+    d3d8_mgs2_vb_census.last_report = now;
+}
+
