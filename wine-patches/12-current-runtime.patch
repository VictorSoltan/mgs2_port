+/* Degenerate bridges keep every source strip as a strip, unlike the rejected
+ * TRIANGLELIST expansion. For a strip of length L followed by B, append the
+ * last vertex once (twice when L is odd), then B[0] twice. All bridge triangles
+ * are degenerate and the final B[0] starts on even strip parity, preserving its
+ * original winding. Keep the arithmetic proof local and deterministic. */
+static BOOL mgs2_batch_degenerate_selftest(void)
+{
+    static int state = -1;
+    unsigned int a, b;
+
+    if (state >= 0)
+        return state;
+
+    state = TRUE;
+    for (a = 3; a <= 8 && state; ++a)
+    {
+        for (b = 3; b <= 8; ++b)
+        {
+            GLuint indices[24];
+            unsigned int i, j = 0, nondegenerate = 0, second_start;
+
+            for (i = 0; i < a; ++i)
+                indices[j++] = i;
+            indices[j++] = a - 1;
+            if (a & 1)
+                indices[j++] = a - 1;
+            indices[j++] = 100 + 0;
+            indices[j++] = 100 + 0;
+            second_start = j - 1;
+            for (i = 1; i < b; ++i)
+                indices[j++] = 100 + i;
+
+            if (j != a + b + 2 + (a & 1) || (second_start & 1))
+            {
+                state = FALSE;
+                break;
+            }
+
+            for (i = 2; i < j; ++i)
+            {
+                const GLuint x = indices[i - 2], y = indices[i - 1], z = indices[i];
+
+                if (x == y || y == z || x == z)
+                    continue;
+                ++nondegenerate;
+                if (!((x < a && y == x + 1 && z == y + 1)
+                        || (x >= 100 && y == x + 1 && z == y + 1)))
+                {
+                    state = FALSE;
+                    break;
+                }
+            }
+            if (!state || nondegenerate != a - 2 + b - 2)
+            {
+                state = FALSE;
+                break;
+            }
+        }
+    }
+
+    fprintf(stderr, "MGS2DEGENERATE: bridge selftest %s\n", state ? "PASS" : "FAIL");
+    fflush(stderr);
+    return state;
+}
+
+static BOOL mgs2_batch_degenerate_strips_enabled(void)
