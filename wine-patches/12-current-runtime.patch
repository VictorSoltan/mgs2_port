+/* Ranges remain sorted and coalesce if they overlap or leave at most 256 bytes
+ * between them. When eight are pending, merge the closest pair; that bounds the
+ * producer-side bookkeeping while avoiding the old single min..max upload. */
+static void d3d8_vertexbuffer_add_dirty_range(struct d3d8_vertexbuffer *buffer,
+        unsigned int left, unsigned int right)
+{
+    unsigned int i;
+
+    if (left >= right) return;
+    if (buffer->mgs2_snapshot_dirty_count == D3D8_MGS2_SNAPSHOT_DIRTY_RANGES)
+        d3d8_vertexbuffer_merge_nearest_dirty_ranges(buffer);
+
+    for (i = 0; i < buffer->mgs2_snapshot_dirty_count;)
+    {
+        const unsigned int range_left = buffer->mgs2_snapshot_dirty_ranges[i].left;
+        const unsigned int range_right = buffer->mgs2_snapshot_dirty_ranges[i].right;
+
+        if (right < range_left && range_left - right > 256) break;
+        if (left > range_right && left - range_right > 256)
+        {
+            ++i;
+            continue;
+        }
+        left = min(left, range_left);
+        right = max(right, range_right);
+        d3d8_vertexbuffer_remove_dirty_range(buffer, i);
+    }
+
+    memmove(&buffer->mgs2_snapshot_dirty_ranges[i + 1],
+            &buffer->mgs2_snapshot_dirty_ranges[i],
+            (buffer->mgs2_snapshot_dirty_count - i)
+            * sizeof(buffer->mgs2_snapshot_dirty_ranges[0]));
+    buffer->mgs2_snapshot_dirty_ranges[i].left = left;
+    buffer->mgs2_snapshot_dirty_ranges[i].right = right;
+    ++buffer->mgs2_snapshot_dirty_count;
+    buffer->mgs2_snapshot_dirty = TRUE;
+}
