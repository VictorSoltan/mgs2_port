+static void d3d8_mgs2_mark_state_dirty(void)
+{
+    d3d8_mgs2_state_dirty = TRUE;
+}
+
+static void d3d8_mgs2_set_primitive_type(struct wined3d_device_context *context,
+        D3DPRIMITIVETYPE primitive_type)
+{
+    UINT mapped = wined3d_primitive_type_from_d3d(primitive_type);
+
+    if (mapped == d3d8_mgs2_last_primitive)
+        return;
+    d3d8_mgs2_last_primitive = mapped;
+    wined3d_device_context_set_primitive_type(context, mapped, 0);
+}
+
+static BOOL d3d8_mgs2_vbo_prepare_buffer(struct d3d8_device *device,
+        unsigned int bytes, struct wined3d_buffer **buffer)
+{
+    struct wined3d_buffer_desc desc;
+    struct wined3d_buffer **entry;
+    unsigned int *entry_size;
+    unsigned int capacity;
+
+    if (device->mgs2_expanded_pool_pos >= D3D8_MGS2_VBO_BATCH_SLOTS)
+        return FALSE;
+    entry = &device->mgs2_expanded_pool[device->mgs2_expanded_pool_idx]
+            [device->mgs2_expanded_pool_pos];
+    entry_size = &device->mgs2_expanded_pool_size[device->mgs2_expanded_pool_idx]
+            [device->mgs2_expanded_pool_pos];
+    if (*entry && *entry_size >= bytes)
+    {
+        *buffer = *entry;
+        return TRUE;
+    }
+
+    capacity = 4096;
+    while (capacity < bytes && capacity <= D3D8_MGS2_VBO_BATCH_MAX / 2)
+        capacity *= 2;
+    if (capacity < bytes)
+        return FALSE;
+
+    memset(&desc, 0, sizeof(desc));
+    desc.byte_width = capacity;
+    desc.usage = WINED3DUSAGE_DYNAMIC;
+    desc.bind_flags = WINED3D_BIND_VERTEX_BUFFER;
+    desc.access = WINED3D_RESOURCE_ACCESS_GPU;
+
+    if (*entry)
+        wined3d_buffer_decref(*entry);
+    *entry = NULL;
+    *entry_size = 0;
+    if (FAILED(wined3d_buffer_create(device->wined3d_device, &desc, NULL, NULL,
+            &d3d8_null_wined3d_parent_ops, entry)))
+        return FALSE;
+    *entry_size = capacity;
+    *buffer = *entry;
+    ++d3d8_mgs2_vbo_stats.creates;
+    return TRUE;
+}
+
+static void d3d8_mgs2_vbo_cleanup(struct d3d8_device *device)
+{
+    unsigned int i, j;
+
+    for (i = 0; i < D3D8_MGS2_VBO_FRAME_COUNT; ++i)
+    {
+        for (j = 0; j < D3D8_MGS2_VBO_BATCH_SLOTS; ++j)
+        {
+            if (device->mgs2_expanded_pool[i][j])
+                wined3d_buffer_decref(device->mgs2_expanded_pool[i][j]);
+            device->mgs2_expanded_pool[i][j] = NULL;
+            device->mgs2_expanded_pool_size[i][j] = 0;
+        }
+    }
+    free(device->mgs2_expanded_data);
+    device->mgs2_expanded_data = NULL;
+    device->mgs2_expanded_capacity = 0;
+    device->mgs2_expanded_pool_idx = 0;
+    device->mgs2_expanded_pool_pos = 0;
+    if (d3d8_mgs2_pending.expanded)
+        d3d8_mgs2_pending.count = 0;
+    d3d8_mgs2_pending.expanded = FALSE;
+}
+
+static BOOL d3d8_mgs2_vbo_source(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, unsigned int start_vertex, unsigned int vertex_count,
+        unsigned int *stream_idx, struct d3d8_vertexbuffer **buffer,
+        unsigned int *stride, unsigned int *left)
+{
+    const struct wined3d_stateblock_state *state = device->stateblock_state;
+    const struct wined3d_stream_state *stream;
+    struct d3d8_vertex_declaration *decl;
+    ULONGLONG offset, bytes;
+    unsigned int map;
+
+    if (primitive_type != D3DPT_TRIANGLESTRIP || vertex_count < 3 || !state->vertex_declaration)
+        return FALSE;
+    decl = wined3d_vertex_declaration_get_parent(state->vertex_declaration);
+    map = decl->stream_map;
+    if (!map || (map & (map - 1)))
+        return FALSE;
+    *stream_idx = wined3d_bit_scan(&map);
+    stream = &state->streams[*stream_idx];
+    if (!stream->buffer || !stream->stride || stream->flags || stream->frequency != 1)
+        return FALSE;
+    *buffer = wined3d_buffer_get_parent(stream->buffer);
+    if (!(*buffer)->mgs2_snapshot)
+        return FALSE;
+
+    offset = (ULONGLONG)stream->offset + (ULONGLONG)start_vertex * stream->stride;
+    bytes = (ULONGLONG)vertex_count * stream->stride;
+    if (offset > (*buffer)->mgs2_snapshot_size || bytes > (*buffer)->mgs2_snapshot_size - offset)
+        return FALSE;
+    *stride = stream->stride;
+    *left = offset;
+    return TRUE;
+}
+
+/* Copy a strip while its producer shadow is known to represent this draw.
+ * Delaying the copy until flush would race a later Lock that mutates the same
+ * shadow before the preceding draw packet reaches CSMT. */
+static BOOL d3d8_mgs2_vbo_append(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, unsigned int start_vertex, unsigned int vertex_count)
+{
+    struct d3d8_vertexbuffer *buffer;
+    unsigned int stream_idx, stride, left;
+    unsigned int expanded_vertices, bytes, needed, capacity, i;
+    const BYTE *src;
+    BYTE *data, *dst;
+
+    if (!d3d8_mgs2_vbo_expand()) return FALSE;
+    if (!d3d8_mgs2_vbo_source(device, primitive_type, start_vertex, vertex_count,
+            &stream_idx, &buffer, &stride, &left))
+    {
+        if (d3d8_mgs2_pending.expanded)
+            d3d8_mgs2_flush_pending(device);
+        return FALSE;
+    }
+
+    if (d3d8_mgs2_pending.count && (!d3d8_mgs2_pending.expanded
+            || d3d8_mgs2_pending.stream_idx != stream_idx
+            || d3d8_mgs2_pending.stride != stride))
+        d3d8_mgs2_flush_pending(device);
+
+    expanded_vertices = 3 * (vertex_count - 2);
+    if (expanded_vertices > ~0u / stride)
+        return FALSE;
+    bytes = expanded_vertices * stride;
+    if (bytes > D3D8_MGS2_VBO_BATCH_MAX
+            || d3d8_mgs2_pending.expanded_bytes > D3D8_MGS2_VBO_BATCH_MAX - bytes)
+    {
+        if (d3d8_mgs2_pending.expanded)
+            d3d8_mgs2_flush_pending(device);
+        ++d3d8_mgs2_vbo_stats.overflow;
+        return FALSE;
+    }
+
+    needed = d3d8_mgs2_pending.expanded_bytes + bytes;
+    if (needed > device->mgs2_expanded_capacity)
+    {
+        capacity = max(device->mgs2_expanded_capacity * 2, 256u * 1024u);
+        capacity = max(capacity, needed);
+        if (!(data = realloc(device->mgs2_expanded_data, capacity)))
+        {
+            if (d3d8_mgs2_pending.expanded)
+                d3d8_mgs2_flush_pending(device);
+            return FALSE;
+        }
+        device->mgs2_expanded_data = data;
+        device->mgs2_expanded_capacity = capacity;
+    }
+
+    src = buffer->mgs2_snapshot + left;
+    dst = device->mgs2_expanded_data + d3d8_mgs2_pending.expanded_bytes;
+    for (i = 0; i + 2 < vertex_count; ++i)
+    {
+        memcpy(dst, src + (i + (i & 1)) * stride, stride);
+        dst += stride;
+        memcpy(dst, src + (i + !(i & 1)) * stride, stride);
+        dst += stride;
+        memcpy(dst, src + (i + 2) * stride, stride);
+        dst += stride;
+    }
+
+    if (!d3d8_mgs2_pending.count)
+    {
+        d3d8_mgs2_pending.primitive_type = primitive_type;
+        d3d8_mgs2_pending.expanded = TRUE;
+        d3d8_mgs2_pending.stream_idx = stream_idx;
+        d3d8_mgs2_pending.stride = stride;
+        d3d8_mgs2_pending.expanded_vertices = 0;
+        d3d8_mgs2_pending.expanded_bytes = 0;
+    }
+    d3d8_mgs2_pending.starts[d3d8_mgs2_pending.count] = start_vertex;
+    d3d8_mgs2_pending.counts[d3d8_mgs2_pending.count] = vertex_count;
+    ++d3d8_mgs2_pending.count;
+    d3d8_mgs2_pending.expanded_vertices += expanded_vertices;
+    d3d8_mgs2_pending.expanded_bytes += bytes;
+    return TRUE;
+}
+
+static BOOL d3d8_mgs2_vbo_flush(struct d3d8_device *device)
+{
+    struct wined3d_stream_state original, stream;
+    struct wined3d_buffer *ring;
+    struct wined3d_resource *resource;
+    struct wined3d_box box;
+    unsigned int bytes;
+
+    if (!d3d8_mgs2_pending.expanded || !d3d8_mgs2_pending.count)
+        return FALSE;
+    bytes = d3d8_mgs2_pending.expanded_bytes;
+    if (!d3d8_mgs2_vbo_prepare_buffer(device, bytes, &ring))
+    {
+        ++d3d8_mgs2_vbo_stats.fallback;
+        return FALSE;
+    }
+
+    resource = wined3d_buffer_get_resource(ring);
+    wined3d_box_set(&box, 0, 0, bytes, 1, 0, 1);
+    wined3d_device_context_update_sub_resource(device->immediate_context,
+            resource, 0, &box, device->mgs2_expanded_data, bytes, bytes, 0);
+
+    original = device->stateblock_state->streams[d3d8_mgs2_pending.stream_idx];
+    stream = original;
+    stream.buffer = ring;
+    stream.offset = 0;
+    stream.stride = d3d8_mgs2_pending.stride;
+    if (FAILED(wined3d_device_context_set_stream_sources(device->immediate_context,
+            d3d8_mgs2_pending.stream_idx, 1, &stream)))
+    {
+        ++d3d8_mgs2_vbo_stats.fallback;
+        return FALSE;
+    }
+
+    d3d8_mgs2_set_primitive_type(device->immediate_context, D3DPT_TRIANGLELIST);
+    wined3d_device_context_draw(device->immediate_context,
+            0, d3d8_mgs2_pending.expanded_vertices, 0, 0);
+    wined3d_device_context_set_stream_sources(device->immediate_context,
+            d3d8_mgs2_pending.stream_idx, 1, &original);
+    d3d8_mgs2_set_primitive_type(device->immediate_context,
+            d3d8_mgs2_pending.primitive_type);
+
+    ++device->mgs2_expanded_pool_pos;
+    d3d8_mgs2_vbo_stats.draws += d3d8_mgs2_pending.count;
+    ++d3d8_mgs2_vbo_stats.batches;
+    d3d8_mgs2_vbo_stats.bytes += bytes;
+    return TRUE;
+}
+
+static void d3d8_mgs2_vbo_present(struct d3d8_device *device)
+{
+    DWORD now;
+
+    if (!d3d8_mgs2_vbo_expand()) return;
+    device->mgs2_expanded_pool_idx = (device->mgs2_expanded_pool_idx + 1)
+            % D3D8_MGS2_VBO_FRAME_COUNT;
+    device->mgs2_expanded_pool_pos = 0;
+    if (!d3d8_mgs2_vbo_stats_on()) return;
+    ++d3d8_mgs2_vbo_stats.frames;
+    now = GetTickCount();
+    if (now - d3d8_mgs2_vbo_stats.last_report < 1000) return;
+    fprintf(stderr, "MGS2VBO: frames=%u draws=%I64u batches=%I64u factor=%.2f "
+            "bytes=%I64uKB %.1fKB/f fallback=%I64u overflow=%I64u creates=%I64u\n",
+            d3d8_mgs2_vbo_stats.frames, d3d8_mgs2_vbo_stats.draws,
+            d3d8_mgs2_vbo_stats.batches,
+            d3d8_mgs2_vbo_stats.batches
+                    ? (double)d3d8_mgs2_vbo_stats.draws / d3d8_mgs2_vbo_stats.batches : 0.0,
+            d3d8_mgs2_vbo_stats.bytes / 1024,
+            d3d8_mgs2_vbo_stats.frames
+                    ? d3d8_mgs2_vbo_stats.bytes / 1024.0 / d3d8_mgs2_vbo_stats.frames : 0.0,
+            d3d8_mgs2_vbo_stats.fallback, d3d8_mgs2_vbo_stats.overflow,
+            d3d8_mgs2_vbo_stats.creates);
+    fflush(stderr);
+    memset(&d3d8_mgs2_vbo_stats, 0, sizeof(d3d8_mgs2_vbo_stats));
+    d3d8_mgs2_vbo_stats.last_report = now;
+}
+
+void d3d8_mgs2_flush_pending(struct d3d8_device *device)
+{
+    if (!d3d8_mgs2_producer() || !d3d8_mgs2_pending.count)
+        return;
+
+    if (!d3d8_mgs2_vbo_flush(device))
+        wined3d_device_context_draw_batch(device->immediate_context,
+                wined3d_primitive_type_from_d3d(d3d8_mgs2_pending.primitive_type), 0,
+                d3d8_mgs2_pending.starts, d3d8_mgs2_pending.counts,
+                d3d8_mgs2_pending.count);
+    d3d8_mgs2_pending.count = 0;
+    d3d8_mgs2_pending.expanded = FALSE;
+    d3d8_mgs2_pending.expanded_vertices = 0;
+    d3d8_mgs2_pending.expanded_bytes = 0;
+}
+
+static double d3d8_mgs2_now_ms(void)
+{
+    static LARGE_INTEGER frequency;
+    LARGE_INTEGER counter;
+
+    if (!frequency.QuadPart)
+        QueryPerformanceFrequency(&frequency);
+    QueryPerformanceCounter(&counter);
+    return frequency.QuadPart ? counter.QuadPart * 1000.0 / frequency.QuadPart : 0.0;
+}
 
