+static void mgs2_batch_report(void)
+{
+    static DWORD last;
+    DWORD now = GetTickCount();
+    DWORD elapsed;
+
+    if (!mgs2_batch_stats_enabled()) return;
+
+    if (!last)
+    {
+        last = now;
+        mgs2_batch.flush_present = 0;
+        return;
+    }
+    if (now - last < 1000) return;
+    elapsed = now - last;
+    last = now;
+    mgs2_batch_hashcache_enabled();
+    mgs2_batch_skip_draw_enabled();
+    mgs2_batch_poll_switch("Z:\\tmp\\mgs2-batch-hashcache", "hashcache",
+            &mgs2_batch_hashcache_state);
+    mgs2_batch_poll_switch("Z:\\tmp\\mgs2-batch-skip-draw", "skip-draw",
+            &mgs2_batch_skip_draw_state);
+    fprintf(stderr, "MGS2BATCH: frames=%u fps=%u.%02u draws=%u batches=%u factor=%u.%02u idx=%uKB | "
+            "flush total=%u dirty=%u incompat=%u full=%u\n",
+            mgs2_batch.flush_present,
+            (unsigned int)(mgs2_batch.flush_present * 1000 / elapsed),
+            (unsigned int)(mgs2_batch.flush_present * 100000 / elapsed) % 100,
+            mgs2_batch.draws_in, mgs2_batch.batches_out,
+            mgs2_batch.batches_out ? mgs2_batch.draws_in / mgs2_batch.batches_out : 0,
+            mgs2_batch.batches_out ? (mgs2_batch.draws_in * 100 / mgs2_batch.batches_out) % 100 : 0,
+            mgs2_batch.idx_bytes / 1024,
+            mgs2_batch_flush_barrier, mgs2_batch.flush_dirty,
+            mgs2_batch.flush_incompat, mgs2_batch.flush_full);
+    if (mgs2_batch_profile_enabled())
+        fprintf(stderr, "MGS2BATCHPROFILE: build=%.2fms upload=%.2fms draw=%.2fms\n",
+                mgs2_batch.build_ms, mgs2_batch.upload_ms, mgs2_batch.draw_ms);
+    fprintf(stderr, "MGS2CACHE: hits=%u fast=%u slow=%u probes=%u misses=%u evict=%u "
+            "entries=%u bytes=%uKB fallback=%u arena=%u reset=%u triangles=%u degen=%u hash=%u skip=%u\n",
+            mgs2_batch.cache_hits, mgs2_batch.cache_fast_hits, mgs2_batch.cache_slow_hits,
+            mgs2_batch.cache_probes, mgs2_batch.cache_misses,
+            mgs2_batch_cache_evictions, mgs2_batch_cache_count,
+            mgs2_batch_cache_bytes / 1024, mgs2_batch.cache_fallback,
+            mgs2_batch_ebo_arena_enabled(), mgs2_batch.arena_resets, mgs2_batch_triangles_enabled(),
+            mgs2_batch_degenerate_strips_enabled(),
+            mgs2_batch_hashcache_enabled(), mgs2_batch_skip_draw_enabled());
+    fflush(stderr);
+    mgs2_batch.draws_in = mgs2_batch.batches_out = 0;
+    mgs2_batch.flush_dirty = mgs2_batch.flush_incompat = 0;
+    mgs2_batch.flush_present = mgs2_batch.flush_full = 0;
+    mgs2_batch_flush_barrier = 0;
+    mgs2_batch.idx_bytes = 0;
+    mgs2_batch.build_ms = mgs2_batch.upload_ms = mgs2_batch.draw_ms = 0.0;
+    mgs2_batch.cache_hits = mgs2_batch.cache_misses = mgs2_batch.cache_fallback = 0;
+    mgs2_batch.cache_fast_hits = mgs2_batch.cache_slow_hits = mgs2_batch.cache_probes = 0;
+    mgs2_batch.arena_resets = 0;
+    mgs2_batch_cache_evictions = 0;
+}
+
+static unsigned int mgs2_batch_hash_mix(unsigned int hash, unsigned int value)
+{
+    hash ^= value;
+    return hash * 16777619u;
+}
+
+static unsigned int mgs2_batch_hash(GLenum mode, GLenum index_type, BOOL degenerate_strips,
+        unsigned int segment_count, const unsigned int *first, const unsigned int *count)
+{
+    unsigned int i, hash = 2166136261u;
+
+    hash = mgs2_batch_hash_mix(hash, mode);
+    hash = mgs2_batch_hash_mix(hash, index_type);
+    hash = mgs2_batch_hash_mix(hash, degenerate_strips);
+    hash = mgs2_batch_hash_mix(hash, segment_count);
+    for (i = 0; i < segment_count; ++i)
+    {
+        hash = mgs2_batch_hash_mix(hash, first[i]);
+        hash = mgs2_batch_hash_mix(hash, count[i]);
+    }
+    return hash;
+}
+
+static struct mgs2_batch_cache_entry *mgs2_batch_cache_find(
+        struct wined3d_context_gl *context_gl, GLenum mode, GLenum index_type,
+        BOOL degenerate_strips, unsigned int segment_count, unsigned int hash,
+        const unsigned int *first, const unsigned int *count)
+{
+    unsigned int i, j, set = hash & (MGS2_BATCH_CACHE_SETS - 1);
+
+    /* A cache miss was followed by a linear scan of every retained batch.
+     * Heavy combat built ~1300 signatures and turned that cold path into the
+     * visible freeze. Restrict lookup to four candidates in the hash set. */
+    for (i = 0; i < MGS2_BATCH_CACHE_WAYS; ++i)
+    {
+        struct mgs2_batch_cache_entry *entry = &mgs2_batch_cache[
+                set * MGS2_BATCH_CACHE_WAYS + i];
+
+        if (!entry->context_gl) continue;
+
+        ++mgs2_batch.cache_probes;
+
+        if (entry->context_gl != context_gl || entry->hash != hash
+                || entry->mode != mode || entry->index_type != index_type
+                || entry->degenerate_strips != degenerate_strips || entry->segment_count != segment_count)
+            continue;
+        for (j = 0; j < segment_count; ++j)
+            if (entry->first[j] != first[j] || entry->count[j] != count[j])
+                break;
+        if (j == segment_count)
+        {
+            if (i) ++mgs2_batch.cache_slow_hits;
+            else ++mgs2_batch.cache_fast_hits;
+            entry->age = ++mgs2_batch_cache_clock;
+            return entry;
+        }
+    }
+    return NULL;
+}
+
+static void mgs2_batch_cache_remove(struct mgs2_batch_cache_entry *entry,
+        const struct wined3d_gl_info *gl_info)
+{
+    if (!entry->context_gl) return;
+
+    if (!entry->arena) GL_EXTCALL(glDeleteBuffers(1, &entry->bo));
+    free(entry->first);
+    free(entry->count);
+    mgs2_batch_cache_bytes -= entry->bytes;
+    ++mgs2_batch_cache_evictions;
+    --mgs2_batch_cache_count;
+    memset(entry, 0, sizeof(*entry));
+}
+
+static void mgs2_batch_cache_cancel(struct mgs2_batch_cache_entry *entry)
+{
+    assert(!entry->context_gl);
+    --mgs2_batch_cache_count;
+    memset(entry, 0, sizeof(*entry));
+}
+
+/* A set may only evict buffers created by this GL context.  A set occupied by
+ * another context falls back to ordinary draws instead of deleting a foreign
+ * context's name. */
+static struct mgs2_batch_cache_entry *mgs2_batch_cache_make_room(
+        struct wined3d_context_gl *context_gl, const struct wined3d_gl_info *gl_info,
+        unsigned int bytes, unsigned int hash)
+{
+    struct mgs2_batch_cache_entry *entry, *victim;
+    unsigned int i, set = hash & (MGS2_BATCH_CACHE_SETS - 1);
+
+    while (mgs2_batch_cache_bytes + bytes > MGS2_BATCH_CACHE_BYTES)
+    {
+        victim = NULL;
+        for (i = 0; i < MGS2_BATCH_CACHE_WAYS; ++i)
+        {
+            entry = &mgs2_batch_cache[set * MGS2_BATCH_CACHE_WAYS + i];
+            if (entry->context_gl == context_gl && (!victim || entry->age < victim->age))
+                victim = entry;
+        }
+        if (!victim)
+            return NULL;
+        mgs2_batch_cache_remove(victim, gl_info);
+    }
+
+    victim = NULL;
+    for (i = 0; i < MGS2_BATCH_CACHE_WAYS; ++i)
+    {
+        entry = &mgs2_batch_cache[set * MGS2_BATCH_CACHE_WAYS + i];
+        if (!entry->context_gl)
+        {
+            ++mgs2_batch_cache_count;
+            return entry;
+        }
+        if (entry->context_gl == context_gl && (!victim || entry->age < victim->age))
+            victim = entry;
+    }
+    if (!victim) return NULL;
+
+    mgs2_batch_cache_remove(victim, gl_info);
+    ++mgs2_batch_cache_count;
+    return victim;
+}
+
+static void mgs2_batch_cache_purge_context(struct wined3d_context_gl *context_gl)
+{
+    unsigned int i;
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+
+    for (i = 0; i < MGS2_BATCH_CACHE_ENTRIES; ++i)
+    {
+        struct mgs2_batch_cache_entry *entry = &mgs2_batch_cache[i];
+
+        if (entry->context_gl == context_gl)
+            mgs2_batch_cache_remove(entry, gl_info);
+    }
+}
+
+static struct mgs2_batch_arena *mgs2_batch_arena_get(
+        struct wined3d_context_gl *context_gl, const struct wined3d_gl_info *gl_info)
+{
+    struct mgs2_batch_arena *free_arena = NULL;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(mgs2_batch_arenas); ++i)
+    {
+        struct mgs2_batch_arena *arena = &mgs2_batch_arenas[i];
+
+        if (arena->context_gl == context_gl)
+            return arena;
+        if (!arena->context_gl && !free_arena)
+            free_arena = arena;
+    }
+    if (!free_arena)
+        return NULL;
+
+    GL_EXTCALL(glGenBuffers(1, &free_arena->bo));
+    if (!free_arena->bo)
+        return NULL;
+    wined3d_context_gl_bind_bo(context_gl, GL_ELEMENT_ARRAY_BUFFER, free_arena->bo);
+    GL_EXTCALL(glBufferData(GL_ELEMENT_ARRAY_BUFFER, MGS2_BATCH_ARENA_BYTES,
+            NULL, GL_STATIC_DRAW));
+    free_arena->context_gl = context_gl;
+    free_arena->used = 0;
+    return free_arena;
+}
+
+static struct mgs2_batch_cache_entry *mgs2_batch_arena_make_room(
+        struct wined3d_context_gl *context_gl, const struct wined3d_gl_info *gl_info,
+        unsigned int bytes, unsigned int hash)
+{
+    struct mgs2_batch_cache_entry *entry;
+    struct mgs2_batch_arena *arena;
+    unsigned int aligned;
+
+    if (bytes > MGS2_BATCH_ARENA_BYTES
+            || !(arena = mgs2_batch_arena_get(context_gl, gl_info)))
+        return NULL;
+
+    aligned = (arena->used + 3) & ~3u;
+    if (aligned + bytes > MGS2_BATCH_ARENA_BYTES)
+    {
+        /* Orphaning is safe with queued draws: GL keeps the old store alive for
+         * commands that already reference it. Only this context's signatures
+         * point into the replaced store, so other arenas remain valid. */
+        mgs2_batch_cache_purge_context(context_gl);
+        wined3d_context_gl_bind_bo(context_gl, GL_ELEMENT_ARRAY_BUFFER, arena->bo);
+        GL_EXTCALL(glBufferData(GL_ELEMENT_ARRAY_BUFFER, MGS2_BATCH_ARENA_BYTES,
+                NULL, GL_STATIC_DRAW));
+        arena->used = 0;
+        aligned = 0;
+        ++mgs2_batch.arena_resets;
+    }
+
+    if (!(entry = mgs2_batch_cache_make_room(context_gl, gl_info, bytes, hash)))
+        return NULL;
+
+    arena->used = aligned + bytes;
+    entry->bo = arena->bo;
+    entry->offset = aligned;
+    entry->arena = TRUE;
+    return entry;
+}
+
+/* Issues the accumulated run as one indexed draw. GL state is whatever the pending
+ * draws were issued under -- callers must guarantee that. */
+void mgs2_batch_flush(void)
+{
+    static void *buf;
+    static unsigned int buf_size;
+    struct wined3d_context_gl *context_gl = mgs2_batch.context_gl;
+    struct mgs2_batch_cache_entry *entry;
+    const struct wined3d_gl_info *gl_info;
+    unsigned int i, j, total, bytes, stride, hash;
+    GLenum draw_mode;
+    BOOL use16, triangles, degenerate_strips, skip_draw;
+    double t = 0.0;
+    BOOL profile;
+
+    if (!mgs2_batch.n || !context_gl)
+        return;
+    ++mgs2_batch_flush_barrier;
+    gl_info = context_gl->gl_info;
+    profile = mgs2_batch_profile_enabled();
+    skip_draw = mgs2_batch_skip_draw_enabled();
+
+    /* One draw is not worth an index buffer: issue it the ordinary way. */
+    if (mgs2_batch.n == 1)
+    {
+        if (!skip_draw)
+            gl_info->gl_ops.gl.p_glDrawArrays(mgs2_batch.mode,
+                    mgs2_batch.first[0], mgs2_batch.count[0]);
+        ++mgs2_batch.batches_out;
+        mgs2_batch.n = 0;
+        mgs2_batch.max_index = 0;
+        return;
+    }
+
+    /* restart index must not be a legal vertex index in this batch */
+    use16 = mgs2_batch.max_index < 0xffff;
+    stride = use16 ? 2 : 4;
+    triangles = mgs2_batch_triangles_enabled();
+    degenerate_strips = !triangles && mgs2_batch_degenerate_strips_enabled();
+    draw_mode = triangles ? GL_TRIANGLES : mgs2_batch.mode;
+    hash = mgs2_batch_hash(draw_mode, use16 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, degenerate_strips,
+            mgs2_batch.n, mgs2_batch.first, mgs2_batch.count);
+
+    /* A preceding restart batch may have hoisted the enable across draws. The
+     * degenerate representation must not inherit that unrelated state. */
+    if (degenerate_strips && mgs2_batch.restart_enabled
+            && mgs2_batch.restart_context == context_gl)
+        mgs2_batch_restart_end(context_gl, gl_info);
+
+    total = 0;
+    if (profile) t = mgs2_batch_now_ms();
