+    if (!buffer || !buffer->mgs2_snapshot_dirty) return;
+    buffer->mgs2_snapshot_dirty = FALSE;
+    for (i = 0; i < buffer->mgs2_snapshot_dirty_count; ++i)
+    {
+        box.left = buffer->mgs2_snapshot_dirty_ranges[i].left;
+        box.right = buffer->mgs2_snapshot_dirty_ranges[i].right;
+        size = box.right - box.left;
+        wined3d_device_context_update_sub_resource(buffer->mgs2_context,
+                wined3d_buffer_get_resource(buffer->wined3d_buffer), 0, &box,
+                buffer->mgs2_snapshot + box.left, size, size, 0);
+        d3d8_mgs2_vb_census_upload(size);
+    }
+    buffer->mgs2_snapshot_dirty_count = 0;
