+/* ---------------------------------------------------------------------------
+ * MGS2 draw batching.
+ *
+ * Rung D measured that the entire 52.75 ms of renderer cost in heavy Plant is the
+ * glDraw* calls and their submission to the Mali driver -- state application, the
+ * resource walk and the whole CSMT transport are free. The census on the same spot
+ * measured 12014 draws/s in 1415 conservative batches, i.e. runs averaging 8.5
+ * draws, 96% of draws in runs of two or more, all of them NON-indexed
+ * TRIANGLESTRIP, 91% covering vertex ranges that continue exactly where the
+ * previous draw ended.
+ *
+ * So: merge a run of non-indexed strips into ONE indexed draw, with
+ * GL_PRIMITIVE_RESTART_FIXED_INDEX separating the strips. glMultiDrawArrays and
+ * glMultiDrawElementsIndirect are both absent on this blob, checked on the live
+ * context, so this is the only mechanism available. It was proved to work first:
+ * glEnable(GL_PRIMITIVE_RESTART_FIXED_INDEX) and the indexed draw both return
+ * GL_NO_ERROR here, even though wined3d believes ARB_ES3_COMPATIBILITY is missing,
+ * because on a real GLES 3.x context the token is core.
+ *
+ * Correctness rests on three things:
+ *   the batch is flushed BEFORE context_apply_draw_state whenever any graphics
+ *   state is dirty, so a run can never be merged across a state change -- at that
+ *   moment GL still holds exactly the state the pending draws were issued under;
+ *   it is flushed on present, or the last run of a frame would be drawn into the
+ *   next one;
+ *   0xFFFF (or 0xFFFFFFFF) is safe as the restart index only because the census
+ *   proved this game issues no indexed draws at all in this scene, so it cannot
+ *   collide with a real index. If an indexed draw appears, the batch is flushed and
+ *   that draw runs normally.
+ *
+ * MGS2_BATCH=1. Off by default. MGS2_BATCH_MAX caps a run (default 256).
+ * --------------------------------------------------------------------------- */
+#define MGS2_BATCH_SLOTS 512
+#define MGS2_BATCH_CACHE_SETS 1024
+#define MGS2_BATCH_CACHE_WAYS 4
+#define MGS2_BATCH_CACHE_ENTRIES (MGS2_BATCH_CACHE_SETS * MGS2_BATCH_CACHE_WAYS)
+#define MGS2_BATCH_CACHE_BYTES (8 * 1024 * 1024)
+#define MGS2_BATCH_ARENA_CONTEXTS 2
+#define MGS2_BATCH_ARENA_BYTES (4 * 1024 * 1024)
+
+static struct
+{
+    struct wined3d_context_gl *context_gl;
+    GLenum mode;
+    unsigned int first[MGS2_BATCH_SLOTS];
+    unsigned int count[MGS2_BATCH_SLOTS];
+    unsigned int n;
+    unsigned int max_index;
+    /* counters, one line per second, never per draw */
+    unsigned int draws_in, batches_out, flush_dirty, flush_incompat, flush_present, flush_full;
+    unsigned int idx_bytes;
+    /* Opt-in microprofile for the synthetic EBO path, accumulated per second. */
+    double build_ms, upload_ms, draw_ms;
+    unsigned int cache_hits, cache_misses, cache_fallback;
+    unsigned int cache_fast_hits, cache_slow_hits, cache_probes;
+    unsigned int arena_resets;
+    /* Opt-in experiment: keep restart enabled across synthetic batches. */
+    struct wined3d_context_gl *restart_context;
+    BOOL restart_enabled;
+} mgs2_batch;
+
+struct mgs2_batch_cache_entry
+{
+    struct wined3d_context_gl *context_gl;
