+static void mgs2_cs_profile_map_resource(const struct wined3d_resource *resource, unsigned int flags)
+{
+    unsigned int bind, access, rw;
+
+    if (!mgs2_cs_profile_enabled())
+        return;
+
+    if (resource->type == WINED3D_RTYPE_BUFFER)
+    {
+        if (resource->bind_flags & WINED3D_BIND_VERTEX_BUFFER)
+            bind = 0;
+        else if (resource->bind_flags & WINED3D_BIND_INDEX_BUFFER)
+            bind = 1;
+        else
+            bind = 2;
+    }
+    else if (resource->bind_flags & (WINED3D_BIND_RENDER_TARGET | WINED3D_BIND_DEPTH_STENCIL))
+        bind = 4;
+    else
+        bind = 3;
+
+    if (resource->access & WINED3D_RESOURCE_ACCESS_GPU)
+        access = resource->access & WINED3D_RESOURCE_ACCESS_CPU ? 2 : 0;
+    else
