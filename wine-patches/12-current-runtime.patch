+/* dmime makes one synth port serve every MGS2 AudioPath when shared groups are
+ * enabled.  The game can deactivate the port while leaving another AudioPath
+ * ready to submit MIDI; that formerly made the next gameplay SFX silently go
+ * to an inactive synth until the whole audio graph was rebuilt. */
+static BOOL mgs2_shared_port_autorevive(void)
+{
+    static int enabled = -1;
+    char value[8];
+    DWORD len;
+
+    if (enabled != -1) return enabled;
+    len = GetEnvironmentVariableA("MGS2_DMIME_SHAREDGROUPS", value, sizeof(value));
+    enabled = len && len < sizeof(value) && value[0] != '0';
+    return enabled;
+}
