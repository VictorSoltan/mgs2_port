+static void mgs2_batch_restart_begin(struct wined3d_context_gl *context_gl,
+        const struct wined3d_gl_info *gl_info)
+{
+    if (mgs2_batch_restart_hoist_enabled()
+            && mgs2_batch.restart_enabled && mgs2_batch.restart_context == context_gl)
+        return;
+
+    gl_info->gl_ops.gl.p_glEnable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+    if (mgs2_batch_restart_hoist_enabled())
+    {
+        mgs2_batch.restart_context = context_gl;
+        mgs2_batch.restart_enabled = TRUE;
+    }
+}
+
+static void mgs2_batch_restart_end(struct wined3d_context_gl *context_gl,
+        const struct wined3d_gl_info *gl_info)
+{
+    if (!mgs2_batch_restart_hoist_enabled()
+            || (mgs2_batch.restart_enabled && mgs2_batch.restart_context == context_gl))
+    {
+        gl_info->gl_ops.gl.p_glDisable(GL_PRIMITIVE_RESTART_FIXED_INDEX);
+        if (mgs2_batch.restart_context == context_gl)
+        {
+            mgs2_batch.restart_context = NULL;
+            mgs2_batch.restart_enabled = FALSE;
+        }
+    }
+}
