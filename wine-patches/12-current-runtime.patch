+static void d3d8_vertexbuffer_remove_dirty_range(struct d3d8_vertexbuffer *buffer, unsigned int index)
+{
+    memmove(&buffer->mgs2_snapshot_dirty_ranges[index],
+            &buffer->mgs2_snapshot_dirty_ranges[index + 1],
+            (buffer->mgs2_snapshot_dirty_count - index - 1)
+            * sizeof(buffer->mgs2_snapshot_dirty_ranges[0]));
+    --buffer->mgs2_snapshot_dirty_count;
+}
