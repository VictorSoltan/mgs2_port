+static void d3d8_vertexbuffer_merge_nearest_dirty_ranges(struct d3d8_vertexbuffer *buffer)
+{
+    unsigned int i, best = 0, gap, best_gap = ~0u;
+
+    for (i = 0; i + 1 < buffer->mgs2_snapshot_dirty_count; ++i)
+    {
+        gap = buffer->mgs2_snapshot_dirty_ranges[i + 1].left
+                - buffer->mgs2_snapshot_dirty_ranges[i].right;
+        if (gap < best_gap)
+        {
+            best = i;
+            best_gap = gap;
+        }
+    }
+    buffer->mgs2_snapshot_dirty_ranges[best].right
+            = buffer->mgs2_snapshot_dirty_ranges[best + 1].right;
+    d3d8_vertexbuffer_remove_dirty_range(buffer, best + 1);
