+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, old_pack_alignment);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, old_pack_row_length);
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, old_pack_buffer));
+    gl_info->fbo_ops.glDeleteFramebuffers(1, &fbo);
+    checkGLcall("MGS2 GPU alpha readback");
+
+    fprintf(f, "seq=%u tex=%p gl=%u srgb=%u status=%#x alpha=%u/%g/%u zero=%u full=%u other=%u\n",
+            seq, texture, gl_texture->name, srgb, status, alpha_min,
+            status == GL_FRAMEBUFFER_COMPLETE ? (double)alpha_sum / pixel_count : -1.0,
+            alpha_max, alpha_zero, alpha_full, alpha_other);
+    fflush(f);
+    free(pixels);
+}
