+static void mgs_log_effect_draw(const struct wined3d_state *state,
+        const struct wined3d_draw_parameters *parameters, bool line, bool srcalpha_one)
+{
+    const struct wined3d_shader_resource_view *view[3];
+    const struct wined3d_blend_state *blend_state;
+    const struct wined3d_rendertarget_blend_state_desc *rt = NULL;
+    const struct wined3d_viewport *vp = NULL;
+    struct wined3d_resource *resource[3] = {NULL, NULL, NULL};
+    unsigned int all_after, i;
+    static FILE *f;
+
+    ++mgs_draw_id;
+    all_after = mgs_effect_log_all_after();
+    if (!mgs_effect_log_enabled()
+            || (!line && !srcalpha_one && (!all_after || mgs_draw_id < all_after)))
+        return;
+    if (!f && !(f = fopen("/tmp/mgseffect.log", "w")))
+        return;
+
+    for (i = 0; i < ARRAY_SIZE(view); ++i)
+    {
+        view[i] = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][i];
+        if (view[i])
+            resource[i] = view[i]->resource;
+    }
+    if (state->viewport_count)
+        vp = &state->viewports[0];
+    blend_state = state->blend_state;
+    if (blend_state)
+        rt = &blend_state->desc.rt[0];
+
+    fprintf(f, "draw=%u prim=%s indexed=%u count=%u line=%u add=%u "
+            "vp=%.0f,%.0f/%.0fx%.0f blend=%u/%u/%u/%u "
+            "tex0=%p/%s/%ux%u tex1=%p/%s/%ux%u tex2=%p/%s/%ux%u "
+            "tss0=%u/%u/%#x/%#x/%#x/%#x tss1=%u/%u/%#x/%#x/%#x/%#x "
+            "tss2=%u/%u/%#x/%#x/%#x/%#x vs=%p ps=%p "
+            "atest=%u afunc=%u aref=%u z=%u zwrite=%u\n",
+            mgs_draw_id, debug_d3dprimitivetype(state->primitive_type), parameters->indexed,
+            parameters->indirect ? 0 : parameters->u.direct.index_count, line, srcalpha_one,
+            vp ? vp->x : 0.0f, vp ? vp->y : 0.0f,
+            vp ? vp->width : 0.0f, vp ? vp->height : 0.0f,
+            rt ? rt->enable : 0, rt ? rt->src : 0, rt ? rt->dst : 0, rt ? rt->op : 0,
+            resource[0], resource[0] ? debug_d3dformat(resource[0]->format->id) : "none",
+            resource[0] ? resource[0]->width : 0, resource[0] ? resource[0]->height : 0,
+            resource[1], resource[1] ? debug_d3dformat(resource[1]->format->id) : "none",
+            resource[1] ? resource[1]->width : 0, resource[1] ? resource[1]->height : 0,
+            resource[2], resource[2] ? debug_d3dformat(resource[2]->format->id) : "none",
+            resource[2] ? resource[2]->width : 0, resource[2] ? resource[2]->height : 0,
+            state->texture_states[0][WINED3D_TSS_COLOR_OP], state->texture_states[0][WINED3D_TSS_ALPHA_OP],
+            state->texture_states[0][WINED3D_TSS_COLOR_ARG1], state->texture_states[0][WINED3D_TSS_COLOR_ARG2],
+            state->texture_states[0][WINED3D_TSS_ALPHA_ARG1], state->texture_states[0][WINED3D_TSS_ALPHA_ARG2],
+            state->texture_states[1][WINED3D_TSS_COLOR_OP], state->texture_states[1][WINED3D_TSS_ALPHA_OP],
+            state->texture_states[1][WINED3D_TSS_COLOR_ARG1], state->texture_states[1][WINED3D_TSS_COLOR_ARG2],
+            state->texture_states[1][WINED3D_TSS_ALPHA_ARG1], state->texture_states[1][WINED3D_TSS_ALPHA_ARG2],
+            state->texture_states[2][WINED3D_TSS_COLOR_OP], state->texture_states[2][WINED3D_TSS_ALPHA_OP],
+            state->texture_states[2][WINED3D_TSS_COLOR_ARG1], state->texture_states[2][WINED3D_TSS_COLOR_ARG2],
+            state->texture_states[2][WINED3D_TSS_ALPHA_ARG1], state->texture_states[2][WINED3D_TSS_ALPHA_ARG2],
+            state->shader[WINED3D_SHADER_TYPE_VERTEX], state->shader[WINED3D_SHADER_TYPE_PIXEL],
+            state->render_states[WINED3D_RS_ALPHATESTENABLE],
+            state->render_states[WINED3D_RS_ALPHAFUNC], state->render_states[WINED3D_RS_ALPHAREF],
+            state->render_states[WINED3D_RS_ZENABLE], state->render_states[WINED3D_RS_ZWRITEENABLE]);
+    fflush(f);
+}
