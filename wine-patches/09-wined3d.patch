+/* The state record for the white-effect draws listed blend factors and the
+ * equation, but never glIsEnabled(GL_BLEND) -- and correct factors stay stored
+ * while blending is switched off. The alpha probe has since shown the shader
+ * emits properly fractional alpha (0.04-0.63) for exactly these draws, so the
+ * fragments are right and the compositing is not. Read the real GL state at the
+ * draw rather than the state we believe we set. Logged once. */
+static void mgs_report_blend_state(const struct wined3d_gl_info *gl_info,
+        struct wined3d_context_gl *context_gl)
+{
+    static int done;
+    GLint src_rgb = 0, dst_rgb = 0, src_a = 0, dst_a = 0, eq_rgb = 0, eq_a = 0;
+    GLint fbo = 0, attach_type = 0, red = 0, alpha = 0, encoding = 0;
+    GLboolean mask[4] = {0, 0, 0, 0};
+    GLboolean enabled;
+    FILE *f;
+
+    if (done)
+        return;
+    done = 1;
+
+    enabled = gl_info->gl_ops.gl.p_glIsEnabled(GL_BLEND);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_SRC_RGB, &src_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_DST_RGB, &dst_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_SRC_ALPHA, &src_a);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_DST_ALPHA, &dst_a);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_EQUATION_RGB, &eq_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &eq_a);
+    gl_info->gl_ops.gl.p_glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &fbo);
+    GL_EXTCALL(glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+            GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &attach_type));
+    GL_EXTCALL(glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+            GL_FRAMEBUFFER_ATTACHMENT_RED_SIZE, &red));
+    GL_EXTCALL(glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+            GL_FRAMEBUFFER_ATTACHMENT_ALPHA_SIZE, &alpha));
+    GL_EXTCALL(glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+            GL_FRAMEBUFFER_ATTACHMENT_COLOR_ENCODING, &encoding));
+
+    if (!(f = fopen("/tmp/mgsblend.log", "w")))
+        return;
+    fprintf(f, "GL_BLEND enabled      = %d\n", enabled);
+    fprintf(f, "src_rgb=%#x dst_rgb=%#x src_alpha=%#x dst_alpha=%#x\n", src_rgb, dst_rgb, src_a, dst_a);
+    fprintf(f, "equation rgb=%#x alpha=%#x\n", eq_rgb, eq_a);
+    fprintf(f, "colour write mask     = %d %d %d %d\n", mask[0], mask[1], mask[2], mask[3]);
+    fprintf(f, "draw framebuffer      = %d\n", fbo);
+    fprintf(f, "attachment0 type=%#x red_bits=%d alpha_bits=%d encoding=%#x\n",
+            attach_type, red, alpha, encoding);
+    fclose(f);
+}
