+
+static BOOL mgs_depth_clear_init(const struct wined3d_gl_info *gl_info, struct mgs_depth_clear *dc)
+{
+    static const char vs_src[] =
+        "#version 300 es\n"
+        "in vec2 pos;\n"
+        "uniform float z;\n"
+        "void main() { gl_Position = vec4(pos, z, 1.0); }\n";
+    static const char fs_src[] =
+        "#version 300 es\n"
+        "precision highp float;\n"
+        "void main() {}\n";
+    static const GLfloat quad[] = {-1.0f, -1.0f, 1.0f, -1.0f, -1.0f, 1.0f, 1.0f, 1.0f};
+    GLuint vs, fs;
+    GLint ok = 0;
+
+    if (dc->program || dc->failed)
+        return !dc->failed;
+
+    vs = GL_EXTCALL(glCreateShader(GL_VERTEX_SHADER));
+    fs = GL_EXTCALL(glCreateShader(GL_FRAGMENT_SHADER));
+    if (!vs || !fs)
+    {
+        ERR("Could not create the depth-clear shaders.\n");
+        dc->failed = TRUE;
+        return FALSE;
+    }
+    {
+        const char *sources[1];
+        GLint compiled;
+
+        sources[0] = vs_src;
+        GL_EXTCALL(glShaderSource(vs, 1, sources, NULL));
+        GL_EXTCALL(glCompileShader(vs));
+        GL_EXTCALL(glGetShaderiv(vs, GL_COMPILE_STATUS, &compiled));
+        if (!compiled)
+            ERR("Depth-clear vertex shader did not compile.\n");
+
+        sources[0] = fs_src;
+        GL_EXTCALL(glShaderSource(fs, 1, sources, NULL));
+        GL_EXTCALL(glCompileShader(fs));
+        GL_EXTCALL(glGetShaderiv(fs, GL_COMPILE_STATUS, &compiled));
+        if (!compiled)
+            ERR("Depth-clear fragment shader did not compile.\n");
+    }
+
+    dc->program = GL_EXTCALL(glCreateProgram());
+    GL_EXTCALL(glAttachShader(dc->program, vs));
+    GL_EXTCALL(glAttachShader(dc->program, fs));
+    GL_EXTCALL(glBindAttribLocation(dc->program, 0, "pos"));
+    GL_EXTCALL(glLinkProgram(dc->program));
+    GL_EXTCALL(glGetProgramiv(dc->program, GL_LINK_STATUS, &ok));
+    GL_EXTCALL(glDeleteShader(vs));
+    GL_EXTCALL(glDeleteShader(fs));
+    if (!ok)
+    {
+        ERR("Could not link the depth-clear program.\n");
+        dc->failed = TRUE;
+        return FALSE;
+    }
+    dc->z_location = GL_EXTCALL(glGetUniformLocation(dc->program, "z"));
+
+    GL_EXTCALL(glGenVertexArrays(1, &dc->vao));
+    GL_EXTCALL(glBindVertexArray(dc->vao));
+    GL_EXTCALL(glGenBuffers(1, &dc->vbo));
+    GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, dc->vbo));
+    GL_EXTCALL(glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW));
+    GL_EXTCALL(glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 0, NULL));
+    GL_EXTCALL(glEnableVertexAttribArray(0));
+    GL_EXTCALL(glBindVertexArray(0));
+    GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, 0));
+
+    checkGLcall("depth-clear program setup");
+    return TRUE;
+}
+
+static void mgs_gles_clear_depth(struct wined3d_context_gl *context_gl, float depth)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    static struct mgs_depth_clear dc;
+
+    if (!mgs_depth_clear_init(gl_info, &dc))
+        return;
+
+    /* The caller has already set glDepthMask(GL_TRUE) and configured scissor
+     * for the requested clear rectangles; leave both alone so the emulated
+     * clear is scissored exactly like a real one. */
+    gl_info->gl_ops.gl.p_glDisable(GL_CULL_FACE);
+    gl_info->gl_ops.gl.p_glDisable(GL_BLEND);
+    gl_info->gl_ops.gl.p_glDisable(GL_STENCIL_TEST);
+    gl_info->gl_ops.gl.p_glEnable(GL_DEPTH_TEST);
+    gl_info->gl_ops.gl.p_glDepthFunc(GL_ALWAYS);
+    gl_info->gl_ops.gl.p_glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+
+    GL_EXTCALL(glUseProgram(dc.program));
+    GL_EXTCALL(glUniform1f(dc.z_location, depth * 2.0f - 1.0f));
+    GL_EXTCALL(glBindVertexArray(dc.vao));
+    gl_info->gl_ops.gl.p_glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    GL_EXTCALL(glBindVertexArray(0));
+    GL_EXTCALL(glUseProgram(0));
+    checkGLcall("emulated depth clear");
+
+    /* Everything touched above is wined3d-managed state. */
+    context_invalidate_state(&context_gl->c, STATE_DEPTH_STENCIL);
+    context_invalidate_state(&context_gl->c, STATE_RASTERIZER);
+    context_invalidate_state(&context_gl->c, STATE_BLEND);
+    context_invalidate_state(&context_gl->c, STATE_VDECL);
+    context_invalidate_state(&context_gl->c, STATE_STREAMSRC);
+    context_invalidate_state(&context_gl->c, STATE_SHADER(WINED3D_SHADER_TYPE_VERTEX));
+    context_invalidate_state(&context_gl->c, STATE_SHADER(WINED3D_SHADER_TYPE_PIXEL));
+}
