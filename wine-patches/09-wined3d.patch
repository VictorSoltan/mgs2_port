+/* Unbuffered per-call tracer: Wine's ERR loses its tail through box86 when the
+ * process dies, so a crash hunt needs fopen/fclose per line. That cost is fine
+ * for a crash hunt and ruinous otherwise -- this sits on the per-draw path, so
+ * leaving it on costs ~13 file opens per draw call and starves rendering badly
+ * enough to look like a rendering bug. Off unless MGS2_TRACE=1. */
+static int mgs_trace_enabled(void)
+{
+    static int cached = -1;
+
+    if (cached < 0)
+    {
+        const char *e = getenv("MGS2_TRACE");
+        cached = e && *e != '0';
+    }
+    return cached;
+}
+
+static void mgs_trace2(const char *fmt, ...)
+{
+    static FILE *f;
+    va_list args;
+
+    if (!mgs_trace_enabled())
+        return;
+    /* Keep the handle open and flush per line instead of reopening: the
+     * fopen/fclose form is ~13 file opens per draw call, which slowed the game
+     * so far down it could not even reach the crash being investigated. */
+    if (!f && !(f = fopen("/tmp/mgstrace.log", "a")))
+        return;
+    va_start(args, fmt);
+    vfprintf(f, fmt, args);
+    va_end(args);
+    fflush(f);
+}
