+static const BYTE *mgs_get_stream_element_sysmem(struct wined3d_context *context,
+        const struct wined3d_state *state, const struct wined3d_stream_info_element *element,
+        unsigned int first, unsigned int count)
+{
+    struct wined3d_buffer *buffer = state->streams[element->stream_idx].buffer;
+    const BYTE *base, *ptr;
+    uintptr_t offset;
+
+    if (!buffer)
+        return NULL;
+    if (!element->data.buffer_object)
+        return element->data.addr + ((intptr_t)state->load_base_vertex_index + first) * element->stride;
+    if (!(base = wined3d_buffer_load_sysmem(buffer, context)))
+        return NULL;
+
+    offset = (uintptr_t)element->data.addr
+            + ((intptr_t)state->load_base_vertex_index + first) * element->stride;
+    if (offset > buffer->resource.size || count > (buffer->resource.size - offset) / element->stride)
+        return NULL;
+    ptr = base + offset;
+    return ptr;
+}
+
+static int mgs_alpha_draw_log_enabled(void)
+{
+    static int cached = -1;
+
+    if (cached < 0)
+    {
+        const char *e = getenv("MGS2_ALPHADRAWLOG");
+        cached = e && *e != '0';
+    }
+    return cached;
+}
+
+static unsigned int mgs_alpha_draw_log_after(void)
+{
+    static unsigned int cached;
+    static int checked;
+
+    if (!checked)
+    {
+        const char *e = getenv("MGS2_ALPHADRAWLOG_AFTER");
+        cached = e ? strtoul(e, NULL, 0) : 0;
+        checked = 1;
+    }
+    return cached;
+}
+
+/* Record the two inputs to MGS2's normal-alpha FFP expression. For stage 0
+ * MODULATE2X that expression is clamp(texture.a * diffuse.a * 2), so the CPU
+ * vertex alpha and the atlas identity are enough to decide which input needs
+ * a GPU-side probe next. */
+static void mgs_log_normal_alpha_inputs(struct wined3d_context *context,
+        const struct wined3d_state *state, const struct wined3d_draw_parameters *parameters,
+        bool normal_alpha)
+{
+    const struct wined3d_stream_info_element *diffuse, *texcoord;
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource = NULL;
+    const struct wined3d_gl_info *gl_info = wined3d_context_gl(context)->gl_info;
+    struct wined3d_buffer *diffuse_buffer, *texcoord_buffer;
+    const BYTE *diffuse_data = NULL, *texcoord_data = NULL;
+    GLint old_array_buffer = 0;
+    GLint program = 0, texmatrix_location = -2;
+    GLint gl_src_rgb = 0, gl_dst_rgb = 0, gl_src_alpha = 0, gl_dst_alpha = 0;
+    GLint gl_equation_rgb = 0, gl_equation_alpha = 0;
+    GLfloat actual_texmatrix[16] = {0};
+    bool mapped_diffuse = false, mapped_texcoord = false;
+    unsigned int amin = 255, amax = 0, asum = 0, first, count, i;
+    float umin = FLT_MAX, umax = -FLT_MAX, vmin = FLT_MAX, vmax = -FLT_MAX;
+    static unsigned int seq;
+    static FILE *f;
+
+    if (!mgs_alpha_draw_log_enabled() || mgs_draw_id < mgs_alpha_draw_log_after()
+            || seq >= 256 || !normal_alpha || parameters->indirect
+            || parameters->indexed || state->shader[WINED3D_SHADER_TYPE_VERTEX]
+            || state->shader[WINED3D_SHADER_TYPE_PIXEL] || !state->viewport_count
+            || state->viewports[0].width != 512.0f || state->viewports[0].height != 480.0f)
+        return;
+
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (view)
+        resource = view->resource;
+    if (!resource || resource->format->id != WINED3DFMT_B8G8R8A8_UNORM
+            || resource->width != 512 || resource->height != 1024
+            || state->load_base_vertex_index < 0)
+        return;
+
+    first = parameters->u.direct.start_idx;
+    count = parameters->u.direct.index_count;
+    diffuse = &context->stream_info.elements[WINED3D_FFP_DIFFUSE];
+    texcoord = &context->stream_info.elements[WINED3D_FFP_TEXCOORD0];
+    if ((context->stream_info.use_map & (1u << WINED3D_FFP_DIFFUSE))
+            && diffuse->format && diffuse->stride && !diffuse->data.buffer_object)
+        diffuse_data = mgs_get_stream_element_sysmem(context, state, diffuse, first, count);
+    else if ((context->stream_info.use_map & (1u << WINED3D_FFP_DIFFUSE))
+            && diffuse->format && diffuse->stride && diffuse->data.buffer_object
+            && (diffuse_buffer = state->streams[diffuse->stream_idx].buffer))
+    {
+        uintptr_t offset = (uintptr_t)diffuse->data.addr
+                + ((uintptr_t)state->load_base_vertex_index + first) * diffuse->stride;
+
+        if (offset <= diffuse_buffer->resource.size
+                && count <= (diffuse_buffer->resource.size - offset) / diffuse->stride)
+        {
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &old_array_buffer);
+            GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER,
+                    wined3d_bo_gl(diffuse->data.buffer_object)->id));
+            diffuse_data = GL_EXTCALL(glMapBufferRange(GL_ARRAY_BUFFER,
+                    diffuse->data.buffer_object->buffer_offset + offset,
+                    count * diffuse->stride, GL_MAP_READ_BIT));
+            mapped_diffuse = !!diffuse_data;
+        }
+    }
+    if ((context->stream_info.use_map & (1u << WINED3D_FFP_TEXCOORD0))
+            && texcoord->format && texcoord->stride && !texcoord->data.buffer_object)
+        texcoord_data = mgs_get_stream_element_sysmem(context, state, texcoord, first, count);
+
+    if (diffuse_data && diffuse->format->id == WINED3DFMT_B8G8R8A8_UNORM)
+    {
+        for (i = 0; i < count; ++i)
+        {
+            DWORD color = *(const DWORD *)(diffuse_data + i * diffuse->stride);
+            unsigned int alpha = D3DCOLOR_B_A(color);
+
+            amin = min(amin, alpha);
+            amax = max(amax, alpha);
+            asum += alpha;
+        }
+    }
+    if (mapped_diffuse)
+    {
+        GL_EXTCALL(glUnmapBuffer(GL_ARRAY_BUFFER));
+        GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, old_array_buffer));
+        checkGLcall("MGS2 map diffuse alpha VBO");
+    }
+    if (!texcoord_data
+            && (context->stream_info.use_map & (1u << WINED3D_FFP_TEXCOORD0))
+            && texcoord->format && texcoord->stride && texcoord->data.buffer_object
+            && (texcoord_buffer = state->streams[texcoord->stream_idx].buffer))
+    {
+        uintptr_t offset = (uintptr_t)texcoord->data.addr
+                + ((uintptr_t)state->load_base_vertex_index + first) * texcoord->stride;
+
+        if (offset <= texcoord_buffer->resource.size
+                && count <= (texcoord_buffer->resource.size - offset) / texcoord->stride)
+        {
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &old_array_buffer);
+            GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER,
+                    wined3d_bo_gl(texcoord->data.buffer_object)->id));
+            texcoord_data = GL_EXTCALL(glMapBufferRange(GL_ARRAY_BUFFER,
+                    texcoord->data.buffer_object->buffer_offset + offset,
+                    count * texcoord->stride, GL_MAP_READ_BIT));
+            mapped_texcoord = !!texcoord_data;
+        }
+    }
+    if (texcoord_data && texcoord->format->id == WINED3DFMT_R32G32_FLOAT)
+    {
+        for (i = 0; i < count; ++i)
+        {
+            const float *uv = (const float *)(texcoord_data + i * texcoord->stride);
+
+            umin = min(umin, uv[0]);
+            umax = max(umax, uv[0]);
+            vmin = min(vmin, uv[1]);
+            vmax = max(vmax, uv[1]);
+        }
+    }
+    if (mapped_texcoord)
+    {
+        GL_EXTCALL(glUnmapBuffer(GL_ARRAY_BUFFER));
+        GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, old_array_buffer));
+        checkGLcall("MGS2 map texcoord VBO");
+    }
+    if (!f && !(f = fopen("/tmp/mgsalphadraw.log", "w")))
+        return;
+
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    texmatrix_location = GL_EXTCALL(glGetUniformLocation(program, "ffp_texture_matrix[0]"));
+    if (texmatrix_location >= 0)
+        GL_EXTCALL(glGetUniformfv(program, texmatrix_location, actual_texmatrix));
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_SRC_RGB, &gl_src_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_DST_RGB, &gl_dst_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_SRC_ALPHA, &gl_src_alpha);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_DST_ALPHA, &gl_dst_alpha);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_EQUATION_RGB, &gl_equation_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &gl_equation_alpha);
+
+    fprintf(f, "seq=%u draw=%u prim=%s first=%u count=%u tex=%p/%s/%ux%u "
+            "diff=%s/%u/%p a=%u/%g/%u uv=%s/%u/%p range=%g,%g/%g,%g tss=%u/%#x/%#x\n",
+            ++seq, mgs_draw_id, debug_d3dprimitivetype(state->primitive_type), first, count,
+            resource, resource ? debug_d3dformat(resource->format->id) : "none",
+            resource ? resource->width : 0, resource ? resource->height : 0,
+            diffuse->format ? debug_d3dformat(diffuse->format->id) : "none", diffuse->stride,
+            diffuse_data, amin, count && amin <= amax ? (double)asum / count : -1.0, amax,
+            texcoord->format ? debug_d3dformat(texcoord->format->id) : "none", texcoord->stride,
+            texcoord_data, umin, umax, vmin, vmax,
+            state->texture_states[0][WINED3D_TSS_ALPHA_OP],
+            state->texture_states[0][WINED3D_TSS_ALPHA_ARG1],
+            state->texture_states[0][WINED3D_TSS_ALPHA_ARG2]);
+    fprintf(f, "gpu seq=%u transformed=%u ttff=%#x addr=%u/%u program=%d loc=%d "
+            "diffattr=%u/%#x/%u texattr=%u/%#x/%u "
+            "blend=%#x/%#x/%#x/%#x/%#x/%#x "
+            "actualTm0=[%g,%g,%g,%g;%g,%g,%g,%g;%g,%g,%g,%g;%g,%g,%g,%g]\n",
+            seq, state->vertex_declaration->position_transformed,
+            state->texture_states[0][WINED3D_TSS_TEXTURE_TRANSFORM_FLAGS],
+            state->sampler[WINED3D_SHADER_TYPE_PIXEL][0]
+                    ? state->sampler[WINED3D_SHADER_TYPE_PIXEL][0]->desc.address_u : 0,
+            state->sampler[WINED3D_SHADER_TYPE_PIXEL][0]
+                    ? state->sampler[WINED3D_SHADER_TYPE_PIXEL][0]->desc.address_v : 0,
+            program, texmatrix_location,
+            diffuse->format ? wined3d_format_gl(diffuse->format)->vtx_format : 0,
+            diffuse->format ? wined3d_format_gl(diffuse->format)->vtx_type : 0,
+            diffuse->format ? !!(diffuse->format->attrs & WINED3D_FORMAT_ATTR_NORMALISED) : 0,
+            texcoord->format ? wined3d_format_gl(texcoord->format)->vtx_format : 0,
+            texcoord->format ? wined3d_format_gl(texcoord->format)->vtx_type : 0,
+            texcoord->format ? !!(texcoord->format->attrs & WINED3D_FORMAT_ATTR_NORMALISED) : 0,
+            gl_src_rgb, gl_dst_rgb, gl_src_alpha, gl_dst_alpha, gl_equation_rgb, gl_equation_alpha,
+            actual_texmatrix[0], actual_texmatrix[1], actual_texmatrix[2], actual_texmatrix[3],
+            actual_texmatrix[4], actual_texmatrix[5], actual_texmatrix[6], actual_texmatrix[7],
+            actual_texmatrix[8], actual_texmatrix[9], actual_texmatrix[10], actual_texmatrix[11],
+            actual_texmatrix[12], actual_texmatrix[13], actual_texmatrix[14], actual_texmatrix[15]);
+    fflush(f);
+}
