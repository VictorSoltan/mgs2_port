+static bool mgs_draw_is_codec_black_quad(const struct wined3d_state *state,
+        const struct wined3d_draw_parameters *parameters)
+{
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource;
+    const struct wined3d_viewport *vp;
+
+    if (!mgs_skip_codec_black_quad_enabled() || parameters->indirect
+            || parameters->u.direct.index_count != 4 || !state->viewport_count
+            || state->primitive_type != WINED3D_PT_TRIANGLESTRIP)
+        return false;
+    vp = &state->viewports[0];
+    if (vp->width < 110.0f || vp->width > 120.0f || vp->height < 170.0f || vp->height > 220.0f)
+        return false;
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (!view || !(resource = view->resource))
+        return false;
+    return resource->format->id == WINED3DFMT_B5G6R5_UNORM
+            && resource->width == 128 && resource->height == 256;
+}
+
+/* c_indemo.c emits two face-box draws with the GS expression
+ * (ZERO - ZERO) * FIX + DEST. The original Windows translator represents
+ * these as alpha-only writes so that RGB stays untouched while depth and the
+ * destination alpha mask are updated. Identify that exact observed D3D draw
+ * signature for a controlled A/B; do not affect normal runs. */
+static bool mgs_begin_codec_identity_mask(const struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state, const struct wined3d_draw_parameters *parameters,
+        GLboolean saved_mask[4])
+{
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource;
+    const struct wined3d_blend_state *blend_state;
+    const struct wined3d_rendertarget_blend_state_desc *rt;
+    const struct wined3d_viewport *vp;
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    static unsigned int matched;
+    static FILE *f;
+
+    if (!mgs_codec_identity_mask_enabled() || !mgs_codec_face_seen || matched >= 2
+            || parameters->indirect || parameters->u.direct.index_count != 6
+            || state->primitive_type != WINED3D_PT_TRIANGLELIST || !state->viewport_count)
+        return false;
+    vp = &state->viewports[0];
+    if (vp->width < 600.0f || vp->height < 440.0f)
+        return false;
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (!view || !(resource = view->resource)
+            || resource->format->id != WINED3DFMT_L8_UNORM
+            || resource->width != 16 || resource->height != 16)
+        return false;
+    if (!(blend_state = state->blend_state))
+        return false;
+    rt = &blend_state->desc.rt[0];
+    if (!rt->enable || rt->src != WINED3D_BLEND_SRCALPHA
+            || rt->dst != WINED3D_BLEND_ONE || rt->op != WINED3D_BLEND_OP_ADD)
+        return false;
+
+    gl_info->gl_ops.gl.p_glGetBooleanv(GL_COLOR_WRITEMASK, saved_mask);
+    gl_info->gl_ops.gl.p_glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_TRUE);
+    checkGLcall("MGS2 codec identity alpha-only mask");
+    if (!f)
+        f = fopen("/tmp/mgscodecidentity.log", "w");
+    if (f)
+    {
+        fprintf(f, "match=%u saved=%u/%u/%u/%u\n", matched,
+                saved_mask[0], saved_mask[1], saved_mask[2], saved_mask[3]);
+        fflush(f);
+    }
+    ++matched;
+    return true;
+}
+
+static void mgs_end_codec_identity_mask(const struct wined3d_context_gl *context_gl,
+        bool active, const GLboolean saved_mask[4])
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+
+    if (!active)
+        return;
+    gl_info->gl_ops.gl.p_glColorMask(saved_mask[0], saved_mask[1], saved_mask[2], saved_mask[3]);
+    checkGLcall("MGS2 restore codec colour mask");
+}
