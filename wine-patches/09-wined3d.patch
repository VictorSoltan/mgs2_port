+    gl_texture = wined3d_texture_gl_get_gl_texture(wined3d_texture_gl(texture), srgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read_fbo);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_BUFFER, &old_read_buffer);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ALIGNMENT, &old_pack_alignment);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ROW_LENGTH, &old_pack_row_length);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &old_pack_buffer);
+
+    gl_info->fbo_ops.glGenFramebuffers(1, &fbo);
