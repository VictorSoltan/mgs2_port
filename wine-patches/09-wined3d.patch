+static bool mgs_draw_is_small_view(const struct wined3d_state *state)
+{
+    const struct wined3d_viewport *vp;
+
+    if (!state->viewport_count)
+        return false;
+    vp = &state->viewports[0];
+    return vp->width <= 320.0f && vp->height <= 320.0f;
+}
