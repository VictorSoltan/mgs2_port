+/* Codec faces are 3D objects rendered in channels 2 and 3. Those channels
+ * become small D3D viewports inside the codec frame. Record only new state
+ * combinations in small viewports; per-draw logging makes the game unusably
+ * slow on the RG353VS. */
+static void mgs_log_small_view_draw(const struct wined3d_state *state,
+        const struct wined3d_draw_parameters *parameters)
+{
+    const struct wined3d_shader_resource_view *view[3];
+    const struct wined3d_blend_state *blend_state;
+    const struct wined3d_depth_stencil_state *depth_stencil_state;
+    const struct wined3d_rasterizer_state *rasterizer_state;
+    const struct wined3d_vertex_declaration *vdecl;
+    const struct wined3d_light_info *light = NULL;
+    const struct wined3d_rendertarget_blend_state_desc *rt = NULL;
+    const struct wined3d_resource *resource[3] = {NULL, NULL, NULL};
+    const struct wined3d_viewport *vp;
+    static uint64_t seen[4096];
+    static unsigned int seen_count;
+    static unsigned int seq;
+    static FILE *f;
+    static FILE *seq_f;
+    uint64_t hash = 1469598103934665603ULL;
+    unsigned int count, i, active_lights = 0;
+
+    if (!mgs_view_log_enabled() || !mgs_draw_is_small_view(state))
+        return;
+    vp = &state->viewports[0];
+
+#define MGS_VIEW_HASH(v) do { hash ^= (uintptr_t)(v); hash *= 1099511628211ULL; } while (0)
+    count = parameters->indirect ? 0 : parameters->u.direct.index_count;
+    for (i = 0; i < ARRAY_SIZE(view); ++i)
+    {
+        view[i] = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][i];
+        if (view[i])
+            resource[i] = view[i]->resource;
+    }
+    blend_state = state->blend_state;
+    if (blend_state)
+        rt = &blend_state->desc.rt[0];
+    depth_stencil_state = state->depth_stencil_state;
+    rasterizer_state = state->rasterizer_state;
+    vdecl = state->vertex_declaration;
+    for (i = 0; i < WINED3D_MAX_ACTIVE_LIGHTS; ++i)
+    {
+        if (!state->light_state.lights[i])
+            continue;
+        if (!light)
+            light = state->light_state.lights[i];
+        ++active_lights;
+    }
+
+    ++seq;
+    if (mgs_view_seq_enabled() && vp->width >= 110.0f && vp->width <= 120.0f
+            && vp->height >= 170.0f && vp->height <= 220.0f && seq <= 20000)
+    {
+        if (!seq_f)
+            seq_f = fopen("/tmp/mgsviewseq.log", "w");
+        if (seq_f)
+        {
+            fprintf(seq_f, "seq=%u vp=%.0f,%.0f prim=%s count=%u tex=%p/%p/%p light=%u "
+                    "rast=%u/%u/%u scissor=%ld,%ld-%ld,%ld\n",
+                    seq, vp->x, vp->y, debug_d3dprimitivetype(state->primitive_type), count,
+                    resource[0], resource[1], resource[2], active_lights,
+                    rasterizer_state ? rasterizer_state->desc.cull_mode : WINED3D_CULL_BACK,
+                    rasterizer_state ? rasterizer_state->desc.front_ccw : 0,
+                    rasterizer_state ? rasterizer_state->desc.scissor : 0,
+                    state->scissor_rects[0].left, state->scissor_rects[0].top,
+                    state->scissor_rects[0].right, state->scissor_rects[0].bottom);
+            fflush(seq_f);
+        }
+    }
+
+    MGS_VIEW_HASH((unsigned int)vp->x);
+    MGS_VIEW_HASH((unsigned int)vp->y);
+    MGS_VIEW_HASH((unsigned int)vp->width);
+    MGS_VIEW_HASH((unsigned int)vp->height);
+    MGS_VIEW_HASH(state->primitive_type);
+    MGS_VIEW_HASH(count);
+    MGS_VIEW_HASH(resource[0]);
+    MGS_VIEW_HASH(resource[1]);
+    MGS_VIEW_HASH(resource[2]);
+    MGS_VIEW_HASH(state->shader[WINED3D_SHADER_TYPE_VERTEX]);
+    MGS_VIEW_HASH(state->shader[WINED3D_SHADER_TYPE_PIXEL]);
+    MGS_VIEW_HASH(state->render_states[WINED3D_RS_ZFUNC]);
+    MGS_VIEW_HASH(state->render_states[WINED3D_RS_CULLMODE]);
+    MGS_VIEW_HASH(state->render_states[WINED3D_RS_LIGHTING]);
+    MGS_VIEW_HASH(state->texture_states[0][WINED3D_TSS_COLOR_OP]);
+    MGS_VIEW_HASH(state->texture_states[1][WINED3D_TSS_COLOR_OP]);
+    MGS_VIEW_HASH(active_lights);
+#undef MGS_VIEW_HASH
+
+    for (i = 0; i < seen_count; ++i)
+        if (seen[i] == hash)
+            return;
+    if (seen_count >= ARRAY_SIZE(seen))
+        return;
+    seen[seen_count++] = hash;
+
+    if (!f && !(f = fopen("/tmp/mgsview.log", "w")))
+        return;
+    fprintf(f, "seq=%u vp=%.0f,%.0f %.0fx%.0f zrange=%g:%g prim=%s count=%u indexed=%u "
+            "tex0=%p/%s/%ux%u tex1=%p/%s/%ux%u tex2=%p/%s/%ux%u vs=%p ps=%p "
+            "blend=%u/%u/%u/%u ds=%u/%u/%u rawz=%u/%u/%u "
+            "rast=%u/%u/%u rawcull=%u scissor=%ld,%ld-%ld,%ld "
+            "light=%u active=%u l0type=%u l0diff=%g,%g,%g l0amb=%g,%g,%g l0dir=%g,%g,%g "
+            "vdecl=%u/%u/%u/%#x tss0=%u/%u/%#x/%#x/%#x/%#x "
+            "tss1=%u/%u/%#x/%#x/%#x/%#x tss2=%u/%u/%#x/%#x/%#x/%#x "
+            "fog=%u atest=%u afunc=%u/%u aref=%u\n",
+            seq,
+            vp->x, vp->y, vp->width, vp->height, vp->min_z, vp->max_z,
+            debug_d3dprimitivetype(state->primitive_type), count, parameters->indexed,
+            resource[0], resource[0] ? debug_d3dformat(resource[0]->format->id) : "none",
+            resource[0] ? resource[0]->width : 0, resource[0] ? resource[0]->height : 0,
+            resource[1], resource[1] ? debug_d3dformat(resource[1]->format->id) : "none",
+            resource[1] ? resource[1]->width : 0, resource[1] ? resource[1]->height : 0,
+            resource[2], resource[2] ? debug_d3dformat(resource[2]->format->id) : "none",
+            resource[2] ? resource[2]->width : 0, resource[2] ? resource[2]->height : 0,
+            state->shader[WINED3D_SHADER_TYPE_VERTEX], state->shader[WINED3D_SHADER_TYPE_PIXEL],
+            rt ? rt->enable : 0, rt ? rt->src : 0, rt ? rt->dst : 0, rt ? rt->op : 0,
+            depth_stencil_state ? depth_stencil_state->desc.depth : 1,
+            depth_stencil_state ? depth_stencil_state->desc.depth_write : 1,
+            depth_stencil_state ? depth_stencil_state->desc.depth_func : WINED3D_CMP_LESS,
+            state->render_states[WINED3D_RS_ZENABLE], state->render_states[WINED3D_RS_ZWRITEENABLE],
+            state->render_states[WINED3D_RS_ZFUNC],
+            rasterizer_state ? rasterizer_state->desc.cull_mode : WINED3D_CULL_BACK,
+            rasterizer_state ? rasterizer_state->desc.front_ccw : 0,
+            rasterizer_state ? rasterizer_state->desc.scissor : 0,
+            state->render_states[WINED3D_RS_CULLMODE],
+            state->scissor_rects[0].left, state->scissor_rects[0].top,
+            state->scissor_rects[0].right, state->scissor_rects[0].bottom,
+            state->render_states[WINED3D_RS_LIGHTING], active_lights,
+            light ? light->OriginalParms.type : 0,
+            light ? light->OriginalParms.diffuse.r : 0.0f,
+            light ? light->OriginalParms.diffuse.g : 0.0f,
+            light ? light->OriginalParms.diffuse.b : 0.0f,
+            light ? light->OriginalParms.ambient.r : 0.0f,
+            light ? light->OriginalParms.ambient.g : 0.0f,
+            light ? light->OriginalParms.ambient.b : 0.0f,
+            light ? light->OriginalParms.direction.x : 0.0f,
+            light ? light->OriginalParms.direction.y : 0.0f,
+            light ? light->OriginalParms.direction.z : 0.0f,
+            vdecl ? vdecl->position_transformed : 0, vdecl ? vdecl->normal : 0,
+            vdecl ? vdecl->diffuse : 0, vdecl ? vdecl->texcoords : 0,
+            state->texture_states[0][WINED3D_TSS_COLOR_OP], state->texture_states[0][WINED3D_TSS_ALPHA_OP],
+            state->texture_states[0][WINED3D_TSS_COLOR_ARG1], state->texture_states[0][WINED3D_TSS_COLOR_ARG2],
+            state->texture_states[0][WINED3D_TSS_ALPHA_ARG1], state->texture_states[0][WINED3D_TSS_ALPHA_ARG2],
+            state->texture_states[1][WINED3D_TSS_COLOR_OP], state->texture_states[1][WINED3D_TSS_ALPHA_OP],
+            state->texture_states[1][WINED3D_TSS_COLOR_ARG1], state->texture_states[1][WINED3D_TSS_COLOR_ARG2],
+            state->texture_states[1][WINED3D_TSS_ALPHA_ARG1], state->texture_states[1][WINED3D_TSS_ALPHA_ARG2],
+            state->texture_states[2][WINED3D_TSS_COLOR_OP], state->texture_states[2][WINED3D_TSS_ALPHA_OP],
+            state->texture_states[2][WINED3D_TSS_COLOR_ARG1], state->texture_states[2][WINED3D_TSS_COLOR_ARG2],
+            state->texture_states[2][WINED3D_TSS_ALPHA_ARG1], state->texture_states[2][WINED3D_TSS_ALPHA_ARG2],
+            state->render_states[WINED3D_RS_FOGENABLE],
+            state->render_states[WINED3D_RS_ALPHATESTENABLE],
+            state->render_states[WINED3D_RS_ALPHAFUNC], state->extra_ps_args.alpha_func,
+            state->render_states[WINED3D_RS_ALPHAREF]);
+    fflush(f);
+}
