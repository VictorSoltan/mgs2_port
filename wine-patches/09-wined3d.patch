+/* Inspect dynamic 32-byte vertex records while the driver-provided mapping is
+ * still valid. MGS2 uses this exact stride for the CPU-skinned codec EVM data
+ * (XYZ, normal, UV). No resource readback or additional GL call is involved. */
+static void mgs_log_dynamic_vb_mapping(const struct wined3d_buffer *buffer)
+{
+    const struct wined3d_resource *resource = &buffer->resource;
+    static unsigned int seq;
+    static FILE *f;
+    SIZE_T range_idx;
+
+    if (!mgs_dynamic_vb_log_enabled() || seq >= 16384 || !buffer->map_ptr
+            || !(resource->usage & WINED3DUSAGE_DYNAMIC))
+        return;
+
+    for (range_idx = 0; range_idx < buffer->dirty_range_count && seq < 16384; ++range_idx)
+    {
+        const struct wined3d_range *range = &buffer->dirty_ranges[range_idx];
+        const BYTE *data;
+        float pmin[3] = {FLT_MAX, FLT_MAX, FLT_MAX}, pmax[3] = {-FLT_MAX, -FLT_MAX, -FLT_MAX};
+        float nmin[3] = {FLT_MAX, FLT_MAX, FLT_MAX}, nmax[3] = {-FLT_MAX, -FLT_MAX, -FLT_MAX};
+        float tmin[2] = {FLT_MAX, FLT_MAX}, tmax[2] = {-FLT_MAX, -FLT_MAX};
+        unsigned int vertex_count, i, c, nan_count = 0;
+
+        if (range->size < 4 * 32 || range->size % 32
+                || range->offset > resource->size || range->size > resource->size - range->offset)
+            continue;
+        data = (const BYTE *)buffer->map_ptr + range->offset;
+        vertex_count = range->size / 32;
+        for (i = 0; i < vertex_count; ++i)
+        {
+            const float *v = (const float *)(data + i * 32);
+
+            for (c = 0; c < 3; ++c)
+            {
+                if (v[c] != v[c] || v[c + 3] != v[c + 3])
+                {
+                    ++nan_count;
+                    continue;
+                }
+                pmin[c] = min(pmin[c], v[c]);
+                pmax[c] = max(pmax[c], v[c]);
+                nmin[c] = min(nmin[c], v[c + 3]);
+                nmax[c] = max(nmax[c], v[c + 3]);
+            }
+            for (c = 0; c < 2; ++c)
+            {
+                if (v[c + 6] != v[c + 6])
+                {
+                    ++nan_count;
+                    continue;
+                }
+                tmin[c] = min(tmin[c], v[c + 6]);
+                tmax[c] = max(tmax[c], v[c + 6]);
+            }
+        }
+
+        if (!f && !(f = fopen("/tmp/mgsdynvb.log", "w")))
+            return;
+        fprintf(f, "seq=%u buffer=%p resource=%u range=%u+%u verts=%u nan=%u "
+                "pos=%g,%g,%g:%g,%g,%g norm=%g,%g,%g:%g,%g,%g uv=%g,%g:%g,%g\n",
+                ++seq, buffer, resource->size, range->offset, range->size, vertex_count, nan_count,
+                pmin[0], pmin[1], pmin[2], pmax[0], pmax[1], pmax[2],
+                nmin[0], nmin[1], nmin[2], nmax[0], nmax[1], nmax[2],
+                tmin[0], tmin[1], tmax[0], tmax[1]);
+        fflush(f);
+    }
