+/* Record the values that the GLSL backend actually reads from the FFP push
+ * constant buffers. Render-state logs alone cannot detect a stale or missing
+ * stateblock-to-constant-buffer update. Call this after context_apply_draw_state(). */
+static void mgs_log_small_view_ffp_constants(struct wined3d_context *context,
+        const struct wined3d_state *state, const struct wined3d_draw_parameters *parameters)
+{
+    const struct wined3d_ffp_vs_constants *vs_constants;
+    const struct wined3d_ffp_ps_constants *ps_constants;
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource = NULL;
+    const struct wined3d_buffer *vertex_buffer = NULL;
