+/* Map the 24 destination snapshots produced by MGS2_CODEC_SCREEN_DUMP back to
+ * the application's actual 2D geometry and depth values. Most MGS2 dmapack
+ * vertices store XY as signed shorts and put Z in the fixed-function world
+ * matrix, so draw-state metadata alone cannot identify a packet. */
+static void mgs_log_codec_screen_geometry(struct wined3d_context *context,
+        const struct wined3d_state *state, const struct wined3d_draw_parameters *parameters)
+{
+    const struct wined3d_stream_info_element *position;
+    const struct wined3d_ffp_vs_constants *constants = NULL;
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource = NULL;
+    const struct wined3d_depth_stencil_state *depth_stencil_state;
+    const struct wined3d_rendertarget_view *rtv;
+    const struct wined3d_viewport *vp;
+    const struct wined3d_gl_info *gl_info = wined3d_context_gl(context)->gl_info;
+    static bool started;
+    static unsigned int seq;
+    static FILE *f;
+    GLint gl_src_rgb = 0, gl_dst_rgb = 0, gl_equation_rgb = 0;
+    GLboolean gl_blend;
+    unsigned int first = 0, count = 0;
+
+    if (!mgs_codec_screen_dump_enabled() || seq >= 24 || !state->viewport_count)
+        return;
+
+    vp = &state->viewports[0];
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (view)
+        resource = view->resource;
+    if (!started && mgs_codec_face_rt_resource && resource == mgs_codec_face_rt_resource
+            && vp->width >= 600.0f && vp->height >= 440.0f
+            && vp->width <= 640.0f && vp->height <= 480.0f)
+        started = true;
+    if (!started)
+        return;
+
+    if (!f && !(f = fopen("/tmp/mgscodecgeom.log", "w")))
+        return;
+
+    if (!parameters->indirect)
+    {
+        first = parameters->u.direct.start_idx;
+        count = parameters->u.direct.index_count;
+    }
+    position = &context->stream_info.elements[WINED3D_FFP_POSITION];
+    if (!state->shader[WINED3D_SHADER_TYPE_VERTEX]
+            && context->device->push_constants[WINED3D_PUSH_CONSTANTS_VS_FFP])
+        constants = wined3d_buffer_load_sysmem(
+                context->device->push_constants[WINED3D_PUSH_CONSTANTS_VS_FFP], context);
+    depth_stencil_state = state->depth_stencil_state;
+    rtv = state->fb.render_targets[0];
+    gl_blend = gl_info->gl_ops.gl.p_glIsEnabled(GL_BLEND);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_SRC_RGB, &gl_src_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_DST_RGB, &gl_dst_rgb);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_EQUATION_RGB, &gl_equation_rgb);
+
+    fprintf(f, "screen=%02u prim=%s count=%u first=%u pos=%s stride=%u transformed=%u "
+            "ptr=%p bo=%p base=%d d3dmask=%#x depth=%u/%u/%u rawdepth=%u/%u/%u ",
+            seq, debug_d3dprimitivetype(state->primitive_type), count, first,
+            position->format ? debug_d3dformat(position->format->id) : "none", position->stride,
+            context->stream_info.position_transformed, position->data.addr,
+            position->data.buffer_object, state->load_base_vertex_index,
+            wined3d_blend_state_get_writemask(state->blend_state, 0),
+            depth_stencil_state ? depth_stencil_state->desc.depth : 1,
+            depth_stencil_state ? depth_stencil_state->desc.depth_write : 1,
+            depth_stencil_state ? depth_stencil_state->desc.depth_func : WINED3D_CMP_LESS,
+            state->render_states[WINED3D_RS_ZENABLE],
+            state->render_states[WINED3D_RS_ZWRITEENABLE],
+            state->render_states[WINED3D_RS_ZFUNC]);
+    fprintf(f, "rt=%s caps=%#x postblend=%u glblend=%u/%#x/%#x/%#x ",
+            rtv ? debug_d3dformat(rtv->format->id) : "none", rtv ? rtv->format_caps : 0,
+            rtv && (rtv->format_caps & WINED3D_FORMAT_CAP_POSTPIXELSHADER_BLENDING),
+            gl_blend, gl_src_rgb, gl_dst_rgb, gl_equation_rgb);
+
+    if (constants)
+    {
+        fprintf(f, "mvz=%g,%g,%g,%g prz=%g,%g,%g,%g ",
+                constants->modelview.not_blended.modelview_matrix._13,
+                constants->modelview.not_blended.modelview_matrix._23,
+                constants->modelview.not_blended.modelview_matrix._33,
+                constants->modelview.not_blended.modelview_matrix._43,
+                constants->projection_matrix._13, constants->projection_matrix._23,
+                constants->projection_matrix._33, constants->projection_matrix._43);
+    }
+    fputc('\n', f);
+    fflush(f);
+    ++seq;
+}
+
+/* Log the CPU-side vertex stream and the exact FFP transform constants used by
+ * codec face models. The D3D clip coordinates are sufficient for visibility:
+ * Wine's final GL fixup only flips Y, remaps Z, and adds a sub-pixel offset. */
+static void mgs_log_codec_face_geometry(struct wined3d_context *context,
+        const struct wined3d_state *state, const struct wined3d_draw_parameters *parameters)
+{
+    const struct wined3d_stream_info_element *position, *normal, *texcoord;
+    const struct wined3d_ffp_vs_constants *constants;
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *texture;
+    const struct wined3d_viewport *vp;
+    const BYTE *position_data, *normal_data, *texcoord_data;
+    float pmin[3] = {FLT_MAX, FLT_MAX, FLT_MAX}, pmax[3] = {-FLT_MAX, -FLT_MAX, -FLT_MAX};
+    float nmin[3] = {FLT_MAX, FLT_MAX, FLT_MAX}, nmax[3] = {-FLT_MAX, -FLT_MAX, -FLT_MAX};
+    float tmin[2] = {FLT_MAX, FLT_MAX}, tmax[2] = {-FLT_MAX, -FLT_MAX};
+    float cmin[3] = {FLT_MAX, FLT_MAX, FLT_MAX}, cmax[3] = {-FLT_MAX, -FLT_MAX, -FLT_MAX};
+    static unsigned int seq;
+    static FILE *f;
+    unsigned int first, count, inside = 0, invalid_w = 0, i, c;
+
+    if (!mgs_face_geom_log_enabled() || seq >= 256 || parameters->indirect || parameters->indexed
+            || !state->viewport_count || state->shader[WINED3D_SHADER_TYPE_VERTEX]
+            || state->shader[WINED3D_SHADER_TYPE_PIXEL]
+            || state->primitive_type != WINED3D_PT_TRIANGLESTRIP
+            || !state->render_states[WINED3D_RS_LIGHTING]
+            || !context->device->push_constants[WINED3D_PUSH_CONSTANTS_VS_FFP])
+        return;
+    vp = &state->viewports[0];
+    if (vp->width < 110.0f || vp->width > 120.0f || vp->height < 170.0f || vp->height > 220.0f)
+        return;
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (!view || !(texture = view->resource)
+            || texture->format->id != WINED3DFMT_B8G8R8A8_UNORM || texture->width != 512
+            || (texture->height != 512 && texture->height != 1024))
+        return;
+
+    position = &context->stream_info.elements[WINED3D_FFP_POSITION];
+    normal = &context->stream_info.elements[WINED3D_FFP_NORMAL];
+    texcoord = &context->stream_info.elements[WINED3D_FFP_TEXCOORD0];
+    if ((context->stream_info.use_map & ((1u << WINED3D_FFP_POSITION)
+            | (1u << WINED3D_FFP_NORMAL) | (1u << WINED3D_FFP_TEXCOORD0)))
+            != ((1u << WINED3D_FFP_POSITION) | (1u << WINED3D_FFP_NORMAL)
+            | (1u << WINED3D_FFP_TEXCOORD0))
+            || !position->format || !normal->format || !texcoord->format
+            || !position->stride || !normal->stride || !texcoord->stride
+            || state->load_base_vertex_index < 0)
+        return;
+    first = parameters->u.direct.start_idx;
+    count = parameters->u.direct.index_count;
+    position_data = mgs_get_stream_element_sysmem(context, state, position, first, count);
+    normal_data = mgs_get_stream_element_sysmem(context, state, normal, first, count);
+    texcoord_data = mgs_get_stream_element_sysmem(context, state, texcoord, first, count);
+    constants = wined3d_buffer_load_sysmem(
+            context->device->push_constants[WINED3D_PUSH_CONSTANTS_VS_FFP], context);
+    if (!f && !(f = fopen("/tmp/mgsfacegeom.log", "w")))
+        return;
+
+    if (!position_data || !normal_data || !texcoord_data || !constants
+            || position->format->id != WINED3DFMT_R32G32B32_FLOAT
+            || normal->format->id != WINED3DFMT_R32G32B32_FLOAT
+            || texcoord->format->id != WINED3DFMT_R32G32_FLOAT)
+    {
+        fprintf(f, "seq=%u unavailable pos=%p/%s normal=%p/%s uv=%p/%s use=%#lx stride=%u/%u/%u\n",
+                ++seq, position_data, debug_d3dformat(position->format->id),
+                normal_data, debug_d3dformat(normal->format->id),
+                texcoord_data, debug_d3dformat(texcoord->format->id),
+                context->stream_info.use_map, position->stride, normal->stride, texcoord->stride);
+        fflush(f);
+        return;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        const float *p = (const float *)(position_data + i * position->stride);
+        const float *n = (const float *)(normal_data + i * normal->stride);
+        const float *t = (const float *)(texcoord_data + i * texcoord->stride);
+        struct wined3d_vec4 object = {p[0], p[1], p[2], 1.0f}, eye, clip;
+        float ndc[3];
+
+        for (c = 0; c < 3; ++c)
+        {
+            pmin[c] = min(pmin[c], p[c]);
+            pmax[c] = max(pmax[c], p[c]);
+            nmin[c] = min(nmin[c], n[c]);
+            nmax[c] = max(nmax[c], n[c]);
+        }
+        for (c = 0; c < 2; ++c)
+        {
+            tmin[c] = min(tmin[c], t[c]);
+            tmax[c] = max(tmax[c], t[c]);
+        }
+        wined3d_vec4_transform(&eye, &object, &constants->modelview.not_blended.modelview_matrix);
+        wined3d_vec4_transform(&clip, &eye, &constants->projection_matrix);
+        if (clip.w == 0.0f || clip.w != clip.w)
+        {
+            ++invalid_w;
+            continue;
+        }
+        ndc[0] = clip.x / clip.w;
+        ndc[1] = clip.y / clip.w;
+        ndc[2] = clip.z / clip.w;
+        for (c = 0; c < 3; ++c)
+        {
+            cmin[c] = min(cmin[c], ndc[c]);
+            cmax[c] = max(cmax[c], ndc[c]);
+        }
+        if (ndc[0] >= -1.0f && ndc[0] <= 1.0f && ndc[1] >= -1.0f && ndc[1] <= 1.0f
+                && ndc[2] >= 0.0f && ndc[2] <= 1.0f)
+            ++inside;
+    }
+
+    fprintf(f, "seq=%u vp=%.0f,%.0f %.0fx%.0f tex=%ux%u first=%u count=%u stride=%u/%u/%u "
+            "pos=%g,%g,%g:%g,%g,%g norm=%g,%g,%g:%g,%g,%g uv=%g,%g:%g,%g "
+            "ndc=%g,%g,%g:%g,%g,%g inside=%u badw=%u "
+            "mv=[%g,%g,%g,%g;%g,%g,%g,%g;%g,%g,%g,%g;%g,%g,%g,%g] "
+            "pr=[%g,%g,%g,%g;%g,%g,%g,%g;%g,%g,%g,%g;%g,%g,%g,%g]\n",
+            ++seq, vp->x, vp->y, vp->width, vp->height, texture->width, texture->height,
+            first, count, position->stride, normal->stride, texcoord->stride,
+            pmin[0], pmin[1], pmin[2], pmax[0], pmax[1], pmax[2],
+            nmin[0], nmin[1], nmin[2], nmax[0], nmax[1], nmax[2],
+            tmin[0], tmin[1], tmax[0], tmax[1],
+            cmin[0], cmin[1], cmin[2], cmax[0], cmax[1], cmax[2], inside, invalid_w,
+            constants->modelview.not_blended.modelview_matrix._11,
+            constants->modelview.not_blended.modelview_matrix._12,
+            constants->modelview.not_blended.modelview_matrix._13,
+            constants->modelview.not_blended.modelview_matrix._14,
+            constants->modelview.not_blended.modelview_matrix._21,
+            constants->modelview.not_blended.modelview_matrix._22,
+            constants->modelview.not_blended.modelview_matrix._23,
+            constants->modelview.not_blended.modelview_matrix._24,
+            constants->modelview.not_blended.modelview_matrix._31,
+            constants->modelview.not_blended.modelview_matrix._32,
+            constants->modelview.not_blended.modelview_matrix._33,
+            constants->modelview.not_blended.modelview_matrix._34,
+            constants->modelview.not_blended.modelview_matrix._41,
+            constants->modelview.not_blended.modelview_matrix._42,
+            constants->modelview.not_blended.modelview_matrix._43,
+            constants->modelview.not_blended.modelview_matrix._44,
+            constants->projection_matrix._11, constants->projection_matrix._12,
+            constants->projection_matrix._13, constants->projection_matrix._14,
+            constants->projection_matrix._21, constants->projection_matrix._22,
+            constants->projection_matrix._23, constants->projection_matrix._24,
+            constants->projection_matrix._31, constants->projection_matrix._32,
+            constants->projection_matrix._33, constants->projection_matrix._34,
+            constants->projection_matrix._41, constants->projection_matrix._42,
+            constants->projection_matrix._43, constants->projection_matrix._44);
+    fflush(f);
+}
+
+/* Read back the actual GL viewport after selected codec face draws. This is a
+ * diagnostic only: it distinguishes geometry that produced no fragments from
+ * fragments whose fixed-function shader wrote black. Preserve all pack state
+ * touched by glReadPixels so enabling the probe does not affect later draws. */
+static void mgs_readback_codec_face(const struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state)
+{
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource;
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    const struct wined3d_viewport *vp;
+    static unsigned char pixels[120 * 220 * 4];
+    static unsigned int seq;
+    static FILE *f;
+    GLint gl_vp[4], pack_alignment, pack_row_length, pack_buffer;
+    GLint draw_framebuffer, read_framebuffer, read_buffer;
+    uint64_t sums[4] = {0, 0, 0, 0};
+    unsigned int nonblack = 0, nonzero_alpha = 0, pixel_count, i;
+    unsigned char max_values[4] = {0, 0, 0, 0};
+
+    if (!mgs_face_readback_enabled() || seq >= 256 || !state->viewport_count
+            || state->shader[WINED3D_SHADER_TYPE_VERTEX]
+            || state->shader[WINED3D_SHADER_TYPE_PIXEL]
+            || state->primitive_type != WINED3D_PT_TRIANGLESTRIP
+            || !state->render_states[WINED3D_RS_LIGHTING])
+        return;
+    vp = &state->viewports[0];
+    if (vp->width < 110.0f || vp->width > 120.0f || vp->height < 170.0f || vp->height > 220.0f)
+        return;
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (!view || !(resource = view->resource)
+            || resource->format->id != WINED3DFMT_B8G8R8A8_UNORM
+            || resource->width != 512 || (resource->height != 512 && resource->height != 1024))
+        return;
+
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_VIEWPORT, gl_vp);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row_length);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_framebuffer);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_BUFFER, &read_buffer);
+    if (gl_vp[2] <= 0 || gl_vp[2] > 120 || gl_vp[3] <= 0 || gl_vp[3] > 220)
+        return;
+
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, 0));
+    gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, draw_framebuffer);
+    gl_info->gl_ops.gl.p_glReadBuffer(GL_COLOR_ATTACHMENT0);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    gl_info->gl_ops.gl.p_glReadPixels(gl_vp[0], gl_vp[1], gl_vp[2], gl_vp[3],
+            GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    checkGLcall("MGS2 codec face glReadPixels");
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, pack_row_length);
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer));
+    gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, read_framebuffer);
+    gl_info->gl_ops.gl.p_glReadBuffer(read_buffer);
+
+    pixel_count = gl_vp[2] * gl_vp[3];
+    for (i = 0; i < pixel_count; ++i)
+    {
+        unsigned int c;
+
+        for (c = 0; c < 4; ++c)
+        {
+            unsigned char value = pixels[i * 4 + c];
+            sums[c] += value;
+            if (value > max_values[c])
+                max_values[c] = value;
+        }
+        if (pixels[i * 4] || pixels[i * 4 + 1] || pixels[i * 4 + 2])
+            ++nonblack;
+        if (pixels[i * 4 + 3])
+            ++nonzero_alpha;
+    }
+
+    if (!f && !(f = fopen("/tmp/mgsfacereadback.log", "w")))
+        return;
+    fprintf(f, "seq=%u glvp=%d,%d %dx%d fbo=%d/%d read=%#x tex=%ux%u "
+            "pixels=%u nonblack=%u nonzeroA=%u "
+            "mean=%g,%g,%g,%g max=%u,%u,%u,%u\n",
+            ++seq, gl_vp[0], gl_vp[1], gl_vp[2], gl_vp[3], draw_framebuffer, read_framebuffer,
+            read_buffer, resource->width, resource->height,
+            pixel_count, nonblack, nonzero_alpha,
+            (double)sums[0] / pixel_count, (double)sums[1] / pixel_count,
+            (double)sums[2] / pixel_count, (double)sums[3] / pixel_count,
+            max_values[0], max_values[1], max_values[2], max_values[3]);
+    fflush(f);
+}
+
+/* Dump the destination FBO around the first draw that samples the populated
+ * 512x512 codec render target. This is deliberately separate from the source
+ * readback below: a valid source does not prove that the fixed-function
+ * composite sampled it, nor that a later UI draw did not cover the result.
+ * PPM keeps the device-side probe dependency-free and directly inspectable. */
+static void mgs_dump_codec_screen_after_draw(const struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state, const struct wined3d_draw_parameters *parameters,
+        const char *phase)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource = NULL;
+    const struct wined3d_blend_state *blend_state;
+    const struct wined3d_rendertarget_blend_state_desc *rt = NULL;
+    const struct wined3d_viewport *vp;
+    static unsigned char rgba[640 * 480 * 4];
+    static unsigned char rgb[640 * 480 * 3];
+    static GLint capture_fbo, capture_width, capture_height;
+    static unsigned int remaining, seq;
+    static bool started;
+    static FILE *log;
+    GLint draw_fbo, read_fbo, read_buffer;
+    GLint pack_alignment, pack_row_length, pack_buffer;
+    unsigned int x, y;
+    char filename[80];
+    FILE *file;
+
+    if (!mgs_codec_screen_dump_enabled() || strcmp(phase, "after")
+            || !state->viewport_count || seq >= 24)
+        return;
+
+    vp = &state->viewports[0];
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (view)
+        resource = view->resource;
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_fbo);
+
+    if (!started && mgs_codec_face_rt_resource && resource == mgs_codec_face_rt_resource
+            && vp->width >= 600.0f && vp->height >= 440.0f
+            && vp->width <= 640.0f && vp->height <= 480.0f)
+    {
+        capture_fbo = draw_fbo;
+        capture_width = vp->width;
+        capture_height = vp->height;
+        remaining = 24;
+        started = true;
+    }
+
+    if (!remaining || draw_fbo != capture_fbo || capture_width <= 0 || capture_width > 640
+            || capture_height <= 0 || capture_height > 480)
+        return;
+
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row_length);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fbo);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_BUFFER, &read_buffer);
+
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, 0));
+    gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, capture_fbo);
+    gl_info->gl_ops.gl.p_glReadBuffer(capture_fbo ? GL_COLOR_ATTACHMENT0 : GL_BACK);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    gl_info->gl_ops.gl.p_glReadPixels(0, 0, capture_width, capture_height,
+            GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    checkGLcall("MGS2 codec destination glReadPixels");
+
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, pack_row_length);
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer));
+    gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fbo);
+    gl_info->gl_ops.gl.p_glReadBuffer(read_buffer);
+
+    for (y = 0; y < capture_height; ++y)
+    {
+        unsigned int src_y = capture_height - 1 - y;
+
+        for (x = 0; x < capture_width; ++x)
+        {
+            unsigned int src = (src_y * capture_width + x) * 4;
+            unsigned int dst = (y * capture_width + x) * 3;
+
+            rgb[dst] = rgba[src];
+            rgb[dst + 1] = rgba[src + 1];
+            rgb[dst + 2] = rgba[src + 2];
+        }
+    }
+
+    snprintf(filename, sizeof(filename), "/tmp/mgscodec-screen-%02u.ppm", seq);
+    if ((file = fopen(filename, "wb")))
+    {
+        fprintf(file, "P6\n%d %d\n255\n", capture_width, capture_height);
+        fwrite(rgb, 3, capture_width * capture_height, file);
+        fclose(file);
+    }
+    blend_state = state->blend_state;
+    if (blend_state)
+        rt = &blend_state->desc.rt[0];
+    if (!log)
+        log = fopen("/tmp/mgscodecscreen.log", "w");
+    if (log)
+    {
+        fprintf(log, "screen=%02u fbo=%d d3dvp=%g,%g %gx%g prim=%s indexed=%u count=%u "
+                "tex=%p/%s/%ux%u blend=%u/%u/%u/%u atest=%u/%u/%u "
+                "z=%u/%u/%u vs=%p ps=%p\n",
+                seq, draw_fbo, vp->x, vp->y, vp->width, vp->height,
+                debug_d3dprimitivetype(state->primitive_type), parameters->indexed,
+                parameters->indirect ? 0 : parameters->u.direct.index_count,
+                resource, resource ? debug_d3dformat(resource->format->id) : "none",
+                resource ? resource->width : 0, resource ? resource->height : 0,
+                rt ? rt->enable : 0, rt ? rt->src : 0, rt ? rt->dst : 0, rt ? rt->op : 0,
+                state->render_states[WINED3D_RS_ALPHATESTENABLE],
+                state->render_states[WINED3D_RS_ALPHAFUNC],
+                state->render_states[WINED3D_RS_ALPHAREF],
+                state->render_states[WINED3D_RS_ZENABLE],
+                state->render_states[WINED3D_RS_ZWRITEENABLE],
+                state->render_states[WINED3D_RS_ZFUNC],
+                state->shader[WINED3D_SHADER_TYPE_VERTEX], state->shader[WINED3D_SHADER_TYPE_PIXEL]);
+        fflush(log);
+    }
+    ++seq;
+    --remaining;
+}
+
+/* The face meshes are known to reach the draw FBO with valid colour. Track
+ * what happens after a codec face viewport has been populated, and name
+ * the first later draw which destroys either rectangle. This deliberately
+ * reads only the short channel-4 tail of one frame; doing synchronous
+ * readbacks throughout a codec conversation is prohibitively expensive on
+ * the RG353VS. */
+static void mgs_track_codec_composite_after_draw(const struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state, const struct wined3d_draw_parameters *parameters,
+        const char *phase)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    const struct wined3d_shader_resource_view *view;
+    struct wined3d_resource *resource = NULL;
+    const struct wined3d_blend_state *blend_state;
+    const struct wined3d_rendertarget_blend_state_desc *rt = NULL;
+    const struct wined3d_viewport *vp;
+    static unsigned char pixels[120 * 220 * 4];
+    static GLint face_rect[2][4];
+    static GLint face_fbo[2];
+    static GLint face_attachment[2];
+    static GLint face_attachment_type[2];
+    static unsigned int have_face, seq;
+    static bool done;
+    static FILE *f;
+    GLint gl_vp[4], draw_framebuffer, read_framebuffer, read_buffer, draw_attachment = 0;
+    GLint draw_attachment_type = 0, current_face_attachment[2] = {0, 0};
+    GLint current_face_attachment_type[2] = {0, 0};
+    GLint pack_alignment, pack_row_length, pack_buffer;
+    GLint active_texture = GL_TEXTURE0, bound_texture[4] = {0, 0, 0, 0};
+    GLuint texture_rgb = 0, texture_srgb = 0, rb_multisample = 0, rb_resolved = 0;
+    uint32_t texture_locations = 0, texture_draw_binding = 0;
+    unsigned int nonblack[2] = {0, 0}, max_rgb[2] = {0, 0};
+    uint64_t checksum[2] = {1469598103934665603ULL, 1469598103934665603ULL};
+    unsigned int count, i, side;
+
+    if (!mgs_codec_composite_log_enabled() || done || !state->viewport_count)
+        return;
+
+    vp = &state->viewports[0];
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_VIEWPORT, gl_vp);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_framebuffer);
+
+    if (vp->width >= 110.0f && vp->width <= 120.0f
+            && vp->height >= 170.0f && vp->height <= 220.0f)
+    {
+        if (!strcmp(phase, "preapply"))
+            return;
+        side = gl_vp[0] < 256 ? 0 : 1;
+        memcpy(face_rect[side], gl_vp, sizeof(gl_vp));
+        face_fbo[side] = draw_framebuffer;
+        gl_info->fbo_ops.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER,
+                GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &face_attachment[side]);
+        gl_info->fbo_ops.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER,
+                GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &face_attachment_type[side]);
+        have_face |= 1u << side;
+        if (!strcmp(phase, "after"))
+        {
+            const struct wined3d_rendertarget_view *rtv = state->fb.render_targets[0];
+            const struct wined3d_resource *rt_resource = rtv ? rtv->resource : NULL;
+            const struct wined3d_shader_resource_view *face_view;
+            const struct wined3d_resource *face_resource = NULL;
+            const struct wined3d_blend_state *face_blend_state;
+            const struct wined3d_rendertarget_blend_state_desc *face_rt = NULL;
+            unsigned int face_nonblack = 0, face_max = 0, pixel_count;
+
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row_length);
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_BUFFER, &read_buffer);
+            GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, 0));
+            gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, draw_framebuffer);
+            gl_info->gl_ops.gl.p_glReadBuffer(GL_COLOR_ATTACHMENT0);
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+            gl_info->gl_ops.gl.p_glReadPixels(gl_vp[0], gl_vp[1], gl_vp[2], gl_vp[3],
+                    GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+            pixel_count = gl_vp[2] * gl_vp[3];
+            for (i = 0; i < pixel_count; ++i)
+            {
+                unsigned int c;
+
+                if (pixels[i * 4] || pixels[i * 4 + 1] || pixels[i * 4 + 2])
+                    ++face_nonblack;
+                for (c = 0; c < 3; ++c)
+                    if (pixels[i * 4 + c] > face_max)
+                        face_max = pixels[i * 4 + c];
+            }
+            checkGLcall("MGS2 codec all-face-draw glReadPixels");
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
+            gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, pack_row_length);
+            GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer));
+            gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, read_framebuffer);
+            gl_info->gl_ops.gl.p_glReadBuffer(read_buffer);
+
+            face_view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+            if (face_view)
+                face_resource = face_view->resource;
+            face_blend_state = state->blend_state;
+            if (face_blend_state)
+                face_rt = &face_blend_state->desc.rt[0];
+
+            if (!f && !(f = fopen("/tmp/mgscodeccomposite.log", "w")))
+                return;
+            fprintf(f, "event=%ld FACE side=%u fbo=%d attachment=%#x:%d rect=%d,%d %dx%d "
+                    "rt=%p/%ux%u/bind=%#x prim=%s count=%u tex=%p/%s/%ux%u "
+                    "blend=%u/%u/%u/%u atest=%u/%u/%u pixels=%u/%u%s\n",
+                    InterlockedIncrement(&mgs_codec_event_id), side, draw_framebuffer,
+                    face_attachment_type[side], face_attachment[side],
+                    gl_vp[0], gl_vp[1], gl_vp[2], gl_vp[3],
+                    rt_resource, rt_resource ? rt_resource->width : 0,
+                    rt_resource ? rt_resource->height : 0,
+                    rt_resource ? rt_resource->draw_binding : 0,
+                    debug_d3dprimitivetype(state->primitive_type),
+                    parameters->indirect ? 0 : parameters->u.direct.index_count,
+                    face_resource, face_resource ? debug_d3dformat(face_resource->format->id) : "none",
+                    face_resource ? face_resource->width : 0,
+                    face_resource ? face_resource->height : 0,
+                    face_rt ? face_rt->enable : 0, face_rt ? face_rt->src : 0,
+                    face_rt ? face_rt->dst : 0, face_rt ? face_rt->op : 0,
+                    state->render_states[WINED3D_RS_ALPHATESTENABLE],
+                    state->render_states[WINED3D_RS_ALPHAFUNC],
+                    state->render_states[WINED3D_RS_ALPHAREF],
+                    face_nonblack, face_max, face_nonblack ? "" : " BLACK");
+            fflush(f);
+            mgs_codec_face_rt_resource = rt_resource;
+            InterlockedExchange(&mgs_codec_face_seen, 1);
+        }
+        return;
+    }
+
+    if (!have_face || ++seq > 256)
+    {
+        if (seq > 256)
+            done = true;
+        return;
+    }
+
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row_length);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
+    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_BUFFER, &read_buffer);
+    gl_info->fbo_ops.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER,
+            GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &draw_attachment);
+    gl_info->fbo_ops.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER,
+            GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &draw_attachment_type);
+
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, 0));
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    for (side = 0; side < 2; ++side)
+    {
+        unsigned int pixel_count = face_rect[side][2] * face_rect[side][3];
+
+        if (!(have_face & (1u << side)))
+            continue;
+
+        gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, face_fbo[side]);
+        gl_info->gl_ops.gl.p_glReadBuffer(GL_COLOR_ATTACHMENT0);
+        gl_info->fbo_ops.glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER,
+                GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,
+                &current_face_attachment[side]);
+        gl_info->fbo_ops.glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER,
+                GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE,
+                &current_face_attachment_type[side]);
+        gl_info->gl_ops.gl.p_glReadPixels(face_rect[side][0], face_rect[side][1],
+                face_rect[side][2], face_rect[side][3], GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+        for (i = 0; i < pixel_count; ++i)
+        {
+            unsigned int rgb = pixels[i * 4] | pixels[i * 4 + 1] | pixels[i * 4 + 2];
+            unsigned int c;
+
+            if (rgb)
+                ++nonblack[side];
+            if (pixels[i * 4] > max_rgb[side]) max_rgb[side] = pixels[i * 4];
+            if (pixels[i * 4 + 1] > max_rgb[side]) max_rgb[side] = pixels[i * 4 + 1];
+            if (pixels[i * 4 + 2] > max_rgb[side]) max_rgb[side] = pixels[i * 4 + 2];
+            for (c = 0; c < 4; ++c)
+            {
+                checksum[side] ^= pixels[i * 4 + c];
+                checksum[side] *= 1099511628211ULL;
+            }
+        }
+    }
+    checkGLcall("MGS2 codec composite glReadPixels");
+
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, pack_row_length);
+    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer));
+    gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, read_framebuffer);
+    gl_info->gl_ops.gl.p_glReadBuffer(read_buffer);
+
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (view)
+        resource = view->resource;
+    if (resource && resource->type != WINED3D_RTYPE_BUFFER)
+    {
+        const struct wined3d_texture_gl *texture_gl =
+                wined3d_texture_gl(wined3d_texture_from_resource(resource));
+
+        texture_rgb = texture_gl->texture_rgb.name;
+        texture_srgb = texture_gl->texture_srgb.name;
+        rb_multisample = texture_gl->rb_multisample;
+        rb_resolved = texture_gl->rb_resolved;
+        texture_locations = texture_gl->t.sub_resources[0].locations;
+        texture_draw_binding = resource->draw_binding;
+
+        gl_info->gl_ops.gl.p_glGetIntegerv(GL_ACTIVE_TEXTURE, &active_texture);
+        for (i = 0; i < ARRAY_SIZE(bound_texture); ++i)
+        {
+            GL_EXTCALL(glActiveTexture(GL_TEXTURE0 + i));
+            gl_info->gl_ops.gl.p_glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound_texture[i]);
+        }
+        GL_EXTCALL(glActiveTexture(active_texture));
+    }
+    blend_state = state->blend_state;
+    if (blend_state)
+        rt = &blend_state->desc.rt[0];
+    count = parameters->indirect ? 0 : parameters->u.direct.index_count;
+
+    if (!f && !(f = fopen("/tmp/mgscodeccomposite.log", "w")))
+        return;
+    fprintf(f, "event=%ld seq=%u phase=%s d3dvp=%g,%g %gx%g glvp=%d,%d %dx%d "
+            "fbo=%d/%#x:%d faces=%#x/%d:%#x:%d:%#x:%d/%d:%#x:%d:%#x:%d "
+            "prim=%s indexed=%u count=%u tex=%p/%s/%ux%u "
+            "gltex=%u/%u rb=%u/%u loc=%#x bind=%#x units=%d/%d/%d/%d active=%#x "
+            "blend=%u/%u/%u/%u "
+            "atest=%u afunc=%u aref=%u faceL=%u/%u/%#llx faceR=%u/%u/%#llx%s\n",
+            InterlockedIncrement(&mgs_codec_event_id), seq, phase, vp->x, vp->y, vp->width, vp->height,
+            gl_vp[0], gl_vp[1], gl_vp[2], gl_vp[3], draw_framebuffer,
+            draw_attachment_type, draw_attachment,
+            have_face, face_fbo[0], face_attachment_type[0], face_attachment[0],
+            current_face_attachment_type[0], current_face_attachment[0],
+            face_fbo[1], face_attachment_type[1], face_attachment[1],
+            current_face_attachment_type[1], current_face_attachment[1],
+            debug_d3dprimitivetype(state->primitive_type), parameters->indexed, count,
+            resource, resource ? debug_d3dformat(resource->format->id) : "none",
+            resource ? resource->width : 0, resource ? resource->height : 0,
+            texture_rgb, texture_srgb, rb_multisample, rb_resolved,
+            texture_locations, texture_draw_binding,
+            bound_texture[0], bound_texture[1], bound_texture[2], bound_texture[3], active_texture,
+            rt ? rt->enable : 0, rt ? rt->src : 0, rt ? rt->dst : 0, rt ? rt->op : 0,
+            state->render_states[WINED3D_RS_ALPHATESTENABLE],
+            state->render_states[WINED3D_RS_ALPHAFUNC], state->render_states[WINED3D_RS_ALPHAREF],
+            nonblack[0], max_rgb[0], (unsigned long long)checksum[0],
+            nonblack[1], max_rgb[1], (unsigned long long)checksum[1],
+            (((have_face & 1) && !nonblack[0]) || ((have_face & 2) && !nonblack[1])) ? " LOST" : "");
+    fflush(f);
+
+    if (!strcmp(phase, "after")
+            && (((have_face & 1) && !nonblack[0]) || ((have_face & 2) && !nonblack[1])))
+        done = true;
+}
+
+/* Count whether selected codec-face draws produce any samples. Unlike a colour
+ * readback this remains meaningful when the fragment shader writes black, and
+ * therefore cleanly separates clipping / fragment-test failures from texture
+ * or lighting failures. GL_ANY_SAMPLES_PASSED is part of OpenGL ES 3.0. */
+static GLuint mgs_face_sample_query_id;
+
+static bool mgs_begin_codec_face_sample_query(const struct wined3d_context_gl *context_gl,
+        const struct wined3d_state *state)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    const struct wined3d_shader_resource_view *view;
+    const struct wined3d_resource *resource;
+    const struct wined3d_viewport *vp;
+    static unsigned int seq;
+
+    if (!mgs_face_sample_query_enabled() || seq >= 256 || !state->viewport_count
+            || state->shader[WINED3D_SHADER_TYPE_VERTEX]
+            || state->shader[WINED3D_SHADER_TYPE_PIXEL]
+            || state->primitive_type != WINED3D_PT_TRIANGLESTRIP
+            || !state->render_states[WINED3D_RS_LIGHTING])
+        return false;
+    vp = &state->viewports[0];
+    if (vp->width < 110.0f || vp->width > 120.0f || vp->height < 170.0f || vp->height > 220.0f)
+        return false;
+    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
+    if (!view || !(resource = view->resource)
+            || resource->format->id != WINED3DFMT_B8G8R8A8_UNORM
+            || resource->width != 512 || (resource->height != 512 && resource->height != 1024))
+        return false;
+
+    if (!mgs_face_sample_query_id)
+        GL_EXTCALL(glGenQueries(1, &mgs_face_sample_query_id));
+    if (!mgs_face_sample_query_id)
+        return false;
