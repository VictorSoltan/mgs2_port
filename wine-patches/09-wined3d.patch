+/* The probe named the guilty operand -- WINED3DTA_TEXTURE -- and the descriptor
+ * showed its colour fixup is XXX1, i.e. an L8-style format whose alpha is 1 by
+ * definition. Name the actual texture so the conclusion rests on the resource,
+ * not on inferring a format from a fixup code. Counts draws per class too:
+ * a translucent effect that saturates because it is drawn far more often than
+ * intended looks identical to one with wrong alpha. */
+static void mgs_report_effect_texture(const struct wined3d_gl_info *gl_info,
+        const struct wined3d_state *state)
+{
+    static unsigned int draws;
+    static FILE *f;
+    struct wined3d_texture *texture;
+
+    if (!f && !(f = fopen("/tmp/mgstexdraw.log", "w")))
+        return;
+    ++draws;
+    if (draws > 40)
+        return;
+
+    /* The provoking-vertex fix has to rewrite primitives, so its shape depends
+     * entirely on what the guilty draws actually submit: a triangle list can be
+     * rotated in place, strips and fans must be expanded first. Measure before
+     * writing the fix. */
+    fprintf(f, "draw %3u prim=%u indexed=%s shademode=%u\n", draws,
+            state->primitive_type,
+            state->index_buffer ? "yes" : "no",
+            state->render_states[WINED3D_RS_SHADEMODE]);
+
+    if ((texture = wined3d_state_get_ffp_texture(state, 0)))
+        fprintf(f, "draw %3u stage0 tex=%s %ux%u levels=%u fixup=%u%u%u%u\n", draws,
+                debug_d3dformat(texture->resource.format->id),
+                texture->resource.width, texture->resource.height,
+                texture->level_count,
+                texture->resource.format->color_fixup.x_source,
+                texture->resource.format->color_fixup.y_source,
+                texture->resource.format->color_fixup.z_source,
+                texture->resource.format->color_fixup.w_source);
+    else
+        fprintf(f, "draw %3u stage0 tex=<none>\n", draws);
+
+    /* Sampler parameters were never in the state record, and they are the one
+     * remaining way a texture with correct texels and an identity fixup can
+     * still sample alpha as 1.0: a min filter that expects mipmaps on a
+     * single-level texture leaves it incomplete, and GLES reads an incomplete
+     * texture as (0,0,0,1). A stale swizzle would do it too. */
+    if (draws == 1 && texture)
+    {
+        GLint minf = 0, magf = 0, base = 0, maxl = 0, sr = 0, sg = 0, sb = 0, sa = 0;
+
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, &minf);
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, &magf);
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_BASE_LEVEL, &base);
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, &maxl);
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_R, &sr);
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_G, &sg);
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_B, &sb);
+        gl_info->gl_ops.gl.p_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, &sa);
+        fprintf(f, "sampler min=%#x mag=%#x base=%d max=%d swizzle=%#x,%#x,%#x,%#x\n",
+                minf, magf, base, maxl, sr, sg, sb, sa);
+    }
+    fflush(f);
+}
