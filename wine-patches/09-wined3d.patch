+/* D3D A1R5G5B5 packs a word as  A RRRRR GGGGG BBBBB  (alpha in the high bit).
+ * GLES GL_UNSIGNED_SHORT_5_5_5_1 wants  RRRRR GGGGG BBBBB A  (alpha in the low
+ * bit). The two differ by a 16-bit rotate, so the conversion is exact and stays
+ * two bytes per texel -- no need to expand to RGBA8. Self-inverse it is not, so
+ * download rotates the other way. */
+static void convert_b5g5r5a1_unorm_gles(const BYTE *src, BYTE *dst, UINT src_row_pitch, UINT src_slice_pitch,
+        UINT dst_row_pitch, UINT dst_slice_pitch, UINT width, UINT height, UINT depth)
+{
+    unsigned int x, y, z;
+
+    for (z = 0; z < depth; ++z)
+    {
+        for (y = 0; y < height; ++y)
+        {
+            const unsigned short *src_row = (const unsigned short *)(src + z * src_slice_pitch + y * src_row_pitch);
+            unsigned short *dst_row = (unsigned short *)(dst + z * dst_slice_pitch + y * dst_row_pitch);
+
+            for (x = 0; x < width; ++x)
+            {
+                unsigned short v = src_row[x];
+                dst_row[x] = (unsigned short)((v << 1) | (v >> 15));
+            }
+        }
+    }
+}
