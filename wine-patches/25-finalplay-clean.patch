- * visible. Count only current producer batches whose every source draw is
- * rejected; this is the submission reduction a real culler could guarantee. */
-static void d3d8_mgs2_visibility_draw(struct d3d8_device *device,
-        D3DPRIMITIVETYPE primitive_type, BOOL batchable,
-        unsigned int start_vertex, unsigned int vertex_count,
-        BOOL compatible)
-{
-    const struct wined3d_stateblock_state *state = device->stateblock_state;
-    struct d3d8_vertex_declaration *decl;
-    struct d3d8_vertexbuffer *buffer;
-    unsigned int stream_idx, stride, left, position_offset, i, clip_and = 0x3f;
-    BOOL eligible = FALSE, culled = FALSE, current_merge, finite = TRUE;
-    float object[4], world[4], view[4], clip[4];
-
-    if (!d3d8_mgs2_visibility_census()
-            || d3d8_mgs2_visibility.frames % D3D8_MGS2_VISIBILITY_SAMPLE_PERIOD)
-        return;
-
-    ++d3d8_mgs2_visibility.draws;
-    if (!batchable)
-        ++d3d8_mgs2_visibility.source_unsupported;
-    else if (state->vs)
-        ++d3d8_mgs2_visibility.custom_shader;
-    else if (state->rs[WINED3D_RS_VERTEXBLEND]
-            || state->rs[WINED3D_RS_INDEXEDVERTEXBLENDENABLE])
-        ++d3d8_mgs2_visibility.vertex_blend;
-    else if (!d3d8_mgs2_vbo_source(device, primitive_type, start_vertex, vertex_count,
-            &stream_idx, &buffer, &stride, &left))
-        ++d3d8_mgs2_visibility.source_unsupported;
-    else
-    {
-        decl = wined3d_vertex_declaration_get_parent(state->vertex_declaration);
-        if (!d3d8_mgs2_visibility_position_offset(decl, stream_idx, &position_offset)
-                || position_offset > stride || sizeof(float) * 3 > stride - position_offset)
-            ++d3d8_mgs2_visibility.position_unsupported;
-        else if (buffer->mgs2_geometry_valid_overflow)
-            ++d3d8_mgs2_visibility.validity_overflow;
-        else if (!d3d8_mgs2_geometry_range_valid(buffer, left, left + vertex_count * stride))
-            ++d3d8_mgs2_visibility.invalid_coverage;
-        else
-        {
-            eligible = TRUE;
-            ++d3d8_mgs2_visibility.eligible;
-            for (i = 0; i < vertex_count; ++i)
-            {
-                memcpy(object, buffer->mgs2_snapshot + left + i * stride + position_offset,
