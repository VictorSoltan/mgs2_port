-    if (!mgs_codec_identity_mask_enabled() || !mgs_codec_face_seen || matched >= 2
-            || parameters->indirect || parameters->u.direct.index_count != 6
-            || state->primitive_type != WINED3D_PT_TRIANGLELIST || !state->viewport_count)
-        return false;
-    vp = &state->viewports[0];
-    if (vp->width < 600.0f || vp->height < 440.0f)
