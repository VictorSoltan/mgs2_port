-/*
- * MGS2_LINK_TWICE=1: does the driver cache programs by source?
- *
- * The prewarm idea -- link everything during loading so no link lands inside a
- * frame -- only works if the blob recognises a source it has already compiled.
- * wined3d looks programs up by its own state key, not by shader text, so a
- * pre-linked program is invisible to that lookup; the game will still call
- * glLinkProgram for its combination. The only way prewarm can pay off is if that
- * second link is cheap because the driver kept the result.
- *
- * So measure exactly that, once: right after the first real link, build a second
- * program from the same shader objects and time linking it. Costs one extra link
- * at startup and answers the question outright.
- */
-static void mgs2_link_twice_probe(const struct wined3d_gl_info *gl_info, GLuint program,
-        double first_ms)
-{
-    static int done;
-    char value[8];
-    DWORD len;
-    GLuint shaders[8], probe_program;
-    GLsizei count = 0, i;
-    double t0;
-    GLint status = 0;
-
-    if (done) return;
-    len = GetEnvironmentVariableA("MGS2_LINK_TWICE", value, sizeof(value));
-    if (!len || len >= sizeof(value) || value[0] == '0') return;
-    done = 1;
-
-    GL_EXTCALL(glGetAttachedShaders(program, ARRAY_SIZE(shaders), &count, shaders));
-    if (count <= 0) return;
-
-    probe_program = GL_EXTCALL(glCreateProgram());
-    for (i = 0; i < count; ++i)
-        GL_EXTCALL(glAttachShader(probe_program, shaders[i]));
-
-    t0 = mgs2_now_ms();
-    GL_EXTCALL(glLinkProgram(probe_program));
-    GL_EXTCALL(glGetProgramiv(probe_program, GL_LINK_STATUS, &status));
-    ERR("MGS2 LINKTWICE first=%.1f ms second=%.1f ms status=%d shaders=%d "
-        "(second cheap => the driver caches by source and prewarm works; "
-        "second as slow => prewarm is pointless, only program binaries help)\n",
-        first_ms, mgs2_now_ms() - t0, status, count);
-
-    GL_EXTCALL(glDeleteProgram(probe_program));
-}
