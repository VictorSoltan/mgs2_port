-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_VIEWPORT, gl_vp);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ALIGNMENT, &pack_alignment);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row_length);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_framebuffer);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_framebuffer);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_READ_BUFFER, &read_buffer);
-    if (gl_vp[2] <= 0 || gl_vp[2] > 120 || gl_vp[3] <= 0 || gl_vp[3] > 220)
-        return;
-
-    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, 0));
-    gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, draw_framebuffer);
-    gl_info->gl_ops.gl.p_glReadBuffer(GL_COLOR_ATTACHMENT0);
-    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
-    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
-    gl_info->gl_ops.gl.p_glReadPixels(gl_vp[0], gl_vp[1], gl_vp[2], gl_vp[3],
-            GL_RGBA, GL_UNSIGNED_BYTE, pixels);
-    checkGLcall("MGS2 codec face glReadPixels");
-    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, pack_alignment);
-    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, pack_row_length);
-    GL_EXTCALL(glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer));
-    gl_info->fbo_ops.glBindFramebuffer(GL_READ_FRAMEBUFFER, read_framebuffer);
-    gl_info->gl_ops.gl.p_glReadBuffer(read_buffer);
-
-    pixel_count = gl_vp[2] * gl_vp[3];
-    for (i = 0; i < pixel_count; ++i)
-    {
-        unsigned int c;
-
-        for (c = 0; c < 4; ++c)
-        {
-            unsigned char value = pixels[i * 4 + c];
