-static int mgs_alpha_draw_log_enabled(void)
-{
-    static int cached = -1;
-
-    if (cached < 0)
-    {
-        const char *e = getenv("MGS2_ALPHADRAWLOG");
-        cached = e && *e != '0';
-    }
-    return cached;
-}
-
-static unsigned int mgs_alpha_draw_log_after(void)
-{
-    static unsigned int cached;
-    static int checked;
-
-    if (!checked)
-    {
-        const char *e = getenv("MGS2_ALPHADRAWLOG_AFTER");
-        cached = e ? strtoul(e, NULL, 0) : 0;
-        checked = 1;
-    }
-    return cached;
-}
