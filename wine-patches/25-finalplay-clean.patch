-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_SRC_ALPHA, &gl_src_alpha);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_DST_ALPHA, &gl_dst_alpha);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_EQUATION_RGB, &gl_equation_rgb);
-    gl_info->gl_ops.gl.p_glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &gl_equation_alpha);
-
-    fprintf(f, "seq=%u draw=%u prim=%s first=%u count=%u tex=%p/%s/%ux%u "
-            "diff=%s/%u/%p a=%u/%g/%u uv=%s/%u/%p range=%g,%g/%g,%g tss=%u/%#x/%#x\n",
-            ++seq, mgs_draw_id, debug_d3dprimitivetype(state->primitive_type), first, count,
-            resource, resource ? debug_d3dformat(resource->format->id) : "none",
-            resource ? resource->width : 0, resource ? resource->height : 0,
-            diffuse->format ? debug_d3dformat(diffuse->format->id) : "none", diffuse->stride,
-            diffuse_data, amin, count && amin <= amax ? (double)asum / count : -1.0, amax,
-            texcoord->format ? debug_d3dformat(texcoord->format->id) : "none", texcoord->stride,
-            texcoord_data, umin, umax, vmin, vmax,
-            state->texture_states[0][WINED3D_TSS_ALPHA_OP],
-            state->texture_states[0][WINED3D_TSS_ALPHA_ARG1],
