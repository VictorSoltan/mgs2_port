-            vmax = max(vmax, uv[1]);
-        }
-    }
-    if (mapped_texcoord)
-    {
-        GL_EXTCALL(glUnmapBuffer(GL_ARRAY_BUFFER));
-        GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, old_array_buffer));
