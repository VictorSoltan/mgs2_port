-    {
-        const struct wined3d_stream_state *current = &state->streams[i];
-        const struct wined3d_stream_state *last = &d3d8_mgs2_projected.last_streams[i];
-
-        if (current->buffer != last->buffer)
-            mask |= D3D8_MGS2_STREAM_DIFF_BUFFER;
