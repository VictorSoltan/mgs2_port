-/* Count whether selected codec-face draws produce any samples. Unlike a colour
- * readback this remains meaningful when the fragment shader writes black, and
- * therefore cleanly separates clipping / fragment-test failures from texture
- * or lighting failures. GL_ANY_SAMPLES_PASSED is part of OpenGL ES 3.0. */
-static GLuint mgs_face_sample_query_id;
-
-static bool mgs_begin_codec_face_sample_query(const struct wined3d_context_gl *context_gl,
-        const struct wined3d_state *state)
-{
-    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
-    const struct wined3d_shader_resource_view *view;
-    const struct wined3d_resource *resource;
-    const struct wined3d_viewport *vp;
-    static unsigned int seq;
-
-    if (!mgs_face_sample_query_enabled() || seq >= 256 || !state->viewport_count
-            || state->shader[WINED3D_SHADER_TYPE_VERTEX]
-            || state->shader[WINED3D_SHADER_TYPE_PIXEL]
-            || state->primitive_type != WINED3D_PT_TRIANGLESTRIP
-            || !state->render_states[WINED3D_RS_LIGHTING])
-        return false;
-    vp = &state->viewports[0];
-    if (vp->width < 110.0f || vp->width > 120.0f || vp->height < 170.0f || vp->height > 220.0f)
-        return false;
-    view = state->shader_resource_view[WINED3D_SHADER_TYPE_PIXEL][0];
-    if (!view || !(resource = view->resource)
-            || resource->format->id != WINED3DFMT_B8G8R8A8_UNORM
-            || resource->width != 512 || (resource->height != 512 && resource->height != 1024))
-        return false;
-
-    if (!mgs_face_sample_query_id)
-        GL_EXTCALL(glGenQueries(1, &mgs_face_sample_query_id));
-    if (!mgs_face_sample_query_id)
-        return false;
-    GL_EXTCALL(glBeginQuery(GL_ANY_SAMPLES_PASSED, mgs_face_sample_query_id));
-    checkGLcall("MGS2 codec face glBeginQuery");
-    ++seq;
-    return true;
-}
-
-static void mgs_end_codec_face_sample_query(const struct wined3d_context_gl *context_gl, bool active)
-{
-    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
-    static unsigned int seq;
-    static FILE *f;
-    GLuint result = 0;
-
-    if (!active)
-        return;
-
-    GL_EXTCALL(glEndQuery(GL_ANY_SAMPLES_PASSED));
-    checkGLcall("MGS2 codec face glEndQuery");
-    GL_EXTCALL(glGetQueryObjectuiv(mgs_face_sample_query_id, GL_QUERY_RESULT, &result));
-    checkGLcall("MGS2 codec face glGetQueryObjectuiv");
-
-    if (!f && !(f = fopen("/tmp/mgsfacesamples.log", "w")))
-        return;
-    fprintf(f, "seq=%u any_samples=%u query=%u\n", ++seq, result, mgs_face_sample_query_id);
-    fflush(f);
-}
