-    hash ^= (ULONGLONG)(ULONG_PTR)declaration;
-    hash ^= (ULONGLONG)left << 32 | vertex_count;
-    hash ^= (ULONGLONG)stride << 32 | position_offset;
-    hash ^= hash >> 33;
