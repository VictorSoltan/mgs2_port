-    first = parameters->u.direct.start_idx;
-    count = parameters->u.direct.index_count;
-    diffuse = &context->stream_info.elements[WINED3D_FFP_DIFFUSE];
-    texcoord = &context->stream_info.elements[WINED3D_FFP_TEXCOORD0];
-    if ((context->stream_info.use_map & (1u << WINED3D_FFP_DIFFUSE))
