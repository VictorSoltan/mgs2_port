-static unsigned int d3d8_mgs2_cull_cache_set(ULONGLONG identity, ULONGLONG generation,
-        unsigned int left, unsigned int vertex_count, unsigned int stride,
-        unsigned int position_offset, const struct d3d8_vertex_declaration *declaration)
-{
