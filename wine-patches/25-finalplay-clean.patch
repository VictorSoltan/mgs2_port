-            ReadFile(h, buf, sizeof(buf) - 1, &got, NULL);
-            CloseHandle(h);
-        }
-        cached = (buf[0] == 'A' || buf[0] == 'B' || buf[0] == 'C') ? buf[0] : '0';
-    }
-    return cached;
-}
