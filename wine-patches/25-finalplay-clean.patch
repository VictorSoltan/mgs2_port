-static const BYTE *mgs_get_stream_element_sysmem(struct wined3d_context *context,
-        const struct wined3d_state *state, const struct wined3d_stream_info_element *element,
-        unsigned int first, unsigned int count)
-{
-    struct wined3d_buffer *buffer = state->streams[element->stream_idx].buffer;
-    const BYTE *base, *ptr;
-    uintptr_t offset;
-
-    if (!buffer)
-        return NULL;
-    if (!element->data.buffer_object)
-        return element->data.addr + ((intptr_t)state->load_base_vertex_index + first) * element->stride;
-    if (!(base = wined3d_buffer_load_sysmem(buffer, context)))
-        return NULL;
-
-    offset = (uintptr_t)element->data.addr
-            + ((intptr_t)state->load_base_vertex_index + first) * element->stride;
-    if (offset > buffer->resource.size || count > (buffer->resource.size - offset) / element->stride)
-        return NULL;
-    ptr = base + offset;
-    return ptr;
-}
