+/* Keep the expensive FIR convolution behind a simple, pointer-only ABI.  The
+ * ordinary implementation below remains valid x86 code; the MGS2 Box86 build
+ * may recognise its exact prologue and run the same job natively on ARM. */
+struct mgs2_fir_job
+{
+    float *output;
+    const float *intermediate;
+    float *fir_copy;
+    const float *fir_table;
+    DWORD count;
+    DWORD required_input;
+    DWORD channels;
+    DWORD output_channels;
+    DWORD firstep;
+    float firgain;
+    DWORD fir_length;
+    DWORD freq_start_low, freq_start_high;
+    DWORD freq_num_low, freq_num_high;
+    DWORD freq_den_low, freq_den_high;
+};
+
+static DECLSPEC_NOINLINE __attribute__((noclone)) void mgs2_resample_fir_target(
+        const struct mgs2_fir_job *job)
+{
+    ULONGLONG freq_start = ((ULONGLONG)job->freq_start_high << 32) | job->freq_start_low;
+    ULONGLONG freq_num = ((ULONGLONG)job->freq_num_high << 32) | job->freq_num_low;
+    ULONGLONG freq_den = ((ULONGLONG)job->freq_den_high << 32) | job->freq_den_low;
+    DWORD i;
+
+    for (i = 0; i < job->count; ++i)
+    {
+        ULONGLONG phase = freq_start + i * freq_num;
+        UINT int_fir_steps = phase * job->firstep / freq_den;
+        float total_fir_steps = phase * job->firstep / (float)freq_den;
+        UINT ipos = int_fir_steps / job->firstep;
+        UINT idx = (ipos + 1) * job->firstep - int_fir_steps - 1;
+        float rem = int_fir_steps + 1.0 - total_fir_steps;
+        UINT fir_used = 0, channel;
+
+        while (idx < job->fir_length - 1)
+        {
+            job->fir_copy[fir_used++] = job->fir_table[idx] * (1.0 - rem)
+                    + job->fir_table[idx + 1] * rem;
+            idx += job->firstep;
+        }
+
+        for (channel = 0; channel < job->channels; ++channel)
+        {
+            const float *cache = job->intermediate + channel * job->required_input + ipos;
+            float sum = 0.0f;
+            UINT j;
+
+            for (j = 0; j < fir_used; ++j)
+                sum += job->fir_copy[j] * cache[j];
+            job->output[i * job->output_channels + channel] = sum * job->firgain;
+        }
+    }
+}
+
