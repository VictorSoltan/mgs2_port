+/* Patch 31, gated on MGS2_D3D8_CULL_BOX. Instead of scanning the draw's own vertex
+ * range on every tested draw -- 349 times per frame, in emulated x86 -- scan every
+ * byte this buffer declares valid once, on the first test after a write, and let
+ * every later draw reuse that one box.
+ *
+ * The box is CONSERVATIVE: it covers vertices outside the draw's range, so it can
+ * only fail to cull something that the exact box would have culled. It can never
+ * cull something visible, which is the direction that matters. The cost is fewer
+ * culled draws; MGS2CULL's culled/f is the number that says whether that trade is
+ * worth it, and it is why this ships switchable.
+ *
+ * Invalidated wherever mgs2_geometry_generation is bumped, i.e. on every writable
+ * Unlock, because after a write the vertices genuinely are different. */
+static BOOL d3d8_mgs2_cull_box(struct d3d8_vertexbuffer *buffer, unsigned int stride,
+        unsigned int position_offset, float min_value[3], float max_value[3])
+{
+    float box_min[3], box_max[3];
+    unsigned int i, axis;
+    BOOL any = FALSE;
+
+    if (buffer->mgs2_cull_box_valid && buffer->mgs2_cull_box_stride == stride
+            && buffer->mgs2_cull_box_offset == position_offset)
+    {
+        memcpy(min_value, buffer->mgs2_cull_box_min, sizeof(buffer->mgs2_cull_box_min));
+        memcpy(max_value, buffer->mgs2_cull_box_max, sizeof(buffer->mgs2_cull_box_max));
+        return TRUE;
+    }
+
+    /* An overflowed range list no longer describes the whole buffer, so a box
+     * built from it would not be conservative. Fall back to the exact per-draw
+     * scan in that case rather than risk culling something visible. */
+    if (buffer->mgs2_geometry_valid_overflow || !buffer->mgs2_geometry_valid_count)
+        return FALSE;
+
+    for (i = 0; i < buffer->mgs2_geometry_valid_count; ++i)
+    {
+        unsigned int left = buffer->mgs2_geometry_valid_ranges[i].left;
+        unsigned int right = buffer->mgs2_geometry_valid_ranges[i].right;
+        unsigned int count;
+        float r_min[3], r_max[3];
+
+        if (right <= left || position_offset > stride || sizeof(float) * 3 > stride - position_offset)
+            return FALSE;
+        count = (right - left) / stride;
+        if (!count)
+            continue;
+        if (!d3d8_mgs2_scan_aabb(buffer, left, count, stride, position_offset, r_min, r_max))
+            return FALSE;
+        for (axis = 0; axis < 3; ++axis)
+        {
+            if (!any || r_min[axis] < box_min[axis]) box_min[axis] = r_min[axis];
+            if (!any || r_max[axis] > box_max[axis]) box_max[axis] = r_max[axis];
+        }
+        any = TRUE;
+    }
+
+    if (!any)
+        return FALSE;
+
+    memcpy(buffer->mgs2_cull_box_min, box_min, sizeof(box_min));
+    memcpy(buffer->mgs2_cull_box_max, box_max, sizeof(box_max));
+    buffer->mgs2_cull_box_stride = stride;
+    buffer->mgs2_cull_box_offset = position_offset;
+    buffer->mgs2_cull_box_valid = TRUE;
+    memcpy(min_value, box_min, sizeof(box_min));
+    memcpy(max_value, box_max, sizeof(box_max));
+    return TRUE;
+}
+
+/* Patch 25 removed every env-gated branch from this file, so there is no helper
+ * left to reuse; this reads its own switch once. Off by default: the box trades
+ * culling accuracy for scan cost and only a measurement on the device can say
+ * whether that trade is good. */
+static BOOL d3d8_mgs2_cull_box_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0)
+    {
+        const char *value = getenv("MGS2_D3D8_CULL_BOX");
+
+        on = value && strcmp(value, "0") ? 1 : 0;
+    }
+    return on;
+}
+
+static BOOL d3d8_mgs2_cull_aabb(struct d3d8_vertexbuffer *buffer, unsigned int left,
+        unsigned int vertex_count, unsigned int stride, unsigned int position_offset,
+        float min_value[3], float max_value[3])
+{
+    if (d3d8_mgs2_cull_box_enabled()
+            && d3d8_mgs2_cull_box(buffer, stride, position_offset, min_value, max_value))
+        return TRUE;
+
+    return d3d8_mgs2_scan_aabb(buffer, left, vertex_count, stride, position_offset,
+            min_value, max_value);
+}
