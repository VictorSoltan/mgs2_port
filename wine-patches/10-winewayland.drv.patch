+static void mgs_release_pbos(struct wayland_gl_drawable *gl)
+{
+    /* Deleting GL objects requires a current context. Teardown can happen
+     * after the context is gone, in which case the buffers die with it and
+     * calling glDeleteBuffers would be at best a no-op. */
+    BOOL have_ctx = funcs->p_eglGetCurrentContext() != EGL_NO_CONTEXT;
+    int i;
+
+    if (!gl->pbo_active) return;
+    for (i = 0; i < MGS_MAX_PBOS; i++)
+    {
+        if (!gl->pbo[i]) continue;
+        if (have_ctx) funcs->p_glDeleteBuffers(1, &gl->pbo[i]);
+        gl->pbo[i] = 0;
+    }
+    gl->pbo_active = FALSE;
+    gl->pbo_filled = 0;
+    gl->pbo_index = 0;
