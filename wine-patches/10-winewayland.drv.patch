+static BOOL wayland_gl_drawable_resize_pbuffer(struct wayland_gl_drawable *gl, int width, int height)
+{
+    EGLint attribs[] = { EGL_WIDTH, width, EGL_HEIGHT, height, EGL_NONE };
+    EGLConfig config = egl_config_for_format(gl->base.format);
+    EGLSurface old = gl->base.surface, surface;
+    BOOL was_current = old && funcs->p_eglGetCurrentSurface(EGL_DRAW) == old;
+
+    if (width <= 0) width = 1;
+    if (height <= 0) height = 1;
+    if (old && gl->width == width && gl->height == height) return TRUE;
+
+    if (!(surface = funcs->p_eglCreatePbufferSurface(egl->display, config, attribs)))
+    {
+        ERR("eglCreatePbufferSurface failed for %dx%d\n", width, height);
+        return FALSE;
+    }
+
+    gl->base.surface = surface;
+    gl->width = width;
+    gl->height = height;
+
+    if (was_current)
+    {
+        EGLContext ctx = funcs->p_eglGetCurrentContext();
+        funcs->p_eglMakeCurrent(egl->display, surface, surface, ctx);
+    }
+    if (old) funcs->p_eglDestroySurface(egl->display, old);
+
+    /* geometry changed, the pixel-pack buffers are the wrong size now */
+    mgs_release_pbos(gl);
+    mgs_release_shm_buffers(gl);
+
+    TRACE("resized pbuffer to %dx%d surface %p\n", width, height, surface);
+    return TRUE;
