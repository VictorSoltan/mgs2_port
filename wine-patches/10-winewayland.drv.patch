+static BOOL mgs_ensure_pbos(struct wayland_gl_drawable *gl)
+{
+    const size_t size = (size_t)gl->width * gl->height * 4;
+    int i;
+
+    if (gl->pbo_active && gl->pbo_width == gl->width && gl->pbo_height == gl->height)
+        return TRUE;
+
+    mgs_release_pbos(gl);
+
+    if (!funcs->p_glGenBuffers || !funcs->p_glBindBuffer || !funcs->p_glBufferData ||
+        !funcs->p_glMapBufferRange || !funcs->p_glUnmapBuffer || !funcs->p_glDeleteBuffers)
+    {
+        ERR("PBO entry points unavailable, falling back to synchronous readback\n");
+        mgs_cfg.use_pbo = FALSE;
+        return FALSE;
+    }
+
+    for (i = 0; i < mgs_cfg.pbos; i++)
+    {
+        funcs->p_glGenBuffers(1, &gl->pbo[i]);
+        if (!gl->pbo[i])
+        {
+            ERR("glGenBuffers failed, falling back to synchronous readback\n");
+            mgs_release_pbos(gl);
+            mgs_cfg.use_pbo = FALSE;
+            return FALSE;
+        }
+        funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, gl->pbo[i]);
+        funcs->p_glBufferData(GL_PIXEL_PACK_BUFFER, size, NULL, GL_STREAM_READ);
+    }
+    funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+
+    gl->pbo_width = gl->width;
+    gl->pbo_height = gl->height;
+    gl->pbo_filled = 0;
+    gl->pbo_index = 0;
+    gl->pbo_active = TRUE;
+    return TRUE;
+}
