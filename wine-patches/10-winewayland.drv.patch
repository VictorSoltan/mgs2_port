+/* Pick a shm buffer of the right size that the compositor is not holding.
+ * Grows the pool lazily up to mgs_cfg.shm_buffers entries. */
+static struct wayland_shm_buffer *mgs_acquire_shm_buffer(struct wayland_gl_drawable *gl,
+                                                         int width, int height)
+{
+    struct wayland_shm_buffer *buf;
+    int i;
+
+    for (i = 0; i < gl->shm_count; i++)
+    {
+        buf = gl->shm_buffers[i];
+        if (buf && !buf->busy && buf->width == width && buf->height == height)
+            return buf;
+    }
+
+    if (gl->shm_count < mgs_cfg.shm_buffers)
+    {
+        if (!(buf = wayland_shm_buffer_create(width, height, WL_SHM_FORMAT_XRGB8888)))
+        {
+            ERR("wayland_shm_buffer_create failed for %dx%d\n", width, height);
+            return NULL;
+        }
+        wl_proxy_set_queue((struct wl_proxy *)buf->wl_buffer, gl->wl_event_queue);
+        wl_buffer_add_listener(buf->wl_buffer, &mgs_buffer_listener, buf);
+        gl->shm_buffers[gl->shm_count++] = buf;
+        return buf;
+    }
+
+    /* Pool is full and everything is in flight: drain release events, then
+     * take whatever became free. */
+    wl_display_dispatch_queue_pending(process_wayland.wl_display, gl->wl_event_queue);
+    for (i = 0; i < gl->shm_count; i++)
+    {
+        buf = gl->shm_buffers[i];
+        if (buf && !buf->busy && buf->width == width && buf->height == height)
+            return buf;
+    }
+    return NULL;
+}
