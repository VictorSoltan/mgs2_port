+/* Copy width*height BGRA/RGBA pixels from src into the shm buffer, flipping
+ * vertically if requested (GL origin is bottom-left, wl_shm is top-left) and
+ * swapping R/B when we could not read in the compositor's byte order. */
+static void mgs_copy_to_shm(struct wayland_gl_drawable *gl, struct wayland_shm_buffer *dst,
+                            const unsigned char *src)
+{
+    const int w = gl->width, h = gl->height;
+    const size_t stride = (size_t)w * 4;
+    unsigned char *out = dst->map_data;
+    int y;
+
+    /* wayland_shm_buffer_create allocates width*height*4 for XRGB8888 and the
+     * struct carries no stride, so stride is width*4 by construction. Bail out
+     * rather than run off the mapping if that ever stops holding. */
+    if (!out || dst->map_size < stride * (size_t)h)
+    {
+        ERR("shm buffer too small: map_size %zu, need %zu (%dx%d)\n",
+            dst->map_size, stride * (size_t)h, w, h);
+        return;
+    }
+
+    if (mgs_cfg.bgra)
+    {
+        if (!mgs_cfg.flip)
+        {
+            memcpy(out, src, stride * h);
+            return;
+        }
+        for (y = 0; y < h; y++)
+            memcpy(out + (size_t)y * stride, src + (size_t)(h - 1 - y) * stride, stride);
+        return;
+    }
+
+    /* RGBA fallback: swap R and B while copying. */
+    for (y = 0; y < h; y++)
+    {
+        const unsigned char *s = src + (size_t)(mgs_cfg.flip ? (h - 1 - y) : y) * stride;
+        unsigned char *d = out + (size_t)y * stride;
+        int x;
+        for (x = 0; x < w; x++, s += 4, d += 4)
+        {
+            d[0] = s[2];
+            d[1] = s[1];
+            d[2] = s[0];
+            d[3] = s[3];
+        }
+    }
+}
+
+static void mgs_present_shm(struct wayland_gl_drawable *gl, struct wayland_shm_buffer *buf)
+{
+    struct wayland_client_surface *client =
+        CONTAINING_RECORD(gl->base.client, struct wayland_client_surface, client);
+
+    buf->busy = TRUE;
+    wayland_shm_buffer_ref(buf);
+    wl_surface_attach(client->wl_surface, buf->wl_buffer, 0, 0);
+    wl_surface_damage_buffer(client->wl_surface, 0, 0, gl->width, gl->height);
+    wl_surface_commit(client->wl_surface);
+    wl_display_flush(process_wayland.wl_display);
