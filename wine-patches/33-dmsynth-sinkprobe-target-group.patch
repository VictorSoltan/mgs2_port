+/* The historical probe targeted group 2, which was the weapon-shot route used
+ * to build it.  MGS2's current autoloaded punch candidate is group 1.  Keep the
+ * old default, but allow a deliberate diagnostic run to select the group
+ * without rebuilding another one-off DLL.  This is only evaluated after one of
+ * the probe switches is enabled. */
+static DWORD sinkprobe_target_group(void)
+{
+    static int group = -1;
+
+    if (group == -1)
+        group = mgs2_env_int("MGS2_SINKPROBE_GROUP", 2, 1, 32);
+    return group;
+}
+
+/* No program filter preserves the historical queue-time capture.  When the
+ * variable is present, the queue-side call passes -1 and is ignored; the
+ * render-side call supplies FluidSynth's actual selected program. */
+static int sinkprobe_target_program(void)
+{
+    static int target = -2;
+    char value[16];
+    DWORD len;
+
+    if (target == -2)
+    {
+        len = GetEnvironmentVariableA("MGS2_SINKPROBE_PROGRAM", value, sizeof(value));
+        target = len && len < sizeof(value) ?
+                mgs2_env_int("MGS2_SINKPROBE_PROGRAM", 0, 0, 127) : -1;
+    }
+    return target;
+}
+
+BOOL synth_sink_probe_program_filter_enabled(void)
+{
+    return sinkprobe_target_program() >= 0;
+}
+
+static BOOL sinkprobe_target_program_matches(int program)
+{
+    int target = sinkprobe_target_program();
+
+    return target < 0 || (program >= 0 && program == target);
+}
+
