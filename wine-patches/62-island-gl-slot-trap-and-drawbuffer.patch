+/*
+ * One numbering for every pointer this file translates, so a slot number in a
+ * log names exactly one thing:
+ *
+ *   0                       .. GL_SLOT_COUNT-1   gl_ops, position IS the name
+ *   GL_SLOT_COUNT           .. +20               fbo_ops
+ *   GL_SLOT_COUNT + 0x100   .. +generic count    ffp_attrib_ops.generic[]
+ *   GL_SLOT_COUNT + 0x200 / +0x201               glDisableWINE / glEnableWINE
+ *
+ * The trap table in Box86 is indexed by this same number, which is why the
+ * offsets are sparse: they leave room for each group to grow without renumbering
+ * the ones already printed in old logs.
+ */
+#define MGS2_GL_SLOT_COUNT   (sizeof(struct wined3d_gl_funcs) / sizeof(void *))
+#define MGS2_FBO_SLOT_BASE   (MGS2_GL_SLOT_COUNT)
+#define MGS2_FFP_SLOT_BASE   (MGS2_GL_SLOT_COUNT + 0x100)
+#define MGS2_WINE_SLOT_BASE  (MGS2_GL_SLOT_COUNT + 0x200)
+
+const char *mgs2_island_gl_slot_name(unsigned int slot)
+{
+    if (slot < MGS2_GL_SLOT_COUNT)
+        return mgs2_gl_slot_name[slot];
+    if (slot >= MGS2_FBO_SLOT_BASE
+            && slot < MGS2_FBO_SLOT_BASE + ARRAY_SIZE(mgs2_fbo_slot_name))
+        return mgs2_fbo_slot_name[slot - MGS2_FBO_SLOT_BASE];
+    if (slot >= MGS2_FFP_SLOT_BASE && slot < MGS2_FFP_SLOT_BASE + WINED3D_FFP_EMIT_COUNT)
+    {
+        /* No name list exists for these -- they are WineD3D's own emitters,
+         * identified by index, and the caller already prints the number. No
+         * formatting here on purpose: the island reaches libc through Box86's
+         * stub list, and half of it aborts by design. */
+        return "ffp_attrib_ops.generic[]";
+    }
+    if (slot == MGS2_WINE_SLOT_BASE)
+        return "glDisableWINE";
+    if (slot == MGS2_WINE_SLOT_BASE + 1)
+        return "glEnableWINE";
+    return NULL;
+}
+
+/*
+ * glDrawBuffer(), implemented for the island in terms of glDrawBuffers().
+ *
+ * This is a RESOLUTION, not a stand-in. The scalar entry point does not exist on
+ * this stack at all: libmali exports glDrawBuffers and glReadBuffer but no
+ * glDrawBuffer (readelf on the device), and Wine's GLES path does not fill the
+ * unix half of it either, so the guest's own slot ends in code the island cannot
+ * call. The array form with one element is the documented GLES equivalent, and
+ * it is the mapping this tree ALREADY uses for the same reason in
+ * wined3d_context_gl_apply_draw_buffers(); this puts it where the island's own
+ * table can use it too.
+ *
+ * It is installed only when glDrawBuffers itself resolved. If it did not, the
+ * slot keeps whatever the failure path put there -- an unresolved call must fail,
+ * not quietly do nothing.
+ *
+ * Found by the diagnostic trap: "called UNRESOLVED GL slot 90 (glDrawBuffer)
+ * from wined3d_context_gl_apply_fbo_state+0x2a0", which is the inlined
+ * wined3d_context_gl_set_draw_buffer(context_gl, GL_NONE) on the FBO attach
+ * path. Section 18 of docs/briefs/MGS2_ISLAND_ENTRY34_FAULT_2026-08-19.md.
+ */
+static void (WINE_GLAPI *mgs2_island_native_draw_buffers)(GLsizei n, const GLenum *bufs);
+
+static void WINE_GLAPI mgs2_island_gl_draw_buffer(GLenum buffer)
+{
+    mgs2_island_native_draw_buffers(1, &buffer);
+}
