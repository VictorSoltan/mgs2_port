+    /* An OpenGL ES implementation reports "OpenGL ES 3.2 <vendor stuff>" or
+     * "OpenGL ES-CM 1.1 ...", per the GLES spec's GL_VERSION format. atoi() on
+     * that returns 0, the caller then substitutes major version 1, and every
+     * entry point whose registry requirement is GL_VERSION_3_x is refused --
+     * even though the driver resolves it perfectly well. That is why
+     * glClearBufferfv, glClearDepthf and glDepthRangef all come back NULL from
+     * wglGetProcAddress on this device while glDrawBuffers, which an extension
+     * name vouches for, gets through. Skip the prefix so the real version is
+     * parsed. */
+    if (!strncmp( ptr, "OpenGL ES-CM ", 13 )) ptr += 13;
+    else if (!strncmp( ptr, "OpenGL ES ", 10 )) ptr += 10;
+
