+        gl->t_prev_swap_ab = now;
+    }
+
+done:
+    mgs_restore_pack_state(saved_pack_pbo, saved_pack_alignment, saved_pack_row_length,
+            saved_pack_skip_rows, saved_pack_skip_pixels);
