+static void mgs_sfx_write_wav(const char *path, const void *data, DWORD bytes, DWORD rate)
+{
+    static const char riff[] = "RIFF", wave[] = "WAVE", fmt[] = "fmt ", data_tag[] = "data";
+    DWORD riff_size = bytes + 36, fmt_size = 16, byte_rate = rate * 2, data_size = bytes;
+    WORD format = WAVE_FORMAT_PCM, channels = 1, block_align = 2, bits = 16;
+    FILE *file = fopen(path, "wb");
+
+    if (!file) return;
+    fwrite(riff, sizeof(riff) - 1, 1, file);
+    fwrite(&riff_size, sizeof(riff_size), 1, file);
+    fwrite(wave, sizeof(wave) - 1, 1, file);
+    fwrite(fmt, sizeof(fmt) - 1, 1, file);
+    fwrite(&fmt_size, sizeof(fmt_size), 1, file);
+    fwrite(&format, sizeof(format), 1, file);
+    fwrite(&channels, sizeof(channels), 1, file);
+    fwrite(&rate, sizeof(rate), 1, file);
+    fwrite(&byte_rate, sizeof(byte_rate), 1, file);
+    fwrite(&block_align, sizeof(block_align), 1, file);
+    fwrite(&bits, sizeof(bits), 1, file);
+    fwrite(data_tag, sizeof(data_tag) - 1, 1, file);
+    fwrite(&data_size, sizeof(data_size), 1, file);
+    fwrite(data, bytes, 1, file);
+    fclose(file);
+}
+
+static DWORD mgs_sfx_decode_vag(const BYTE *source, DWORD bytes, DWORD start, SHORT *output)
+{
+    static const double coeff[5][2] = {
+        { 0.0, 0.0 }, { 60.0 / 64.0, 0.0 }, { 115.0 / 64.0, -52.0 / 64.0 },
+        { 98.0 / 64.0, -55.0 / 64.0 }, { 122.0 / 64.0, -60.0 / 64.0 }
+    };
+    double s1 = 0.0, s2 = 0.0;
+    DWORD offset, samples = 0;
+
+    for (offset = start; offset + 16 <= bytes; offset += 16)
+    {
+        DWORD i;
+        BYTE header = source[offset], flags = source[offset + 1];
+        int predictor = header >> 4, shift = header & 0x0f;
+
+        if (predictor > 4 || shift > 12 || flags > 7) break;
+        for (i = 0; i < 14; ++i)
+        {
+            BYTE packed = source[offset + 2 + i];
+            int nibbles[2] = { packed & 0x0f, packed >> 4 };
+            DWORD n;
+
+            for (n = 0; n < 2; ++n)
+            {
+                int value = nibbles[n];
+                double decoded;
+
+                if (value & 8) value -= 16;
+                decoded = ((value << 12) >> shift) + s1 * coeff[predictor][0]
+                        + s2 * coeff[predictor][1];
+                if (decoded > 32767.0) decoded = 32767.0;
+                if (decoded < -32768.0) decoded = -32768.0;
+                output[samples++] = (SHORT)decoded;
+                s2 = s1;
+                s1 = decoded;
+            }
+        }
+        if (flags & 1) break;
+    }
+    return samples;
+}
+
+static void mgs_sfx_dump_once(const IDirectSoundBufferImpl *dsb)
+{
+    static LONG dumped;
+    struct mgs_sfx_stats stats;
+    char dir[MAX_PATH], path[MAX_PATH];
+    SHORT *decoded;
+    DWORD decoded_samples;
+    FILE *file;
+
+    if (InterlockedCompareExchange(&dumped, 1, 0)) return;
+    mgs_sfx_analyse(dsb->buffer->memory, dsb->buflen, &stats);
+    mgs_sfx_dump_dir(dir, sizeof(dir));
+
+    snprintf(path, sizeof(path), "%s\\sfx_play_01.raw", dir);
+    file = fopen(path, "wb");
+    if (file)
+    {
+        fwrite(dsb->buffer->memory, dsb->buflen, 1, file);
+        fclose(file);
+    }
+    snprintf(path, sizeof(path), "%s\\as_pcm44100.wav", dir);
+    mgs_sfx_write_wav(path, dsb->buffer->memory, dsb->buflen, 44100);
+
+    decoded = HeapAlloc(GetProcessHeap(), 0, dsb->buflen / 16 * 28 * sizeof(*decoded));
+    if (decoded)
+    {
+        decoded_samples = mgs_sfx_decode_vag(dsb->buffer->memory, dsb->buflen,
+                stats.vag_offset, decoded);
+        snprintf(path, sizeof(path), "%s\\as_vag22050.wav", dir);
+        mgs_sfx_write_wav(path, decoded, decoded_samples * sizeof(*decoded), 22050);
+        HeapFree(GetProcessHeap(), 0, decoded);
+    }
+
+    snprintf(path, sizeof(path), "%s\\sfx_play_01.txt", dir);
+    file = fopen(path, "wt");
+    if (!file) return;
+    fprintf(file, "buffer=%p\nfrequency=%lu\nchannels=%u\nbits=%u\nvolume=%ld\npan=%ld\n"
+            "play_cursor=%lu\nnonzero_bytes=%lu/%lu\nnonzero_range=%lu..%lu\n"
+            "pcm16_peak=%lu/32768\npcm16_rms=%.6f\n"
+            "vag_best_offset=%lu\nvag_valid_blocks=%lu/%lu\nvag_validity_per_mille=%lu\n"
+            "vag_end_flag_blocks=%lu\n",
+            dsb->buffer->memory, dsb->pwfx->nSamplesPerSec, dsb->pwfx->nChannels,
+            dsb->pwfx->wBitsPerSample, dsb->volpan.lVolume, dsb->volpan.lPan,
+            dsb->sec_mixpos, stats.nonzero_bytes, dsb->buflen,
+            stats.first_nonzero, stats.last_nonzero, stats.pcm_peak, stats.pcm_rms,
+            stats.vag_offset, stats.vag_valid, stats.vag_total,
+            stats.vag_total ? stats.vag_valid * 1000 / stats.vag_total : 0,
+            stats.vag_end_blocks);
+    fclose(file);
+}
