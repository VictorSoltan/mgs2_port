+
+    snprintf(path, sizeof(path), "/dev/dma_heap/%s", heap);
+    if ((hfd = open(path, O_RDWR | O_CLOEXEC)) < 0)
+    {
+        ERR("MGS2 dmabuf: cannot open %s: %s\n", path, strerror(errno));
+        return -1;
+    }
+    memset(&req, 0, sizeof(req));
+    req.len = len;
+    req.fd_flags = O_RDWR | O_CLOEXEC;
+    r = ioctl(hfd, MGS_DMA_HEAP_IOCTL_ALLOC, &req);
+    close(hfd);
+    if (r < 0)
+    {
+        ERR("MGS2 dmabuf: ALLOC on %s failed: %s\n", heap, strerror(errno));
+        return -1;
+    }
+    return (int)req.fd;
+}
+
+static void mgs_dmabuf_release(void *data, struct wl_buffer *buffer)
+{
+    struct mgs_dmabuf_buffer *b = data;
+    (void)buffer;
+    b->busy = FALSE;
+}
+static const struct wl_buffer_listener mgs_dmabuf_buffer_listener = { mgs_dmabuf_release };
+
+static void mgs_dmabuf_global(void *data, struct wl_registry *reg, uint32_t name,
+                              const char *iface, uint32_t version)
+{
+    struct wayland_gl_drawable *gl = data;
+
+    if (strcmp(iface, "zwp_linux_dmabuf_v1")) return;
+    /* Bind at 3: version 3 is the highest this hand-written table describes, and
+     * binding above what the table covers is how a client earns a protocol
+     * error the first time the compositor sends an event it did not expect. */
+    gl->dmabuf_global = wl_registry_bind(reg, name, &mgs_zwp_linux_dmabuf_v1_interface,
+                                         version < 3 ? version : 3);
+    TRACE("MGS2 dmabuf: bound zwp_linux_dmabuf_v1 (compositor offers v%u)\n", version);
+}
+static void mgs_dmabuf_global_remove(void *d, struct wl_registry *r, uint32_t n)
+{ (void)d; (void)r; (void)n; }
+static const struct wl_registry_listener mgs_dmabuf_registry_listener =
+{ mgs_dmabuf_global, mgs_dmabuf_global_remove };
+
+static void mgs_dmabuf_teardown(struct wayland_gl_drawable *gl)
+{
+    BOOL have_ctx = funcs->p_eglGetCurrentContext() != EGL_NO_CONTEXT;
+    int i;
+
+    for (i = 0; i < gl->dmabuf_count; i++)
+    {
+        struct mgs_dmabuf_buffer *b = &gl->dmabuf[i];
+
+        if (b->wl_buffer) wl_buffer_destroy(b->wl_buffer);
+        if (b->image && p_mgs_eglDestroyImageKHR)
+            p_mgs_eglDestroyImageKHR(egl->display, b->image);
+        if (have_ctx)
+        {
+            if (b->fbo) funcs->p_glDeleteFramebuffers(1, &b->fbo);
+            if (b->tex) funcs->p_glDeleteTextures(1, &b->tex);
+        }
+        if (b->fd >= 0) close(b->fd);
+        if (b->sendfd >= 0) close(b->sendfd);
+        memset(b, 0, sizeof(*b));
+        b->fd = -1;
+        b->sendfd = -1;
+    }
+    gl->dmabuf_count = 0;
+    if (gl->dmabuf_registry)
+    {
+        wl_registry_destroy(gl->dmabuf_registry);
+        gl->dmabuf_registry = NULL;
+    }
+}
+
+/* Build the ring. Any failure is permanent for this drawable: it sets
+ * dmabuf_failed and the caller drops back to the shm path for good, because a
+ * presenter that retries an allocation every frame is worse than one that never
+ * had it. */
+static BOOL mgs_dmabuf_ensure(struct wayland_gl_drawable *gl)
+{
+    struct wl_registry *reg;
+    int i;
+
+    if (gl->dmabuf_failed) return FALSE;
+    if (gl->dmabuf_count && gl->dmabuf_width == gl->width
+        && gl->dmabuf_height == gl->height)
+        return TRUE;
+
+    mgs_dmabuf_teardown(gl);
+
+    if (!p_mgs_eglCreateImageKHR)
+    {
+        p_mgs_eglCreateImageKHR = (void *)funcs->p_eglGetProcAddress("eglCreateImageKHR");
+        p_mgs_eglDestroyImageKHR = (void *)funcs->p_eglGetProcAddress("eglDestroyImageKHR");
+        p_mgs_glEGLImageTargetTexture2DOES =
+            (void *)funcs->p_eglGetProcAddress("glEGLImageTargetTexture2DOES");
+        p_mgs_eglDupNativeFenceFDANDROID =
+            (void *)funcs->p_eglGetProcAddress("eglDupNativeFenceFDANDROID");
+    }
+    if (!p_mgs_eglCreateImageKHR || !p_mgs_glEGLImageTargetTexture2DOES)
+    {
+        ERR("MGS2 dmabuf: EGLImage entry points missing, staying on shm\n");
+        gl->dmabuf_failed = TRUE;
+        return FALSE;
+    }
+
+    /*
+     * Binding the global must not block this thread, and the first version of
+     * this code did exactly that with wl_display_roundtrip_queue. That hung the
+     * game: winewayland.drv keeps its own event thread inside
+     * wl_display_dispatch -> poll, libwayland serialises display access behind
+     * an internal mutex, and a blocking roundtrip issued from the wined3d CS
+     * thread deadlocks against it. The captured signature was one thread in an
+     * endless poll and the CS thread in FUTEX_WAIT_PRIVATE on a contended mutex.
+     *
+     * So: ask once, never wait. Until the global turns up, the caller presents
+     * through shm as it always did, and the ring is built on a later frame.
+     */
+    if (!gl->dmabuf_global)
+    {
+        if (!gl->dmabuf_registry)
+        {
+            reg = wl_display_get_registry(process_wayland.wl_display);
+            if (!reg) { gl->dmabuf_failed = TRUE; return FALSE; }
+            wl_proxy_set_queue((struct wl_proxy *)reg, gl->wl_event_queue);
+            wl_registry_add_listener(reg, &mgs_dmabuf_registry_listener, gl);
+            gl->dmabuf_registry = reg;
+            wl_display_flush(process_wayland.wl_display);
+        }
+        wl_display_dispatch_queue_pending(process_wayland.wl_display, gl->wl_event_queue);
+        if (!gl->dmabuf_global)
+        {
+            if (++gl->dmabuf_bind_tries > 300)
+            {
+                ERR("MGS2 dmabuf: no zwp_linux_dmabuf_v1 after 300 frames, "
+                    "staying on shm\n");
+                gl->dmabuf_failed = TRUE;
+            }
+            return FALSE;
+        }
+    }
+
+    for (i = 0; i < mgs_cfg.dmabuf_bufs; i++)
+    {
+        struct mgs_dmabuf_buffer *b = &gl->dmabuf[i];
+        const int stride = gl->width * 4;
+        struct wl_proxy *params;
+        int attrs[13], n = 0;
+        unsigned int status;
+
+        b->fd = mgs_dma_heap_alloc(mgs_cfg.dmabuf_heap, (size_t)stride * gl->height);
+        if (b->fd < 0) goto fail;
+
+        attrs[n++] = EGL_WIDTH;                     attrs[n++] = gl->width;
+        attrs[n++] = EGL_HEIGHT;                    attrs[n++] = gl->height;
+        attrs[n++] = EGL_LINUX_DRM_FOURCC_EXT;      attrs[n++] = (int)mgs_cfg.dmabuf_fourcc;
+        attrs[n++] = EGL_DMA_BUF_PLANE0_FD_EXT;     attrs[n++] = b->fd;
+        attrs[n++] = EGL_DMA_BUF_PLANE0_OFFSET_EXT; attrs[n++] = 0;
+        attrs[n++] = EGL_DMA_BUF_PLANE0_PITCH_EXT;  attrs[n++] = stride;
+        attrs[n++] = EGL_NONE;
+
+        b->image = p_mgs_eglCreateImageKHR(egl->display, EGL_NO_CONTEXT,
+                                           EGL_LINUX_DMA_BUF_EXT, NULL, attrs);
+        if (!b->image)
+        {
+            ERR("MGS2 dmabuf: eglCreateImageKHR failed (egl error %#x, fourcc %#x)\n",
+                funcs->p_eglGetError(), mgs_cfg.dmabuf_fourcc);
+            goto fail;
+        }
+
+        funcs->p_glGenTextures(1, &b->tex);
+        funcs->p_glBindTexture(GL_TEXTURE_2D, b->tex);
+        funcs->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        funcs->p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        p_mgs_glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, b->image);
+
+        funcs->p_glGenFramebuffers(1, &b->fbo);
+        funcs->p_glBindFramebuffer(GL_FRAMEBUFFER, b->fbo);
+        funcs->p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                        GL_TEXTURE_2D, b->tex, 0);
+        status = funcs->p_glCheckFramebufferStatus(GL_FRAMEBUFFER);
+        funcs->p_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        if (status != GL_FRAMEBUFFER_COMPLETE)
+        {
+            ERR("MGS2 dmabuf: FBO incomplete (%#x) for fourcc %#x\n",
+                status, mgs_cfg.dmabuf_fourcc);
+            goto fail;
+        }
+
+        params = wl_proxy_marshal_flags(gl->dmabuf_global, 1,
+                                        &mgs_zwp_linux_buffer_params_v1_interface,
+                                        wl_proxy_get_version(gl->dmabuf_global), 0, NULL);
+        if (!params) goto fail;
+        wl_proxy_set_queue(params, gl->wl_event_queue);
+        /*
+         * Who owns an 'h' argument after marshalling is the one thing here that
+         * two readings of libwayland disagree about, and both readings produce a
+         * real bug: keep a descriptor libwayland closed and teardown closes some
+         * unrelated reused number, hand over a copy libwayland also copies and
+         * every ring rebuild leaks one per buffer.
+         *
+         * So do not decide it from documentation. Hand over a dup, and once the
+         * connection has been flushed, ask the kernel whether that dup is still
+         * open: if it is, libwayland made its own copy and this one is ours to
+         * close; if it is not, libwayland took ownership and there is nothing to
+         * close. Correct either way, and it reports which convention this
+         * libwayland actually follows. Reconciled after the loop, in
+         * mgs_dmabuf_reconcile_fds().
+         *
+         * b->fd itself is kept regardless: MGS2_GL_DMABUF_SYNC=3 needs it every
+         * frame for DMA_BUF_IOCTL_IMPORT_SYNC_FILE. Modifier is linear (0,0).
+         */
+        b->sendfd = dup(b->fd);
+        if (b->sendfd < 0)
+        {
+            ERR("MGS2 dmabuf: dup failed: %s\n", strerror(errno));
+            wl_proxy_marshal_flags(params, 0, NULL, wl_proxy_get_version(params),
+                                   WL_MARSHAL_FLAG_DESTROY);
+            goto fail;
+        }
+        wl_proxy_marshal_flags(params, 1, NULL, wl_proxy_get_version(params), 0,
+                               b->sendfd, 0u, 0u, (uint32_t)stride, 0u, 0u);
+        b->wl_buffer = (struct wl_buffer *)wl_proxy_marshal_flags(
+            params, 3, &wl_buffer_interface, wl_proxy_get_version(params), 0,
+            NULL, gl->width, gl->height, mgs_cfg.dmabuf_fourcc, 0u);
+        wl_proxy_marshal_flags(params, 0, NULL, wl_proxy_get_version(params),
+                               WL_MARSHAL_FLAG_DESTROY);
+        if (!b->wl_buffer) goto fail;
+        wl_proxy_set_queue((struct wl_proxy *)b->wl_buffer, gl->wl_event_queue);
+        wl_buffer_add_listener(b->wl_buffer, &mgs_dmabuf_buffer_listener, b);
+
+        gl->dmabuf_count++;
+    }
+
+    mgs_dmabuf_reconcile_fds(gl);
+    gl->dmabuf_width = gl->width;
+    gl->dmabuf_height = gl->height;
+    ERR("MGS2 dmabuf: %d buffers of %dx%d from %s, fourcc %#x -- CPU readback is off\n",
+        gl->dmabuf_count, gl->width, gl->height, mgs_cfg.dmabuf_heap,
+        mgs_cfg.dmabuf_fourcc);
+    return TRUE;
+
+fail:
+    mgs_dmabuf_teardown(gl);
+    gl->dmabuf_failed = TRUE;
+    ERR("MGS2 dmabuf: setup failed, falling back to the shm presenter\n");
+    return FALSE;
+}
+
+/*
+ * Making the compositor read a finished buffer, on a stack with no explicit sync.
+ *
+ * Checked on the device: sway advertises 42 globals and NOT ONE of them is an
+ * explicit-synchronization protocol -- no wp_linux_drm_syncobj_v1, no
+ * zwp_linux_explicit_synchronization_v1. So there is nowhere to hand an acquire
+ * fence even though the blob exports eglDupNativeFenceFDANDROID and Box86 wraps
+ * it. Correctness has to come from the implicit fence on the dma-buf.
+ *
+ * Mode 0 was the first version and it is simply wrong: it attaches and commits
+ * straight after glBlitFramebuffer, without ever submitting the blit. The
+ * command can still be sitting unflushed in the driver, so the GPU has not
+ * started, the kernel has attached no fence, and the compositor is free to
+ * scan out a buffer with the previous frame -- or half of it. The owner saw
+ * exactly that: the frame juddered.
+ *
+ * Mode 1 waits for the blit on the CPU. Correct, and measured useless: the blit
+ * depends on the whole frame, so waiting for it costs what the old glFinish
+ * cost (readback back to 6.5-17 ms, the entire win gone).
+ *
+ * Mode 2, the default, is the one that should be both: glFlush SUBMITS the blit
+ * without waiting for it. If the driver attaches an implicit fence at submission
+ * -- which is the normal behaviour for an imported dma-buf -- the compositor
+ * waits on that fence and the game does not wait at all.
+ */
+
+/*
+ * Mode 3, the one that is both correct and free.
+ *
+ * The compositor's only way to know our blit is unfinished is the implicit
+ * fence on the dma-buf's reservation object, and the blob does not put one
+ * there: with mode 2 (submit, do not wait) the picture tears exactly like vsync
+ * off, and the tearing is indifferent to the buffer count, so it is not a
+ * pacing problem. sway offers no explicit-synchronization protocol either --
+ * all 42 of its globals were enumerated and none of them is one.
+ *
+ * The kernel bridges precisely this gap. EGL_ANDROID_native_fence_sync hands us
+ * the GPU's write fence as a sync_file, and DMA_BUF_IOCTL_IMPORT_SYNC_FILE
+ * installs it into the buffer's reservation object as a WRITE fence. From then
+ * on the compositor's ordinary implicit synchronisation sees it and waits --
+ * and the wait happens on the compositor's side, not in this thread, which is
+ * the whole point. No protocol, no latency frame, no CPU stall.
+ */
+static unsigned int mgs_fence_create_fail, mgs_fence_dup_fail, mgs_fence_import_fail;
+
+static BOOL mgs_dmabuf_attach_fence(struct mgs_dmabuf_buffer *b)
+{
+    static const EGLAttrib attrs[] = {
+        EGL_SYNC_NATIVE_FENCE_FD_ANDROID, EGL_NO_NATIVE_FENCE_FD_ANDROID, EGL_NONE
+    };
+    struct mgs_dma_buf_import_sync_file req;
+    void *sync;
+    int fence_fd;
+
+    if (!p_mgs_eglDupNativeFenceFDANDROID) { mgs_fence_create_fail++; return FALSE; }
+
+    sync = funcs->p_eglCreateSync(egl->display, EGL_SYNC_NATIVE_FENCE_ANDROID, attrs);
+    if (!sync) { mgs_fence_create_fail++; return FALSE; }
+
+    /* The fence is only queryable once the work is submitted. */
+    funcs->p_glFlush();
+    fence_fd = p_mgs_eglDupNativeFenceFDANDROID(egl->display, sync);
+    funcs->p_eglDestroySync(egl->display, sync);
+    if (fence_fd < 0) { mgs_fence_dup_fail++; return FALSE; }
+
+    req.flags = MGS_DMA_BUF_SYNC_WRITE;
+    req.fd = fence_fd;
+    if (ioctl(b->fd, MGS_DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &req) < 0)
+    {
+        if (!mgs_fence_import_fail)
+            ERR("MGS2 dmabuf: IMPORT_SYNC_FILE failed (%s)\n", strerror(errno));
+        mgs_fence_import_fail++;
+        close(fence_fd);
+        return FALSE;
+    }
+    close(fence_fd);
+    return TRUE;
+}
+
+static void mgs_dmabuf_wait_blit(struct mgs_dmabuf_buffer *b)
+{
+    void *sync;
+
+    switch (mgs_cfg.dmabuf_sync)
+    {
+    case 0:
+        return;
+    case 2:
+        funcs->p_glFlush();
+        return;
+    case 3:
+        /*
+         * Fail CLOSED. Every earlier version of this fell back to a bare
+         * glFlush when anything went wrong, which is mode 2 -- the mode that
+         * was measured tearing. A rare fence failure must cost one slow frame,
+         * never a torn one, so the fallback is glFinish: the blit is complete
+         * before the buffer is handed over, whatever the compositor does next.
+         * The counters make the cost visible instead of silent; a performance
+         * run is only valid with all three at zero.
+         */
+        if (!mgs_dmabuf_attach_fence(b)) funcs->p_glFinish();
+        return;
+    default:
+        sync = funcs->p_eglCreateSync(egl->display, EGL_SYNC_FENCE, NULL);
+        if (!sync) { funcs->p_glFinish(); return; }
+        funcs->p_eglClientWaitSync(egl->display, sync, 0, 100000000ull /* 100 ms */);
+        funcs->p_eglDestroySync(egl->display, sync);
+        return;
+    }
+}
+
+/* See the comment at the marshalling site: settle fd ownership by observation
+ * rather than by belief, once the requests carrying them have gone out. */
+static void mgs_dmabuf_reconcile_fds(struct wayland_gl_drawable *gl)
+{
+    static BOOL reported;
+    int i, reclaimed = 0, consumed = 0;
+
+    wl_display_flush(process_wayland.wl_display);
+    for (i = 0; i < gl->dmabuf_count; i++)
+    {
+        struct mgs_dmabuf_buffer *b = &gl->dmabuf[i];
+
+        if (b->sendfd < 0) continue;
+        if (fcntl(b->sendfd, F_GETFD) >= 0) { close(b->sendfd); reclaimed++; }
+        else consumed++;
+        b->sendfd = -1;
+    }
+    if (!reported && (reclaimed || consumed))
+    {
+        ERR("MGS2 dmabuf: libwayland %s the fd it was handed "
+            "(%d reclaimed, %d consumed)\n",
+            reclaimed ? "duplicates" : "takes ownership of", reclaimed, consumed);
+        reported = TRUE;
+    }
+}
+
+static struct mgs_dmabuf_buffer *mgs_dmabuf_acquire(struct wayland_gl_drawable *gl)
+{
+    int i;
+
+    for (i = 0; i < gl->dmabuf_count; i++)
+        if (!gl->dmabuf[i].busy) return &gl->dmabuf[i];
+
+    wl_display_dispatch_queue_pending(process_wayland.wl_display, gl->wl_event_queue);
+    for (i = 0; i < gl->dmabuf_count; i++)
+        if (!gl->dmabuf[i].busy) return &gl->dmabuf[i];
+    return NULL;
+}
+
+static BOOL mgs_ensure_pbos(struct wayland_gl_drawable *gl)
+{
+    const size_t size = (size_t)gl->width * gl->height * 4;
+    int i;
+
+    if (gl->pbo_active && gl->pbo_width == gl->width && gl->pbo_height == gl->height)
+        return TRUE;
+
+    mgs_release_pbos(gl);
+
+    if (!funcs->p_glGenBuffers || !funcs->p_glBindBuffer || !funcs->p_glBufferData ||
+        !funcs->p_glMapBufferRange || !funcs->p_glUnmapBuffer || !funcs->p_glDeleteBuffers)
+    {
+        ERR("PBO entry points unavailable, falling back to synchronous readback\n");
+        mgs_cfg.use_pbo = FALSE;
+        return FALSE;
+    }
+
+    for (i = 0; i < mgs_cfg.pbos; i++)
+    {
+        funcs->p_glGenBuffers(1, &gl->pbo[i]);
+        if (!gl->pbo[i])
+        {
+            ERR("glGenBuffers failed, falling back to synchronous readback\n");
+            mgs_release_pbos(gl);
+            mgs_cfg.use_pbo = FALSE;
+            return FALSE;
+        }
+        funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, gl->pbo[i]);
+        funcs->p_glBufferData(GL_PIXEL_PACK_BUFFER, size, NULL, GL_STREAM_READ);
+    }
+    funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+
+    gl->pbo_width = gl->width;
+    gl->pbo_height = gl->height;
+    gl->pbo_filled = 0;
+    gl->pbo_index = 0;
+    gl->pbo_active = TRUE;
+    return TRUE;
+}
+
+static int mgs_cmp_double(const void *a, const void *b)
+{
+    double x = *(const double *)a, y = *(const double *)b;
+    return (x > y) - (x < y);
+}
+
+/* Percentile by nearest rank on an already sorted array. */
+static double mgs_pct(const double *sorted, unsigned int n, double q)
+{
+    unsigned int i;
+    if (!n) return 0.0;
+    i = (unsigned int)(q * n);
+    if (i >= n) i = n - 1;
+    return sorted[i];
+}
+
+/*
+ * One line per A/B block.  Everything the reader needs is on it, including the
+ * counts it uses as controls, because a block whose numbers have to be joined
+ * across two lines is a block that gets mis-paired when the log is trimmed.
+ *
+ * `wait` is the arm's own GPU-wait figure and it is the manipulation check: on
+ * the sync arm it is gpu_finish (only meaningful with MGS2_GL_READ_SPLIT=1), on
+ * the async arm it is the readPixels of the frame the GPU finished a frame ago.
+ * If the async arm does not show that number collapsing, the run measured
+ * nothing and no fps difference from it may be quoted.
+ */
+/* The reader keys off these two words, so arm A must always print "sync". */
+/*
+ * Reaching wined3d's texture-matrix switch from here.
+ *
+ * The optimisation lives in wined3d.dll and the only same-process ABBA in this
+ * project lives in this file, so rather than build a second A/B system the
+ * presenter drives the other module's flag directly. wined3d publishes a record
+ * whose first four words are a magic, a version, a length and the magic
+ * inverted -- the same self-identifying shape Box86 already scans for -- so it
+ * can be found once by walking this process's own mappings. Only the `enabled`
+ * word is ever written.
+ */
+#define MGS_TXM_MAGIC 0x314D5854u /* TXM1 */
+
+static void mgs_txm_find(void)
+{
+    static BOOL tried;
+    unsigned int want0 = MGS_TXM_MAGIC, want3 = ~MGS_TXM_MAGIC;
+    char line[512];
+    FILE *maps;
+    int lines = 0, scanned = 0;
+
+    if (tried) return;
+    tried = TRUE;
+
+    /* Box86 synthesises /proc/self/maps for the guest, so try the real thing by
+     * pid as well -- and never fail silently: an early `return` here is exactly
+     * how this scan spent a run doing nothing while the A/B reported both arms
+     * as the same. */
+    if (!(maps = fopen("/proc/self/maps", "r")))
+    {
+        char alt[64];
+
+        snprintf(alt, sizeof(alt), "/proc/%d/maps", (int)getpid());
+        if (!(maps = fopen(alt, "r")))
+        {
+            ERR("MGS2 texmatrix A/B: cannot read either /proc/self/maps or %s "
+                "(%s) -- the switch cannot be reached\n", alt, strerror(errno));
+            return;
+        }
+        ERR("MGS2 texmatrix A/B: /proc/self/maps unusable, reading %s\n", alt);
+    }
+    while (fgets(line, sizeof(line), maps))
+    {
+        unsigned long lo, hi;
+        char perms[8], path[256];
+        unsigned char *p, *end;
+        int n;
+
+        path[0] = 0;
+        n = sscanf(line, "%lx-%lx %7s %*s %*s %*s %255s", &lo, &hi, perms, path);
+        ++lines;
+        if (n < 3 || perms[0] != 'r' || perms[1] != 'w') continue;
+
+        /*
+         * Only the two modules that can hold the record, matched by name.
+         *
+         * The first version of this walked every writable mapping, which hung
+         * the game before the presenter had even printed its config: Box86's
+         * anonymous arenas are large, it re-protects pages under its own feet
+         * for self-modifying-code detection, and reading them from another
+         * thread is not something this scan may do. wined3d.dll and the box86
+         * binary are ordinary file-backed data sections and are safe to read.
+         */
+        /* wined3d.dll only. Box86's writable mappings are its dynarec arenas,
+         * which it re-protects under its own feet; reading them from here is
+         * what broke adapter initialisation. The island links a second copy of
+         * the record into Box86, but the texture-matrix path runs guest-side in
+         * the p72c boundary (shader phase D was deliberately left guest), so
+         * that copy is never incremented and does not need flipping. */
+        if (!strstr(path, "wined3d")) continue;
+        if (hi - lo > 64u * 1024 * 1024) continue;
+        ++scanned;
+
+        for (p = (unsigned char *)lo, end = (unsigned char *)hi - 32;
+                p < end; p += 4)
+        {
+            unsigned int *w = (unsigned int *)p;
+
+            if (w[0] != want0 || w[1] != 1 || w[3] != want3) continue;
+            if (w[2] < 8 || w[2] > 256) continue;
+            if (mgs_txm_count < (int)ARRAY_SIZE(mgs_txm_enabled))
+            {
+                mgs_txm_enabled[mgs_txm_count++] = (volatile unsigned int *)&w[4];
+                ERR("MGS2 texmatrix A/B: TXM1 #%d at %p in %s\n",
+                    mgs_txm_count, (void *)w, path);
+            }
+        }
+    }
+    fclose(maps);
+    if (!mgs_txm_count)
+        ERR("MGS2 texmatrix A/B: no TXM1 record found in %d wined3d mapping(s) "
+            "of %d line(s) -- both arms would be identical\n",
+            scanned, lines);
+}
+
+static const char *mgs_ab_arm_name(void)
+{
+    if (mgs_cfg.ab_mode == 2)
+        return (mgs_txm_count && *mgs_txm_enabled[0]) ? "async" : "sync";
+    if (mgs_cfg.ab_mode) return mgs_cfg.dmabuf ? "async" : "sync";
+    return mgs_cfg.async ? "async" : "sync";
+}
+
+static void mgs_report_ab(struct wayland_gl_drawable *gl, double now)
+{
+    static double sorted[MGS_AB_MAX];
+    double span = now - gl->ab_t0;
+    unsigned int n = gl->ab_frames, k = gl->ab_ft_n;
+    double inv;
+
+    if (!n || span <= 0.0)
+    {
+        ERR("MGS2 PRESENT A/B block=%u arm=%s VOID frames=%u span=%.1f drop=%u\n",
+            gl->ab_block, mgs_ab_arm_name(), n, span, gl->ab_drop);
+        return;
+    }
+    inv = 1.0 / n;
+    if (k > MGS_AB_MAX) k = MGS_AB_MAX;
+    memcpy(sorted, gl->ab_ft, k * sizeof(double));
+    qsort(sorted, k, sizeof(double), mgs_cmp_double);
+
+    ERR("MGS2 PRESENT A/B block=%u arm=%s frames=%u span=%.1f fps=%.3f "
+        "ft_mean=%.2f p50=%.2f p95=%.2f p99=%.2f ftmax=%.2f "
+        "readback=%.3f wait=%.3f pixel=%.3f gpucopy=%.3f copy=%.3f acquire=%.3f "
+        "slow=%u/%u/%u/%u drop=%u tick=%.0f\n",
+        gl->ab_block, mgs_ab_arm_name(), n, span, n * 1000.0 / span,
+        span / n, mgs_pct(sorted, k, 0.50), mgs_pct(sorted, k, 0.95),
+        mgs_pct(sorted, k, 0.99), k ? sorted[k - 1] : 0.0,
+        gl->ab_readback * inv,
+        (mgs_cfg.async ? gl->ab_readback - gl->ab_gpucopy : gl->ab_finish) * inv,
+        (gl->ab_readback - (mgs_cfg.async ? gl->ab_gpucopy : gl->ab_finish)) * inv,
+        gl->ab_gpucopy * inv, gl->ab_copy * inv, gl->ab_acquire * inv,
+        gl->ab_slow[0], gl->ab_slow[1], gl->ab_slow[2], gl->ab_slow[3],
+        gl->ab_drop, now);
+}
+
+/*
+ * Close the block if it is full, print it, flip the arm and start the next one.
+ * Called once per displayed frame from the timing tail of wayland_drawable_swap.
+ *
+ * Arm order is block%4 -> A B B A.  The first `ab_settle` frames after a flip
+ * are counted but not accumulated: switching arms leaves the async texture ring
+ * unprimed once and drops one presented frame, and neither belongs in either
+ * arm's mean.
+ */
+static void mgs_ab_tick(struct wayland_gl_drawable *gl, double now,
+                        double readback, double copy, double finish,
+                        double gpucopy, double acquire, double interval)
+{
+    static const BOOL arm_async[4] = { FALSE, TRUE, TRUE, FALSE };
+
+    if (mgs_cfg.ab_mode == 2)
+    {
+        static BOOL primed;
+
+        if (!primed)
+        {
+            int t;
+
+            mgs_txm_find();
+            for (t = 0; t < mgs_txm_count; ++t)
+                *mgs_txm_enabled[t] = 0;   /* block 0 is arm A: skipping off */
+            primed = TRUE;
+        }
+    }
+
+    if (readback < 0.0)
+    {
+        gl->ab_drop++;
+        gl->ab_seen++;
+        if (gl->ab_seen < (unsigned int)mgs_cfg.present_ab) return;
+    }
+    else if (gl->ab_seen >= (unsigned int)mgs_cfg.ab_settle)
+    {
+        if (!gl->ab_frames) gl->ab_t0 = now - (interval > 0.0 ? interval : 0.0);
+        gl->ab_frames++;
+        gl->ab_readback += readback;
+        gl->ab_copy     += copy;
+        gl->ab_finish   += finish;
+        gl->ab_gpucopy  += gpucopy;
+        gl->ab_acquire  += acquire;
+        if (interval > 0.0)
+        {
+            if (gl->ab_ft_n < MGS_AB_MAX) gl->ab_ft[gl->ab_ft_n++] = interval;
+            if (interval > 500.0)      gl->ab_slow[3]++;
+            else if (interval > 200.0) gl->ab_slow[2]++;
+            else if (interval > 100.0) gl->ab_slow[1]++;
+            else if (interval > 50.0)  gl->ab_slow[0]++;
+        }
+        gl->ab_seen++;
+        if (gl->ab_seen < (unsigned int)mgs_cfg.present_ab) return;
+    }
+    else
+    {
+        gl->ab_seen++;
+        if (gl->ab_seen < (unsigned int)mgs_cfg.present_ab) return;
+    }
+
+    mgs_report_ab(gl, now);
+    gl->ab_block++;
+    gl->ab_seen = gl->ab_frames = gl->ab_ft_n = 0;
+    gl->ab_readback = gl->ab_copy = gl->ab_finish = 0.0;
+    gl->ab_gpucopy = gl->ab_acquire = 0.0;
+    gl->ab_slow[0] = gl->ab_slow[1] = gl->ab_slow[2] = gl->ab_slow[3] = 0;
+    gl->ab_drop = 0;
+    if (mgs_cfg.ab_mode == 2)
+    {
+        int t;
+        for (t = 0; t < mgs_txm_count; ++t)
+            *mgs_txm_enabled[t] = arm_async[gl->ab_block & 3];
+    }
+    else if (mgs_cfg.ab_mode) mgs_cfg.dmabuf = arm_async[gl->ab_block & 3];
+    else                      mgs_cfg.async  = arm_async[gl->ab_block & 3];
+}
+
+/*
+ * Where does a delivered frame's time actually sit, and does the part that
+ * quantises sit inside this function or outside it?
+ *
+ *   outside  from the presenter returning to the game calling it again --
+ *            the game, d3d8, wined3d and the CS thread
+ *   swap     eglSwapBuffers on the pbuffer
+ *   read     glFinish (when split) plus glReadPixels
+ *   commit   attach, damage, commit, flush
+ *
+ * Split by the multiple of the compositor period the frame landed on. If the
+ * step from k=1 to k=2 shows up in `outside`, the limiter is the game and no
+ * presenter change can move it. If it shows up in `swap`, it is EGL or the
+ * display pipeline, and dmabuf inherits it.
+ */
+static void mgs_stage_tick(struct wayland_gl_drawable *gl, double t_enter,
+                           double t_swapped, double t0, double t1, double now)
+{
+    double period = 1000.0 / 60.0;
+    double interval = gl->st_exit > 0.0 ? now - gl->st_exit : 0.0;
+    unsigned int k;
+
+    if (gl->st_exit > 0.0 && t_enter > 0.0)
+    {
+        double total = now - gl->st_exit;
+        k = (unsigned int)((total / period) + 0.5);
+        if (k < 1 || k > 4) k = 0;
+        gl->st_out[k]    += t_enter - gl->st_exit;
+        gl->st_swap[k]   += t_swapped - t_enter;
+        gl->st_read[k]   += (t1 > 0.0 ? t1 - t0 : 0.0);
+        gl->st_commit[k] += now - (t1 > 0.0 ? t1 : t0);
+        gl->st_total[k]  += total;
+        gl->st_n[k]++;
+        gl->st_frames++;
+    }
+    gl->st_exit = now;
+    (void)interval;
+
+    if (gl->st_frames < (unsigned int)mgs_cfg.stages) return;
+
+    for (k = 0; k < 5; k++)
+    {
+        double n = gl->st_n[k];
+        if (!n) continue;
+        ERR("MGS2 present stages: k=%u n=%u total=%.2f | outside=%.2f swap=%.2f "
+            "read=%.2f commit=%.2f\n",
+            k, gl->st_n[k], gl->st_total[k] / n, gl->st_out[k] / n,
+            gl->st_swap[k] / n, gl->st_read[k] / n, gl->st_commit[k] / n);
+        gl->st_out[k] = gl->st_swap[k] = gl->st_read[k] = 0.0;
+        gl->st_commit[k] = gl->st_total[k] = 0.0;
+        gl->st_n[k] = 0;
+    }
+    gl->st_frames = 0;
+}
+
+static void mgs_report_stats(struct wayland_gl_drawable *gl, double now)
+{
+    double span = now - gl->t_first;
+    if (span <= 0.0) return;
+    ERR("MGS2 present stats: tick=%.0f %u frames in %.0f ms = %.1f fps | readback %.2f ms/f | copy %.2f ms/f%s\n",
+        now, gl->frames, span, gl->frames * 1000.0 / span,
+        gl->t_readback / gl->frames, gl->t_copy / gl->frames,
+        mgs_cfg.read_split ? " (split below)" : "");
+    if (mgs_cfg.read_split)
+        ERR("MGS2 read split: gpu_finish %.2f ms/f | pixel_transfer %.2f ms/f\n",
+            gl->t_finish / gl->frames,
+            (gl->t_readback - gl->t_finish) / gl->frames);
+    if (mgs_cfg.dmabuf)
+        ERR("MGS2 dmabuf: %u frames skipped for want of a free buffer (sync=%d) | "
+            "fence fail create/dup/import %u/%u/%u\n",
+            gl->dmabuf_skipped, mgs_cfg.dmabuf_sync,
+            mgs_fence_create_fail, mgs_fence_dup_fail, mgs_fence_import_fail);
+    ERR("MGS2 frame time: worst %.0f ms | over 50/100/200/500 ms: %u/%u/%u/%u "
+        "| compositor wait %.2f ms/f, worst %.0f ms\n",
+        gl->frame_max, gl->slow_50, gl->slow_100, gl->slow_200, gl->slow_500,
+        gl->t_acquire / gl->frames, gl->acquire_max);
+    gl->frames = 0;
+    gl->t_readback = gl->t_copy = gl->t_finish = 0.0;
+    gl->frame_max = gl->acquire_max = gl->t_acquire = 0.0;
+    gl->slow_50 = gl->slow_100 = gl->slow_200 = gl->slow_500 = 0;
+    gl->t_first = now;
+}
+
+
+/*
+ * MGS2_GL_ASYNC: stop the game thread waiting for the GPU.
+ *
+ * The synchronous path calls glReadPixels on the frame that was just submitted,
+ * so the CPU blocks until the GPU has finished it. Brief #28 measured that wait
+ * at 2.8 ms in a corridor and 31.7 ms with the whole Plant in view -- a fifth of
+ * a 154 ms frame spent doing nothing.
+ *
+ * Here the frame is copied into a texture on the GPU, which does not wait, and
+ * the frame read back is the *previous* one, whose fence the GPU signalled long
+ * ago. CPU and GPU overlap instead of taking turns. The cost is one frame of
+ * presentation latency and one on-GPU copy of 640x480.
+ *
+ * Deliberately single-threaded. A second EGL context in a share group with its
+ * own thread would also work and would not add the frame of latency, but it puts
+ * wl_surface commits on a thread the compositor code here has never seen; this
+ * version gets the same overlap with none of that risk. If the measurement says
+ * the overlap is worth it, the threaded variant is the follow-up.
+ */
+static BOOL mgs_async_ensure(struct wayland_gl_drawable *gl, GLint *saved_tex, GLint *saved_fbo)
+{
+    int i;
+
+    funcs->p_glGetIntegerv(GL_TEXTURE_BINDING_2D, saved_tex);
+    funcs->p_glGetIntegerv(GL_FRAMEBUFFER_BINDING, saved_fbo);
+
+    if (gl->async_tex[0] && gl->async_width == gl->width && gl->async_height == gl->height)
+        return TRUE;
+
+    if (gl->async_tex[0])
+    {
+        funcs->p_glDeleteTextures(2, gl->async_tex);
+        gl->async_tex[0] = gl->async_tex[1] = 0;
+        gl->async_primed = FALSE;
+    }
+    if (!gl->async_fbo) funcs->p_glGenFramebuffers(1, &gl->async_fbo);
+
+    funcs->p_glGenTextures(2, gl->async_tex);
+    for (i = 0; i < 2; ++i)
+    {
+        funcs->p_glBindTexture(GL_TEXTURE_2D, gl->async_tex[i]);
+        funcs->p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, gl->width, gl->height, 0,
+                              GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+    }
+    gl->async_width = gl->width;
+    gl->async_height = gl->height;
+    gl->async_index = 0;
+    gl->async_primed = FALSE;
+
+    if (!gl->async_tex[0] || !gl->async_fbo)
+    {
+        ERR("MGS2 async: could not create the texture ring, falling back\n");
+        mgs_cfg.async = FALSE;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static void mgs_restore_pack_state(GLint pbo, GLint alignment, GLint row_length,
+        GLint skip_rows, GLint skip_pixels)
+{
+    funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, pbo);
+    funcs->p_glPixelStorei(GL_PACK_ALIGNMENT, alignment);
+    funcs->p_glPixelStorei(GL_PACK_ROW_LENGTH, row_length);
+    funcs->p_glPixelStorei(GL_PACK_SKIP_ROWS, skip_rows);
+    funcs->p_glPixelStorei(GL_PACK_SKIP_PIXELS, skip_pixels);
+}
+
 static BOOL wayland_drawable_swap(struct opengl_drawable *base)
 {
     struct wayland_gl_drawable *gl = impl_from_opengl_drawable(base);
+    const unsigned int read_format = mgs_cfg.bgra ? GL_BGRA_EXT : GL_RGBA;
+    struct wayland_shm_buffer *buf;
+    double t0 = 0.0, t1 = 0.0, t2 = 0.0, t_drained = 0.0;
+    double t_gpucopy = 0.0, t_acq = 0.0;
+    double t_enter = 0.0, t_swapped = 0.0;
+    BOOL timing = mgs_cfg.stats > 0;
+    GLint saved_pack_pbo = 0, saved_pack_alignment = 4, saved_pack_row_length = 0;
+    GLint saved_pack_skip_rows = 0, saved_pack_skip_pixels = 0;
+
+    if (mgs_cfg.stages) t_enter = mgs_now_ms();
+
+    funcs->p_glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &saved_pack_pbo);
+    funcs->p_glGetIntegerv(GL_PACK_ALIGNMENT, &saved_pack_alignment);
+    funcs->p_glGetIntegerv(GL_PACK_ROW_LENGTH, &saved_pack_row_length);
+    funcs->p_glGetIntegerv(GL_PACK_SKIP_ROWS, &saved_pack_skip_rows);
+    funcs->p_glGetIntegerv(GL_PACK_SKIP_PIXELS, &saved_pack_skip_pixels);
+    funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    funcs->p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    funcs->p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    funcs->p_glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    funcs->p_glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
 
     client_surface_present(base->client);
     funcs->p_eglSwapBuffers(egl->display, gl->base.surface);
+    if (mgs_cfg.stages) t_swapped = mgs_now_ms();
+
+    if (gl->width <= 0 || gl->height <= 0) goto done;
+
+    /* Mali is tile-based, so an attachment whose contents are still "live" at the
+     * end of a pass has to be written out of tile memory into RAM. The game
+     * clears depth and stencil every frame and we only ever read colour, so tell
+     * the driver they are finished and save that write. MGS2_GL_INVALIDATE_DS=0
+     * turns it off. */
+    if (mgs_cfg.invalidate_ds && funcs->p_glInvalidateFramebuffer)
+    {
+        static const GLenum attachments[] = { GL_DEPTH, GL_STENCIL };
+
+        funcs->p_glInvalidateFramebuffer(GL_FRAMEBUFFER, ARRAY_SIZE(attachments),
+                                         attachments);
+    }
+
+    /* Reap any buffer releases the compositor has already sent. */
+    wl_display_dispatch_queue_pending(process_wayland.wl_display, gl->wl_event_queue);
+
+    if (timing) t0 = mgs_now_ms();
+
+    if (mgs_cfg.dmabuf && mgs_dmabuf_ensure(gl))
+    {
+        /* GPU-to-GPU. The blit is queued and returns; nothing here waits for the
+         * GPU and nothing touches the pixels with the CPU.
+         *
+         * The destination Y range is inverted on purpose, and a straight blit
+         * really does come out upside down -- verified on screen before this
+         * comment was written. GL puts texture y=0 at the BOTTOM, while a
+         * dma-buf's row 0 is the TOP of the image by DRM convention, so
+         * importing one as a texture already flips it once. The shm path does
+         * not need this because glReadPixels returns the bottom row first and
+         * writing those rows in order into a top-down shm buffer performs the
+         * same flip implicitly -- which is exactly why MGS2_GL_FLIP=0 is right
+         * there and means nothing here. */
+        struct wayland_client_surface *client =
+            CONTAINING_RECORD(gl->base.client, struct wayland_client_surface, client);
+        struct mgs_dmabuf_buffer *b;
+        GLint old_read = 0, old_draw = 0;
+        double t_acq0 = mgs_now_ms();
+
+        b = mgs_dmabuf_acquire(gl);
+        if (timing)
+        {
+            double d = mgs_now_ms() - t_acq0;
+            gl->t_acquire += d;
+            t_acq = d;
+            if (d > gl->acquire_max) gl->acquire_max = d;
+        }
+        /* Every buffer still held by the compositor: skip the frame rather than
+         * block. Blocking here is the one thing this presenter exists to avoid.
+         * Counted and reported, because a silently skipped frame is judder that
+         * the frame-rate figure will happily hide -- the swap still happened. */
+        if (!b) { gl->dmabuf_skipped++; goto done; }
+
+        funcs->p_glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read);
+        funcs->p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+        funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+        funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, b->fbo);
+        if (mgs_cfg.dmabuf_flip)
+            funcs->p_glBlitFramebuffer(0, 0, gl->width, gl->height,
+                                       0, gl->height, gl->width, 0,
+                                       GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        else
+            funcs->p_glBlitFramebuffer(0, 0, gl->width, gl->height,
+                                       0, 0, gl->width, gl->height,
+                                       GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        funcs->p_glBindFramebuffer(GL_READ_FRAMEBUFFER, old_read);
+        funcs->p_glBindFramebuffer(GL_DRAW_FRAMEBUFFER, old_draw);
+        mgs_dmabuf_wait_blit(b);
+        if (timing) t1 = t2 = mgs_now_ms();
+
+        b->busy = TRUE;
+        wl_surface_attach(client->wl_surface, b->wl_buffer, 0, 0);
+        wl_surface_damage_buffer(client->wl_surface, 0, 0, gl->width, gl->height);
+        wl_surface_commit(client->wl_surface);
+        wl_display_flush(process_wayland.wl_display);
+    }
+    else if (mgs_cfg.use_pbo && mgs_ensure_pbos(gl))
+    {
+        const size_t size = (size_t)gl->width * gl->height * 4;
+        int cur = gl->pbo_index;
+        int old = (cur + 1) % mgs_cfg.pbos;
+        void *ptr;
+
+        /* Kick off the transfer of the frame we just rendered; this returns
+         * without waiting for the GPU. */
+        funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, gl->pbo[cur]);
+        funcs->p_glReadPixels(0, 0, gl->width, gl->height, read_format, GL_UNSIGNED_BYTE, NULL);
+        if (gl->pbo_filled < mgs_cfg.pbos) gl->pbo_filled++;
+        gl->pbo_index = old;
+
+        if (timing) t1 = mgs_now_ms();
+
+        /* Until the pipeline is primed there is no completed frame to show. */
+        if (gl->pbo_filled < mgs_cfg.pbos)
+        {
+            funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+            goto done;
+        }
+
+        if (!(buf = mgs_acquire_shm_buffer(gl, gl->width, gl->height)))
+        {
+            funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+            goto done;
+        }
+
+        funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, gl->pbo[old]);
+        ptr = funcs->p_glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, size, GL_MAP_READ_BIT);
+        if (ptr)
+        {
+            mgs_copy_to_shm(gl, buf, ptr);
+            funcs->p_glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+            funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+            if (timing) t2 = mgs_now_ms();
+            mgs_present_shm(gl, buf);
+        }
+        else
+        {
+            ERR("glMapBufferRange failed, falling back to synchronous readback\n");
+            funcs->p_glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+            mgs_release_pbos(gl);
+            mgs_cfg.use_pbo = FALSE;
+            goto done;
+        }
+    }
+    else if (mgs_cfg.async)
+    {
+        GLint saved_tex = 0, saved_fbo = 0;
+        int cur, prev;
+
+        if (!mgs_async_ensure(gl, &saved_tex, &saved_fbo)) goto done;
 
+        cur = gl->async_index;
+        prev = 1 - cur;
+
+        /* This frame: GPU-side copy only, no wait. */
+        funcs->p_glBindTexture(GL_TEXTURE_2D, gl->async_tex[cur]);
+        funcs->p_glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, gl->width, gl->height);
+        if (timing) t_gpucopy = mgs_now_ms();
+
+        /* Previous frame: the GPU finished it a frame ago, so this read does not
+         * stall. The very first frame has no previous one and is simply not
+         * presented. */
+        if (gl->async_primed)
+        {
+            double t_acq0 = mgs_now_ms();
+
+            buf = mgs_acquire_shm_buffer(gl, gl->width, gl->height);
+            if (timing)
+            {
