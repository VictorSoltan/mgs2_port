+    DWORD i, count = samples_size / sizeof(short);
+    int peak = 0;
+
+    if (enabled == -1) enabled = mgs2_env_int("MGS2_SINKMETER", 0, 0, 1);
+    if (!enabled || !samples) return;
+
+    for (i = 0; i < count; ++i)
+    {
+        int value = samples[i] < 0 ? -samples[i] : samples[i];
+        if (value > peak) peak = value;
+    }
