+                buffer->mgs2_geometry_mapped_data, buffer->mgs2_geometry_mapped_length);
+        d3d8_vertexbuffer_add_geometry_valid_range(buffer,
+                buffer->mgs2_geometry_mapped_offset,
+                buffer->mgs2_geometry_mapped_offset + buffer->mgs2_geometry_mapped_length);
+        ++buffer->mgs2_geometry_generation;
+        /* Patch 31: the conservative cull box describes vertices that have
+         * just been overwritten, so it dies with them. */
+        buffer->mgs2_cull_box_valid = FALSE;
+        buffer->mgs2_geometry_mapped_data = NULL;
+        buffer->mgs2_geometry_mapped_writable = FALSE;
+    }
     wined3d_resource_unmap(wined3d_buffer_get_resource(buffer->wined3d_buffer), 0);
 
     return D3D_OK;
 }
 
+void d3d8_vertexbuffer_flush_snapshot(struct d3d8_vertexbuffer *buffer)
+{
+    struct wined3d_box box = {0, 0, 0, 1, 0, 1};
+    unsigned int i, size;
+
+    if (!buffer || !buffer->mgs2_snapshot_dirty) return;
+    buffer->mgs2_snapshot_dirty = FALSE;
+    for (i = 0; i < buffer->mgs2_snapshot_dirty_count; ++i)
+    {
+        box.left = buffer->mgs2_snapshot_dirty_ranges[i].left;
+        box.right = buffer->mgs2_snapshot_dirty_ranges[i].right;
+        size = box.right - box.left;
+        wined3d_device_context_update_sub_resource(buffer->mgs2_context,
+                wined3d_buffer_get_resource(buffer->wined3d_buffer), 0, &box,
+                buffer->mgs2_snapshot + box.left, size, size, 0);
+    }
+    buffer->mgs2_snapshot_dirty_count = 0;
+}
