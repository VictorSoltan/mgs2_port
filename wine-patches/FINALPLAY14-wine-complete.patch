+/* wglGetProcAddress() only serves names opengl32 knows as *extension* entry
+ * points. The ARB_ES2_compatibility functions -- glClearDepthf, glDepthRangef,
+ * glTexStorage2D, glReleaseShaderCompiler, glGetShaderPrecisionFormat -- are
+ * core GL 4.1, so on this stack they all come back NULL while ordinary
+ * extension functions like glDrawBuffers and glBindFramebuffer resolve fine.
+ * Measured:
+ *
+ *     PTR glClearDepthf 00000000   PTR glDrawBuffers     79D22630
+ *     PTR glDepthRangef 00000000   PTR glBindFramebuffer 79D08960
+ *
+ * Core functions are reachable the other way, as ordinary exports of
+ * opengl32.dll, which is how wined3d loads ALL_GL_FUNCS. Fall back to that so
+ * a GLES context can actually use the ES-shaped entry points it has. */
+static void *mgs_get_gl_func(const char *name)
+{
+    static HMODULE opengl32;
+    void *pointer;
+
+    if ((pointer = (void *)wglGetProcAddress(name)))
+        return pointer;
+
+    if (!opengl32)
+        opengl32 = GetModuleHandleA("opengl32.dll");
+    if (opengl32 && (pointer = (void *)GetProcAddress(opengl32, name)))
+        TRACE("%s came from opengl32 exports rather than wglGetProcAddress.\n", name);
+
+    return pointer;
+}
