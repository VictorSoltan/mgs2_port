+static void mgs_frame_witness_record(struct wayland_gl_drawable *gl,
+        struct wayland_shm_buffer *buf)
+{
+    struct mgs2_frame_witness_sample *sample;
+    const uint32_t *pixels;
+    uint32_t hash = 2166136261u, first = 0, lit = 0, changed = 0;
+    unsigned int gx, gy, frame, slot;
+
+    if (!mgs_cfg.witness || !buf->map_data || gl->width <= 0 || gl->height <= 0
+            || buf->map_size < (size_t)gl->width * gl->height * 4)
+        return;
+
+    frame = mgs2_p67_frame_witness.frames + 1;
+    slot = (frame - 1) % MGS2_FRAME_WITNESS_SLOTS;
+    sample = &mgs2_p67_frame_witness.sample[slot];
+    pixels = buf->map_data;
+    __atomic_add_fetch(&mgs2_p67_frame_witness.publish_sequence, 1, __ATOMIC_RELEASE);
+    for (gy = 0; gy < 16; ++gy)
+    {
+        unsigned int y = ((2 * gy + 1) * (unsigned int)gl->height) / 32;
+
+        if (y >= (unsigned int)gl->height) y = gl->height - 1;
+        for (gx = 0; gx < 16; ++gx)
+        {
+            unsigned int x = ((2 * gx + 1) * (unsigned int)gl->width) / 32;
+            uint32_t pixel;
+
+            if (x >= (unsigned int)gl->width) x = gl->width - 1;
+            pixel = pixels[(size_t)y * gl->width + x];
+            if (!gx && !gy) first = pixel;
+            else if (pixel != first) ++changed;
+            if (pixel & 0x00ffffffu) ++lit;
+            hash = (hash ^ pixel) * 16777619u;
+        }
+    }
+    sample->frame = frame;
+    sample->width = gl->width;
+    sample->height = gl->height;
+    sample->checksum = hash;
+    sample->lit_samples = lit;
+    sample->changed_samples = changed;
+    mgs2_p67_frame_witness.frames = frame;
+    mgs2_p67_frame_witness.write_index = slot;
+    __atomic_add_fetch(&mgs2_p67_frame_witness.publish_sequence, 1, __ATOMIC_RELEASE);
+}
