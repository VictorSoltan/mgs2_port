+#ifdef MGS2_ISLAND_ARM
+/*
+ * Patch 53, class C. The translated gl_ops table.
+ *
+ * A guest wined3d_gl_info holds x86 function pointers; native ARM cannot call
+ * them. Rather than resolve at 1259 call sites -- impossible for the 670 that
+ * come through GL_EXTCALL, whose macro argument is the whole call expression --
+ * translate the table once and cache it on the guest pointer.
+ *
+ * gl_ops is nothing but function pointers, so it is walked as an array of them.
+ * A NULL entry stays NULL: GL_EXTCALL is also how WineD3D asks whether an
+ * extension exists, and answering that question with an abort would be wrong.
+ * An entry that does not resolve becomes NULL for the same reason -- gl_ops
+ * also carries Wine's own WGL functions, which have no native counterpart
+ * because context creation stays on the x86 side.
+ *
+ * The cache is one entry because there is one gl_info per adapter and MGS2 uses
+ * one adapter; a second would simply re-translate, which is correct if slower.
+ */
+void *mgs2_island_try_resolve(void *fp);
+void *mgs2_island_gl_by_name(const char *name);
+void mgs2_island_report_unresolved(unsigned int slot, void *fp);
+void mgs2_island_report_gl_info(unsigned int total, unsigned int null_in,
+        unsigned int resolved, unsigned int failed);
+/* Diagnostic builds hand back a stub that names the slot and aborts; production
+ * returns NULL, which is the fail-closed behaviour. Either way the island never
+ * calls a guest x86 pointer. */
+void *mgs2_island_gl_trap(unsigned int slot);
+void mgs2_island_report_substitution(unsigned int slot, const char *name,
+        const char *how);
+void *mgs2_island_wrap_wgl_get_pixel_format(void *guest);
+void *mgs2_island_wrap_gl_polygon_mode(void *guest);
+
+/*
+ * Slot index -> GL function name, in the exact order gl_ops declares them.
+ *
+ * The first attempt matched each pointer's address against opengl32.dll's
+ * export table. That was wrong twice over. It resolved 3 of 493 while the table
+ * came from the reference wineprefix rather than the DLL actually mounted, and
+ * even against the right DLL it only reached 88: the extension entries are not
+ * exports at all, they are internal thunks Wine's opengl32 builds for
+ * wglGetProcAddress, so no export table can ever name them.
+ *
+ * Addresses were the wrong key. The struct is generated from these same macro
+ * lists on both sides, so the slot's POSITION already carries its name -- by
+ * construction, with no table to go stale and nothing to match against. Expand
+ * the lists in declaration order and the index is the name.
+ */
+static const char *const mgs2_gl_slot_name[] =
+{
+#define USE_GL_FUNC(x) #x,
+    ALL_WGL_FUNCS
+    ALL_GL_FUNCS
+    ALL_WGL_EXT_FUNCS
+    ALL_GL_EXT_FUNCS
+#undef USE_GL_FUNC
+};
+
+/*
+ * gl_ops is not the only table of pointers in a wined3d_gl_info.
+ *
+ * `translated = *guest` copies the WHOLE structure, and only gl_ops was walked
+ * afterwards, so fbo_ops, ffp_attrib_ops, p_glDisableWINE, p_glEnableWINE and
+ * p_wglCreateContextAttribsARB kept their guest x86 values. Native ARM code
+ * calling through any of them branches straight into x86 bytes.
+ *
+ * That is not hypothetical: arming island entry 34
+ * (wined3d_texture_load_location) on 2026-08-19 died on the first frame at
+ * host pc 0x7aeccdf0, which is inside the MOUNTED opengl32.dll -- the bytes
+ * there are 55 64 8B 0D 18 00 00 00, an i386 prologue reading fs:0x18 -- while
+ * the guest EIP was parked on its bridge's `ret`, which made the report read
+ * as bridge corruption. It was an untranslated fbo_ops call: the texture
+ * location path sets up framebuffers, and none of those pointers had been
+ * touched.
+ *
+ * fbo_ops carries GL entry points, so it resolves the same way gl_ops does --
+ * by name, position being the name. Wine's opengl32 builds the extension
+ * entries as internal wglGetProcAddress thunks that no export table names,
+ * which is why the by-name path exists at all.
+ */
+static const char *const mgs2_fbo_slot_name[] =
+{
+    "glIsRenderbuffer", "glBindRenderbuffer", "glDeleteRenderbuffers",
+    "glGenRenderbuffers", "glRenderbufferStorage",
+    "glRenderbufferStorageMultisample", "glGetRenderbufferParameteriv",
+    "glIsFramebuffer", "glBindFramebuffer", "glDeleteFramebuffers",
+    "glGenFramebuffers", "glCheckFramebufferStatus", "glFramebufferTexture",
+    "glFramebufferTexture1D", "glFramebufferTexture2D",
+    "glFramebufferTexture3D", "glFramebufferTextureLayer",
+    "glFramebufferRenderbuffer", "glGetFramebufferAttachmentParameteriv",
+    "glBlitFramebuffer", "glGenerateMipmap",
+};
+
+/*
+ * One numbering for every pointer this file translates, so a slot number in a
+ * log names exactly one thing:
+ *
+ *   0                       .. GL_SLOT_COUNT-1   gl_ops, position IS the name
+ *   GL_SLOT_COUNT           .. +20               fbo_ops
+ *   GL_SLOT_COUNT + 0x100   .. +generic count    ffp_attrib_ops.generic[]
+ *   GL_SLOT_COUNT + 0x200 / +0x201               glDisableWINE / glEnableWINE
+ *
+ * The trap table in Box86 is indexed by this same number, which is why the
+ * offsets are sparse: they leave room for each group to grow without renumbering
+ * the ones already printed in old logs.
+ */
+#define MGS2_GL_SLOT_COUNT   (sizeof(struct wined3d_gl_funcs) / sizeof(void *))
+#define MGS2_FBO_SLOT_BASE   (MGS2_GL_SLOT_COUNT)
+#define MGS2_FFP_SLOT_BASE   (MGS2_GL_SLOT_COUNT + 0x100)
+#define MGS2_WINE_SLOT_BASE  (MGS2_GL_SLOT_COUNT + 0x200)
+
+const char *mgs2_island_gl_slot_name(unsigned int slot)
+{
+    if (slot < MGS2_GL_SLOT_COUNT)
+        return mgs2_gl_slot_name[slot];
+    if (slot >= MGS2_FBO_SLOT_BASE
+            && slot < MGS2_FBO_SLOT_BASE + ARRAY_SIZE(mgs2_fbo_slot_name))
+        return mgs2_fbo_slot_name[slot - MGS2_FBO_SLOT_BASE];
+    if (slot >= MGS2_FFP_SLOT_BASE && slot < MGS2_FFP_SLOT_BASE + WINED3D_FFP_EMIT_COUNT)
+    {
+        /* No name list exists for these -- they are WineD3D's own emitters,
+         * identified by index, and the caller already prints the number. No
+         * formatting here on purpose: the island reaches libc through Box86's
+         * stub list, and half of it aborts by design. */
+        return "ffp_attrib_ops.generic[]";
+    }
+    if (slot == MGS2_WINE_SLOT_BASE)
+        return "glDisableWINE";
+    if (slot == MGS2_WINE_SLOT_BASE + 1)
+        return "glEnableWINE";
+    return NULL;
+}
+
+/*
+ * glDrawBuffer(), implemented for the island in terms of glDrawBuffers().
+ *
+ * This is a RESOLUTION, not a stand-in. The scalar entry point does not exist on
+ * this stack at all: libmali exports glDrawBuffers and glReadBuffer but no
+ * glDrawBuffer (readelf on the device), and Wine's GLES path does not fill the
+ * unix half of it either, so the guest's own slot ends in code the island cannot
+ * call. The array form with one element is the documented GLES equivalent, and
+ * it is the mapping this tree ALREADY uses for the same reason in
+ * wined3d_context_gl_apply_draw_buffers(); this puts it where the island's own
+ * table can use it too.
+ *
+ * It is installed only when glDrawBuffers itself resolved. If it did not, the
+ * slot keeps whatever the failure path put there -- an unresolved call must fail,
+ * not quietly do nothing.
+ *
+ * Found by the diagnostic trap: "called UNRESOLVED GL slot 90 (glDrawBuffer)
+ * from wined3d_context_gl_apply_fbo_state+0x2a0", which is the inlined
+ * wined3d_context_gl_set_draw_buffer(context_gl, GL_NONE) on the FBO attach
+ * path. Section 18 of docs/briefs/MGS2_ISLAND_ENTRY34_FAULT_2026-08-19.md.
+ */
+static void (WINE_GLAPI *mgs2_island_native_draw_buffers)(GLsizei n, const GLenum *bufs);
+
+static void WINE_GLAPI mgs2_island_gl_draw_buffer(GLenum buffer)
+{
+    mgs2_island_native_draw_buffers(1, &buffer);
+}
+
+const struct wined3d_gl_info *mgs2_island_gl_info(const struct wined3d_gl_info *guest)
+{
+    static struct wined3d_gl_info translated;
+    static const struct wined3d_gl_info *cached;
+    void **slot;
+    size_t i, count;
+
+    if (!guest)
+        return guest;
+    if (guest == cached)
+        return &translated;
+
+    translated = *guest;
+    slot = (void **)&translated.gl_ops;
+    count = sizeof(translated.gl_ops) / sizeof(void *);
+    /* If these ever disagree the names have silently shifted against the slots,
+     * and every GL call would go to the wrong function -- the same silent
+     * mis-aim as the stale class-B table. Fail the build, not the run. */
+    C_ASSERT(sizeof(mgs2_gl_slot_name) / sizeof(mgs2_gl_slot_name[0])
+            == sizeof(struct wined3d_gl_funcs) / sizeof(void *));
+    {
+        /* Report the whole table at once. Chasing one unresolved pointer per
+         * device run costs ten minutes each; this names every gap in a single
+         * run so the remaining work can be seen rather than discovered. */
+        unsigned int null_in = 0, ok = 0, failed = 0;
+        int draw_buffer_slot = -1;
+
+        for (i = 0; i < count; ++i)
+        {
+            void *before = slot[i];
+
+            if (!before) { ++null_in; continue; }
+            /* By name first: it is the key that cannot go stale. The address
+             * path stays as a fallback for anything the driver exposes under a
+             * different name than wined3d's slot. */
+            slot[i] = mgs2_island_gl_by_name(mgs2_gl_slot_name[i]);
+            if (!slot[i])
+                slot[i] = mgs2_island_try_resolve(before);
+            if (!slot[i] && !strcmp(mgs2_gl_slot_name[i], "wglGetPixelFormat"))
+            {
+                slot[i] = mgs2_island_wrap_wgl_get_pixel_format(before);
+                if (slot[i])
+                    mgs2_island_report_substitution((unsigned int)i,
+                            "wglGetPixelFormat", "exact guest WGL target through Box86");
+            }
+            if (!slot[i] && !strcmp(mgs2_gl_slot_name[i], "glPolygonMode"))
+            {
+                slot[i] = mgs2_island_wrap_gl_polygon_mode(before);
+                if (slot[i])
+                    mgs2_island_report_substitution((unsigned int)i,
+                            "glPolygonMode", "exact guest opengl32 target through Box86");
+            }
+            if (slot[i]) ++ok;
+            else
+            {
+                ++failed;
+                mgs2_island_report_unresolved((unsigned int)i, before);
+                slot[i] = mgs2_island_gl_trap((unsigned int)i);
+                if (!strcmp(mgs2_gl_slot_name[i], "glDrawBuffer"))
+                    draw_buffer_slot = (int)i;
+            }
+        }
+
+        /* The scalar draw-buffer entry point, once the array form is known to
+         * have resolved. Ordering matters: glDrawBuffers is an extension slot and
+         * is translated later in this same pass, so this cannot go inside the
+         * loop. */
+        if (draw_buffer_slot >= 0)
+        {
+            if (translated.gl_ops.ext.p_glDrawBuffers)
+            {
+                mgs2_island_native_draw_buffers = translated.gl_ops.ext.p_glDrawBuffers;
+                ((void **)&translated.gl_ops)[draw_buffer_slot] =
+                        (void *)mgs2_island_gl_draw_buffer;
+                --failed;
+                ++ok;
+                mgs2_island_report_substitution((unsigned int)draw_buffer_slot,
+                        "glDrawBuffer", "glDrawBuffers(1, &buffer)");
+            }
+            else
+            {
+                mgs2_island_report_substitution((unsigned int)draw_buffer_slot,
+                        "glDrawBuffer", "NOT substituted: glDrawBuffers is unresolved too");
+            }
+        }
+
+        /* fbo_ops: same treatment, same key. Reported with the slot index
+         * offset by the gl_ops count so a number in a log names one table
+         * unambiguously. */
+        C_ASSERT(sizeof(mgs2_fbo_slot_name) / sizeof(mgs2_fbo_slot_name[0])
+                == sizeof(struct wined3d_fbo_ops) / sizeof(void *));
+        slot = (void **)&translated.fbo_ops;
+        for (i = 0; i < sizeof(translated.fbo_ops) / sizeof(void *); ++i)
+        {
+            void *before = slot[i];
+
+            if (!before) { ++null_in; continue; }
+            slot[i] = mgs2_island_gl_by_name(mgs2_fbo_slot_name[i]);
+            if (!slot[i])
+                slot[i] = mgs2_island_try_resolve(before);
+            if (slot[i]) ++ok;
+            else
+            {
+                ++failed;
+                mgs2_island_report_unresolved((unsigned int)(count + i), before);
+                slot[i] = mgs2_island_gl_trap((unsigned int)(MGS2_FBO_SLOT_BASE + i));
+            }
+        }
+
+        /* ffp_attrib_ops.generic[] holds WineD3D's own attribute emitters, so
+         * these are class-B names rather than GL entry points -- there is no
+         * driver symbol to ask for. try_resolve covers A, B and C in that
+         * order, which is exactly right here. */
+        slot = (void **)&translated.ffp_attrib_ops;
+        for (i = 0; i < sizeof(translated.ffp_attrib_ops) / sizeof(void *); ++i)
+        {
+            void *before = slot[i];
+
+            if (!before) { ++null_in; continue; }
+            if ((slot[i] = mgs2_island_try_resolve(before))) ++ok;
+            else
+            {
+                ++failed;
+                mgs2_island_report_unresolved((unsigned int)(count + 0x100 + i), before);
+                slot[i] = mgs2_island_gl_trap((unsigned int)(MGS2_FFP_SLOT_BASE + i));
+            }
+        }
+
+        /* The three loose pointers. glDisableWINE/glEnableWINE are Wine's own,
+         * so by name against the driver would be wrong; try_resolve is the
+         * whole ladder. A failure leaves NULL on purpose: native ARM must fault
+         * on the call rather than enter x86 bytes, which is the failure this
+         * whole function exists to remove. */
+        if (translated.p_glDisableWINE
+                && !(translated.p_glDisableWINE = mgs2_island_try_resolve(
+                        (void *)translated.p_glDisableWINE)))
+            {
+                ++failed;
+                mgs2_island_report_unresolved((unsigned int)(count + 0x200), NULL);
+                translated.p_glDisableWINE = (void (WINE_GLAPI *)(GLenum))mgs2_island_gl_trap((unsigned int)MGS2_WINE_SLOT_BASE);
+            }
+        if (translated.p_glEnableWINE
+                && !(translated.p_glEnableWINE = mgs2_island_try_resolve(
+                        (void *)translated.p_glEnableWINE)))
+            {
+                ++failed;
+                mgs2_island_report_unresolved((unsigned int)(count + 0x201), NULL);
+                translated.p_glEnableWINE = (void (WINE_GLAPI *)(GLenum))mgs2_island_gl_trap((unsigned int)(MGS2_WINE_SLOT_BASE + 1));
+            }
+
+        /* Context creation stays on the x86 side by design (section 13.6 of the
+         * reinforcement frame-budget brief), so this one is not translated at
+         * all -- it is cleared, so that an island call through it fails loudly
+         * instead of appearing to work. */
+        translated.p_wglCreateContextAttribsARB = NULL;
+
