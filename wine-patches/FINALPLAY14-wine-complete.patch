+            double v = b[i] > 128 ? b[i] - 128 : 128 - b[i];
+            if (v > peak) peak = v;
+        }
+        peak /= 128.0;
+    }
+    return peak;
+}
+
+void mgs_probe_pcm(int stage, const void *ptr, DWORD bytes, WORD bits)
+{
+    if (!ptr || !bytes) return;
+    mgs_dsound_note(stage, mgs_peak_of(ptr, bytes, bits, 256));
+}
+
+void mgs_probe_f32(int stage, const float *p, size_t count)
+{
+    size_t i;
+    double peak = 0.0;
+
+    if (!p || !count) return;
+    for (i = 0; i < count; i++)
+    {
+        double v = p[i] < 0.0f ? -(double)p[i] : (double)p[i];
+        if (v > peak) peak = v;
+    }
+    mgs_dsound_note(stage, peak);
+}
+
+static LONG mgs_f32_peak_scaled(const float *p, size_t count)
+{
+    size_t i, step;
+    float peak = 0.0f;
+
+    if (!p || !count) return 0;
+    step = count > 64 ? count / 64 : 1;
+    for (i = 0; i < count; i += step)
+    {
+        float value = p[i] < 0.0f ? -p[i] : p[i];
+        if (value > peak) peak = value;
+    }
+    return peak * 100000.0f;
+}
+
+/* Per-buffer write census, behind MGS2_DSOUND_PROBE=2.
+ *
+ * The peaks above are global maxima, which cannot separate one sound from
+ * another. MGS2 does its own mixing and streams the result into a handful of
+ * secondary buffers -- 51900 Unlocks against 16 Plays -- so the useful question
+ * is which of those buffers carry signal and which are being filled with
+ * silence. Keyed by buffer pointer, reported once a second.
+ *
+ * Deliberately lock-free: a torn peak or a duplicated slot costs nothing here,
+ * and a lock on the Unlock path would change the timing being measured.
+ */
+#define MGS_BUFSTAT_MAX 40
+
+static struct mgs_bufstat
+{
+    void *buf;
+    DWORD buflen;
+    DWORD rate;
+    WORD channels;
+    WORD bits;
+    LONG writes;
+    LONG kbytes;
+    LONG peak;      /* x1e5 */
+    LONG volcalls;
+    LONG vollast;
+    LONG bulk_silent;   /* written constantly and never carries signal: a synth sink */
+} mgs_bufstat[MGS_BUFSTAT_MAX];
+
+static struct mgs_bufstat *mgs_bufstat_get(void *buf)
+{
+    int i;
+
+    for (i = 0; i < MGS_BUFSTAT_MAX; i++)
+    {
+        if (mgs_bufstat[i].buf == buf) return &mgs_bufstat[i];
+        if (!mgs_bufstat[i].buf) { mgs_bufstat[i].buf = buf; return &mgs_bufstat[i]; }
+    }
+    return NULL;
+}
+
+/* The game starts its voice buffers at DSBVOLUME_MIN and is expected to raise
+ * them; whether it ever does is the whole question. */
+void mgs_probe_buffer_volume(void *buf, LONG volume)
+{
+    struct mgs_bufstat *st = mgs_bufstat_get(buf);
+
+    if (!st) return;
+    st->volcalls++;
+    st->vollast = volume;
+}
+
+void mgs_probe_buffer_write(void *buf, DWORD buflen, const WAVEFORMATEX *fmt,
+        const void *p1, DWORD x1, const void *p2, DWORD x2)
+{
+    WORD bits = fmt ? fmt->wBitsPerSample : 0;
+    struct mgs_bufstat *st = NULL;
+    static DWORD last;
+    LONG silent_writes;
+    double peak;
+    LONG scaled;
+    DWORD now;
+    int i, silent;
+
+    if (!(st = mgs_bufstat_get(buf))) return;
+    if (!st->rate)
+    {
+        st->buflen = buflen;
+        st->rate = fmt ? fmt->nSamplesPerSec : 0;
+        st->channels = fmt ? fmt->nChannels : 0;
+        st->bits = bits;
+    }
+
+    peak = mgs_peak_of(p1, x1, bits, 8);
+    if ((scaled = mgs_peak_of(p2, x2, bits, 8) * 100000.0) > st->peak) st->peak = scaled;
+    InterlockedIncrement(&st->writes);
+    InterlockedExchangeAdd(&st->kbytes, (x1 + x2) / 1024);
+
+    now = GetTickCount();
+    if (now - last < 1000) return;
+    last = now;
+
+    /* The fourteen dmsynth sinks are written a thousand times a second between
+     * them and are always silent; printing each one every second cost more
+     * frame rate than the measurement was worth. They collapse to one line. */
+    silent = silent_writes = 0;
+    for (i = 0; i < MGS_BUFSTAT_MAX && mgs_bufstat[i].buf; i++)
+    {
+        struct mgs_bufstat *e = &mgs_bufstat[i];
+
+        if (e->writes && e->peak <= 50 && !e->volcalls)
+        {
+            silent++;
+            silent_writes += e->writes;
+            /* Three quiet seconds in a row and it is a sink; stop scanning it.
+             * A write that carries signal still increments the counter, so a
+             * buffer that starts producing sound is not hidden -- only its
+             * amplitude is, and the write count is what the question needs. */
+            if (e->writes > 40 && ++e->bulk_silent > 3) e->bulk_silent = 4;
+        }
+        else if (e->peak > 50)
+            e->bulk_silent = 0;
+        else if (e->writes || e->volcalls)
+            ERR("MGS2 buf %2d %p len=%7lu %5lu Hz %uch/%ubit writes=%4ld kb=%5ld peak=%ld volset=%ld vol=%ld\n",
+                i, e->buf, e->buflen, e->rate, e->channels, e->bits,
+                e->writes, e->kbytes, e->peak, e->volcalls, e->vollast);
+        e->writes = 0;
+        e->volcalls = 0;
+        e->kbytes = 0;
+        e->peak = 0;
+    }
+    if (silent) ERR("MGS2 silent: %d buffers, %ld writes\n", silent, silent_writes);
+}
