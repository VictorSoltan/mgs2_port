+/*
+ * MGS2-specific fast paths and their counters.
+ *
+ * Two costs showed up on an RK3566 handheld running this game through Box86:
+ * every redundant SetRenderState still took the global wined3d mutex and walked
+ * into the stateblock, and every draw re-uploaded every bound managed texture
+ * whether or not its contents had changed. Both are avoidable without changing
+ * observable D3D8 behaviour. Counters are aggregate, one line per second, never
+ * per call -- per-call logging on this device has already cost more than it
+ * measured.
+ */
+
+/* FINALPLAY contains only the measured producer, dirty-range uploads and the
+ * conservative visibility culler. All laboratory policy is compile-time. */
+static void d3d8_mgs2_mark_state_dirty(struct d3d8_device *device)
+{
+    device->mgs2_state_dirty = TRUE;
+}
+
+static void d3d8_mgs2_set_primitive_type(struct d3d8_device *device,
+        struct wined3d_device_context *context,
+        D3DPRIMITIVETYPE primitive_type)
+{
+    UINT mapped = wined3d_primitive_type_from_d3d(primitive_type);
+
+    if (mapped == device->mgs2_last_primitive)
+        return;
+    device->mgs2_last_primitive = mapped;
+    wined3d_device_context_set_primitive_type(context, mapped, 0);
+}
+
+static BOOL d3d8_mgs2_vbo_source(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, unsigned int start_vertex, unsigned int vertex_count,
+        unsigned int *stream_idx, struct d3d8_vertexbuffer **buffer,
+        unsigned int *stride, unsigned int *left)
+{
+    const struct wined3d_stateblock_state *state = device->stateblock_state;
+    const struct wined3d_stream_state *stream;
+    struct d3d8_vertex_declaration *decl;
+    ULONGLONG offset, bytes;
+    unsigned int map;
+
+    if (primitive_type != D3DPT_TRIANGLESTRIP || vertex_count < 3 || !state->vertex_declaration)
+        return FALSE;
+    decl = wined3d_vertex_declaration_get_parent(state->vertex_declaration);
+    map = decl->stream_map;
+    if (!map || (map & (map - 1)))
+        return FALSE;
+    *stream_idx = wined3d_bit_scan(&map);
+    stream = &state->streams[*stream_idx];
+    if (!stream->buffer || !stream->stride || stream->flags || stream->frequency != 1)
+        return FALSE;
+    *buffer = wined3d_buffer_get_parent(stream->buffer);
+    if (!(*buffer)->mgs2_snapshot)
+        return FALSE;
+
+    offset = (ULONGLONG)stream->offset + (ULONGLONG)start_vertex * stream->stride;
+    bytes = (ULONGLONG)vertex_count * stream->stride;
+    if (offset > (*buffer)->mgs2_snapshot_size || bytes > (*buffer)->mgs2_snapshot_size - offset)
+        return FALSE;
+    *stride = stream->stride;
+    *left = offset;
+    return TRUE;
+}
+
+static BOOL d3d8_mgs2_geometry_range_valid(const struct d3d8_vertexbuffer *buffer,
+        unsigned int left, unsigned int right)
+{
+    unsigned int i;
+
+    if (buffer->mgs2_geometry_valid_overflow)
+        return FALSE;
+    for (i = 0; i < buffer->mgs2_geometry_valid_count; ++i)
+        if (left >= buffer->mgs2_geometry_valid_ranges[i].left
+                && right <= buffer->mgs2_geometry_valid_ranges[i].right)
+            return TRUE;
+    return FALSE;
+}
+
+static BOOL d3d8_mgs2_visibility_position_offset(
+        const struct d3d8_vertex_declaration *decl, unsigned int wanted_stream,
+        unsigned int *position_offset)
+{
+    static const unsigned int type_sizes[] = {4, 8, 12, 16, 4, 4, 4, 8};
+    const DWORD *token, *end;
+    unsigned int stream = ~0u, offset = 0;
+
+    if (!decl->elements)
+    {
+        if (wanted_stream || (decl->shader_handle & D3DFVF_POSITION_MASK) != D3DFVF_XYZ)
+            return FALSE;
+        *position_offset = 0;
+        return TRUE;
+    }
+
+    token = decl->elements;
+    end = token + decl->elements_size / sizeof(*token);
+    while (token < end && *token != D3DVSD_END())
+    {
+        D3DVSD_TOKENTYPE token_type = (*token & D3DVSD_TOKENTYPEMASK)
+                >> D3DVSD_TOKENTYPESHIFT;
+
+        if (token_type == D3DVSD_TOKEN_STREAM && !(*token & D3DVSD_STREAMTESSMASK))
+        {
+            stream = (*token & D3DVSD_STREAMNUMBERMASK) >> D3DVSD_STREAMNUMBERSHIFT;
+            offset = 0;
+        }
+        else if (token_type == D3DVSD_TOKEN_STREAMDATA)
+        {
+            if (*token & D3DVSD_DATALOADTYPEMASK)
+            {
+                offset += sizeof(DWORD) * ((*token & D3DVSD_SKIPCOUNTMASK)
+                        >> D3DVSD_SKIPCOUNTSHIFT);
+            }
+            else
+            {
+                unsigned int type = (*token & D3DVSD_DATATYPEMASK) >> D3DVSD_DATATYPESHIFT;
+                unsigned int reg = (*token & D3DVSD_VERTEXREGMASK) >> D3DVSD_VERTEXREGSHIFT;
+
+                if (type >= ARRAY_SIZE(type_sizes))
+                    return FALSE;
+                if (stream == wanted_stream && reg == D3DVSDE_POSITION)
+                {
+                    if (type != D3DVSDT_FLOAT3)
+                        return FALSE;
+                    *position_offset = offset;
+                    return TRUE;
+                }
+                offset += type_sizes[type];
+            }
+        }
+        token += parse_token(token);
+    }
+    return FALSE;
+}
+
+/* Same multiplication order used by WineD3D's multiply_matrix(): the result
+ * is src2 * src1 for D3D's row-vector convention. */
+static void d3d8_mgs2_multiply_matrix(struct wined3d_matrix *dst,
+        const struct wined3d_matrix *src1, const struct wined3d_matrix *src2)
+{
+    struct wined3d_matrix tmp;
+
+    tmp._11 = src1->_11 * src2->_11 + src1->_21 * src2->_12 + src1->_31 * src2->_13 + src1->_41 * src2->_14;
+    tmp._21 = src1->_11 * src2->_21 + src1->_21 * src2->_22 + src1->_31 * src2->_23 + src1->_41 * src2->_24;
+    tmp._31 = src1->_11 * src2->_31 + src1->_21 * src2->_32 + src1->_31 * src2->_33 + src1->_41 * src2->_34;
+    tmp._41 = src1->_11 * src2->_41 + src1->_21 * src2->_42 + src1->_31 * src2->_43 + src1->_41 * src2->_44;
+    tmp._12 = src1->_12 * src2->_11 + src1->_22 * src2->_12 + src1->_32 * src2->_13 + src1->_42 * src2->_14;
+    tmp._22 = src1->_12 * src2->_21 + src1->_22 * src2->_22 + src1->_32 * src2->_23 + src1->_42 * src2->_24;
+    tmp._32 = src1->_12 * src2->_31 + src1->_22 * src2->_32 + src1->_32 * src2->_33 + src1->_42 * src2->_34;
+    tmp._42 = src1->_12 * src2->_41 + src1->_22 * src2->_42 + src1->_32 * src2->_43 + src1->_42 * src2->_44;
+    tmp._13 = src1->_13 * src2->_11 + src1->_23 * src2->_12 + src1->_33 * src2->_13 + src1->_43 * src2->_14;
+    tmp._23 = src1->_13 * src2->_21 + src1->_23 * src2->_22 + src1->_33 * src2->_23 + src1->_43 * src2->_24;
+    tmp._33 = src1->_13 * src2->_31 + src1->_23 * src2->_32 + src1->_33 * src2->_33 + src1->_43 * src2->_34;
+    tmp._43 = src1->_13 * src2->_41 + src1->_23 * src2->_42 + src1->_33 * src2->_43 + src1->_43 * src2->_44;
+    tmp._14 = src1->_14 * src2->_11 + src1->_24 * src2->_12 + src1->_34 * src2->_13 + src1->_44 * src2->_14;
+    tmp._24 = src1->_14 * src2->_21 + src1->_24 * src2->_22 + src1->_34 * src2->_23 + src1->_44 * src2->_24;
+    tmp._34 = src1->_14 * src2->_31 + src1->_24 * src2->_32 + src1->_34 * src2->_33 + src1->_44 * src2->_34;
+    tmp._44 = src1->_14 * src2->_41 + src1->_24 * src2->_42 + src1->_34 * src2->_43 + src1->_44 * src2->_44;
+    *dst = tmp;
+}
+
+static void d3d8_mgs2_visibility_transform(float dst[4], const float src[4],
+        const struct wined3d_matrix *m)
+{
+    float tmp[4];
+
+    tmp[0] = src[0] * m->_11 + src[1] * m->_21 + src[2] * m->_31 + src[3] * m->_41;
+    tmp[1] = src[0] * m->_12 + src[1] * m->_22 + src[2] * m->_32 + src[3] * m->_42;
+    tmp[2] = src[0] * m->_13 + src[1] * m->_23 + src[2] * m->_33 + src[3] * m->_43;
+    tmp[3] = src[0] * m->_14 + src[1] * m->_24 + src[2] * m->_34 + src[3] * m->_44;
+    memcpy(dst, tmp, sizeof(tmp));
+}
+
+static unsigned int d3d8_mgs2_visibility_clip_code(const float v[4])
+{
+    const float epsilon = 1.0e-5f
+            * (fabsf(v[0]) + fabsf(v[1]) + fabsf(v[2]) + fabsf(v[3]) + 1.0f);
+    unsigned int code = 0;
+
+    if (v[0] < -v[3] - epsilon) code |= 0x01;
+    if (v[0] >  v[3] + epsilon) code |= 0x02;
+    if (v[1] < -v[3] - epsilon) code |= 0x04;
+    if (v[1] >  v[3] + epsilon) code |= 0x08;
+    if (v[2] < -epsilon) code |= 0x10;
+    if (v[2] >  v[3] + epsilon) code |= 0x20;
+    return code;
+}
+
+/* The model-space AABB is computed on every call. A 256x4 set-associative cache
+ * keyed on (identity, generation, declaration, range, stride, position_offset)
+ * used to sit in front of this loop; it was removed on 2026-08-12 after its own
+ * telemetry measured cache_hit=0 against cache_miss=112800 over 300 frames.
+ * MGS2 re-uploads its dynamic vertex buffers every frame -- that is why the
+ * cached DISCARD shadow exists at all -- so mgs2_geometry_generation is bumped
+ * on the writable Unlock before any entry can ever be reused. The cache could
+ * not hit by construction. It only cost one hash plus up to four key comparisons
+ * per tested draw (376 per frame measured) and 72 KB of BSS. */
+static __attribute__((noinline)) BOOL d3d8_mgs2_scan_aabb(
+        const struct d3d8_vertexbuffer *buffer, unsigned int left,
+        unsigned int vertex_count, unsigned int stride, unsigned int position_offset,
+        float min_value[3], float max_value[3])
+{
+    unsigned int i, axis;
+    float position[3];
+
+    for (i = 0; i < vertex_count; ++i)
+    {
+        memcpy(position, buffer->mgs2_snapshot + left + i * stride + position_offset,
+                sizeof(position));
+        if (!isfinite(position[0]) || !isfinite(position[1]) || !isfinite(position[2]))
+            return FALSE;
+        for (axis = 0; axis < 3; ++axis)
+        {
+            if (!i || position[axis] < min_value[axis]) min_value[axis] = position[axis];
+            if (!i || position[axis] > max_value[axis]) max_value[axis] = position[axis];
+        }
+    }
+
+    return TRUE;
+}
+
+/* Patch 31, gated on MGS2_D3D8_CULL_BOX. Instead of scanning the draw's own vertex
+ * range on every tested draw -- 349 times per frame, in emulated x86 -- scan every
+ * byte this buffer declares valid once, on the first test after a write, and let
+ * every later draw reuse that one box.
+ *
+ * The box is CONSERVATIVE: it covers vertices outside the draw's range, so it can
+ * only fail to cull something that the exact box would have culled. It can never
+ * cull something visible, which is the direction that matters. The cost is fewer
+ * culled draws; MGS2CULL's culled/f is the number that says whether that trade is
+ * worth it, and it is why this ships switchable.
+ *
+ * Invalidated wherever mgs2_geometry_generation is bumped, i.e. on every writable
+ * Unlock, because after a write the vertices genuinely are different. */
+static BOOL d3d8_mgs2_cull_box(struct d3d8_vertexbuffer *buffer, unsigned int stride,
+        unsigned int position_offset, float min_value[3], float max_value[3])
+{
+    float box_min[3], box_max[3];
+    unsigned int i, axis;
+    BOOL any = FALSE;
+
+    if (buffer->mgs2_cull_box_valid && buffer->mgs2_cull_box_stride == stride
+            && buffer->mgs2_cull_box_offset == position_offset)
+    {
+        memcpy(min_value, buffer->mgs2_cull_box_min, sizeof(buffer->mgs2_cull_box_min));
+        memcpy(max_value, buffer->mgs2_cull_box_max, sizeof(buffer->mgs2_cull_box_max));
+        return TRUE;
+    }
+
+    /* An overflowed range list no longer describes the whole buffer, so a box
+     * built from it would not be conservative. Fall back to the exact per-draw
+     * scan in that case rather than risk culling something visible. */
+    if (buffer->mgs2_geometry_valid_overflow || !buffer->mgs2_geometry_valid_count)
+        return FALSE;
+
+    for (i = 0; i < buffer->mgs2_geometry_valid_count; ++i)
+    {
+        unsigned int left = buffer->mgs2_geometry_valid_ranges[i].left;
+        unsigned int right = buffer->mgs2_geometry_valid_ranges[i].right;
+        unsigned int count;
+        float r_min[3], r_max[3];
+
+        if (right <= left || position_offset > stride || sizeof(float) * 3 > stride - position_offset)
+            return FALSE;
+        count = (right - left) / stride;
+        if (!count)
+            continue;
+        if (!d3d8_mgs2_scan_aabb(buffer, left, count, stride, position_offset, r_min, r_max))
+            return FALSE;
+        for (axis = 0; axis < 3; ++axis)
+        {
+            if (!any || r_min[axis] < box_min[axis]) box_min[axis] = r_min[axis];
+            if (!any || r_max[axis] > box_max[axis]) box_max[axis] = r_max[axis];
+        }
+        any = TRUE;
+    }
+
+    if (!any)
+        return FALSE;
+
+    memcpy(buffer->mgs2_cull_box_min, box_min, sizeof(box_min));
+    memcpy(buffer->mgs2_cull_box_max, box_max, sizeof(box_max));
+    buffer->mgs2_cull_box_stride = stride;
+    buffer->mgs2_cull_box_offset = position_offset;
+    buffer->mgs2_cull_box_valid = TRUE;
+    memcpy(min_value, box_min, sizeof(box_min));
+    memcpy(max_value, box_max, sizeof(box_max));
+    return TRUE;
+}
+
+/* Patch 25 removed every env-gated branch from this file, so there is no helper
+ * left to reuse; this reads its own switch once. Off by default: the box trades
+ * culling accuracy for scan cost and only a measurement on the device can say
+ * whether that trade is good. */
+static BOOL d3d8_mgs2_cull_box_enabled(void)
+{
+    static int on = -1;
+
+    if (on < 0)
+    {
+        const char *value = getenv("MGS2_D3D8_CULL_BOX");
+
+        on = value && strcmp(value, "0") ? 1 : 0;
+    }
+    return on;
+}
+
+static BOOL d3d8_mgs2_cull_aabb(struct d3d8_vertexbuffer *buffer, unsigned int left,
+        unsigned int vertex_count, unsigned int stride, unsigned int position_offset,
+        float min_value[3], float max_value[3])
+{
+    if (d3d8_mgs2_cull_box_enabled()
+            && d3d8_mgs2_cull_box(buffer, stride, position_offset, min_value, max_value))
+        return TRUE;
+
+    return d3d8_mgs2_scan_aabb(buffer, left, vertex_count, stride, position_offset,
+            min_value, max_value);
+}
+
+static BOOL d3d8_mgs2_visibility_should_cull(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, unsigned int start_vertex, unsigned int vertex_count)
+{
+    const struct wined3d_stateblock_state *state = device->stateblock_state;
+    struct d3d8_vertex_declaration *declaration;
+    struct d3d8_vertexbuffer *buffer;
+    struct wined3d_matrix world_view;
+    unsigned int stream_idx, stride, left, position_offset, corner, axis, clip_and = 0x3f;
+    float min_value[3], max_value[3], object[4], clip[4];
+
+    if (state->vs || state->rs[WINED3D_RS_VERTEXBLEND]
+            || state->rs[WINED3D_RS_INDEXEDVERTEXBLENDENABLE])
+        return FALSE;
+    if (!d3d8_mgs2_vbo_source(device, primitive_type, start_vertex, vertex_count,
+            &stream_idx, &buffer, &stride, &left) || !buffer->mgs2_geometry_identity)
+        return FALSE;
+    declaration = wined3d_vertex_declaration_get_parent(state->vertex_declaration);
+    if (!d3d8_mgs2_visibility_position_offset(declaration, stream_idx, &position_offset)
+            || position_offset > stride || sizeof(float) * 3 > stride - position_offset)
+        return FALSE;
+    if (!d3d8_mgs2_geometry_range_valid(buffer, left, left + vertex_count * stride))
+        return FALSE;
+    if (!d3d8_mgs2_cull_aabb(buffer, left, vertex_count, stride,
+            position_offset, min_value, max_value))
+        return FALSE;
+
+    if (!device->mgs2_cull_wvp_valid)
+    {
+        d3d8_mgs2_multiply_matrix(&world_view,
+                &state->transforms[WINED3D_TS_VIEW],
+                &state->transforms[WINED3D_TS_WORLD]);
+        d3d8_mgs2_multiply_matrix(&device->mgs2_cull_wvp,
+                &state->transforms[WINED3D_TS_PROJECTION], &world_view);
+        device->mgs2_cull_wvp_valid = TRUE;
+    }
+
+    for (corner = 0; corner < 8; ++corner)
+    {
+        for (axis = 0; axis < 3; ++axis)
+            object[axis] = corner & (1u << axis) ? max_value[axis] : min_value[axis];
+        object[3] = 1.0f;
+        d3d8_mgs2_visibility_transform(clip, object, &device->mgs2_cull_wvp);
+        if (!isfinite(clip[0]) || !isfinite(clip[1])
+                || !isfinite(clip[2]) || !isfinite(clip[3]))
+            return FALSE;
+        clip_and &= d3d8_mgs2_visibility_clip_code(clip);
+    }
+    return !!clip_and;
+}
+
+void d3d8_mgs2_flush_pending(struct d3d8_device *device)
+{
+    if (!device->mgs2_pending.count)
+        return;
+
+    wined3d_device_context_draw_batch(device->immediate_context,
+            wined3d_primitive_type_from_d3d(device->mgs2_pending.primitive_type), 0,
+            device->mgs2_pending.starts, device->mgs2_pending.counts,
+            device->mgs2_pending.count);
+    device->mgs2_pending.count = 0;
+}
