+static ULONGLONG mgs_prod_bit_range(DWORD first, DWORD last)
+{
+    ULONGLONG lower = first ? (~(ULONGLONG)0 << first) : ~(ULONGLONG)0;
+    ULONGLONG upper = last == 63 ? ~(ULONGLONG)0 : (((ULONGLONG)1 << (last + 1)) - 1);
+
+    return lower & upper;
+}
+
+static void mgs_prod_mark_range(BufferMemory *memory, DWORD offset, DWORD bytes)
+{
+    DWORD first, last;
+
+    if (!bytes || offset >= 32576) return;
+    if (bytes > 32576 - offset) bytes = 32576 - offset;
+    first = offset / 256;
+    last = (offset + bytes - 1) / 256;
+    if (first < 64)
+        memory->mgs_prod_written_mask[0] |= mgs_prod_bit_range(first, min(last, 63));
+    if (last >= 64)
+        memory->mgs_prod_written_mask[1] |= mgs_prod_bit_range(max(first, 64) - 64, last - 64);
+}
+
+static void mgs_sfx_producer_note_lock(IDirectSoundBufferImpl *dsb, void *caller,
+        DWORD request_cursor, DWORD request_bytes, DWORD flags,
+        const void *p1, DWORD bytes1, const void *p2, DWORD bytes2)
+{
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb)) return;
+
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    dsb->mgs_prod_lock_caller = caller;
+    dsb->mgs_prod_lock_cursor = request_cursor;
+    dsb->mgs_prod_lock_bytes = request_bytes;
+    dsb->mgs_prod_lock_flags = flags;
+    dsb->mgs_prod_lock_offset1 = p1 ? (const BYTE *)p1 - dsb->buffer->memory : 0;
+    dsb->mgs_prod_lock_bytes1 = bytes1;
+    dsb->mgs_prod_lock_offset2 = p2 ? (const BYTE *)p2 - dsb->buffer->memory : 0;
+    dsb->mgs_prod_lock_bytes2 = bytes2;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
+
+static void mgs_sfx_producer_note_unlock(IDirectSoundBufferImpl *dsb, void *caller,
+        const void *p1, DWORD bytes1, const void *p2, DWORD bytes2)
+{
+    BufferMemory *memory;
+    MgsSfxWriteEvent *event;
+    DWORD index, offset1, offset2;
+
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb) || (!bytes1 && !bytes2)) return;
+
+    memory = dsb->buffer;
+    offset1 = p1 ? (const BYTE *)p1 - memory->memory : 0;
+    offset2 = p2 ? (const BYTE *)p2 - memory->memory : 0;
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    ++memory->mgs_prod_generation;
+    mgs_prod_mark_range(memory, offset1, bytes1);
+    mgs_prod_mark_range(memory, offset2, bytes2);
+    if (memory->mgs_prod_write_count < MGS_SFX_WRITE_HISTORY)
+        index = memory->mgs_prod_write_count++;
+    else
+    {
+        index = MGS_SFX_WRITE_HISTORY - 1;
+        ++memory->mgs_prod_write_dropped;
+    }
+    event = &memory->mgs_prod_writes[index];
+    event->generation = memory->mgs_prod_generation;
+    event->lock_caller = dsb->mgs_prod_lock_caller;
+    event->unlock_caller = caller;
+    event->request_cursor = dsb->mgs_prod_lock_cursor;
+    event->request_bytes = dsb->mgs_prod_lock_bytes;
+    event->flags = dsb->mgs_prod_lock_flags;
+    event->offset1 = offset1;
+    event->bytes1 = bytes1;
+    event->offset2 = offset2;
+    event->bytes2 = bytes2;
+    dsb->mgs_prod_lock_caller = NULL;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
+
+static void mgs_sfx_producer_note_position(IDirectSoundBufferImpl *dsb, void *caller, DWORD position)
+{
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb)) return;
+
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    dsb->mgs_prod_position_pending = TRUE;
+    dsb->mgs_prod_position_caller = caller;
+    dsb->mgs_prod_position = position;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
+
+static void mgs_prod_log_pool_states(DirectSoundDevice *device, DWORD *playing)
+{
+    IDirectSoundBufferImpl *dsb;
+    int i;
+
+    *playing = 0;
+    fprintf(mgs_prod_log, "POOL_STATES");
+    AcquireSRWLockShared(&device->buffer_list_lock);
+    for (i = 0; i < device->nrofbuffers; ++i)
+    {
+        dsb = device->buffers[i];
+        if (!mgs_sfx_voice(dsb)) continue;
+        AcquireSRWLockShared(&dsb->lock);
+        if (dsb->state == STATE_STARTING || dsb->state == STATE_PLAYING) ++*playing;
+        fprintf(mgs_prod_log, " %ld:%lu", dsb->mgs_prod_iface_id, dsb->state);
+        ReleaseSRWLockShared(&dsb->lock);
+    }
+    ReleaseSRWLockShared(&device->buffer_list_lock);
+    fputc('\n', mgs_prod_log);
+}
+
+static void mgs_sfx_producer_note_play(IDirectSoundBufferImpl *dsb, void *caller, DWORD flags)
+{
+    BufferMemory *memory;
+    MgsSfxWriteEvent *event;
+    char dir[MAX_PATH], path[MAX_PATH];
+    DWORD i, playing;
+    FILE *raw;
+
+    if (!mgs_sfx_producer_on() || !mgs_sfx_voice(dsb)) return;
+
+    memory = dsb->buffer;
+    AcquireSRWLockExclusive(&mgs_prod_lock);
+    mgs_prod_arm_if_marked(dsb->device);
+    if (mgs_prod_log)
+    {
+        fprintf(mgs_prod_log, "PLAY tick=%lu caller=%p iface=%ld parent=%ld memory=%ld "
+                "generation=%ld object=%p data=%p sec_mixpos=%lu api_pos=%lu state=%lu "
+                "volume=%ld pan=%ld frequency=%lu flags=%#lx written_mask=%016llx:%016llx "
+                "position_pending=%u position_caller=%p position=%lu writes=%lu dropped=%lu\n",
+                GetTickCount(), caller, dsb->mgs_prod_iface_id,
+                dsb->mgs_prod_parent_iface_id, memory->mgs_prod_memory_id,
+                memory->mgs_prod_generation, dsb, memory->memory, dsb->sec_mixpos,
+                dsb->sec_mixpos, dsb->state, dsb->volpan.lVolume, dsb->volpan.lPan,
+                dsb->freq, flags,
+                (unsigned long long)memory->mgs_prod_written_mask[1],
+                (unsigned long long)memory->mgs_prod_written_mask[0],
+                dsb->mgs_prod_position_pending, dsb->mgs_prod_position_caller,
+                dsb->mgs_prod_position, memory->mgs_prod_write_count,
+                memory->mgs_prod_write_dropped);
+        for (i = 0; i < memory->mgs_prod_write_count; ++i)
+        {
+            event = &memory->mgs_prod_writes[i];
+            fprintf(mgs_prod_log, "WRITE generation=%lu lock_caller=%p unlock_caller=%p "
+                    "request_cursor=%lu request_bytes=%lu flags=%#lx "
+                    "region1=%lu+%lu region2=%lu+%lu\n",
+                    event->generation, event->lock_caller, event->unlock_caller,
+                    event->request_cursor, event->request_bytes, event->flags,
+                    event->offset1, event->bytes1, event->offset2, event->bytes2);
+        }
+        mgs_prod_log_pool_states(dsb->device, &playing);
+        fprintf(mgs_prod_log, "PLAYING_POOL_MEMBERS=%lu\n", playing);
+
+        if (memory->mgs_prod_dumped_generation != memory->mgs_prod_generation)
+        {
+            mgs_prod_output_dir(dir, sizeof(dir));
+            snprintf(path, sizeof(path), "%s\\memory-%ld-generation-%ld.raw", dir,
+                    memory->mgs_prod_memory_id, memory->mgs_prod_generation);
+            raw = fopen(path, "wb");
+            if (raw)
+            {
+                fwrite(memory->memory, dsb->buflen, 1, raw);
+                fclose(raw);
+                memory->mgs_prod_dumped_generation = memory->mgs_prod_generation;
+                fprintf(mgs_prod_log, "RAW memory=%ld generation=%ld path=%s bytes=%lu\n",
+                        memory->mgs_prod_memory_id, memory->mgs_prod_generation,
+                        path, dsb->buflen);
+            }
+        }
+        fflush(mgs_prod_log);
+        if (!--mgs_prod_remaining)
+        {
+            fprintf(mgs_prod_log, "END tick=%lu reason=max_plays\n", GetTickCount());
+            fclose(mgs_prod_log);
+            mgs_prod_log = NULL;
+        }
+    }
+
+    memory->mgs_prod_written_mask[0] = 0;
+    memory->mgs_prod_written_mask[1] = 0;
+    memory->mgs_prod_write_count = 0;
+    memory->mgs_prod_write_dropped = 0;
+    dsb->mgs_prod_position_pending = FALSE;
+    ReleaseSRWLockExclusive(&mgs_prod_lock);
+}
