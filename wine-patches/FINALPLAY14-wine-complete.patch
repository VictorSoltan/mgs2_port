+        ++mgs2_submit_census_live.counters.source_batch_packets;
+    else
+        ++mgs2_submit_census_live.counters.source_direct_packets;
+}
+
+static void mgs2_submit_census_source_draw(const struct wined3d_state *state,
+        enum wined3d_primitive_type primitive_type, const struct wined3d_draw_parameters *parameters)
+{
+    const struct wined3d_direct_draw_parameters *direct;
+    struct mgs2_submit_census_payload *c;
+
+    if (!mgs2_submit_census_on())
+        return;
+
+    c = &mgs2_submit_census_live.counters;
+    ++c->source_draws;
+    if (!parameters->indexed)
+    {
+        ++c->source_nonindexed;
+    }
+    else if (primitive_type == WINED3D_PT_TRIANGLELIST)
+    {
+        ++c->source_indexed;
+        ++c->indexed_trianglelist;
+    }
+    else if (primitive_type == WINED3D_PT_TRIANGLESTRIP)
+    {
+        ++c->source_indexed;
+        ++c->indexed_strip;
+    }
+    else
+    {
+        ++c->source_indexed;
+        ++c->indexed_other;
+    }
+
+    if (parameters->indexed && !parameters->indirect)
+    {
+        direct = &parameters->u.direct;
+        if (!mgs2_submit_census_live.previous_valid || !mgs2_submit_census_live.previous_indexed)
+        {
+            if (mgs2_submit_census_live.previous_valid)
+                ++c->break_after_other_draw;
+        }
+        else
+        {
+            ++c->indexed_adjacent_pairs;
+            if (mgs2_submit_census_live.previous_epoch != mgs2_submit_census_live.epoch)
+                ++c->break_state;
+            else if (mgs2_submit_census_live.previous_primitive != primitive_type)
+                ++c->break_primitive;
+            else if (mgs2_submit_census_live.previous_ib != state->index_buffer)
+                ++c->break_ib;
+            else if (mgs2_submit_census_live.previous_format != state->index_format
+                    || mgs2_submit_census_live.previous_index_offset != state->index_offset)
+                ++c->break_format_offset;
+            else if (mgs2_submit_census_live.previous_base != direct->base_vertex_idx)
+                ++c->break_base;
+            else if (mgs2_submit_census_live.previous_instance_count || direct->instance_count)
+                ++c->break_instanced;
+            else if (mgs2_submit_census_live.previous_start
+                    + mgs2_submit_census_live.previous_count != direct->start_idx)
+                ++c->break_gap;
+            else if (primitive_type == WINED3D_PT_TRIANGLELIST)
+                ++c->indexed_mergeable_list_pairs;
+            else if (primitive_type == WINED3D_PT_TRIANGLESTRIP)
+                ++c->indexed_candidate_strip_pairs;
+            else
+                ++c->break_unsupported;
+        }
+    }
+
+    mgs2_submit_census_live.previous_valid = TRUE;
+    mgs2_submit_census_live.previous_indexed = parameters->indexed;
+    mgs2_submit_census_live.previous_primitive = primitive_type;
+    mgs2_submit_census_live.previous_ib = state->index_buffer;
+    mgs2_submit_census_live.previous_format = state->index_format;
+    mgs2_submit_census_live.previous_index_offset = state->index_offset;
+    mgs2_submit_census_live.previous_epoch = mgs2_submit_census_live.epoch;
+    if (!parameters->indirect)
+    {
+        direct = &parameters->u.direct;
+        mgs2_submit_census_live.previous_base = direct->base_vertex_idx;
+        mgs2_submit_census_live.previous_start = direct->start_idx;
+        mgs2_submit_census_live.previous_count = direct->index_count;
+        mgs2_submit_census_live.previous_instance_count = direct->instance_count;
+    }
+    else
+    {
+        mgs2_submit_census_live.previous_base = 0;
+        mgs2_submit_census_live.previous_start = 0;
+        mgs2_submit_census_live.previous_count = 0;
+        mgs2_submit_census_live.previous_instance_count = 1;
+    }
+}
+
+void mgs2_submit_census_gl_draw(unsigned int kind, unsigned int count)
+{
+    /* island entry 5: Box86 matches these bytes and reads the id. */
+    MGS2_ISLAND_MARK(0x05);
+    mgs2_p46_count(5);
+    struct mgs2_submit_census_payload *c;
+
+#ifdef MGS2_ISLAND_ARM
+    /* p67 correctness only: this callback is linked into Box86 itself, so the
+     * native DRAW closure and its entry wrapper publish into one record rather
+     * than two separately linked copies of WineD3D's census globals. */
+    extern void mgs2_island_draw_final(unsigned int kind, unsigned int count);
+    mgs2_island_draw_final(kind, count);
+#endif
+
+    if (!mgs2_submit_census_on() || !count)
+        return;
+    c = &mgs2_submit_census_live.counters;
+    c->final_draws += count;
+    switch (kind)
+    {
+        case MGS2_SUBMIT_GL_ARRAYS:
+            c->final_arrays += count;
+            break;
+        case MGS2_SUBMIT_GL_ELEMENTS:
+            c->final_elements += count;
+            break;
+        case MGS2_SUBMIT_GL_BATCH_ELEMENTS:
+            c->final_batch_elements += count;
+            break;
+        case MGS2_SUBMIT_GL_INSTANCED:
+            c->final_instanced += count;
+            break;
+        default:
+            c->final_other += count;
+            break;
+    }
+}
+
+
+/* ---------------------------------------------------------------------------
+ * Patch 38 -- bounded, memory-only packet-break census.
+ *
+ * p37 answered "how many source draws became how many GL submissions".  p38
+ * answers "why did each pending batch close", and, at every real closure,
+ * whether the two adjacent real draws were issued under an identical effective
+ * rendering state.
+ *
+ * Method, and why it is exact rather than a hash:
+ *
+ *   The only way struct wined3d_state can change between two draws is a
+ *   non-draw CS opcode, and mgs2_cs_dispatch() already closes the pending batch
+ *   on every non-draw opcode.  So the whole question reduces to: was every
+ *   opcode in the run between the two draws a no-op against the state the CSMT
+ *   consumer already holds?  Each comparable opcode is compared field by field
+ *   against cs->state before its handler runs.  Nothing is hashed, so nothing
+ *   can collide.  Any opcode without an implemented exact comparison, every
+ *   resource mutation and every hard barrier counts as "different", so the
+ *   result can only under-report merge opportunity, never over-report it.
+ *
+ *   As an independent check on that model, one boundary in
+ *   MGS2_P38_VERIFY_STRIDE takes a full byte snapshot of the effective state
+ *   (render/texture-stage/sampler states, bound views/samplers/shaders,
+ *   streams, declaration, index buffer, viewport, scissor, framebuffer,
+ *   blend/depth-stencil/rasterizer objects, material, topology and the FFP
+ *   push-constant buffers, which carry the WORLD/VIEW/PROJECTION matrices) at
+ *   the draw before and the draw after that boundary, and memcmp()s them.
+ *   verify_disagree must be zero for the run to be usable.
+ *
+ * The census changes no rendering decision: every counter is written after the
+ * behaviour it observes has already been chosen.  It performs no allocation, no
+ * I/O, no clock query and no logging on the render thread.  It is off unless
+ * MGS2_REINFORCEMENT_CENSUS=1.
+ * --------------------------------------------------------------------------- */
+
+enum mgs2_p38_break
+{
+    MGS2_P38_BRK_CS_BARRIER,     /* a non-draw CS opcode arrived */
+    MGS2_P38_BRK_STATE_DIRTY,    /* draw-time dirty graphics state */
+    MGS2_P38_BRK_INDEXED,        /* an indexed draw ends a non-indexed run */
+    MGS2_P38_BRK_TOPOLOGY,       /* GL mode changed inside the batcher */
+    MGS2_P38_BRK_CONTEXT,        /* GL context changed inside the batcher */
+    MGS2_P38_BRK_LIMIT,          /* the 256-strip batch limit */
+    MGS2_P38_BRK_PRESENT,        /* end of frame */
+    MGS2_P38_BRK_OTHER,
+    MGS2_P38_BRK_COUNT,
+};
+
+enum mgs2_p38_dirty_cat
+{
+    MGS2_P38_DIRTY_RENDER_STATE,
+    MGS2_P38_DIRTY_TEXTURE_STAGE,
+    MGS2_P38_DIRTY_SAMPLER,
+    MGS2_P38_DIRTY_TEXTURE,
+    MGS2_P38_DIRTY_SHADER,
+    MGS2_P38_DIRTY_SHADER_CONSTANTS,
+    MGS2_P38_DIRTY_VERTEX_DECL,
+    MGS2_P38_DIRTY_STREAM_VB,
+    MGS2_P38_DIRTY_INDEX_BUFFER,
+    MGS2_P38_DIRTY_VIEWPORT_SCISSOR,
+    MGS2_P38_DIRTY_FRAMEBUFFER,
+    MGS2_P38_DIRTY_BLEND_DEPTH_RASTER,
+    MGS2_P38_DIRTY_TRANSFORM,
+    MGS2_P38_DIRTY_OTHER,
+    MGS2_P38_DIRTY_COUNT,
+};
+
+#define MGS2_P38_OPCODES        56
+#define MGS2_P38_PRIMS           8
+#define MGS2_P38_LEN_BUCKETS     8
+#define MGS2_P38_VERIFY_STRIDE  64
+
+struct mgs2_p38_payload
+{
+    /* Real batch closures, by immediate cause. */
+    unsigned int close_total;
+    unsigned int close_reason[MGS2_P38_BRK_COUNT];
+    unsigned int close_cs_opcode[MGS2_P38_OPCODES];
+
+    /* Draw-time dirty-state closures, decomposed. A closure whose dirty mask
+     * spans several categories increments each of them and close_dirty_mixed. */
+    unsigned int close_dirty_total;
+    unsigned int close_dirty_mixed;
+    unsigned int close_dirty_cat[MGS2_P38_DIRTY_COUNT];
+
+    /* Length of each closed batch, in source strips. */
+    unsigned int close_len_hist[MGS2_P38_LEN_BUCKETS];
+
+    /* Exact effective-state verdict for the pair of real draws that the
+     * closure separates. */
+    unsigned int boundary_state_equal;
+    unsigned int boundary_state_different;
+    unsigned int boundary_state_no_next_draw;
+    unsigned int boundary_mergeable;          /* equal AND same topology AND
+                                               * non-indexed AND under the limit */
+
+    /* Inter-draw opcode runs. */
+    unsigned int run_ops;
+    unsigned int run_ops_comparable;
+    unsigned int run_ops_redundant;
+    unsigned int run_ops_by_opcode[MGS2_P38_OPCODES];
+    unsigned int run_redundant_by_opcode[MGS2_P38_OPCODES];
+
+    /* Independent full-snapshot check of the verdict above. */
+    unsigned int verify_checked;
+    unsigned int verify_agree;
+    unsigned int verify_disagree;
+    unsigned int verify_unavailable;
+
+    /* Primitive-type breakdown. Index is enum wined3d_primitive_type clamped. */
+    unsigned int source_by_prim[MGS2_P38_PRIMS];
+    unsigned int gl_arrays_by_prim[MGS2_P38_PRIMS];
+    unsigned int gl_batch_by_prim[MGS2_P38_PRIMS];
+    unsigned int gl_bypass_by_prim[MGS2_P38_PRIMS];
+    unsigned int gl_bypass_total;
+};
+
+/* The verification snapshot. Fixed size, two instances, never grown. */
+struct mgs2_p38_snapshot
+{
+    unsigned int render_states[WINEHIGHEST_RENDER_STATE + 1];
+    unsigned int texture_states[WINED3D_MAX_FFP_TEXTURES][WINED3D_HIGHEST_TEXTURE_STATE + 1];
+    const void *shader_resource_view[WINED3D_SHADER_TYPE_GRAPHICS_COUNT][MAX_SHADER_RESOURCE_VIEWS];
+    const void *sampler[WINED3D_SHADER_TYPE_GRAPHICS_COUNT][MAX_SAMPLER_OBJECTS];
+    const void *shader[WINED3D_SHADER_TYPE_GRAPHICS_COUNT];
+    const void *cb[WINED3D_SHADER_TYPE_GRAPHICS_COUNT][MAX_CONSTANT_BUFFERS];
+    struct wined3d_stream_state streams[WINED3D_MAX_STREAMS];
+    const void *vertex_declaration;
+    const void *index_buffer;
+    unsigned int index_format;
+    unsigned int index_offset;
+    unsigned int base_vertex_index;
+    struct wined3d_viewport viewports[WINED3D_MAX_VIEWPORTS];
+    unsigned int viewport_count;
+    RECT scissor_rects[WINED3D_MAX_VIEWPORTS];
+    unsigned int scissor_rect_count;
+    const void *render_targets[WINED3D_MAX_RENDER_TARGETS];
+    const void *depth_stencil;
+    const void *blend_state;
+    struct wined3d_color blend_factor;
+    unsigned int sample_mask;
+    const void *depth_stencil_state;
+    unsigned int stencil_ref;
+    const void *rasterizer_state;
+    struct wined3d_extra_vs_args extra_vs_args;
+    struct wined3d_extra_ps_args extra_ps_args;
+    unsigned char depth_bounds_enable;
+    float depth_bounds_min, depth_bounds_max;
+    unsigned int primitive_type;
+    unsigned int patch_vertex_count;
+    /* FFP transforms/material/lights reach the shader through these buffers. */
+    unsigned int push_constants_hash_present;
+    unsigned char push_constants[2][1024];
+    unsigned int push_constants_size[2];
+};
+
+static struct
+{
+    struct mgs2_p38_payload counters;
+
+    /* Pending closure being attributed. */
+    unsigned int pending;                /* a closure is waiting for the next draw */
+    unsigned int pending_reason;
+    unsigned int pending_len;
+    unsigned int pending_mode_ok;        /* the closed batch could still accept draws */
+    unsigned int run_all_redundant;      /* every opcode since the closure was a no-op */
+
+    /* Hint set by the caller immediately before mgs2_batch_flush(). */
+    unsigned int hint_reason;
+    unsigned int hint_opcode;
+
+    unsigned int boundary_index;
+    unsigned int verify_state;           /* 0 idle, 1 want "before", 2 want "after" */
+    struct mgs2_p38_snapshot snap[2];
+    unsigned int snap_valid;
+} mgs2_p38;
+
+static unsigned int mgs2_p38_prim_bucket(enum wined3d_primitive_type type)
+{
+    switch (type)
+    {
+        case WINED3D_PT_POINTLIST:     return 0;
+        case WINED3D_PT_LINELIST:      return 1;
+        case WINED3D_PT_LINESTRIP:     return 2;
+        case WINED3D_PT_TRIANGLELIST:  return 3;
+        case WINED3D_PT_TRIANGLESTRIP: return 4;
+        case WINED3D_PT_TRIANGLEFAN:   return 5;
+        case WINED3D_PT_UNDEFINED:     return 7;
+        default:                       return 6;
+    }
+}
+
+static unsigned int mgs2_p38_len_bucket(unsigned int n)
+{
+    if (n <= 1)  return 0;
+    if (n == 2)  return 1;
+    if (n <= 4)  return 2;
+    if (n <= 8)  return 3;
+    if (n <= 16) return 4;
+    if (n <= 32) return 5;
+    if (n <= 63) return 6;
+    return 7;
+}
+
+/* Exact, field-by-field comparison of one non-draw opcode against the state the
+ * consumer already holds. TRUE means "this opcode cannot change any pixel".
+ * Every opcode not listed here is reported as not comparable, which the caller
+ * treats as a real state change. */
+static BOOL mgs2_p38_op_is_redundant(const struct wined3d_cs *cs,
+        enum wined3d_cs_op opcode, const void *data, BOOL *comparable)
+{
+    const struct wined3d_state *state = &cs->state;
+    unsigned int i;
+
+    *comparable = TRUE;
+    switch (opcode)
+    {
+        case WINED3D_CS_OP_NOP:
+            return TRUE;
+
+        case WINED3D_CS_OP_SET_RENDER_STATE:
+        {
+            const struct wined3d_cs_set_render_state *op = data;
+
+            if (op->state > WINEHIGHEST_RENDER_STATE)
+                break;
+            return state->render_states[op->state] == op->value;
+        }
+
+        case WINED3D_CS_OP_SET_TEXTURE_STATE:
+        {
+            const struct wined3d_cs_set_texture_state *op = data;
+
+            if (op->stage >= WINED3D_MAX_FFP_TEXTURES
+                    || op->state > WINED3D_HIGHEST_TEXTURE_STATE)
+                break;
+            return state->texture_states[op->stage][op->state] == op->value;
+        }
+
+        case WINED3D_CS_OP_SET_TEXTURE:
+        {
+            const struct wined3d_cs_set_texture *op = data;
+
+            if (op->shader_type >= WINED3D_SHADER_TYPE_GRAPHICS_COUNT
+                    || op->bind_index >= MAX_SHADER_RESOURCE_VIEWS)
+                break;
+            return state->shader_resource_view[op->shader_type][op->bind_index] == op->view;
+        }
+
+        case WINED3D_CS_OP_SET_SAMPLERS:
+        {
+            const struct wined3d_cs_set_samplers *op = data;
+
+            if (op->type >= WINED3D_SHADER_TYPE_GRAPHICS_COUNT
+                    || op->start_idx + op->count > MAX_SAMPLER_OBJECTS)
+                break;
+            for (i = 0; i < op->count; ++i)
+                if (state->sampler[op->type][op->start_idx + i] != op->samplers[i])
+                    return FALSE;
+            return TRUE;
+        }
+
+        case WINED3D_CS_OP_SET_SHADER_RESOURCE_VIEWS:
+        {
+            const struct wined3d_cs_set_shader_resource_views *op = data;
+
+            if (op->type >= WINED3D_SHADER_TYPE_GRAPHICS_COUNT
+                    || op->start_idx + op->count > MAX_SHADER_RESOURCE_VIEWS)
+                break;
+            for (i = 0; i < op->count; ++i)
+                if (state->shader_resource_view[op->type][op->start_idx + i] != op->views[i])
+                    return FALSE;
+            return TRUE;
+        }
+
+        case WINED3D_CS_OP_SET_VERTEX_DECLARATION:
+        {
+            const struct wined3d_cs_set_vertex_declaration *op = data;
+
+            return state->vertex_declaration == op->declaration;
+        }
+
+        case WINED3D_CS_OP_SET_STREAM_SOURCES:
+        {
+            const struct wined3d_cs_set_stream_sources *op = data;
+
+            if (op->start_idx + op->count > WINED3D_MAX_STREAMS)
+                break;
+            for (i = 0; i < op->count; ++i)
+            {
+                const struct wined3d_stream_state *old = &state->streams[op->start_idx + i];
+                const struct wined3d_stream_state *new_state = &op->streams[i];
+
+                if (old->buffer != new_state->buffer || old->offset != new_state->offset
+                        || old->stride != new_state->stride
+                        || old->frequency != new_state->frequency
+                        || old->flags != new_state->flags)
+                    return FALSE;
+            }
+            return TRUE;
+        }
+
+        case WINED3D_CS_OP_SET_INDEX_BUFFER:
+        {
+            const struct wined3d_cs_set_index_buffer *op = data;
+
+            return state->index_buffer == op->buffer
+                    && state->index_format == op->format_id
+                    && state->index_offset == op->offset;
+        }
+
+        case WINED3D_CS_OP_SET_SHADER:
+        {
+            const struct wined3d_cs_set_shader *op = data;
+
+            if (op->type >= WINED3D_SHADER_TYPE_GRAPHICS_COUNT)
+                break;
+            return state->shader[op->type] == op->shader;
+        }
+
+        case WINED3D_CS_OP_SET_BLEND_STATE:
+        {
+            const struct wined3d_cs_set_blend_state *op = data;
+
+            return state->blend_state == op->state
+                    && !memcmp(&state->blend_factor, &op->factor, sizeof(op->factor))
+                    && state->sample_mask == op->sample_mask;
+        }
+
+        case WINED3D_CS_OP_SET_DEPTH_STENCIL_STATE:
+        {
+            const struct wined3d_cs_set_depth_stencil_state *op = data;
+
+            return state->depth_stencil_state == op->state
+                    && state->stencil_ref == op->stencil_ref;
+        }
+
+        case WINED3D_CS_OP_SET_RASTERIZER_STATE:
+        {
+            const struct wined3d_cs_set_rasterizer_state *op = data;
+
+            return state->rasterizer_state == op->state;
+        }
+
+        case WINED3D_CS_OP_SET_VIEWPORTS:
+        {
+            const struct wined3d_cs_set_viewports *op = data;
+
+            if (op->viewport_count != state->viewport_count
+                    || op->viewport_count > WINED3D_MAX_VIEWPORTS)
+                return FALSE;
+            return !memcmp(state->viewports, op->viewports,
+                    op->viewport_count * sizeof(*op->viewports));
+        }
+
+        case WINED3D_CS_OP_SET_SCISSOR_RECTS:
+        {
+            const struct wined3d_cs_set_scissor_rects *op = data;
+
+            if (op->rect_count != state->scissor_rect_count
+                    || op->rect_count > WINED3D_MAX_VIEWPORTS)
+                return FALSE;
+            return !memcmp(state->scissor_rects, op->rects,
+                    op->rect_count * sizeof(*op->rects));
+        }
+
+        case WINED3D_CS_OP_SET_LIGHT_ENABLE:
+        {
+            const struct wined3d_cs_set_light_enable *op = data;
+            const struct wined3d_light_info *light;
+
+            if (!(light = wined3d_light_state_get_light(&state->light_state, op->idx)))
+                return !op->enable;
+            return !light->enabled == !op->enable;
+        }
+
+        default:
+            break;
+    }
+
+    *comparable = FALSE;
+    return FALSE;
+}
+
+static void mgs2_p38_take_snapshot(const struct wined3d_cs *cs, struct mgs2_p38_snapshot *s)
+{
+    const struct wined3d_state *state = &cs->state;
+    const struct wined3d_device *device = cs->c.device;
+    unsigned int i, j;
+
+    memset(s, 0, sizeof(*s));
+    memcpy(s->render_states, state->render_states, sizeof(s->render_states));
+    memcpy(s->texture_states, state->texture_states, sizeof(s->texture_states));
+    for (i = 0; i < WINED3D_SHADER_TYPE_GRAPHICS_COUNT; ++i)
+    {
+        for (j = 0; j < MAX_SHADER_RESOURCE_VIEWS; ++j)
+            s->shader_resource_view[i][j] = state->shader_resource_view[i][j];
+        for (j = 0; j < MAX_SAMPLER_OBJECTS; ++j)
+            s->sampler[i][j] = state->sampler[i][j];
+        for (j = 0; j < MAX_CONSTANT_BUFFERS; ++j)
+            s->cb[i][j] = state->cb[i][j].buffer;
+        s->shader[i] = state->shader[i];
+    }
+    memcpy(s->streams, state->streams, sizeof(s->streams));
+    s->vertex_declaration = state->vertex_declaration;
+    s->index_buffer = state->index_buffer;
+    s->index_format = state->index_format;
+    s->index_offset = state->index_offset;
+    s->base_vertex_index = state->base_vertex_index;
+    memcpy(s->viewports, state->viewports, sizeof(s->viewports));
+    s->viewport_count = state->viewport_count;
+    memcpy(s->scissor_rects, state->scissor_rects, sizeof(s->scissor_rects));
+    s->scissor_rect_count = state->scissor_rect_count;
+    for (i = 0; i < WINED3D_MAX_RENDER_TARGETS; ++i)
+        s->render_targets[i] = state->fb.render_targets[i];
+    s->depth_stencil = state->fb.depth_stencil;
+    s->blend_state = state->blend_state;
+    s->blend_factor = state->blend_factor;
+    s->sample_mask = state->sample_mask;
+    s->depth_stencil_state = state->depth_stencil_state;
+    s->stencil_ref = state->stencil_ref;
+    s->rasterizer_state = state->rasterizer_state;
+    s->extra_vs_args = state->extra_vs_args;
+    s->extra_ps_args = state->extra_ps_args;
+    s->depth_bounds_enable = !!state->depth_bounds_enable;
+    s->depth_bounds_min = state->depth_bounds_min;
+    s->depth_bounds_max = state->depth_bounds_max;
+    s->primitive_type = state->primitive_type;
+    s->patch_vertex_count = state->patch_vertex_count;
+
+    /* WORLD/VIEW/PROJECTION, texture transforms, material and lights reach the
+     * generated FFP shader through these two buffers. Comparing their bytes is
+     * what makes the check exact for a fixed-function scene. */
+    s->push_constants_hash_present = 1;
+    for (i = 0; i < 2; ++i)
+    {
+        enum wined3d_push_constants type = i ? WINED3D_PUSH_CONSTANTS_PS_FFP
+                : WINED3D_PUSH_CONSTANTS_VS_FFP;
+        const struct wined3d_buffer *buffer = device->push_constants[type];
+        unsigned int size;
+
+        if (!buffer || !buffer->resource.heap_memory)
+        {
+            s->push_constants_hash_present = 0;
+            continue;
+        }
+        size = min(buffer->resource.size, sizeof(s->push_constants[i]));
+        memcpy(s->push_constants[i], buffer->resource.heap_memory, size);
+        s->push_constants_size[i] = size;
+        if (size < buffer->resource.size)
+            s->push_constants_hash_present = 0;
+    }
+}
+
+/* Called by mgs2_cs_dispatch() for every non-draw opcode, before the pending
+ * batch is closed and before the handler runs. */
+static void mgs2_p38_state_op(const struct wined3d_cs *cs, enum wined3d_cs_op opcode, const void *data)
+{
+    struct mgs2_p38_payload *c = &mgs2_p38.counters;
+    unsigned int slot = opcode < MGS2_P38_OPCODES ? opcode : MGS2_P38_OPCODES - 1;
+    BOOL comparable, redundant;
+
+    if (!mgs2_submit_census_on())
+        return;
+
+    redundant = mgs2_p38_op_is_redundant(cs, opcode, data, &comparable);
+
+    ++c->run_ops;
+    ++c->run_ops_by_opcode[slot];
+    if (comparable)
+        ++c->run_ops_comparable;
+    if (comparable && redundant)
+    {
+        ++c->run_ops_redundant;
+        ++c->run_redundant_by_opcode[slot];
+    }
+    else
+    {
+        mgs2_p38.run_all_redundant = 0;
+    }
+
+    mgs2_p38.hint_reason = MGS2_P38_BRK_CS_BARRIER;
+    mgs2_p38.hint_opcode = slot;
+}
+
+/* Set immediately before a mgs2_batch_flush() that is not caused by a CS
+ * opcode. Consumed by mgs2_p38_close(). */
+void mgs2_p38_hint(unsigned int reason)
+{
+    if (mgs2_submit_census_on())
+    {
+        mgs2_p38.hint_reason = reason;
+        mgs2_p38.hint_opcode = MGS2_P38_OPCODES - 1;
+    }
+}
+
+/* Decompose the dirty graphics-state mask that caused a draw-time closure. */
+void mgs2_p38_hint_dirty(const unsigned int *dirty, unsigned int words)
+{
+    struct mgs2_p38_payload *c = &mgs2_p38.counters;
+    unsigned int seen = 0, i, base = 0;
+
+    if (!mgs2_submit_census_on())
+        return;
+
+    mgs2_p38.hint_reason = MGS2_P38_BRK_STATE_DIRTY;
+    mgs2_p38.hint_opcode = MGS2_P38_OPCODES - 1;
+    ++c->close_dirty_total;
+
+    for (i = 0; i < words; ++i)
+    {
+        uint32_t mask = dirty[i];
+
+        while (mask)
+        {
+            unsigned int id = base + wined3d_bit_scan(&mask);
+            unsigned int cat;
+
+            if (STATE_IS_RENDER(id))                            cat = MGS2_P38_DIRTY_RENDER_STATE;
+            else if (STATE_IS_TEXTURESTAGE(id))                 cat = MGS2_P38_DIRTY_TEXTURE_STAGE;
+            else if (STATE_IS_GRAPHICS_SHADER(id))              cat = MGS2_P38_DIRTY_SHADER;
+            else if (STATE_IS_GRAPHICS_CONSTANT_BUFFER(id))     cat = MGS2_P38_DIRTY_SHADER_CONSTANTS;
+            else if (STATE_IS_GRAPHICS_SHADER_RESOURCE_BINDING(id)) cat = MGS2_P38_DIRTY_TEXTURE;
+            else if (STATE_IS_STREAMSRC(id))                    cat = MGS2_P38_DIRTY_STREAM_VB;
+            else if (STATE_IS_INDEXBUFFER(id))                  cat = MGS2_P38_DIRTY_INDEX_BUFFER;
+            else if (STATE_IS_VDECL(id))                        cat = MGS2_P38_DIRTY_VERTEX_DECL;
+            else if (STATE_IS_VIEWPORT(id) || STATE_IS_SCISSORRECT(id)) cat = MGS2_P38_DIRTY_VIEWPORT_SCISSOR;
+            else if (STATE_IS_FRAMEBUFFER(id))                  cat = MGS2_P38_DIRTY_FRAMEBUFFER;
+            else if (STATE_IS_RASTERIZER(id) || STATE_IS_BLEND(id) || STATE_IS_BLEND_FACTOR(id)
+                    || STATE_IS_SAMPLE_MASK(id) || STATE_IS_DEPTH_STENCIL(id)
+                    || STATE_IS_STENCIL_REF(id) || STATE_IS_DEPTH_BOUNDS(id))
+                                                                cat = MGS2_P38_DIRTY_BLEND_DEPTH_RASTER;
+            else if (STATE_IS_BASEVERTEXINDEX(id))              cat = MGS2_P38_DIRTY_STREAM_VB;
+            else                                                cat = MGS2_P38_DIRTY_OTHER;
+
+            if (!(seen & (1u << cat)))
+            {
+                seen |= 1u << cat;
+                ++c->close_dirty_cat[cat];
+            }
+        }
+        base += sizeof(*dirty) * CHAR_BIT;
+    }
+    /* The sampler-state group has no separate dirty id in this Wine; it reaches
+     * the draw through the shader-resource binding, and is reported there. */
+    if (seen & (seen - 1))
+        ++c->close_dirty_mixed;
+}
+
+/* Called from mgs2_batch_flush() when a batch really closes. len is the number
+ * of source strips the closed batch held; mode_ok says whether the next draw
+ * could in principle have joined it. */
+void mgs2_p38_close(unsigned int len, unsigned int mode_ok)
+{
+    struct mgs2_p38_payload *c = &mgs2_p38.counters;
+    unsigned int reason;
+
+    if (!mgs2_submit_census_on())
+        return;
+
+    reason = mgs2_p38.hint_reason < MGS2_P38_BRK_COUNT
+            ? mgs2_p38.hint_reason : MGS2_P38_BRK_OTHER;
+
+    ++c->close_total;
+    ++c->close_reason[reason];
+    if (reason == MGS2_P38_BRK_CS_BARRIER)
+        ++c->close_cs_opcode[mgs2_p38.hint_opcode];
+    ++c->close_len_hist[mgs2_p38_len_bucket(len)];
+
+    /* A closure that is still waiting for its next draw is resolved as
+     * "no next draw" -- end of frame, or a barrier followed by another. */
+    if (mgs2_p38.pending)
+        ++c->boundary_state_no_next_draw;
+
+    mgs2_p38.pending = 1;
+    mgs2_p38.pending_reason = reason;
+    mgs2_p38.pending_len = len;
+    mgs2_p38.pending_mode_ok = mode_ok;
+    /* The opcode that caused this closure has already been folded into
+     * run_all_redundant by mgs2_p38_state_op(). Structural closures are never
+     * merge candidates. */
+    if (reason != MGS2_P38_BRK_CS_BARRIER && reason != MGS2_P38_BRK_STATE_DIRTY)
+        mgs2_p38.run_all_redundant = 0;
+
+    ++mgs2_p38.boundary_index;
+    if (!(mgs2_p38.boundary_index % MGS2_P38_VERIFY_STRIDE))
+        mgs2_p38.verify_state = 1;
+
+    mgs2_p38.hint_reason = MGS2_P38_BRK_OTHER;
+    mgs2_p38.hint_opcode = MGS2_P38_OPCODES - 1;
+}
+
+/* Called for every source draw the consumer executes, after p37's counters.
+ *
+ * Resolves the verdict for the boundary that separates this draw from the
+ * previous one, and drives the sampled full-snapshot verification. The
+ * snapshot pair always brackets two consecutive real draws, whether or not a
+ * boundary sat between them: two draws that the batcher merged MUST have
+ * identical effective state, so that case is a correctness check on the
+ * existing batcher as well. */
+static void mgs2_p38_source_draw(const struct wined3d_cs *cs,
+        enum wined3d_primitive_type primitive_type,
+        const struct wined3d_draw_parameters *parameters)
+{
+    struct mgs2_p38_payload *c = &mgs2_p38.counters;
+    BOOL expected_equal;
+
+    ++c->source_by_prim[mgs2_p38_prim_bucket(primitive_type)];
+
+    if (mgs2_p38.pending)
+    {
+        expected_equal = mgs2_p38.run_all_redundant != 0;
+
+        if (expected_equal)
+            ++c->boundary_state_equal;
+        else
+            ++c->boundary_state_different;
+
+        if (expected_equal && mgs2_p38.pending_mode_ok && !parameters->indexed
+                && primitive_type == WINED3D_PT_TRIANGLESTRIP
+                && mgs2_p38.pending_len < 256)
+            ++c->boundary_mergeable;
+
+        mgs2_p38.pending = 0;
+    }
+    else
+    {
+        /* No boundary: the batcher kept both draws in one submission, so the
+         * effective state is required to be unchanged. */
+        expected_equal = TRUE;
+    }
+
+    if (mgs2_p38.snap_valid == 2)
+    {
+        BOOL snap_equal;
+
+        mgs2_p38_take_snapshot(cs, &mgs2_p38.snap[1]);
+        snap_equal = !memcmp(&mgs2_p38.snap[0], &mgs2_p38.snap[1], sizeof(mgs2_p38.snap[0]));
+        ++c->verify_checked;
+        if (!mgs2_p38.snap[0].push_constants_hash_present
+                || !mgs2_p38.snap[1].push_constants_hash_present)
+            ++c->verify_unavailable;
+        else if (!snap_equal == !expected_equal)
+            ++c->verify_agree;
+        else
+            ++c->verify_disagree;
+        mgs2_p38.snap_valid = 0;
+    }
+    else if (mgs2_p38.snap_valid == 1)
+    {
+        mgs2_p38.snap_valid = 2;
+    }
+    else if (mgs2_p38.verify_state == 1)
+    {
+        mgs2_p38_take_snapshot(cs, &mgs2_p38.snap[0]);
+        mgs2_p38.snap_valid = 1;
+        mgs2_p38.verify_state = 0;
+    }
+
+    /* A new opcode run starts optimistic and is cleared by the first opcode
+     * that is not provably a no-op. */
+    mgs2_p38.run_all_redundant = 1;
+}
+
+/* Final GL submissions, split by the primitive type actually issued. */
+void mgs2_p38_gl_draw(unsigned int kind, unsigned int count, unsigned int gl_mode)
+{
+    struct mgs2_p38_payload *c = &mgs2_p38.counters;
+    unsigned int bucket;
+
+    if (!mgs2_submit_census_on() || !count)
+        return;
+
+    switch (gl_mode)
+    {
+        case 0x0000: bucket = 0; break; /* GL_POINTS */
+        case 0x0001: bucket = 1; break; /* GL_LINES */
+        case 0x0003: bucket = 2; break; /* GL_LINE_STRIP */
+        case 0x0004: bucket = 3; break; /* GL_TRIANGLES */
+        case 0x0005: bucket = 4; break; /* GL_TRIANGLE_STRIP */
+        case 0x0006: bucket = 5; break; /* GL_TRIANGLE_FAN */
+        default:     bucket = 6; break;
+    }
+
+    switch (kind)
+    {
+        case MGS2_SUBMIT_GL_BATCH_ELEMENTS:
+            c->gl_batch_by_prim[bucket] += count;
+            break;
+        case MGS2_SUBMIT_GL_ARRAYS:
+            c->gl_arrays_by_prim[bucket] += count;
+            break;
+        default:
+            break;
+    }
+}
+
+/* A draw the strip batcher never saw: it is its own GL submission. */
+void mgs2_p38_bypass(unsigned int gl_mode)
+{
+    struct mgs2_p38_payload *c = &mgs2_p38.counters;
+    unsigned int bucket;
+
+    if (!mgs2_submit_census_on())
+        return;
+
+    switch (gl_mode)
+    {
+        case 0x0000: bucket = 0; break;
+        case 0x0001: bucket = 1; break;
+        case 0x0003: bucket = 2; break;
+        case 0x0004: bucket = 3; break;
+        case 0x0005: bucket = 4; break;
+        case 0x0006: bucket = 5; break;
+        default:     bucket = 6; break;
+    }
+    ++c->gl_bypass_by_prim[bucket];
+    ++c->gl_bypass_total;
+}
+
+/* Public p38 snapshot, published beside p37's at Present. A separate symbol so
+ * the existing p37 reader keeps working byte for byte. */
+#define MGS2_P38_CENSUS_MAGIC 0x38335250 /* PR38 */
+
+struct mgs2_p38_public
+{
+    unsigned int magic;
+    unsigned int version;
+    unsigned int size_words;
+    unsigned int signature;
+    unsigned int enabled;
+    LONG publish_sequence;
+    struct mgs2_p38_payload counters;
+};
+
+struct mgs2_p38_public mgs2_reinforcement_break_census =
+{
+    MGS2_P38_CENSUS_MAGIC,
+    1,
+    sizeof(struct mgs2_p38_public) / sizeof(unsigned int),
+    ~MGS2_P38_CENSUS_MAGIC,
+};
+
+static void mgs2_p38_publish(void)
+{
+    if (!mgs2_submit_census_on())
+        return;
+
+    mgs2_reinforcement_break_census.enabled = 1;
+    InterlockedIncrement(&mgs2_reinforcement_break_census.publish_sequence);
+    mgs2_reinforcement_break_census.counters = mgs2_p38.counters;
+    InterlockedIncrement(&mgs2_reinforcement_break_census.publish_sequence);
+}
+
+
+/* ---------------------------------------------------------------------------
+ * Patch 39 -- where the renderer thread's idle time goes.
+ *
+ * The 2026-08-14 frame-limit probe measured wined3d_cs at 0.671 of a core while
+ * the GPU spent 71.6% of the fight at or below half its maximum frequency: the
+ * frame is lost to waiting, not to throughput. But the CSMT consumer *spins*
+ * with YieldProcessor() on an empty queue before it ever blocks, and a spin
+ * burns utime exactly like real work. So "0.671 core" may be mostly waiting.
+ *
+ * This splits the consumer loop into four bounded accounts:
+ *
+ *   exec      executing command packets
+ *   present   inside the PRESENT handler, i.e. the GPU round-trip
+ *   spin      queue empty, spinning
+ *   blocked   queue empty, actually asleep on the event
+ *
+ * Cost control: the clock is read twice per present and twice per *idle
+ * episode* (a run of empty-queue polls), never per spin iteration and never per
+ * packet. At ~14 fps that is a few dozen QueryPerformanceCounter calls a second.
+ * Spin iterations are a plain counter. No allocation, no I/O, no logging.
+ * Off unless MGS2_REINFORCEMENT_CENSUS=1.
+ * --------------------------------------------------------------------------- */
+#define MGS2_P39_CENSUS_MAGIC 0x39335250 /* PR39 */
+
+struct mgs2_p39_payload
+{
+    unsigned int presents;
+    unsigned int idle_episodes;
+    unsigned int spin_iterations;
+    unsigned int wait_event_calls;
+    unsigned int packets;
+
+    /* Accumulated microseconds. 32-bit is enough for a bounded capture and
+     * keeps the published record a flat array of words like p37 and p38. */
+    unsigned int present_us;
+    unsigned int idle_us;
+    unsigned int exec_us;
+    unsigned int wall_us;
+
+    /* Per-present distribution of the GPU round-trip, in microseconds. */
+    unsigned int present_hist[8];   /* <1ms 1-2 2-4 4-8 8-16 16-32 32-64 64+ */
+    unsigned int idle_hist[8];
+};
+
+struct mgs2_p39_public
+{
+    unsigned int magic;
+    unsigned int version;
+    unsigned int size_words;
+    unsigned int signature;
+    unsigned int enabled;
+    LONG publish_sequence;
+    struct mgs2_p39_payload counters;
+};
+
+struct mgs2_p39_public mgs2_reinforcement_wait_census =
+{
+    MGS2_P39_CENSUS_MAGIC,
+    1,
+    sizeof(struct mgs2_p39_public) / sizeof(unsigned int),
+    ~MGS2_P39_CENSUS_MAGIC,
+};
+
+static LARGE_INTEGER mgs2_p39_present_start;
+
+static struct
+{
+    struct mgs2_p39_payload counters;
+    LARGE_INTEGER frequency;
+    LARGE_INTEGER last_mark;      /* wall clock reference, advanced at present */
+    LARGE_INTEGER idle_start;
+    BOOL idle_open;
+    BOOL started;
+} mgs2_p39;
+
+static unsigned int mgs2_p39_us_bucket(unsigned int us)
+{
+    if (us < 1000)   return 0;
+    if (us < 2000)   return 1;
+    if (us < 4000)   return 2;
+    if (us < 8000)   return 3;
+    if (us < 16000)  return 4;
+    if (us < 32000)  return 5;
+    if (us < 64000)  return 6;
+    return 7;
+}
+
+static unsigned int mgs2_p39_elapsed_us(const LARGE_INTEGER *from, const LARGE_INTEGER *to)
+{
+    LONGLONG ticks = to->QuadPart - from->QuadPart;
+
+    if (ticks <= 0 || !mgs2_p39.frequency.QuadPart)
+        return 0;
+    return (unsigned int)((ticks * 1000000) / mgs2_p39.frequency.QuadPart);
+}
+
+static BOOL mgs2_p39_on(void)
+{
+    if (!mgs2_submit_census_on())
+        return FALSE;
+    if (!mgs2_p39.started)
+    {
+        QueryPerformanceFrequency(&mgs2_p39.frequency);
+        QueryPerformanceCounter(&mgs2_p39.last_mark);
+        mgs2_p39.started = TRUE;
+        mgs2_reinforcement_wait_census.enabled = 1;
+    }
+    return TRUE;
+}
+
+/* Called every time the consumer sees an empty queue. Only the first poll of a
+ * run reads the clock; the rest just increment. */
+static void mgs2_p39_spin(void)
+{
+    if (!mgs2_p39_on())
+        return;
+    ++mgs2_p39.counters.spin_iterations;
+    if (!mgs2_p39.idle_open)
+    {
+        QueryPerformanceCounter(&mgs2_p39.idle_start);
+        mgs2_p39.idle_open = TRUE;
+        ++mgs2_p39.counters.idle_episodes;
+    }
+}
+
+static void mgs2_p39_wait_event(void)
+{
+    if (mgs2_p39_on())
+        ++mgs2_p39.counters.wait_event_calls;
+}
+
+/* Called when the consumer finds work again, closing an idle episode. */
+static void mgs2_p39_busy(void)
+{
+    LARGE_INTEGER now;
+    unsigned int us;
+
+    if (!mgs2_p39_on() || !mgs2_p39.idle_open)
+        return;
+    QueryPerformanceCounter(&now);
+    us = mgs2_p39_elapsed_us(&mgs2_p39.idle_start, &now);
+    mgs2_p39.counters.idle_us += us;
+    ++mgs2_p39.counters.idle_hist[mgs2_p39_us_bucket(us)];
+    mgs2_p39.idle_open = FALSE;
+}
+
+static void mgs2_p39_packet(void)
+{
+    if (mgs2_p39_on())
+        ++mgs2_p39.counters.packets;
+}
+
+/* Wraps the PRESENT handler: this is where the GPU round-trip is paid. */
+static void mgs2_p39_present(const LARGE_INTEGER *start)
+{
+    struct mgs2_p39_payload *c = &mgs2_p39.counters;
+    LARGE_INTEGER now;
+    unsigned int us;
+
+    if (!mgs2_p39_on())
+        return;
+    QueryPerformanceCounter(&now);
+    us = mgs2_p39_elapsed_us(start, &now);
+    c->present_us += us;
+    ++c->present_hist[mgs2_p39_us_bucket(us)];
+    ++c->presents;
+
+    /* Close the frame: everything not present and not idle was execution. */
+    c->wall_us += mgs2_p39_elapsed_us(&mgs2_p39.last_mark, &now);
+    mgs2_p39.last_mark = now;
+    c->exec_us = c->wall_us > c->present_us + c->idle_us
+            ? c->wall_us - c->present_us - c->idle_us : 0;
+
+    InterlockedIncrement(&mgs2_reinforcement_wait_census.publish_sequence);
+    mgs2_reinforcement_wait_census.counters = *c;
+    InterlockedIncrement(&mgs2_reinforcement_wait_census.publish_sequence);
+}
+
+
+/* ---------------------------------------------------------------------------
+ * Patch 40 -- live ABI proof.
+ *
+ * The offline probe showed i386 and armhf lay the real WineD3D structures out
+ * identically across 175 sizes, alignments and member offsets. That is a
+ * compiler result. This is the live one: it publishes the address of a real
+ * wined3d_state, the byte offsets this build actually uses, and a checksum of
+ * the bytes at those offsets. A native armhf reader on the device recomputes
+ * both from its own ARM-compiled declaration of the same structure and
+ * compares. Agreement means ARM code can read a live WineD3D object through a
+ * raw pointer, which is the last thing standing between the measured layout
+ * result and a native renderer island.
+ *
+ * Memory-only, no allocation, no logging. Published once per present, off
+ * unless MGS2_REINFORCEMENT_CENSUS=1.
+ * --------------------------------------------------------------------------- */
+#define MGS2_P40_CENSUS_MAGIC 0x30345250 /* PR40 */
+#define MGS2_P40_FIELDS 12
+
+struct mgs2_p40_public
+{
+    unsigned int magic;
+    unsigned int version;
+    unsigned int size_words;
+    unsigned int signature;
+    unsigned int enabled;
+    LONG publish_sequence;
+    unsigned int state_address;              /* guest address of the live state */
+    unsigned int state_size;                 /* sizeof(struct wined3d_state) */
+    unsigned int field_count;
+    unsigned int field_offset[MGS2_P40_FIELDS];
+    unsigned int field_size[MGS2_P40_FIELDS];
+    unsigned int checksum;                   /* FNV-1a over those byte ranges */
+    unsigned int samples;
+    /* Differential validation for the native ARM island. The reference result
+     * is produced by the same wined3d_ffp_get_fs_settings() the renderer uses;
+     * the ARM build recomputes it from the raw state and compares these bytes. */
+    unsigned int d3d_info_address;
+    unsigned int ffp_settings_size;
+    unsigned char ffp_settings[160];
+    /* Island differential validation, counted in-process. */
+    unsigned int island_calls;
+    unsigned int island_match;
+    unsigned int island_mismatch;
+    unsigned int island_first_diff_offset;
+    /* Where do the GL entry points actually live? If these are addresses inside
+     * the native Mali driver, island code can call GL directly and the large
+     * GL-calling functions become reachable. If they are Box86 bridge stubs,
+     * they cannot, and the island stays limited to computation. */
+    unsigned int gl_draw_arrays_ptr;
+    unsigned int gl_draw_elements_ptr;
+    unsigned int gl_uniform4fv_ptr;
+    /* GL context probe: the same ten values read through Wine's opengl32 and
+     * through the native driver from island code on the same thread. */
+    unsigned int gl_probe_runs;
+    unsigned int gl_probe_agree;
+    unsigned int gl_probe_disagree;
+    unsigned int gl_probe_native_unavailable;
+    unsigned int gl_probe_wine[10];
+    unsigned int gl_probe_native[10];
+    unsigned char island_ref[160];
+    unsigned char island_native[160];
+};
+
+struct mgs2_p40_public mgs2_reinforcement_abi_proof =
+{
+    MGS2_P40_CENSUS_MAGIC,
+    1,
+    sizeof(struct mgs2_p40_public) / sizeof(unsigned int),
+    ~MGS2_P40_CENSUS_MAGIC,
+};
+
+/* The reader must hash exactly these ranges, in this order. */
+#define MGS2_P40_FIELD_LIST(X)                                    \
+    X(render_states)    X(texture_states)  X(streams)             \
+    X(viewports)        X(scissor_rects)   X(blend_factor)        \
+    X(primitive_type)   X(index_offset)    X(base_vertex_index)   \
+    X(viewport_count)   X(scissor_rect_count) X(sample_mask)
+
+static unsigned int mgs2_p40_fnv(const unsigned char *p, unsigned int n, unsigned int h)
+{
+    while (n--)
+    {
+        h ^= *p++;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+static const struct wined3d_d3d_info *cs_d3d_info_for_proof;
+static const struct wined3d_gl_info *cs_gl_info_for_proof;
+
+/* Patch 42 -- the first native ARM island target.
+ *
+ * Box86 replaces this whole function with an armhf build of the very same
+ * WineD3D source, recognised by its exact prologue. It is deliberately a thin
+ * separate wrapper rather than the real function: the renderer keeps calling
+ * wined3d_ffp_get_fs_settings() as before, so no pixel depends on the island
+ * while it is being validated. mgs2_p40_publish() calls both and compares. */
+/* Deliberately a different marker from the FFP target: "MGS3". */
+__attribute__((noinline, used, optimize("no-optimize-sibling-calls")))
+void mgs2_island_gl_probe_target(unsigned int *out);
+__attribute__((noinline, used, optimize("no-optimize-sibling-calls")))
+void mgs2_island_gl_probe_target(unsigned int *out)
+{
+    MGS2_ISLAND_MARK(0x33);
+    /* Without the Box86 bridge this stays zero, which the reader reports as
+     * "native unavailable" rather than as a disagreement. */
+    if (out)
+        out[0] = 0;
+    __asm__ __volatile__("" ::: "memory");
+}
+
+BOOL mgs2_island_ffp_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv("MGS2_ISLAND_FFP");
+
+        enabled = value && strcmp(value, "0");
+    }
+    return enabled;
+}
+
+__attribute__((noinline, used, optimize("no-optimize-sibling-calls")))
+void mgs2_island_ffp_target(const struct wined3d_state *state,
+        const struct wined3d_d3d_info *d3d_info, struct ffp_frag_settings *settings)
+{
+    /* An eight-byte multi-byte NOP whose displacement spells "MGS2". Box86
+     * matches these exact bytes to find this function, which keeps the
+     * signature independent of the link addresses that a relative jump would
+     * otherwise bake in. It executes as a no-op. */
+    MGS2_ISLAND_MARK(0x32);
+    wined3d_ffp_get_fs_settings(state, d3d_info, settings);
+    __asm__ __volatile__("" ::: "memory");
+}
+
+static void mgs2_p40_publish(const struct wined3d_state *state)
+{
+    static const unsigned int offsets[MGS2_P40_FIELDS] = {
+#define X(f) offsetof(struct wined3d_state, f),
+        MGS2_P40_FIELD_LIST(X)
+#undef X
+    };
+    static const unsigned int sizes[MGS2_P40_FIELDS] = {
+#define X(f) (unsigned int)sizeof(((struct wined3d_state *)0)->f),
+        MGS2_P40_FIELD_LIST(X)
+#undef X
+    };
+    struct mgs2_p40_public *o = &mgs2_reinforcement_abi_proof;
+    unsigned int h = 2166136261u, i;
+
+    if (!mgs2_submit_census_on() || !state)
+        return;
+
+    for (i = 0; i < MGS2_P40_FIELDS; ++i)
+        h = mgs2_p40_fnv((const unsigned char *)state + offsets[i], sizes[i], h);
+
+    InterlockedIncrement(&o->publish_sequence);
+    o->enabled = 1;
+    o->state_address = (unsigned int)(ULONG_PTR)state;
+    o->state_size = (unsigned int)sizeof(struct wined3d_state);
+    o->field_count = MGS2_P40_FIELDS;
+    memcpy(o->field_offset, offsets, sizeof(offsets));
+    memcpy(o->field_size, sizes, sizeof(sizes));
+    o->checksum = h;
+    o->d3d_info_address = (unsigned int)(ULONG_PTR)&cs_d3d_info_for_proof;
+    o->ffp_settings_size = (unsigned int)sizeof(struct ffp_frag_settings);
+    if (sizeof(struct ffp_frag_settings) <= sizeof(o->ffp_settings))
+    {
+        struct ffp_frag_settings settings;
+
+        struct ffp_frag_settings native;
+        unsigned int i;
+
+        /* Both buffers start identical. The struct has alignment holes that
+         * neither implementation is required to write, so comparing them
+         * without this would report stack leftovers as a divergence -- which is
+         * exactly what the first run did, on the padding byte at offset 26. */
+        memset(&settings, 0, sizeof(settings));
+        wined3d_ffp_get_fs_settings(state, cs_d3d_info_for_proof, &settings);
+        memcpy(o->ffp_settings, &settings, sizeof(settings));
+
+        /* Under Box86 with the island enabled this call lands in native ARM
+         * code; otherwise it is the ordinary x86 path and must agree trivially. */
+        memset(&native, 0, sizeof(native));
+        mgs2_island_ffp_target(state, cs_d3d_info_for_proof, &native);
+        if (cs_gl_info_for_proof)
+        {
+            const struct wined3d_gl_info *gl = cs_gl_info_for_proof;
+
+            o->gl_draw_arrays_ptr = (unsigned int)(ULONG_PTR)MGS2_GL_INFO(gl)->gl_ops.gl.p_glDrawArrays;
+            o->gl_draw_elements_ptr = (unsigned int)(ULONG_PTR)MGS2_GL_INFO(gl)->gl_ops.gl.p_glDrawElements;
+            o->gl_uniform4fv_ptr = (unsigned int)(ULONG_PTR)MGS2_GL_INFO(gl)->gl_ops.ext.p_glUniform4fv;
+        }
+        /* The gate for extending the island: read the same GL context values
+         * through Wine's opengl32 and through the native driver from island
+         * code on this same thread, and compare. Read-only. */
+        if (cs_gl_info_for_proof && MGS2_GL_INFO(cs_gl_info_for_proof)->gl_ops.gl.p_glGetIntegerv)
+        {
+            const struct wined3d_gl_info *gl = cs_gl_info_for_proof;
+            unsigned int wine[10] = {1}, native[10] = {0};
+            GLint v[4];
+            unsigned int k;
+
+            MGS2_GL_INFO(gl)->gl_ops.gl.p_glGetIntegerv(GL_CURRENT_PROGRAM, v);              wine[1] = v[0];
+            MGS2_GL_INFO(gl)->gl_ops.gl.p_glGetIntegerv(GL_ARRAY_BUFFER_BINDING, v);         wine[2] = v[0];
+            MGS2_GL_INFO(gl)->gl_ops.gl.p_glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, v); wine[3] = v[0];
+            MGS2_GL_INFO(gl)->gl_ops.gl.p_glGetIntegerv(GL_ACTIVE_TEXTURE, v);               wine[4] = v[0];
+            MGS2_GL_INFO(gl)->gl_ops.gl.p_glGetIntegerv(GL_VIEWPORT, v);
+            wine[5] = v[0]; wine[6] = v[1]; wine[7] = v[2]; wine[8] = v[3];
+            wine[9] = 0;
+
+            mgs2_island_gl_probe_target(native);
+            ++o->gl_probe_runs;
+            if (!native[0])
+            {
+                ++o->gl_probe_native_unavailable;
+            }
+            else
+            {
+                /* Compare the context values only; the error slot is reported
+                 * separately because reading it clears it. */
+                for (k = 1; k <= 8; ++k)
+                    if (wine[k] != native[k])
+                        break;
+                if (k > 8)
+                    ++o->gl_probe_agree;
+                else
+                    ++o->gl_probe_disagree;
+                memcpy(o->gl_probe_wine, wine, sizeof(wine));
+                memcpy(o->gl_probe_native, native, sizeof(native));
+            }
+        }
+        ++o->island_calls;
+        if (!memcmp(&settings, &native, sizeof(settings)))
+        {
+            ++o->island_match;
+        }
+        else
+        {
+            ++o->island_mismatch;
+            for (i = 0; i < sizeof(settings); ++i)
+                if (((const unsigned char *)&settings)[i]
+                        != ((const unsigned char *)&native)[i])
+                {
+                    o->island_first_diff_offset = i;
+                    break;
+                }
+            memcpy(o->island_ref, &settings, sizeof(settings));
+            memcpy(o->island_native, &native, sizeof(native));
+        }
+    }
+    ++o->samples;
+    InterlockedIncrement(&o->publish_sequence);
+}
+
+
+/* Patch 46 -- call frequency of the island's 37 bridge entry points.
+ *
+ * Each bridge crossing costs a guest-stack marshal. If an entry point is called
+ * thousands of times a frame, routing it natively loses more than it saves, and
+ * the cut has to move. Counted with a plain increment, published at present. */
+#define MGS2_P46_MAGIC 0x36345250 /* PR46 */
+#define MGS2_P46_SLOTS 40
+
+struct mgs2_p46_public
+{
+    unsigned int magic, version, size_words, signature, enabled;
+    LONG publish_sequence;
+    unsigned int presents;
+    unsigned int calls[MGS2_P46_SLOTS];
+};
+
+struct mgs2_p46_public mgs2_island_entry_census =
+{
+    MGS2_P46_MAGIC, 1,
+    sizeof(struct mgs2_p46_public) / sizeof(unsigned int),
+    ~MGS2_P46_MAGIC,
+};
+
+unsigned int mgs2_p46_live[MGS2_P46_SLOTS];
+
+#undef mgs2_p46_count
+void mgs2_p46_count(unsigned int slot)
+{
+    if (slot < MGS2_P46_SLOTS && mgs2_submit_census_on())
+        ++mgs2_p46_live[slot];
+}
+
+static void mgs2_p46_publish(void)
+{
+    if (!mgs2_submit_census_on())
+        return;
+    ++mgs2_island_entry_census.presents;
+    mgs2_island_entry_census.enabled = 1;
+    InterlockedIncrement(&mgs2_island_entry_census.publish_sequence);
+    memcpy(mgs2_island_entry_census.calls, mgs2_p46_live, sizeof(mgs2_p46_live));
+    InterlockedIncrement(&mgs2_island_entry_census.publish_sequence);
+}
+
+/* The wait path is entered only after WINED3D_CS_SPIN_COUNT (2000) idle spins,
+ * which makes the suspected submit/alert boundary rare. MGS2_CS_SPIN_COUNT
+ * lowers it so a soak exercises that boundary orders of magnitude more often;
+ * unset, it is the stock value and nothing changes. */
+static unsigned int mgs2_cs_spin_count(void)
+{
+    static unsigned int value;
+
+    if (!value)
+    {
+        const char *env = getenv("MGS2_CS_SPIN_COUNT");
+        int n = env ? atoi(env) : 0;
+        value = (n > 0) ? (unsigned int)n : WINED3D_CS_SPIN_COUNT;
+    }
+    return value;
+}
+
+#ifdef MGS2_ISLAND_ARM
+/* The ARM island never arms either census, so the call sites vanish and the
+ * event ids only have to exist for the compiler. */
+#define MGS2_P52_NOTE(cs, ev)          ((void)0)
+#define MGS2_P52_SUBMIT                0
+#define MGS2_P52_ALERT                 0
+#define MGS2_P52_WAIT_PREPARE          0
+#define MGS2_P52_WAIT_ABORT_NONEMPTY   0
+#define MGS2_P52_WAIT_ENTER            0
+#define MGS2_P52_WAIT_RETURN           0
+#endif
+
+#ifndef MGS2_ISLAND_ARM
+/* The census bodies use Win32 (VirtualQuery, GetCurrentThreadId) and are
+ * never armed in the ARM island build, where those are abort stubs at best.
+ * Keep them out of it entirely rather than stubbing what cannot be called. */
+/* ---------------------------------------------------------------------------
+ * Patch 50: indirect-call target census.
+ *
+ * The native ARM island cannot yet take the four functions that carry the frame
+ * -- wined3d_buffer_load, wined3d_texture_load_location,
+ * wined3d_rendertarget_view_load_location, mgs2_batch_flush -- because their
+ * closures dispatch through function pointers held in WineD3D objects, and a
+ * static analysis cannot say what those pointers hold. "Cannot be armed" was
+ * concluded from that and was withdrawn; this measures it instead.
+ *
+ * It runs in the GUEST DLL on purpose. The hot roots are not armed, so in the
+ * island they never execute and there is nothing to observe; in the x86 build
+ * they run every frame, against the same objects and therefore the same pointer
+ * values the island would see.
+ *
+ * Memory only, bounded, published at present like every other census here.
+ * Each site keeps a handful of distinct targets, classified once on first sight
+ * and counted thereafter, so the hot path is a short scan and an increment.
+ *
+ * Classes: 1 Box86 bridge (a CC 'S' 'C' thunk -- native code the island can
+ * reach by unwrapping), 2 inside wined3d.dll itself (the island has its own ARM
+ * copy of that function), 3 some other module (needs identifying), 0 unknown.
+ * Only class 3 can turn out to require calling back into the emulator.
+ */
+#define MGS2_P50_MAGIC 0x30355250 /* PR50 */
+#define MGS2_P50_SITES 37
+#define MGS2_P50_TARGETS 8
+
+struct mgs2_p50_target
+{
+    unsigned int addr;
+    unsigned int cls;
+    unsigned int calls;
+};
+
+struct mgs2_p50_site
+{
+    unsigned int calls;
+    unsigned int distinct;
+    unsigned int overflow;
+    struct mgs2_p50_target targets[MGS2_P50_TARGETS];
+};
+
+struct mgs2_p50_public
+{
+    unsigned int magic, version, size_words, signature, enabled;
+    LONG publish_sequence;
+    unsigned int presents;
+    unsigned int module_base, module_end;
+    struct mgs2_p50_site sites[MGS2_P50_SITES];
+};
+
+struct mgs2_p50_public mgs2_island_icall_census =
+{
+    MGS2_P50_MAGIC, 1,
+    sizeof(struct mgs2_p50_public) / sizeof(unsigned int),
+    ~MGS2_P50_MAGIC,
+};
+
+static struct mgs2_p50_site mgs2_p50_live[MGS2_P50_SITES];
+static unsigned int mgs2_p50_base, mgs2_p50_end;
+
+static void mgs2_p50_init_range(void)
+{
+    MEMORY_BASIC_INFORMATION mbi;
+    IMAGE_DOS_HEADER *dos;
+    IMAGE_NT_HEADERS *nt;
+
+    if (mgs2_p50_base)
+        return;
+    if (!VirtualQuery((const void *)(ULONG_PTR)mgs2_p50_init_range, &mbi, sizeof(mbi)))
+        return;
+    dos = mbi.AllocationBase;
+    if (!dos || dos->e_magic != IMAGE_DOS_SIGNATURE)
+        return;
+    nt = (IMAGE_NT_HEADERS *)((char *)dos + dos->e_lfanew);
+    if (nt->Signature != IMAGE_NT_SIGNATURE)
+        return;
+    mgs2_p50_base = (unsigned int)(ULONG_PTR)dos;
+    mgs2_p50_end = mgs2_p50_base + nt->OptionalHeader.SizeOfImage;
+}
+
+/* One classification per distinct target, never per call. A Box86 bridge is a
+ * 0xCC 'S' 'C' thunk whose body holds the native function; that byte pattern is
+ * Box86's own signature and cannot be the prologue of real i386 code here. */
+static unsigned int mgs2_p50_classify(const void *target)
+{
+    const unsigned char *p = target;
+
+    if (!p)
+        return 0;
+    if (p[0] == 0xcc && p[1] == 'S' && p[2] == 'C')
+        return 1;
+    if ((unsigned int)(ULONG_PTR)p >= mgs2_p50_base
+            && (unsigned int)(ULONG_PTR)p < mgs2_p50_end)
+        return 2;
+    return 3;
+}
+
+void mgs2_p50_icall(unsigned int site, const void *target)
+{
+    struct mgs2_p50_site *s;
+    unsigned int i, addr;
+
+    if (site >= MGS2_P50_SITES || !mgs2_submit_census_on())
+        return;
+    mgs2_p50_init_range();
+    s = &mgs2_p50_live[site];
+    ++s->calls;
+    addr = (unsigned int)(ULONG_PTR)target;
+    for (i = 0; i < s->distinct; ++i)
+    {
+        if (s->targets[i].addr == addr)
+        {
+            ++s->targets[i].calls;
+            return;
+        }
+    }
+    if (s->distinct == MGS2_P50_TARGETS)
+    {
+        ++s->overflow;
+        return;
+    }
+    i = s->distinct++;
+    s->targets[i].addr = addr;
+    s->targets[i].cls = mgs2_p50_classify(target);
+    s->targets[i].calls = 1;
+}
+
+static void mgs2_p50_publish(void)
+{
+    if (!mgs2_submit_census_on())
+        return;
+    ++mgs2_island_icall_census.presents;
+    mgs2_island_icall_census.enabled = 1;
+    mgs2_island_icall_census.module_base = mgs2_p50_base;
+    mgs2_island_icall_census.module_end = mgs2_p50_end;
+    InterlockedIncrement(&mgs2_island_icall_census.publish_sequence);
+    memcpy(mgs2_island_icall_census.sites, mgs2_p50_live, sizeof(mgs2_p50_live));
+    InterlockedIncrement(&mgs2_island_icall_census.publish_sequence);
+}
+
+/* ---------------------------------------------------------------------------
+ * Patch 52: CS deadlock census.
+ *
+ * The freeze leaves wined3d_cs asleep for ever and the main thread spinning on a
+ * timed wait. Two very different faults produce that, and nothing collected so
+ * far separates them:
+ *
+ *   A  a command is published and the consumer is asleep anyway -- the
+ *      submit/alert handshake is broken
+ *   B  both queues are empty and the CS is behaving correctly -- the main
+ *      thread is stuck on something else entirely
+ *
+ * Reading cs->queue[].head/tail settles it. A weak-memory story was asserted
+ * before this was measured, and withdrawn; see section 24 of the brief.
+ *
+ * This is memory only and never logs. The live cs pointer and the field offsets
+ * are published here too, so an external reader can follow them through
+ * /proc/pid/mem without needing debug info. The ring records the SYNC events
+ * only -- executes are counted, not ringed, because there are thousands a frame
+ * and they would flush the history that matters.
+ */
+#define MGS2_P52_NOTE(cs, ev) mgs2_p52_note((cs), (ev))
+
+#define MGS2_P52_MAGIC 0x32355250 /* PR52 */
+#define MGS2_P52_RING 64
+
+enum mgs2_p52_event
+{
+    MGS2_P52_SUBMIT = 1,
+    MGS2_P52_ALERT,
+    MGS2_P52_WAIT_PREPARE,
+    MGS2_P52_WAIT_ABORT_NONEMPTY,
+    MGS2_P52_WAIT_ENTER,
+    MGS2_P52_WAIT_RETURN,
+};
+
+struct mgs2_p52_entry
+{
+    unsigned int event;
+    unsigned int thread;
+    unsigned int executes;
+    unsigned int default_head, default_tail;
+    unsigned int map_head, map_tail;
+    unsigned int waiting_for_event;
+};
+
+struct mgs2_p52_public
+{
+    unsigned int magic, version, size_words, signature, enabled;
+    unsigned int cs_pointer;
+    unsigned int off_queue_default_head, off_queue_default_tail;
+    unsigned int off_queue_map_head, off_queue_map_tail;
+    unsigned int off_waiting_for_event, off_thread_id;
+    unsigned int submits, alerts, executes;
+    unsigned int wait_prepares, wait_enters, wait_returns, wait_aborts;
+    unsigned int ring_write;
+    struct mgs2_p52_entry ring[MGS2_P52_RING];
+};
+
+struct mgs2_p52_public mgs2_cs_deadlock_census =
+{
+    MGS2_P52_MAGIC, 1,
+    sizeof(struct mgs2_p52_public) / sizeof(unsigned int),
+    ~MGS2_P52_MAGIC,
+};
+
+static int mgs2_p52_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv("MGS2_CS_DEADLOCK_CENSUS");
+        enabled = value && strcmp(value, "0");
+        mgs2_cs_deadlock_census.enabled = enabled;
+    }
+    return enabled;
+}
+
+static void mgs2_p52_note(struct wined3d_cs *cs, unsigned int event)
+{
+    struct mgs2_p52_public *c = &mgs2_cs_deadlock_census;
+    struct mgs2_p52_entry *e;
+
+    if (!mgs2_p52_on())
+        return;
+    if (!c->cs_pointer)
+    {
+        c->cs_pointer = (unsigned int)(ULONG_PTR)cs;
+        c->off_queue_default_head = FIELD_OFFSET(struct wined3d_cs, queue[WINED3D_CS_QUEUE_DEFAULT].head);
+        c->off_queue_default_tail = FIELD_OFFSET(struct wined3d_cs, queue[WINED3D_CS_QUEUE_DEFAULT].tail);
+        c->off_queue_map_head = FIELD_OFFSET(struct wined3d_cs, queue[WINED3D_CS_QUEUE_MAP].head);
+        c->off_queue_map_tail = FIELD_OFFSET(struct wined3d_cs, queue[WINED3D_CS_QUEUE_MAP].tail);
+        c->off_waiting_for_event = FIELD_OFFSET(struct wined3d_cs, waiting_for_event);
+        c->off_thread_id = FIELD_OFFSET(struct wined3d_cs, thread_id);
+    }
+    switch (event)
+    {
+        case MGS2_P52_SUBMIT: ++c->submits; break;
+        case MGS2_P52_ALERT: ++c->alerts; break;
+        case MGS2_P52_WAIT_PREPARE: ++c->wait_prepares; break;
+        case MGS2_P52_WAIT_ABORT_NONEMPTY: ++c->wait_aborts; break;
+        case MGS2_P52_WAIT_ENTER: ++c->wait_enters; break;
+        case MGS2_P52_WAIT_RETURN: ++c->wait_returns; break;
+    }
+    e = &c->ring[c->ring_write % MGS2_P52_RING];
+    e->event = event;
+    e->thread = GetCurrentThreadId();
+    e->executes = c->executes;
+    e->default_head = cs->queue[WINED3D_CS_QUEUE_DEFAULT].head;
+    e->default_tail = cs->queue[WINED3D_CS_QUEUE_DEFAULT].tail;
+    e->map_head = cs->queue[WINED3D_CS_QUEUE_MAP].head;
+    e->map_tail = cs->queue[WINED3D_CS_QUEUE_MAP].tail;
+    e->waiting_for_event = cs->waiting_for_event;
+    ++c->ring_write;
+}
+
+#endif /* !MGS2_ISLAND_ARM */
