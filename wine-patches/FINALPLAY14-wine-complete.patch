+        if (have_ctx) funcs->p_glDeleteBuffers(1, &gl->pbo[i]);
+        gl->pbo[i] = 0;
+    }
+    gl->pbo_active = FALSE;
+    gl->pbo_filled = 0;
+    gl->pbo_index = 0;
