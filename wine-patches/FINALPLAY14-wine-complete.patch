+static HRESULT instrument_port_download_destroy(struct instrument_port_download *entry)
+{
+    struct downloaded_wave *downloaded_wave;
+    IDirectMusicDownload *wave_download;
+    HRESULT hr = S_OK, current;
+    void *next;
+
+    if (entry->download_loaded
+            && FAILED(current = IDirectMusicPortDownload_Unload(entry->port, entry->download)))
+    {
+        WARN("Failed to unload instrument download buffer, hr %#lx\n", current);
+        hr = current;
+    }
+
+    LIST_FOR_EACH_ENTRY_SAFE(downloaded_wave, next, &entry->downloaded_waves, struct downloaded_wave, entry)
+    {
+        if (FAILED(current = IDirectMusicPortDownload_GetBuffer(entry->port, downloaded_wave->id, &wave_download)))
+        {
+            WARN("Failed to get wave download with id %#lx, hr %#lx\n", downloaded_wave->id, current);
+            if (SUCCEEDED(hr)) hr = current;
+        }
+        else
+        {
+            if (FAILED(current = IDirectMusicPortDownload_Unload(entry->port, wave_download)))
+            {
+                WARN("Failed to unload wave download buffer, hr %#lx\n", current);
+                if (SUCCEEDED(hr)) hr = current;
+            }
+            IDirectMusicDownload_Release(wave_download);
+        }
+        list_remove(&downloaded_wave->entry);
+        free(downloaded_wave);
+    }
+
+    if (entry->download) IDirectMusicDownload_Release(entry->download);
+    IDirectMusicPortDownload_Release(entry->port);
