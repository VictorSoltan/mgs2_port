+    ++d3d8_mgs2_geometry_repeat.draws;
+    if (batchable && d3d8_mgs2_vbo_source(device, primitive_type, start_vertex, vertex_count,
+            &stream_idx, &buffer, &stride, &left))
+    {
+        (void)stream_idx;
+        eligible = TRUE;
+        ++d3d8_mgs2_geometry_repeat.eligible;
+        bytes = (size_t)vertex_count * stride;
+        right = left + bytes;
+        if (buffer->mgs2_geometry_valid_overflow)
+            ++d3d8_mgs2_geometry_repeat.validity_overflow;
+        else if (!d3d8_mgs2_geometry_range_valid(buffer, left, right))
+            ++d3d8_mgs2_geometry_repeat.invalid_coverage;
