+    current_merge = d3d8_mgs2_geometry_repeat.have_last && compatible && !d3d8_mgs2_state_dirty
+            && d3d8_mgs2_geometry_repeat.current_run < D3D8_MGS2_DRAW_BATCH_MAX;
+    if (current_merge)
