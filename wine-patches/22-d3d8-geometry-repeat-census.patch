+    unsigned int stream_idx, stride = 0, left = 0, right = 0;
+    BOOL eligible = FALSE, valid = FALSE, wv_buffer, same_shape = FALSE, same_bytes = FALSE;
+    BOOL current_merge, repeat_merge;
+    size_t bytes = 0;
+    ULONGLONG slot;
