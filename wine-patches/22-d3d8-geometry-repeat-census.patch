+static void d3d8_mgs2_geometry_repeat_draw(struct d3d8_device *device,
+        D3DPRIMITIVETYPE primitive_type, BOOL batchable,
+        unsigned int start_vertex, unsigned int vertex_count,
+        BOOL compatible, unsigned int diff_mask, unsigned int stream_diff)
+{
