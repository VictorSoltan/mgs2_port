+ * no VS3 rasterizer helper, transform feedback, geometry, or custom shader is
+ * admitted here.  That keeps the production fallback exact for every complex
+ * combination while still covering MGS2's fixed-function radio/menu material
+ * permutations. */
+static BOOL mgs2_make_ffp_stage(const struct wined3d_gl_info *gl_info, struct shader_glsl_priv *priv,
+        GLuint shader_id, GLenum stage_bit, GLuint *stage_program, void *stage_uniforms,
+        uint32_t bind_attribs_map, unsigned int const_f_count)
+{
+    struct wined3d_string_buffer *tmp_name;
+    GLint linked = GL_FALSE;
+    LONGLONG probe_start;
+    uint32_t attribs_map;
+    unsigned int i;
+    GLuint program;
+    char cache_path[MAX_PATH];
+    BOOL cached = FALSE;
+
+    if (*stage_program)
+        return TRUE;
+    if (!mgs2_resolve_separable(gl_info))
+        return FALSE;
+
+    program = GL_EXTCALL(glCreateProgram());
+    if (!program)
+        return FALSE;
+
+    /* Try the cached binary on a BARE program, before anything is attached to
+     * it. The first build offered it a program that already had the shader
+     * attached and GL_PROGRAM_SEPARABLE set, and all twelve loads came back
+     * with LINK_STATUS false. A restored binary carries that state itself --
+     * separability included -- so there is nothing to set up beforehand, and a
+     * driver is within its rights to refuse a program that is not empty. */
+    if (mgs2_progbin_ready(gl_info))
+    {
+        mgs2_progbin_path(gl_info, shader_id, stage_bit, bind_attribs_map,
+                cache_path, sizeof(cache_path));
+        probe_start = mgs2_probe_now();
+        if (mgs2_progbin_load(gl_info, program, cache_path))
+        {
+            ++mgs2_progbin_hits;
+            mgs2_probe_record(MGS2_PROBE_OP_LINK_SEPARABLE_STAGE, probe_start,
+                    stage_bit == GL_VERTEX_SHADER_BIT ? 0 : 1, shader_id, GL_TRUE,
+                    1 /* d = came from the cache */, program);
+            if (stage_bit == GL_VERTEX_SHADER_BIT)
+                shader_glsl_init_vs_uniform_locations(gl_info, priv, program,
+                        stage_uniforms, const_f_count);
+            else
+                shader_glsl_init_ps_uniform_locations(gl_info, priv, program,
+                        stage_uniforms, const_f_count);
+            *stage_program = program;
+            return TRUE;
+        }
+        ++mgs2_progbin_misses;
+        cached = TRUE;   /* the path is valid; store into it after linking */
+    }
+
+    MGS2_LOCAL(mgs2_glProgramParameteri)(program, GL_PROGRAM_SEPARABLE, GL_TRUE);
+    /* Without the hint, set BEFORE linking, the driver is allowed to keep no
+     * retrievable binary at all -- so probe whether the call is even accepted
+     * here rather than assuming a silent success. */
+    if (cached)
+    {
+        const struct wined3d_gl_info *gi_ = MGS2_GL_INFO(gl_info);
+        GLenum e_;
+
+        while (gi_->gl_ops.gl.p_glGetError() != GL_NO_ERROR) { }
+        MGS2_LOCAL(mgs2_glProgramParameteri)(program,
+                GL_PROGRAM_BINARY_RETRIEVABLE_HINT, GL_TRUE);
+        while ((e_ = gi_->gl_ops.gl.p_glGetError()) != GL_NO_ERROR)
+            if (!mgs2_pbc.hint_err) mgs2_pbc.hint_err = e_;
+    }
+    GL_EXTCALL(glAttachShader(program, shader_id));
+
+    if (!shader_glsl_use_explicit_attrib_location(gl_info))
+    {
+        /* This context does not get ARB_explicit_attrib_location -- it is
+         * promoted at desktop GL 3.3 and the GLES 3.2 version parses as 3.2 --
+         * so the generated FFP vertex shader carries no layout(location=)
+         * qualifier and the monolithic path binds every attribute by name
+         * before linking.  A stage program is linked on its own and needs
+         * exactly the same bindings; without them the driver assigns its own
+         * locations while wined3d keeps feeding the arrays at the fixed FFP
+         * indices, and every vertex attribute reads from the wrong array.
+         * That, not the pipeline itself, is what corrupted the image. */
+        if (stage_bit == GL_VERTEX_SHADER_BIT)
+        {
+            tmp_name = string_buffer_get(&priv->string_buffers);
+            /* Patch 30: a programmable vertex shader declares only the inputs its
+             * signature names, so the caller passes reg_maps.input_registers and
+             * the FFP caller keeps passing the full fixed-function set. Binding a
+             * name the shader does not declare is harmless; failing to bind one it
+             * does declare is what corrupted the image for patch 27. */
+            attribs_map = bind_attribs_map;
+            while (attribs_map)
+            {
+                i = wined3d_bit_scan(&attribs_map);
+                string_buffer_sprintf(tmp_name, "vs_in%u", i);
+                GL_EXTCALL(glBindAttribLocation(program, i, tmp_name->buffer));
+            }
+            checkGLcall("glBindAttribLocation");
+            string_buffer_release(&priv->string_buffers, tmp_name);
+        }
+        else if (!use_legacy_fragment_output(gl_info) && !gl_info->is_gles)
+        {
+            /* The fragment outputs would need glBindFragDataLocation(), which
+             * is desktop-only and NULL in this stack.  On GLES the single
+             * output defaults to location 0, exactly as the monolithic path
+             * relies on. */
+            GL_EXTCALL(glDeleteProgram(program));
+            return FALSE;
+        }
+    }
+
+    probe_start = mgs2_probe_now();
+    GL_EXTCALL(glLinkProgram(program));
+    GL_EXTCALL(glGetProgramiv(program, GL_LINK_STATUS, &linked));
+    mgs2_probe_record(MGS2_PROBE_OP_LINK_SEPARABLE_STAGE, probe_start,
+            stage_bit == GL_VERTEX_SHADER_BIT ? 0 : 1, shader_id, linked, 0, program);
+    if (linked && cached)
+        mgs2_progbin_store(gl_info, program, cache_path);
+
+    if (!linked)
+    {
+        ERR("Separable %s stage program %u failed to link.\n",
+                stage_bit == GL_VERTEX_SHADER_BIT ? "vertex" : "fragment", program);
+        print_glsl_info_log(gl_info, program, TRUE);
+        GL_EXTCALL(glDeleteProgram(program));
+        return FALSE;
+    }
+
+    /* const_f_count is 0 for a fixed-function stage, which has no vs_c[]/ps_c[]
+     * array at all, and the shader's limits->constant_float for a programmable
+     * one. Passing 0 for a programmable vertex shader would leave every
+     * uniform_f_location invalid and the shader would run on stale constants. */
+    if (stage_bit == GL_VERTEX_SHADER_BIT)
+        shader_glsl_init_vs_uniform_locations(gl_info, priv, program, stage_uniforms, const_f_count);
+    else
+        shader_glsl_init_ps_uniform_locations(gl_info, priv, program, stage_uniforms, const_f_count);
+    *stage_program = program;
+    return TRUE;
+}
+
+/* Patch 30: stage programs for programmable vertex shaders, keyed on the compiled
+ * GL shader id. The whole gain is reuse -- the FFP side gets it from the shader
+ * cache wined3d already keeps, and a programmable shader has no such slot, so one
+ * lives here. Sized for MGS2: the measured session linked 27 pairs, and distinct
+ * vertex shaders are far fewer than pairs. A full table simply falls back to the
+ * monolithic path rather than evicting, because evicting a stage program that a
+ * live pipeline still references would be a use-after-free in the driver. */
+#define MGS2_VS_STAGE_CACHE_SIZE 64
+
+struct mgs2_vs_stage_cache
+{
+    unsigned int count;
+    struct
+    {
+        GLuint shader_id;
+        GLuint stage_program;
+        struct glsl_vs_program stage;
+    } entries[MGS2_VS_STAGE_CACHE_SIZE];
+};
+
+/* The FFP half of the monolithic path's constant_update_mask, derived from the
+ * uniform locations that the two stage programs actually exposed.  The first
+ * candidate hard-coded a fixed mask instead; that both requested updates for
+ * absent uniforms and, worse, omitted clip planes and point size. */
+static void mgs2_set_ffp_constant_update_mask(struct glsl_shader_prog_link *entry)
+{
+    unsigned int i;
+
+    entry->constant_update_mask = WINED3D_SHADER_CONST_FFP_MODELVIEW
+            | WINED3D_SHADER_CONST_FFP_PROJ | WINED3D_SHADER_CONST_FFP_LIGHTS
+            | WINED3D_SHADER_CONST_FFP_PS;
+
+    for (i = 1; i < MAX_VERTEX_BLENDS; ++i)
+    {
+        if (entry->vs.modelview_matrix_location[i] != -1)
+        {
+            entry->constant_update_mask |= WINED3D_SHADER_CONST_FFP_VERTEXBLEND;
+            break;
+        }
+    }
+
+    for (i = 0; i < WINED3D_MAX_FFP_TEXTURES; ++i)
+    {
+        if (entry->vs.texture_matrix_location[i] != -1)
+        {
+            entry->constant_update_mask |= WINED3D_SHADER_CONST_FFP_TEXMATRIX;
+            break;
+        }
+    }
+
+    if (entry->vs.material_ambient_location != -1 || entry->vs.material_diffuse_location != -1
+            || entry->vs.material_specular_location != -1
+            || entry->vs.material_emissive_location != -1
+            || entry->vs.material_shininess_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_FFP_MATERIAL;
+
+    if (entry->vs.clip_planes_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_VS_CLIP_PLANES;
+    if (entry->vs.pointsize_min_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_VS_POINTSIZE;
+
+    for (i = 0; i < WINED3D_MAX_FFP_TEXTURES; ++i)
+    {
+        if (entry->ps.bumpenv_mat_location[i] != -1)
+        {
+            entry->constant_update_mask |= WINED3D_SHADER_CONST_PS_BUMP_ENV;
+            break;
+        }
+    }
+
+    if (entry->ps.fog_color_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_PS_FOG;
+    if (entry->ps.alpha_test_ref_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_PS_ALPHA_TEST;
+    if (entry->ps.color_key_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_FFP_COLOR_KEY;
+}
+
+/* Patch 30: the vertex half of the monolithic path's programmable branch, plus the
+ * fixed-function pixel half, because this pairing is a programmable vertex shader
+ * with an FFP pixel shader. Mirrors glsl_shader.c's monolithic assembly rather
+ * than inventing a mask: patch 27's first candidate hard-coded one and both asked
+ * for absent uniforms and dropped clip planes.
+ *
+ * VS_CLIP_PLANES and VS_POINTSIZE stay keyed on their locations, exactly as the
+ * FFP variant does, because both uniforms exist in either kind of vertex shader. */
+static void mgs2_set_programmable_vs_constant_update_mask(struct glsl_shader_prog_link *entry,
+        const struct wined3d_shader *vshader)
+{
+    unsigned int i;
+
+    entry->constant_update_mask = WINED3D_SHADER_CONST_VS_F | WINED3D_SHADER_CONST_FFP_PS;
+    if (vshader->reg_maps.integer_constants)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_VS_I;
+    if (vshader->reg_maps.boolean_constants)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_VS_B;
+    if (entry->vs.pos_fixup_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_POS_FIXUP;
+    if (entry->vs.base_vertex_id_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_BASE_VERTEX_ID;
+    if (entry->vs.clip_planes_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_VS_CLIP_PLANES;
+    if (entry->vs.pointsize_min_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_VS_POINTSIZE;
+
+    for (i = 0; i < WINED3D_MAX_FFP_TEXTURES; ++i)
+    {
+        if (entry->ps.bumpenv_mat_location[i] != -1)
+        {
+            entry->constant_update_mask |= WINED3D_SHADER_CONST_PS_BUMP_ENV;
+            break;
+        }
+    }
+
+    if (entry->ps.fog_color_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_PS_FOG;
+    if (entry->ps.alpha_test_ref_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_PS_ALPHA_TEST;
+    if (entry->ps.color_key_location != -1)
+        entry->constant_update_mask |= WINED3D_SHADER_CONST_FFP_COLOR_KEY;
+}
+
+static BOOL mgs2_make_ffp_pipeline(const struct wined3d_context_gl *context_gl,
+        struct shader_glsl_priv *priv, struct glsl_ffp_vertex_shader *vs,
+        struct glsl_ffp_fragment_shader *ps, struct glsl_shader_prog_link *entry)
+{
+    struct mgs2_ffp_vs_source *vs_source = vs->source;
+    struct mgs2_ffp_ps_source *ps_source = ps->source;
+    LONGLONG probe_start;
+    GLint valid = GL_FALSE;
+    GLuint pipeline;
+
+    /* The fixed-function pair keeps exactly the arguments it had before patch 30
+     * generalised this: the whole FFP attribute set, and no vs_c[]/ps_c[] array. */
+    if (!mgs2_make_ffp_stage(context_gl->gl_info, priv, vs_source->shader_id, GL_VERTEX_SHADER_BIT,
+            &vs_source->stage_program, &vs_source->stage, (1u << WINED3D_FFP_ATTRIBS_COUNT) - 1, 0)
+            || !mgs2_make_ffp_stage(context_gl->gl_info, priv, ps_source->shader_id, GL_FRAGMENT_SHADER_BIT,
+                    &ps_source->stage_program, &ps_source->stage, 0, 0))
+        return FALSE;
+
+    probe_start = mgs2_probe_now();
+    MGS2_LOCAL(mgs2_glGenProgramPipelines)(1, &pipeline);
+    if (!pipeline)
+        return FALSE;
+    MGS2_LOCAL(mgs2_glUseProgramStages)(pipeline, GL_VERTEX_SHADER_BIT, vs_source->stage_program);
+    MGS2_LOCAL(mgs2_glUseProgramStages)(pipeline, GL_FRAGMENT_SHADER_BIT, ps_source->stage_program);
+    if (priv->mgs2_separable_validate)
+    {
+        MGS2_LOCAL(mgs2_glValidateProgramPipeline)(pipeline);
+        MGS2_LOCAL(mgs2_glGetProgramPipelineiv)(pipeline, GL_VALIDATE_STATUS, &valid);
+        if (!valid)
+        {
+            /* Validation also reports on the *current* GL state, so a failure
+             * here is not by itself proof of an incompatible stage interface;
+             * MGS2_GL_SEPARABLE=2 keeps the pipeline anyway, for one run that
+             * can tell the two apart. */
+            ERR("Program pipeline %u (VS stage %u, PS stage %u) failed validation.\n",
+                    pipeline, vs_source->stage_program, ps_source->stage_program);
+            if (mgs2_glGetProgramPipelineInfoLog)
+            {
+                char log[1024];
+
+                log[0] = '\0';
+                MGS2_LOCAL(mgs2_glGetProgramPipelineInfoLog)(pipeline, sizeof(log), NULL, log);
+                if (log[0])
+                    ERR("Pipeline info log: %s\n", debugstr_a(log));
+            }
+            mgs2_probe_record(MGS2_PROBE_OP_VALIDATE_PIPELINE, probe_start,
+                    vs_source->stage_program, ps_source->stage_program, 0, 0, pipeline);
+            MGS2_LOCAL(mgs2_glDeleteProgramPipelines)(1, &pipeline);
+            return FALSE;
+        }
+    }
+    mgs2_probe_record(MGS2_PROBE_OP_VALIDATE_PIPELINE, probe_start,
+            vs_source->stage_program, ps_source->stage_program, 1, 0, pipeline);
+
+    /* A pipeline name is not a program name: the two live in separate object
+     * namespaces, so entry->id must stay a program name.  The first candidate
+     * stored the pipeline here, which made glUseProgram() and the monolithic
+     * "did the program change" comparison operate on a foreign object.  Zero
+     * is correct -- a separable pair runs with no current program -- and
+     * transitions are detected on the entry pointer instead. */
+    entry->id = 0;
+    entry->pipeline_id = pipeline;
+    entry->vs_program_id = vs_source->stage_program;
+    entry->mgs_vs_source = vs_source;
+    entry->ps_program_id = ps_source->stage_program;
+    entry->separable = TRUE;
+
+    /* Take the stage uniform locations, but keep the shader object ids this
+     * entry was created with.  The whole-struct copy used to overwrite them
+     * with zero, and both the program lookup key and
+     * delete_glsl_program_entry() read entry->vs.id / entry->ps.id: every
+     * separable pair hashed to the same all-zero key, so no pair was ever
+     * found again, and the list_remove() that unlinks the entry from the FFP
+     * shader was skipped -- the entry was freed while still linked into
+     * ffp_vs->linked_programs.  Tearing those shaders down on a savegame load
+     * then walked freed memory.  shader_entry itself is linked by the caller. */
+    entry->vs = vs_source->stage;
+    entry->ps = ps_source->stage;
+    entry->vs.id = vs->id;
+    entry->ps.id = ps->id;
+    entry->vs.vertex_color_clamp = GL_FIXED_ONLY_ARB;
+
+    mgs2_set_ffp_constant_update_mask(entry);
+    return TRUE;
+}
+
+/* Patch 30: a pipeline whose vertex stage is a programmable shader and whose
+ * fragment stage is fixed function -- the pairing MGS2 uses for the world and its
+ * characters, and therefore the one that produced all 27 monolithic links and
+ * 5765 ms of stalls in the measured gameplay session.
+ *
+ * Written as a sibling of mgs2_make_ffp_pipeline rather than by generalising it.
+ * That duplicates the pipeline plumbing, and deliberately: the FFP path is
+ * production and each of the six defects patch 27 had to fix lived in exactly
+ * these lines, so an experimental path must not be able to change its behaviour.
+ *
+ * Feasible here only because the vertex shader needs no companion: the monolithic
+ * path attaches a VS3 rasterizer helper for shader_version.major < 4, but skips it
+ * when is_gles && major < 3, and MGS2 is D3D8 with 1.x vertex shaders on a GLES
+ * driver. The caller checks that. */
+static BOOL mgs2_make_programmable_vs_pipeline(const struct wined3d_context_gl *context_gl,
+        struct shader_glsl_priv *priv, const struct wined3d_shader *vshader, GLuint vs_id,
+        struct glsl_ffp_fragment_shader *ps, struct glsl_shader_prog_link *entry)
+{
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    struct mgs2_ffp_ps_source *ps_source = ps->source;
+    struct glsl_vs_program *stage = NULL;
+    GLuint *stage_program = NULL;
+    struct mgs2_vs_stage_cache *cache;
+    GLint valid = GL_FALSE;
+    LONGLONG probe_start;
+    unsigned int i;
+    GLuint pipeline;
+
+    if (!(cache = priv->mgs2_vs_stages))
+    {
+        if (!(cache = calloc(1, sizeof(*cache))))
+            return FALSE;
+        priv->mgs2_vs_stages = cache;
+    }
+
+    for (i = 0; i < cache->count; ++i)
+    {
+        if (cache->entries[i].shader_id == vs_id)
+        {
+            stage_program = &cache->entries[i].stage_program;
+            stage = &cache->entries[i].stage;
+            break;
+        }
+    }
+    if (!stage_program)
+    {
+        /* A full table falls back to the monolithic path instead of evicting.
+         * Evicting a stage program that a live pipeline still names would be a
+         * use-after-free inside the driver, and pipelines outlive this call. */
+        if (cache->count >= MGS2_VS_STAGE_CACHE_SIZE)
+            return FALSE;
+        cache->entries[cache->count].shader_id = vs_id;
+        stage_program = &cache->entries[cache->count].stage_program;
+        stage = &cache->entries[cache->count].stage;
+        ++cache->count;
+    }
+
+    if (!mgs2_make_ffp_stage(gl_info, priv, vs_id, GL_VERTEX_SHADER_BIT, stage_program, stage,
+            vshader->reg_maps.input_registers, vshader->limits->constant_float)
+            || !mgs2_make_ffp_stage(gl_info, priv, ps_source->shader_id, GL_FRAGMENT_SHADER_BIT,
+                    &ps_source->stage_program, &ps_source->stage, 0, 0))
+        return FALSE;
+
+    probe_start = mgs2_probe_now();
+    MGS2_LOCAL(mgs2_glGenProgramPipelines)(1, &pipeline);
+    if (!pipeline)
+        return FALSE;
+    MGS2_LOCAL(mgs2_glUseProgramStages)(pipeline, GL_VERTEX_SHADER_BIT, *stage_program);
+    MGS2_LOCAL(mgs2_glUseProgramStages)(pipeline, GL_FRAGMENT_SHADER_BIT, ps_source->stage_program);
+    if (priv->mgs2_separable_validate)
+    {
+        MGS2_LOCAL(mgs2_glValidateProgramPipeline)(pipeline);
+        MGS2_LOCAL(mgs2_glGetProgramPipelineiv)(pipeline, GL_VALIDATE_STATUS, &valid);
+        if (!valid)
+        {
+            ERR("Programmable-VS pipeline %u (VS stage %u, PS stage %u) failed validation.\n",
+                    pipeline, *stage_program, ps_source->stage_program);
+            if (mgs2_glGetProgramPipelineInfoLog)
+            {
+                char log[1024];
+
+                log[0] = '\0';
+                MGS2_LOCAL(mgs2_glGetProgramPipelineInfoLog)(pipeline, sizeof(log), NULL, log);
+                if (log[0])
+                    ERR("Pipeline info log: %s\n", debugstr_a(log));
+            }
+            /* d = 1 marks the programmable-VS variant in the probe ring, so a
+             * capture can tell the two pairings apart. */
+            mgs2_probe_record(MGS2_PROBE_OP_VALIDATE_PIPELINE, probe_start,
+                    *stage_program, ps_source->stage_program, 0, 1, pipeline);
+            MGS2_LOCAL(mgs2_glDeleteProgramPipelines)(1, &pipeline);
+            return FALSE;
+        }
+    }
+    mgs2_probe_record(MGS2_PROBE_OP_VALIDATE_PIPELINE, probe_start,
+            *stage_program, ps_source->stage_program, 1, 1, pipeline);
+
+    entry->id = 0;
+    entry->pipeline_id = pipeline;
+    entry->vs_program_id = *stage_program;
+    entry->ps_program_id = ps_source->stage_program;
+    entry->separable = TRUE;
+    entry->vs = *stage;
+    entry->ps = ps_source->stage;
+    entry->vs.id = vs_id;
+    entry->ps.id = ps->id;
+    entry->vs.vertex_color_clamp = GL_FIXED_ONLY_ARB;
+
+    mgs2_set_programmable_vs_constant_update_mask(entry, vshader);
+
+    /* Samplers and uniform blocks belong to the stage program, not the pipeline,
+     * and shader_glsl_load_program_resources() assigns them with plain glUniform1i.
+     * Make the stage current for that and drop back to no current program, which
+     * is what a bound pipeline needs -- the same sequence the FFP pair already uses
+     * for its fragment samplers, rather than glActiveShaderProgram, because that
+     * sequence is the one proven on this driver. */
+    GL_EXTCALL(glUseProgram(*stage_program));
+    shader_glsl_load_program_resources(context_gl, priv, *stage_program, vshader);
+    GL_EXTCALL(glUseProgram(0));
+    checkGLcall("separable programmable-VS resource setup");
+    return TRUE;
+}
