+                            got + sizeof(format), 14695981039346656037ull);
+                    memcpy(&rformat, rb, sizeof(rformat));
+                    mgs2_progbin_roundtrip(gl_info, mgs2_glProgramBinary, rformat,
+                            rb + sizeof(rformat), got,
+                            &mgs2_pbc.file_rt_ok, &mgs2_pbc.sep_err, TRUE);
+                }
+                free(rb);
+                fclose(back);
+            }
+        }
+    }
+    else ++mgs2_pbc.store_write_fail;
+    free(blob);
+}
