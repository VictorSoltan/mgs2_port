+/* One round trip: hand a blob straight back to the driver in a fresh program,
+ * in this context, with no file and no key anywhere near it. Records the info
+ * log even when glGetError() is clean, because glProgramBinary is entitled to
+ * leave LINK_STATUS false without raising anything at all -- and it does. */
+static void mgs2_progbin_roundtrip(const struct wined3d_gl_info *gl_info,
+        PFN_mgs2_glProgramBinary put, GLenum format, const void *blob, GLsizei len,
+        unsigned int *ok, unsigned int *errout, BOOL separable)
+{
+    const struct wined3d_gl_info *gi = MGS2_GL_INFO(gl_info);
+    GLuint probe;
+    GLint linked = 0, loglen = 0;
+    GLenum err, first = GL_NO_ERROR;
+
+    if (!put || !(probe = GL_EXTCALL(glCreateProgram())))
+        return;
+    /* A binary taken from a separable program may only be accepted by a target
+     * that is itself marked separable: the flag is program state, and the
+     * driver has every reason to refuse a blob that does not match the object
+     * it is being poured into. The monolithic round trip succeeds while the
+     * separable one says "Bad program binary", which is exactly the shape that
+     * hypothesis predicts. */
+    if (separable && mgs2_glProgramParameteri)
+        mgs2_glProgramParameteri(probe, GL_PROGRAM_SEPARABLE, GL_TRUE);
+    while (gi->gl_ops.gl.p_glGetError() != GL_NO_ERROR) { }
+    put(probe, format, blob, len);
+    while ((err = gi->gl_ops.gl.p_glGetError()) != GL_NO_ERROR)
+        if (first == GL_NO_ERROR) first = err;
+    GL_EXTCALL(glGetProgramiv(probe, GL_LINK_STATUS, &linked));
+    *ok = linked ? 1 : 0;
+    *errout = first;
+    if (!linked && !mgs2_pbc.infolog_len)
+    {
+        GL_EXTCALL(glGetProgramiv(probe, GL_INFO_LOG_LENGTH, &loglen));
+        if (loglen > 0)
+        {
+            char text[64] = {0};
+            GLsizei got = 0;
+
+            GL_EXTCALL(glGetProgramInfoLog(probe, sizeof(text) - 1, &got, text));
+            mgs2_pbc.infolog_len = (unsigned int)loglen;
+            memcpy(mgs2_pbc.infolog, text, sizeof(mgs2_pbc.infolog));
+        }
+        else
+        {
+            mgs2_pbc.infolog_len = 0xffffffffu;   /* asked, and it was empty */
+        }
+    }
+    GL_EXTCALL(glDeleteProgram(probe));
+}
