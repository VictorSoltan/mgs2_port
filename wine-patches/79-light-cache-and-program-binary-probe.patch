+static BOOL mgs2_progbin_ready(const struct wined3d_gl_info *gl_info)
+{
+    const struct wined3d_gl_info *gi = MGS2_GL_INFO(gl_info);
+    const char *env, *str;
+    GLint formats = 0;
+    unsigned long long h = 14695981039346656037ull;
+
+    if (mgs2_progbin_state)
+        return mgs2_progbin_state > 0;
+    mgs2_progbin_state = -1;
+
+    /* OFF by default, and the reason is measured rather than cautious.
+     *
+     * This driver produces a program binary, reports its length, hands back
+     * 12280 bytes in its own format 0x8f61 -- and will not take them back. The
+     * in-memory round trip below (roundtrip_ok in PBC1) hands the blob straight
+     * to glProgramBinary on a fresh program in the same context, with no file
+     * and no key involved: GL raises NO error and LINK_STATUS is still false.
+     * Twelve file-backed loads behaved identically. So the entry points exist,
+     * the format enum is real, and reloading simply does not work here.
+     *
+     * The code stays because retesting after a driver update is then one run:
+     * MGS2_GL_PROGRAM_CACHE=1 and read roundtrip_ok. */
+    env = getenv("MGS2_GL_PROGRAM_CACHE");
+    if (!env || strcmp(env, "1"))
+        return FALSE;
+
+    MGS2_RESOLVE_GL(glProgramParameteri);
+    if (!mgs2_glGetProgramBinary)
+        mgs2_glGetProgramBinary = mgs2_get_gl_func("glGetProgramBinary");
+    if (!mgs2_glProgramBinary)
+        mgs2_glProgramBinary = mgs2_get_gl_func("glProgramBinary");
+    if (!mgs2_glGetProgramBinaryOES)
+        mgs2_glGetProgramBinaryOES = mgs2_get_gl_func("glGetProgramBinaryOES");
+    if (!mgs2_glProgramBinaryOES)
+        mgs2_glProgramBinaryOES = mgs2_get_gl_func("glProgramBinaryOES");
+    mgs2_pbc.oes_present = (mgs2_glGetProgramBinaryOES && mgs2_glProgramBinaryOES) ? 1 : 0;
+    if (!mgs2_glGetProgramBinary || !mgs2_glProgramBinary || !mgs2_glProgramParameteri)
+    {
+        ERR("MGS2 program cache: entry points unavailable, cache off\n");
+        return FALSE;
+    }
+
+    /* The one capability question worth asking. A driver may expose the calls
+     * and still offer no format, in which case nothing can be stored. */
+    gi->gl_ops.gl.p_glGetIntegerv(GL_NUM_PROGRAM_BINARY_FORMATS, &formats);
+    while (gi->gl_ops.gl.p_glGetError() != GL_NO_ERROR) { /* GLES-only enum on some stacks */ }
+    if (formats < 1)
+    {
+        ERR("MGS2 program cache: GL_NUM_PROGRAM_BINARY_FORMATS is %d, cache off\n", formats);
+        return FALSE;
+    }
+
+    /* A binary is valid only for the driver that produced it. */
+    if ((str = (const char *)gi->gl_ops.gl.p_glGetString(GL_VENDOR)))
+        h = mgs2_progbin_fnv(str, strlen(str), h);
+    if ((str = (const char *)gi->gl_ops.gl.p_glGetString(GL_RENDERER)))
+        h = mgs2_progbin_fnv(str, strlen(str), h);
+    if ((str = (const char *)gi->gl_ops.gl.p_glGetString(GL_VERSION)))
+        h = mgs2_progbin_fnv(str, strlen(str), h);
+    mgs2_progbin_driver = (unsigned int)(h ^ (h >> 32));
+
+    env = getenv("MGS2_GL_PROGRAM_CACHE_DIR");
+    snprintf(mgs2_progbin_dir, sizeof(mgs2_progbin_dir), "%s", (env && *env) ? env
+            : "Z:\\storage\\roms\\ports\\MGS2-Substance\\shadercache");
+
+    mgs2_progbin_state = 1;
+    mgs2_pbc.state = 1;
+    ERR("MGS2 program cache: on, %d binary format(s), driver %08x, dir %s\n",
+            formats, mgs2_progbin_driver, mgs2_progbin_dir);
+    return TRUE;
+}
