+static BOOL mgs2_progbin_load(const struct wined3d_gl_info *gl_info, GLuint program,
+        const char *path)
+{
+    const struct wined3d_gl_info *gi = MGS2_GL_INFO(gl_info);
+    GLenum format;
+    GLint linked = 0;
+    long size;
+    void *blob;
+    FILE *f;
+
+    if (!(f = fopen(path, "rb")))
+    {
+        ++mgs2_pbc.open_fail;
+        return FALSE;
+    }
+    if (fseek(f, 0, SEEK_END) || (size = ftell(f)) <= (long)sizeof(format))
+    {
+        ++mgs2_pbc.short_file;
+        fclose(f);
+        return FALSE;
+    }
+    rewind(f);
+    if (!(blob = malloc(size)))
+    {
+        fclose(f);
+        return FALSE;
+    }
+    if (fread(blob, 1, size, f) != (size_t)size)
+    {
+        fclose(f);
+        free(blob);
+        return FALSE;
+    }
+    fclose(f);
+
+    memcpy(&format, blob, sizeof(format));
+    /* Mark the target separable before pouring in a separable binary; see the
+     * round-trip comment above. */
+    if (mgs2_glProgramParameteri)
+        mgs2_glProgramParameteri(program, GL_PROGRAM_SEPARABLE, GL_TRUE);
+    /* The game leaves GL errors pending -- 20479 GL_INVALID_OPERATION from
+     * glAlphaFunc in one measured run -- so without draining first, whatever we
+     * read afterwards is somebody else's. */
+    while (gi->gl_ops.gl.p_glGetError() != GL_NO_ERROR) { }
+    mgs2_glProgramBinary(program, format, (const char *)blob + sizeof(format),
+            (GLsizei)(size - sizeof(format)));
+    /* A stale or foreign binary is a normal outcome, not an error: the spec lets
+     * the driver reject one after any software change. Swallow the GL error and
+     * let the caller link from source. */
+    {
+        GLenum err, first = GL_NO_ERROR;
+
+        while ((err = gi->gl_ops.gl.p_glGetError()) != GL_NO_ERROR)
+            if (first == GL_NO_ERROR) first = err;
+        if (first != GL_NO_ERROR) mgs2_pbc.gl_error = first;
+    }
+    GL_EXTCALL(glGetProgramiv(program, GL_LINK_STATUS, &linked));
+    mgs2_pbc.last_format = format;
+    mgs2_pbc.last_size = (unsigned int)size;
+    if (!linked) ++mgs2_pbc.link_false;
+    free(blob);
+    return linked != 0;
+}
