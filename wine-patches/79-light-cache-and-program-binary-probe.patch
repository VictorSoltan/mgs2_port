+/* ---------------------------------------------------------------------------
+ * Persistent program-binary cache for separable stage programs.
+ *
+ * Measured before it was written, which decided its shape. In one autoload run
+ * the GPU probe recorded 54 events: five glCompileShader calls costing 16 ms in
+ * total, and five separable-stage LINKS costing 611 ms -- 122 ms each. So the
+ * expensive thing is linking, not compiling, and the "shader compile freeze" is
+ * really a link freeze.
+ *
+ * The same run showed all five sources DISTINCT. That closes the obvious design:
+ * a cache that lives only inside one run has nothing to hit. The win has to come
+ * from carrying the linked binaries ACROSS runs, which is what this does.
+ *
+ * The driver is OpenGL ES 3.2, where glGetProgramBinary/glProgramBinary are core
+ * and the format is implementation-defined -- a binary is only valid for the
+ * exact driver that produced it, so GL_VENDOR/GL_RENDERER/GL_VERSION go into the
+ * key and a failed load must fall back silently rather than being an error.
+ *
+ * Worth 611 ms per run from the second run onward, and nothing at all on a
+ * first run or after a driver update. That is the honest size of it.
+ */
+#define MGS2_PROGBIN_VERSION 1u
+#ifndef GL_PROGRAM_BINARY_RETRIEVABLE_HINT
+#define GL_PROGRAM_BINARY_RETRIEVABLE_HINT 0x8257
+#endif
+#ifndef MGS2_PROGBIN_PATH_MAX
+#define MGS2_PROGBIN_PATH_MAX 260
+#endif
+/* stdio, not CreateFileA: the island links a SECOND, native ARM copy of this
+ * translation unit into Box86, where kernel32 does not exist. The Win32 calls
+ * compiled fine and then failed at link time with six undefined references.
+ * fopen/fread/fwrite exist on both sides, and the directory is created by the
+ * launcher so that no mkdir spelling has to work in both either. */
+
+static int mgs2_progbin_state;      /* 0 unknown, 1 usable, -1 off */
+static unsigned int mgs2_progbin_driver;
+static char mgs2_progbin_dir[MGS2_PROGBIN_PATH_MAX];
+/* PBC1 -- why the cache is or is not working, readable by a /proc scan so it
+ * does not depend on which WINEDEBUG channel is open. The first build stored 19
+ * binaries and hit zero of them, and "the key is unstable" and "the driver
+ * rejects the binary" are indistinguishable from the outside. */
+#define MGS2_PBC_MAGIC 0x31434250u /* PBC1 */
+struct mgs2_pbc_public
+{
+    unsigned int magic, version, size_words, signature;
+    unsigned int state;            /* 1 on, (unsigned)-1 off */
+    unsigned int hits, misses, stores;
+    unsigned int open_fail, short_file, gl_error, link_false;
+    unsigned int store_no_len, store_no_data, store_write_fail;
+    unsigned int last_format, last_size, last_src_len;
+    unsigned int roundtrip_tried, roundtrip_ok, roundtrip_err;
+    unsigned int hint_err;                    /* probe 1: RETRIEVABLE_HINT accepted? */
+    unsigned int oes_present, oes_tried, oes_ok, oes_err;   /* probe 2: OES path */
+    unsigned int mono_tried, mono_ok, mono_err, mono_size;  /* probe 3: monolithic */
+    unsigned int sep_tried, sep_ok, sep_err;  /* probe 4: target marked separable first */
+    unsigned int file_rt_tried, file_rt_ok;   /* probe 5: same run, through the file */
+    unsigned int store_crc, load_crc;         /* do the bytes survive the round trip? */
+    unsigned int infolog_len, infolog[16];    /* first 64 bytes, even with no GL error */
+};
+struct mgs2_pbc_public mgs2_pbc =
+{
+    MGS2_PBC_MAGIC, 1,
+    sizeof(struct mgs2_pbc_public) / sizeof(unsigned int),
+    ~MGS2_PBC_MAGIC,
+};
+#define mgs2_progbin_hits   mgs2_pbc.hits
+#define mgs2_progbin_misses mgs2_pbc.misses
+#define mgs2_progbin_stores mgs2_pbc.stores
+
+static unsigned long long mgs2_progbin_fnv(const void *data, size_t len,
+        unsigned long long h)
+{
+    const unsigned char *p = data;
+
+    while (len--)
+    {
+        h ^= *p++;
+        h *= 1099511628211ull;
+    }
+    return h;
+}
