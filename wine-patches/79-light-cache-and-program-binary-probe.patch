Patch 79 -- FFP light-colour cache switched on, and the program-binary branch
closed with proof.

SCOPE: diff of dlls/wined3d/glsl_shader.c against the state before this session's
program-binary work. It therefore also carries FRM1 (the frame denominator) and
the UCT histogram, both of which were needed to reach a verdict at all.

1. FFP LIGHT-COLOUR CACHE, now enabled=1.

   Per field, keyed (vs_program_id, light, field), living in mgs2_ffp_vs_source
   -- the object that owns stage_program. Sharing that owner across separable
   entries is what corrupted the picture in P74A; this is the corrected form.

   Verdict, once the instrument was fixed twice over:
     - FRM1 counts presented frames in wined3d_swapchain_present(), per A/B arm.
       The old denominator came from the game log, which prints one line per N
       frames and therefore reported a multiple of N for any window.
     - UCT gained a histogram. Its mean called the cache arm slower in one run
       and faster in the next; a single preemption inside a 20 us timed group
       moves a mean over a few hundred samples by microseconds. Median instead.

     arm A (off)  median 19.5 us/group, 3.000 uploads
     arm B (on)   median 14.5 us/group, 0.029 uploads   => 1.68 us per call removed

   ~0.7 ms/frame in combat (552 attempted/frame at 87% redundancy), ~0.04 in a
   quiet scene. A miss is three 16-byte memcmps. The 1.68 us is reusable: it
   converts "calls removed per frame" into ms/frame for any future candidate.

2. PROGRAM-BINARY CACHE -- BUILT, MEASURED, DEFAULT OFF.

   The census came first and redirected the work: 12 separable-stage LINKS cost
   2.0 s in one run against 16-88 ms for all glCompileShader calls, and every
   source in a run is distinct. So the target is linking, and only a cache that
   survives between runs could pay.

   Built on glGetProgramBinary/glProgramBinary, keyed on the GLSL text, the
   stage, the bound attribute indices and a hash of GL_VENDOR/RENDERER/VERSION.
   Five probes, and the first conclusion was WRONG in the expensive direction --
   it blamed the driver for a bug of mine:

     1 retrievable hint   accepted
     2 OES entry points   absent from the facade
     3 monolithic program roundtrip OK  -> the driver CAN reload
     4 target separable   roundtrip OK  -> THE BUG WAS MINE
     5 same run via file  roundtrip OK, store_crc == load_crc

   Probe 4 is the one: a binary from a separable program is only accepted by a
   target itself marked GL_PROGRAM_SEPARABLE, and the loader poured it into a
   bare program. Fixed. It now reloads through the file inside one run.

   Across runs it still never hits, and the reason is not the content: 19 stable
   keys, 14 of 19 files byte-identical between runs, zero hits, "Bad program
   binary" with no GL error. A byte-identical blob is refused by the same driver
   in a later process, so validity is scoped to the producing process.
   Persistence is impossible; in-run caching is pointless because no source
   repeats.

   Kept behind MGS2_GL_PROGRAM_CACHE=1 with its PBC1 accounting record so that
   retesting after a driver update is a single run.

   Two things learned that outlive the branch:
     - The island links a SECOND, native ARM copy of this file into Box86, where
       kernel32 does not exist. CreateFileA compiled and then failed at link
       time with six undefined references; stdio works on both sides.
     - The game leaves GL errors pending (20479 GL_INVALID_OPERATION from
       glAlphaFunc in one run), so any error check here must drain first or it
       reads somebody else's.

SHIPPED disabled in FINALPLAY11 (which carries the pre-fix loader ordering);
the probe-4 fix ships with the next release.

--- glsl_shader.c.orig	2026-08-12 09:30:14.507361319 +0300
+++ glsl_shader.c	2026-08-23 12:23:54.231475145 +0300
@@ -123,9 +123,21 @@
 };
 
 /* GLSL shader private data */
+/* Patch 30: stage programs for programmable vertex shaders. Declared after
+ * glsl_vs_program, which this file defines below, so priv only carries a pointer
+ * and the table is allocated on first use. */
+struct mgs2_vs_stage_cache;
+
 struct shader_glsl_priv
 {
     bool use_vkd3d;
+    BOOL mgs2_separable_enabled;
+    BOOL mgs2_separable_validate;
+    BOOL mgs2_separable_vs_enabled;
+    BOOL mgs2_ffp_source_dedup_enabled;
+    struct mgs2_vs_stage_cache *mgs2_vs_stages;
+    struct list mgs2_ffp_vs_sources;
+    struct list mgs2_ffp_ps_sources;
 
     struct wined3d_string_buffer shader_buffer;
     struct wined3d_string_buffer_list string_buffers;
@@ -247,13 +259,462 @@
     struct glsl_ps_program ps;
     struct glsl_cs_program cs;
     GLuint id;
+    GLuint pipeline_id;
+    GLuint vs_program_id;
+    GLuint ps_program_id;
+    BOOL separable;
     DWORD constant_update_mask;
     unsigned int constant_version;
     DWORD shader_controlled_clip_distances : 1;
     DWORD clip_distance_mask : 8; /* WINED3D_MAX_CLIP_DISTANCES, 8 */
     DWORD padding : 23;
+
+    /*
+     * Program-local cache of the FFP texture matrices this program was last
+     * given.
+     *
+     * Uniform values are state of a linked GL program and survive glUseProgram,
+     * but wined3d re-dirties a program's constants every time it becomes
+     * current, so the same matrix is uploaded again and again. Measured on this
+     * device: 331 redundant uploads per frame standing still, 410 in combat,
+     * ~96-97% of all calls to shader_glsl_ffp_vertex_texmatrix_uniform().
+     *
+     * The cache lives here and nowhere else on purpose. This struct IS one
+     * linked GL program, so (program, texture stage) is the natural key, with no
+     * hash table, no allocation on the hot path and no lookup by GLuint.
+     *
+     * A newly linked program gets a fresh entry, so its cache starts invalid by
+     * construction: all four allocation sites in this file use
+     * calloc(1, sizeof(*entry)) -- checked, not assumed -- and none of the four
+     * glLinkProgram() calls relinks an id that a live entry already holds, so
+     * there is no in-place relink to invalidate on. glUseProgram does not
+     * invalidate anything either: uniform values belong to the program.
+     */
+    /* The object that owns this entry's VS uniforms; NULL when not separable. */
+    struct mgs2_ffp_vs_source *mgs_vs_source;
+
+    uint32_t mgs_texmatrix_valid_mask;
+    struct wined3d_matrix mgs_texmatrix_cache[WINED3D_MAX_FFP_TEXTURES];
+};
+
+/*
+ * Counters for the cache above, in a self-identifying record so the A/B reader
+ * can find them by scanning. `enabled` is writable from outside: the
+ * same-process ABBA flips it, which is why the cache is updated even when the
+ * skip is off -- an arm that started with a cold cache would be measuring the
+ * warm-up and not the optimisation.
+ */
+#define MGS2_TEXMATRIX_MAGIC 0x314D5854u /* TXM1 */
+struct mgs2_texmatrix_stats_public
+{
+    unsigned int magic, version, size_words, signature;
+    volatile unsigned int enabled;
+    unsigned int attempted, skipped, executed;
+    unsigned int cold_miss, changed_miss, program_cache_resets;
+    unsigned int per_tex_attempted[WINED3D_MAX_FFP_TEXTURES];
+    unsigned int per_tex_skipped[WINED3D_MAX_FFP_TEXTURES];
+};
+
+/* Bisection switch, compiled in for one experiment: the owner sees the frame
+ * height jumping on this build and not on production, so the skip has to be
+ * separated from everything else the build changed -- the regenerated class-B
+ * registry, the new island binary and the A/B tick in present. With this set,
+ * the cache is still filled and the A/B still flips arms and prints blocks, but
+ * no upload is ever skipped. If the artefact survives that, it is not the cache. */
+/* P74A is CLOSED: the cache lived on glsl_shader_prog_link while the uniforms
+ * belong to vs_program_id, which separable entries SHARE. Kept compiled in as a
+ * counted, non-skipping record of a measured negative; never re-enable without
+ * moving the cache to mgs2_ffp_vs_source, which is the real owner. */
+static const BOOL mgs2_texmatrix_skip_disabled = TRUE;
+
+struct mgs2_texmatrix_stats_public mgs2_texmatrix_stats =
+{
+    MGS2_TEXMATRIX_MAGIC, 1,
+    sizeof(struct mgs2_texmatrix_stats_public) / sizeof(unsigned int),
+    ~MGS2_TEXMATRIX_MAGIC,
+    1,
+};
+
+/*
+ * Same-process ABBA, driven from the swapchain's own present.
+ *
+ * The presenter in winewayland.drv already has an A/B harness, and the first
+ * attempt drove this flag from there by locating the record in memory. That was
+ * a mistake twice over: the scan ran inside the probe context wined3d builds to
+ * enumerate pixel formats and killed adapter initialisation, and once deferred
+ * it silently found nothing. The frame counter this needs is right here --
+ * swapchain_gl_present() is called once per displayed frame -- so the A/B lives
+ * where the optimisation lives and crosses no module boundary.
+ *
+ * The block line is printed in the exact format harness/present_ab_read.py
+ * already parses, so the reducer, its ABBA pairing, its depth and stability
+ * filters and its negative control are reused unchanged. Arm A ("sync") is
+ * always the incumbent: skipping disabled.
+ */
+void mgs2_texmatrix_ab_present(void);
+
+/*
+ * P75A: stop selecting a uniform target that nothing is about to write.
+ *
+ * With separable programs shader_glsl_load_constants() calls
+ * MGS2_LOCAL(mgs2_glActiveShaderProgram)() twice -- once for the VS program, once for the
+ * PS program -- unconditionally, before each stage's upload block. The census
+ * counts 1112-1304 constant loads per combat frame, so that is roughly
+ * 2200-2600 driver calls per frame, and NONE of them appear in the GL_EXTCALL
+ * histogram: this is a project-resolved function pointer, not a GL_EXTCALL
+ * site. The texture-matrix candidate just closed was 410.
+ *
+ * glActiveShaderProgram only chooses which program subsequent glUniform* calls
+ * write into; it does not change which stages execute. So selecting a stage
+ * that no upload follows is pure cost. No cached state, no value comparison,
+ * no payload changes -- the only question is whether an upload follows.
+ *
+ * need_vs/need_ps mirror the guards of the two blocks, and a mirror can drift
+ * from what it mirrors, so it is checked rather than trusted: the upload
+ * helpers bump a witness, and a witness raised while need_* said no is counted
+ * as MISSED. A run with any MISSED is not a result.
+ */
+#define MGS2_ASP_MAGIC 0x31505341u /* ASP1 */
+struct mgs2_asp_stats_public
+{
+    unsigned int magic, version, size_words, signature;
+    volatile unsigned int lazy;
+    unsigned int separable_loads;
+    unsigned int need_vs, need_ps;
+    unsigned int avoided_vs, avoided_ps;
+    unsigned int missed_vs, missed_ps;
+};
+struct mgs2_asp_stats_public mgs2_asp_stats =
+{
+    MGS2_ASP_MAGIC, 1,
+    sizeof(struct mgs2_asp_stats_public) / sizeof(unsigned int),
+    ~MGS2_ASP_MAGIC,
+    1,   /* lazy ON: steady build. The A/B below is compiled out. */
+};
+
+/*
+ * The A/B alternates arms every 12 frames, and with -14.8 ms between them that
+ * alternation is VISIBLE as a ~1 Hz stutter -- the owner reported exactly that
+ * while the measurement was running. A steady build must therefore not carry
+ * the harness at all, which is what this constant turns off. Set it back to
+ * TRUE only to re-measure.
+ */
+static const BOOL mgs2_asp_ab_enabled = FALSE;  /* production: no A/B, no ERR spam */
+static unsigned int mgs2_asp_witness;
+
+/*
+ * Simulator for an FFP light/material cache. Counts only; every upload still
+ * happens.
+ *
+ * The measurement that justifies looking here: between a quiet scene and combat
+ * the light uniforms go from 548 to 986 calls per frame, and lights do not move
+ * within a frame -- they are re-sent because each program needs its own copy.
+ *
+ * THE KEY IS THE POINT. Two previous simulators overstated redundancy by keying
+ * on something GL does not attribute the state to: glVertexAttribPointer was
+ * keyed with the buffer in the lookup instead of the value, and the texture
+ * matrix was keyed on prog->id, which is 0 for every separable entry. Uniforms
+ * belong to the PROGRAM OBJECT, which under separable programs is
+ * prog->vs_program_id -- shared between entries, exactly the sharing that made
+ * the texture-matrix cache corrupt the screen. So the key here is
+ * (vs_program_id, light index, field), which is what GL actually stores.
+ */
+/*
+ * P77: the real light-colour cache. Counters and a runtime switch, so the
+ * same-process ABBA can flip it. `enabled` has one owner --
+ * mgs2_texmatrix_ab_present() -- for the reason the texture-matrix arm was
+ * mislabelled once already: a lazily env-seeded flag in the hot path raced the
+ * A/B and won.
+ */
+#define MGS2_LCA_MAGIC 0x3141434Cu /* LCA1 */
+struct mgs2_lca_stats_public
+{
+    unsigned int magic, version, size_words, signature;
+    volatile unsigned int enabled;
+    unsigned int attempted, skipped, executed, cold, changed, no_owner;
+};
+struct mgs2_lca_stats_public mgs2_lca_stats =
+{
+    MGS2_LCA_MAGIC, 1,
+    sizeof(struct mgs2_lca_stats_public) / sizeof(unsigned int),
+    ~MGS2_LCA_MAGIC,
+    /* enabled = 1. Measured with the UCT median, not its mean: the mean over a
+     * few hundred 20 us intervals flipped sign between two runs because one
+     * preemption inside a timed group moves it by microseconds. Median 19.5 us
+     * per three-field group with the cache off against 14.5 us with it on, at
+     * 3.000 versus 0.029 uploads per group, gives 1.68 us saved per upload
+     * removed. That is ~0.04 ms/frame in a quiet scene, which is nothing, and
+     * ~0.7 ms/frame in combat, where the same path attempts 552 uploads per
+     * frame at 87% redundancy. A miss costs three 16-byte memcmps. */
+    1,
 };
 
+/* UCT1 -- what one GL call actually costs on this stack.
+ *
+ * The light-cache A/B could not be settled by frame time: 90% of the blocks in
+ * a run sit on the 30/60 fps cap, where vsync absorbs any CPU saving, and the
+ * 2.5% that are combat gave a CI of +-4.2 ms against an effect of about 2. More
+ * combat is the wrong answer -- the calls are removed in EVERY frame, capped or
+ * not, so the sample is already there; only the metric was blind to it.
+ *
+ * So this times the three-field light group directly, one call in `period`.
+ * Both arms run the same memcmp work and differ only in how many uniforms they
+ * upload, so
+ *
+ *     (ticks_A/samples_A - ticks_B/samples_B) / (exec_A/samples_A - exec_B/samples_B)
+ *
+ * is the cost of one glUniform4fv, with the per-group overhead and the memcmp
+ * cancelling out. That constant then converts "calls removed per frame" into
+ * ms/frame for this candidate and for every later one, with no scene noise.
+ */
+/* FRM1 -- the frame denominator, counted where frames actually happen.
+ *
+ * Every per-frame number in this project used to be divided by a frame count
+ * scraped out of the game log, and that count was wrong: the presenter prints
+ * one stats line per N frames, so any window that contained k lines reported
+ * exactly k*N frames no matter how long it really was. Two 20-second windows at
+ * 312 and 190 fps both came back as "300 frames", and a whole calls-per-frame
+ * table had to be recomputed by hand afterwards.
+ *
+ * So the counter lives next to the thing it counts. It is incremented in
+ * wined3d_swapchain_present(), before every early return, so it is valid in
+ * production builds where the A/B is compiled out -- a denominator that only
+ * exists in instrumented builds is the same trap one level down.
+ *
+ * arm_frames[] is what an A/B needs and what sample counts cannot substitute
+ * for: skips happen only in the enabled arm, so the steady-state rate is
+ * skipped / arm_frames[1], with no ratio of timer samples anywhere in it.
+ */
+#define MGS2_FRM_MAGIC 0x314D5246u /* FRM1 */
+struct mgs2_frm_public
+{
+    unsigned int magic, version, size_words, signature;
+    unsigned int presented_frames;
+    unsigned int arm;
+    unsigned int arm_frames[2];
+    unsigned int blocks;
+};
+struct mgs2_frm_public mgs2_frm =
+{
+    MGS2_FRM_MAGIC, 1,
+    sizeof(struct mgs2_frm_public) / sizeof(unsigned int),
+    ~MGS2_FRM_MAGIC,
+};
+
+#define MGS2_UCT_MAGIC 0x31544355u /* UCT1 */
+#define MGS2_UCT_BINS 40u
+struct mgs2_uct_stats_public
+{
+    unsigned int magic, version, size_words, signature;
+    unsigned int period, qpc_khz;
+    unsigned int samples[2], ticks_lo[2], ticks_hi[2], exec[2];  /* [0]=A [1]=B */
+    /* A mean over a few hundred wall-clock intervals of ~20 us is not a usable
+     * statistic: one preemption inside a timed group adds milliseconds, and the
+     * first run of this instrument reported the cache arm as SLOWER while it was
+     * doing almost no work. The histogram gives a median instead, which a
+     * handful of outliers cannot move. Bin k holds [k, k+1) microseconds up to
+     * 32 us, then coarser, then everything above in the last bin. */
+    unsigned int hist[2][MGS2_UCT_BINS];
+};
+struct mgs2_uct_stats_public mgs2_uct_stats =
+{
+    MGS2_UCT_MAGIC, 2,
+    sizeof(struct mgs2_uct_stats_public) / sizeof(unsigned int),
+    ~MGS2_UCT_MAGIC,
+    16,
+};
+static unsigned __int64 mgs2_uct_ticks[2];
+static unsigned int mgs2_uct_calls;
+
+static void mgs2_uct_init(void)
+{
+    const char *v = getenv("MGS2_UCT_PERIOD");
+    LARGE_INTEGER freq;
+    int n = (v && *v) ? atoi(v) : 0;
+
+    if (n > 0) mgs2_uct_stats.period = n;
+    QueryPerformanceFrequency(&freq);
+    /* Last, and non-zero: it is also the "initialised" flag. */
+    mgs2_uct_stats.qpc_khz = freq.QuadPart ? (unsigned int)(freq.QuadPart / 1000) : 1;
+}
+
+#define MGS2_LGT_MAGIC 0x3154474Cu /* LGT1 */
+struct mgs2_lgt_stats_public
+{
+    unsigned int magic, version, size_words, signature;
+    unsigned int attempted, redundant, cold, changed, table_full;
+};
+struct mgs2_lgt_stats_public mgs2_lgt_stats =
+{
+    MGS2_LGT_MAGIC, 1,
+    sizeof(struct mgs2_lgt_stats_public) / sizeof(unsigned int),
+    ~MGS2_LGT_MAGIC,
+};
+
+#define MGS2_LGT_BITS 13
+#define MGS2_LGT_SIZE (1u << MGS2_LGT_BITS)
+static struct { unsigned __int64 key, val; } mgs2_lgt_table[MGS2_LGT_SIZE];
+
+static unsigned __int64 mgs2_lgt_hash(const void *d, unsigned int len)
+{
+    const unsigned char *p = d;
+    unsigned __int64 h = 0xcbf29ce484222325ull;
+    unsigned int i;
+
+    for (i = 0; i < len; ++i) { h ^= p[i]; h *= 0x100000001b3ull; }
+    return h ? h : 1;
+}
+
+/* field: a small constant per uniform in the light block, so two different
+ * uniforms of the same light never share a slot. */
+static void mgs2_lgt_probe(GLuint program, unsigned int light, unsigned int field,
+        const void *value, unsigned int len)
+{
+    unsigned __int64 key, vh;
+    unsigned int i, n;
+
+    key = ((unsigned __int64)program << 20) ^ ((unsigned __int64)light << 8) ^ field;
+    if (!key) key = 1;
+    vh = mgs2_lgt_hash(value, len);
+    ++mgs2_lgt_stats.attempted;
+
+    i = (unsigned int)((key * 0x9E3779B97F4A7C15ull) >> (64 - MGS2_LGT_BITS));
+    for (n = 0; n < 8; ++n, i = (i + 1) & (MGS2_LGT_SIZE - 1))
+    {
+        if (!mgs2_lgt_table[i].key)
+        {
+            mgs2_lgt_table[i].key = key;
+            mgs2_lgt_table[i].val = vh;
+            ++mgs2_lgt_stats.cold;
+            return;
+        }
+        if (mgs2_lgt_table[i].key == key)
+        {
+            if (mgs2_lgt_table[i].val == vh) ++mgs2_lgt_stats.redundant;
+            else { mgs2_lgt_table[i].val = vh; ++mgs2_lgt_stats.changed; }
+            return;
+        }
+    }
+    ++mgs2_lgt_stats.table_full;
+}
+
+#define MGS2_LGT(field, val, len) \
+    mgs2_lgt_probe(prog->separable ? prog->vs_program_id : prog->id, light, \
+                   (field), (val), (len))
+
+/*
+ * Every uniform upload in this file raises the witness, which is what makes the
+ * need_vs/need_ps mirror checkable rather than merely plausible. The first
+ * version raised it in ONE helper (the texture matrix) and checked only the VS
+ * side, so "MISSED = 0" was a far weaker statement than it looked.
+ *
+ * GL_EXTCALL takes the whole call as its argument, so the wrapper takes it too
+ * and uses the comma operator: safe inside an `if` with no braces.
+ */
+#define MGS2_UNIFORM_CALL(call) ((void)(++mgs2_asp_witness), GL_EXTCALL(call))
+static BOOL mgs2_asp_need_vs, mgs2_asp_need_ps;
+
+/*
+ * `enabled` has exactly one owner: mgs2_texmatrix_ab_present(). An earlier
+ * version also seeded it lazily from MGS2_GL_TEXMATRIX_SHADOW on the first
+ * uniform upload, and whichever of the two ran first won -- which is why the
+ * first block came out labelled as the wrong arm. The env variable is read once,
+ * in the A/B initialiser, and nowhere else.
+ */
+
+void mgs2_texmatrix_ab_present(void)
+{
+    static const unsigned int arm[4] = { 0, 1, 1, 0 };
+    static int block_len = -1, settle, seen, block;
+    static double stamp[1024];
+    static unsigned int nstamp;
+    static double ms_per_tick;
+    LARGE_INTEGER qpc;
+    double now, iv[1024];
+    unsigned int i, k, n;
+
+    /* First, and above every early return: this is the frame denominator, and
+     * it has to be right in builds that do no A/B at all. */
+    ++mgs2_frm.presented_frames;
+    mgs2_frm.arm = mgs2_lca_stats.enabled ? 1 : 0;
+    ++mgs2_frm.arm_frames[mgs2_frm.arm];
+
+    if (!mgs2_asp_ab_enabled) return;
+
+    if (block_len < 0)
+    {
+        const char *v = getenv("MGS2_PRESENT_AB");
+        const char *w = getenv("MGS2_PRESENT_AB_SETTLE");
+
+        /* Default 12, not 0. getenv() on the PE side did not see
+         * MGS2_PRESENT_AB even though the Unix-side presenter did, and a
+         * silently disabled A/B in a build whose only purpose is the A/B is a
+         * waste of a run. The variable still overrides when it does arrive. */
+        block_len = (v && *v) ? atoi(v) : 12;
+        settle = (w && *w) ? atoi(w) : 1;
+        if (block_len < 2) block_len = 12;
+        if (settle < 0) settle = 0;
+        mgs2_texmatrix_stats.enabled = 0;   /* P74A closed: never skips */
+        mgs2_asp_stats.lazy = 1;            /* production, on in both arms */
+        mgs2_lca_stats.enabled = 0;         /* block 0 is arm A: no light cache */
+        ERR("MGS2 texmatrix A/B: %d-frame blocks, settle %d, arm A = cache off "
+            "(MGS2_PRESENT_AB said %s)\n", block_len, settle, v ? v : "nothing");
+    }
+    if (!block_len) return;
+
+    /* QueryPerformanceCounter, not clock_gettime: this is the PE side. */
+    if (ms_per_tick == 0.0)
+    {
+        LARGE_INTEGER freq;
+
+        QueryPerformanceFrequency(&freq);
+        ms_per_tick = freq.QuadPart ? 1000.0 / (double)freq.QuadPart : 0.0;
+        if (ms_per_tick == 0.0) { block_len = 0; return; }
+    }
+    QueryPerformanceCounter(&qpc);
+    now = (double)qpc.QuadPart * ms_per_tick;
+
+    /* Timestamps first; intervals are differences between consecutive ones, so
+     * a block of N stamps yields N-1 frame times. The settle frames after an
+     * arm flip are dropped: the first frame of a new arm straddles both. */
+    if (seen >= settle && nstamp < ARRAY_SIZE(stamp))
+        stamp[nstamp++] = now;
+    ++seen;
+    if (seen < block_len) return;
+
+    n = nstamp > 1 ? nstamp - 1 : 0;
+    if (n)
+    {
+        double span = stamp[nstamp - 1] - stamp[0], sum = 0.0;
+
+        for (i = 0; i < n; ++i)
+        {
+            iv[i] = stamp[i + 1] - stamp[i];
+            sum += iv[i];
+        }
+        for (i = 0; i + 1 < n; ++i)
+            for (k = 0; k + 1 < n - i; ++k)
+                if (iv[k] > iv[k + 1])
+                {
