+    if ((f = fopen(path, "wb")))
+    {
+        if (fwrite(blob, 1, got + sizeof(format), f) == (size_t)(got + sizeof(format)))
+            ++mgs2_progbin_stores;
+        else
+            ++mgs2_pbc.store_write_fail;
+        fclose(f);
+
+        /* Probe 5, once. The in-memory round trip succeeds once the target is
+         * marked separable, and yet not one file-backed load has ever hit. Two
+         * explanations remain and they need different answers: the bytes do not
+         * survive the file, or the binary is only valid inside the process that
+         * produced it. Reading back what was just written separates them. */
+        if (!mgs2_pbc.file_rt_tried)
