+                blob + sizeof(format), got,
+                &mgs2_pbc.sep_ok, &mgs2_pbc.sep_err, TRUE);
+    }
+    if (!mgs2_pbc.oes_tried && mgs2_glGetProgramBinaryOES && mgs2_glProgramBinaryOES)
+    {
+        GLint osize = 0;
+        GLsizei ogot = 0;
+        GLenum oformat = 0;
+        char *oblob;
+
+        ++mgs2_pbc.oes_tried;
+        GL_EXTCALL(glGetProgramiv(program, GL_PROGRAM_BINARY_LENGTH, &osize));
+        while (gi->gl_ops.gl.p_glGetError() != GL_NO_ERROR) { }
