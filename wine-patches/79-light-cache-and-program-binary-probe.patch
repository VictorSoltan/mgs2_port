+/* Key over what actually changes the linked result: the GLSL text, which stage
+ * it is, which attribute indices were bound before linking, and the driver. */
+static void mgs2_progbin_path(const struct wined3d_gl_info *gl_info, GLuint shader_id,
+        GLenum stage_bit, unsigned int attribs, char *out, size_t out_len)
+{
+    const struct wined3d_gl_info *gi = MGS2_GL_INFO(gl_info);
+    unsigned long long h = 14695981039346656037ull;
+    GLint len = 0;
+    char *src;
+
+    GL_EXTCALL(glGetShaderiv(shader_id, GL_SHADER_SOURCE_LENGTH, &len));
+    if (len > 0 && (src = malloc(len)))
+    {
+        GLsizei got = 0;
+
+        GL_EXTCALL(glGetShaderSource(shader_id, len, &got, src));
+        if (got > 0)
+            h = mgs2_progbin_fnv(src, got, h);
+        mgs2_pbc.last_src_len = (unsigned int)got;
+        free(src);
+    }
+    h = mgs2_progbin_fnv(&stage_bit, sizeof(stage_bit), h);
+    h = mgs2_progbin_fnv(&attribs, sizeof(attribs), h);
+    h = mgs2_progbin_fnv(&mgs2_progbin_driver, sizeof(mgs2_progbin_driver), h);
+    (void)gi;
+    snprintf(out, out_len, "%s\\v%u-%016llx.bin", mgs2_progbin_dir,
+            MGS2_PROGBIN_VERSION, h);
+}
