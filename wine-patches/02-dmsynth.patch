+    if (!sinkaudible_enabled() || !samples || !channels
+            || !InterlockedCompareExchange(&shot_tone_armed, 0, 0))
+        return;
+    remaining = InterlockedCompareExchange(&shot_tone_frames, 0, 0);
+    if (!remaining)
+    {
+        remaining = sample_rate / 20;
+        InterlockedExchange(&shot_tone_frames, remaining);
+    }
+    if (remaining <= 0) return;
+    if (frames > (DWORD)remaining) frames = remaining;
+
+    period = max(sample_rate / 1000, 2);
+    half_period = max(sample_rate / 2000, 1);
+    for (i = 0; i < frames; ++i)
+    {
+        short value = shot_tone_phase < half_period ? 8192 : -8192;
+        WORD channel;
+
+        for (channel = 0; channel < channels; ++channel)
+            samples[i * channels + channel] = value;
+        if (++shot_tone_phase >= period) shot_tone_phase = 0;
+    }
+    InterlockedExchangeAdd(&shot_tone_frames, -(LONG)frames);
+    if (!InterlockedCompareExchange(&shot_tone_frames, 0, 0))
+        InterlockedExchange(&shot_tone_armed, 0);
