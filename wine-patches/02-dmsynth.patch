+/* DirectMusic addresses MIDI channels inside a channel group.  FluidSynth
+ * exposes the same layout as one flat channel array, so keep group 1 on
+ * channels 0..15 and place group 2 on 16..31 instead of collapsing both onto
+ * channel 0..15. */
+static unsigned int synth_channel_count(const struct synth *This)
+{
+    DWORD groups = This->params.dwChannelGroups;
+
+    if (!groups) groups = 1;
+    return groups * 16;
+}
+
+/* synth_Render reapplied the attenuation of every channel on every render
+ * period.  With multiple channel groups that is 32 or more emulated
+ * fluid_synth_set_gen() calls per sink per period, for a value that changes
+ * only when the game moves a volume.  Track the applied value instead. */
+static void update_channel_volumes(struct synth *This)
+{
+    double attenuation = (This->volume0 + This->volume1) * -0.1;
+    unsigned int chan;
+
+    if (This->volumes_applied && attenuation == This->applied_attenuation) return;
