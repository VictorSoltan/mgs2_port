+
+static void sinktone_add(short *samples, DWORD frames, DWORD sample_rate, WORD channels)
+{
+    static LONG announced;
+    DWORD i, period, half_period;
+    LONG phase;
+
+    if (!sinktone_enabled() || !samples || !channels || !sample_rate) return;
+
+    /* Bounded control: an absent tone in the capture must not be confused with a
+     * tone that was never written.  At most twenty lines, off the hot path after
+     * that, so it cannot become the per-render logging that made the device
+     * unplayable before. */
+    if (InterlockedIncrement(&announced) <= 20)
+        ERR("SINKTONE writing samples=%p frames=%lu rate=%lu channels=%u\n",
+                samples, frames, sample_rate, channels);
