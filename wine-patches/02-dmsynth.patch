+void synth_sink_probe_mark(void *sink, void *synth, DWORD group, BYTE status,
+        BYTE note, BYTE velocity)
+{
+    if ((!sinkprobe_enabled() && !sinkaudible_enabled())
+            || status != 0x90 || note != 0x3c || velocity != 0x7f
+            || group != 2)
+        return;
+    if (sinkaudible_enabled())
+    {
+        /* The same note-on is emitted during startup; arm externally in gameplay. */
+        if (InterlockedCompareExchange(&dmsynth_sinkprobe_state.marker, 3, 2) != 2)
+            return;
+    }
+    else if (InterlockedCompareExchange(&dmsynth_sinkprobe_state.marker, 1, 0))
+        return;
+
+    if (dmsynth_sinkprobe_state.marker == 3 || dmsynth_sinkprobe_state.marker == 1)
+    {
+        dmsynth_sinkprobe_state.marker_sink = (DWORD)(ULONG_PTR)sink;
+        dmsynth_sinkprobe_state.marker_synth = (DWORD)(ULONG_PTR)synth;
+        dmsynth_sinkprobe_state.marker_group = group;
+        dmsynth_sinkprobe_state.marker_status = status;
+        dmsynth_sinkprobe_state.marker_note = note;
+        dmsynth_sinkprobe_state.marker_velocity = velocity;
+    }
+    if (sinkaudible_enabled())
+    {
+        /* Arm exactly once after the external gameplay trigger. */
+        InterlockedExchange(&shot_tone_frames, 0);
+        InterlockedExchange(&shot_tone_armed, 1);
