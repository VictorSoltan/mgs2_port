+
+static void sinkprobe_buffer_state(IDirectSoundBuffer *buffer, DWORD *status,
+        DWORD *volume, DWORD *frequency)
+{
+    LONG signed_volume;
+    DWORD value;
+
+    *status = *volume = *frequency = 0xffffffff;
+    if (!FAILED(IDirectSoundBuffer_GetStatus(buffer, &value))) *status = value;
+    if (!FAILED(IDirectSoundBuffer_GetVolume(buffer, &signed_volume))) *volume = signed_volume;
+    if (!FAILED(IDirectSoundBuffer_GetFrequency(buffer, &value))) *frequency = value;
