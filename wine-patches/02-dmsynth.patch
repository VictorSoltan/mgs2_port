+ * DLS instruments were downloaded to, and that combination was measured silent.
+ * Keep the collapsed Wine behaviour unless the mapping is asked for. */
+static BOOL mgs2_dmsynth_groupmap(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1) enabled = mgs2_env_int("MGS2_DMSYNTH_GROUPMAP", 0, 0, 1);
+    return enabled;
+}
