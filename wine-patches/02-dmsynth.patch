+/*
+ * MGS2's downloaded DLS effects are rendered around 40 dB below the regular
+ * DirectSound mix on the RK3566 route.  Keep Wine's default behaviour unless
+ * the port explicitly requests a gain correction.  The value is whole dB and
+ * limited to a conservative range to avoid a malformed environment value
+ * turning into clipped full-scale output.
+ */
+static int mgs2_dmsynth_gain_boost(void)
+{
+    char value[16];
+    DWORD len = GetEnvironmentVariableA("MGS2_DMSYNTH_BOOST_DB", value, sizeof(value));
+    int i = 0, gain = 0;
+
+    if (!len || len >= sizeof(value)) return 0;
+    while (value[i] >= '0' && value[i] <= '9')
+    {
+        gain = gain * 10 + value[i] - '0';
+        if (gain >= 30) return 30;
+        ++i;
+    }
+    return gain;
+}
+
+/*
+ * Cost policy for FluidSynth on this port.
+ *
+ * The whole synthesiser is emulated x86 under box86, and it runs on the audio
+ * thread of every port the game opens, every WRITE_PERIOD, whether or not a
+ * note is sounding: FluidSynth's reverb and chorus are processed per block
+ * regardless of the active voice count (fluid_rvoice_mixer_process_fx).  That
+ * is why enabling DirectMusic routing made the console lag while silence was
+ * free.  Each knob below removes per-sample work, not features the game asks
+ * for by name.
+ *
+ * MGS2_DMSYNTH_FX=1         restore reverb/chorus (default: off)
+ * MGS2_DMSYNTH_INTERP=0|1|4|7   FluidSynth interpolation (default: 1, linear;
+ *                           upstream default is 4, roughly twice the cost per
+ *                           voice sample)
+ * MGS2_DMSYNTH_POLYPHONY=n  voice ceiling (default 24; FluidSynth's own is 256,
+ *                           which on this CPU is a promise it cannot keep)
+ */
+int mgs2_env_int(const char *name, int def, int lo, int hi)
+{
+    char value[16];
+    DWORD len = GetEnvironmentVariableA(name, value, sizeof(value));
+    int i = 0, parsed = 0;
+
+    if (!len || len >= sizeof(value)) return def;
+    if (!value[0]) return def;
+    while (value[i] >= '0' && value[i] <= '9')
+    {
+        parsed = parsed * 10 + value[i] - '0';
+        if (parsed > hi) return hi;
+        ++i;
+    }
+    if (i == 0) return def;
+    return parsed < lo ? lo : parsed;
+}
