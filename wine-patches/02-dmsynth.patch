+static DWORD sinkprobe_checksum(const void *data, DWORD bytes)
+{
+    const BYTE *p = data;
+    DWORD i, hash = 2166136261u;
+
+    if (!data) return 0;
+    for (i = 0; i < bytes; ++i) hash = (hash ^ p[i]) * 16777619u;
+    return hash;
+}
+
+static void sinkprobe_peak(const void *data, DWORD bytes, WORD channels,
+        DWORD *left, DWORD *right)
+{
+    const SHORT *samples = data;
+    DWORD i, count = bytes / sizeof(*samples), l = 0, r = 0;
+
+    if (!data || !channels) { *left = *right = 0; return; }
+    for (i = 0; i < count; ++i)
+    {
+        DWORD value = samples[i] < 0 ? -(DWORD)samples[i] : (DWORD)samples[i];
+        if (!(i % channels)) l = max(l, value);
+        else if (channels > 1 && (i % channels) == 1) r = max(r, value);
+    }
+    *left = l;
+    *right = channels > 1 ? r : l;
+}
+
+static void sinkprobe_cursor(IDirectSoundBuffer *buffer, DWORD *play, DWORD *write)
