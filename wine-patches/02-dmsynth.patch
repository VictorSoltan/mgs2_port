+/*
+ * MGS2_SINKTONE=1: write a continuous 1 kHz square into every sink render.
+ *
+ * The marker-armed burst above needs the game to reach one specific note and a
+ * human to be listening at that moment, which is how the last tone test ended
+ * inconclusive.  This asks the same question in a form a capture can answer:
+ * does anything a dmsynth sink writes reach the output device at all?  No
+ * logging, no per-render files, so it does not perturb frame timing.
+ */
+static LONG sinktone_phase;
+
+static BOOL sinktone_enabled(void)
+{
+    static int enabled = -1;
+    char value[8];
+    DWORD len;
+
+    if (enabled != -1) return enabled;
+    len = GetEnvironmentVariableA("MGS2_SINKTONE", value, sizeof(value));
+    enabled = len && len < sizeof(value) && value[0] != '0';
+    return enabled;
