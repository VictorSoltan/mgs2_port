+static BOOL mgs2_dmsynth_idle_skip(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1) enabled = mgs2_env_int("MGS2_DMSYNTH_IDLE_SKIP", 1, 0, 1);
+    return enabled;
