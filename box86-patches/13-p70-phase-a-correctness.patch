+};
+
+static int mgs2_phase_a_correctness_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv("MGS2_PHASE_A_CORRECTNESS");
+
+        enabled = value && strcmp(value, "0");
+        mgs2_phase_a_correctness.enabled = enabled;
+    }
+    return enabled;
+}
