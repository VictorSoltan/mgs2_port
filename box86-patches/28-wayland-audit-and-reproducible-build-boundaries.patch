From: MGS2 RG353VS port
Subject: [PATCH 28] close remaining Wayland thunk and build provenance boundaries

The strengthened listener auditor found one real format-string mismatch outside
Wine's currently reachable listener set: pointer-gesture begin passed the
surface pointer as an integer and the finger count as a pointer.  It also
confirmed that wl_buffer was the only cross-thread-capable listener left out of
patch 24's release/acquire publication.

Keep the generated revision header private to each build directory.  The old
source-tree output was shared by every build directory and did not depend on a
changed MGS2_GITREV value.  Finally, bound the default-off diagnostic dump to
the thirteen 32-bit words in VkPipelineRasterizationStateCreateInfo instead of
reading three words past it.

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -321,12 +321,6 @@ include_directories(
     "${BOX86_ROOT}/src/wrapped/generated"
 )
 
-# git_head.h is a generated file
-set_source_files_properties(
-    "${BOX86_ROOT}/src/git_head.h"
-    PROPERTIES GENERATED TRUE
-    HEADER_FILE_ONLY TRUE)
-
 set(ELFLOADER_SRC
     "${BOX86_ROOT}/src/mgs2_island_gl_trap.S"
     "${BOX86_ROOT}/src/mgs2_island_gl.c"
@@ -718,29 +712,24 @@ if(NOT MGS2_GITREV)
         OUTPUT_STRIP_TRAILING_WHITESPACE)
 endif()
 
-# creates git_head.h
-if(ARM_DYNAREC)
-    add_custom_command(
-        OUTPUT "${BOX86_ROOT}/src/git_head.h"
-        COMMAND bash -c "echo \\\#define GITREV \\\"${MGS2_GITREV}\\\">\"${BOX86_ROOT}/src/git_head.h\""
-        DEPENDS dynarec ${ELFLOADER_SRC} ${INTERPRETER} ${WRAPPEDS}
-        VERBATIM)
-else()
-    add_custom_command(
-        OUTPUT "${BOX86_ROOT}/src/git_head.h"
-        COMMAND bash -c "echo \\\#define GITREV \\\"${MGS2_GITREV}\\\">\"${BOX86_ROOT}/src/git_head.h\""
-        DEPENDS ${ELFLOADER_SRC} ${INTERPRETER} ${WRAPPEDS}
-        VERBATIM)
-endif()
+# Keep provenance private to this build directory.  file(GENERATE) rewrites
+# the header when a reconfigure changes MGS2_GITREV and cannot leak one build
+# directory's revision into another through the shared source tree.
+set(MGS2_GIT_HEAD_DIR "${CMAKE_CURRENT_BINARY_DIR}/mgs2-generated")
+set(MGS2_GIT_HEAD "${MGS2_GIT_HEAD_DIR}/mgs2_git_head.h")
+file(MAKE_DIRECTORY "${MGS2_GIT_HEAD_DIR}")
+file(GENERATE OUTPUT "${MGS2_GIT_HEAD}"
+    CONTENT "#define GITREV \"${MGS2_GITREV}\"\n")
+include_directories("${MGS2_GIT_HEAD_DIR}")
 
 add_library(interpreter OBJECT ${INTERPRETER})
 
 if(BOX86LIB)
 #build a static or dynamic lib...
 if(BOX86DYNAMIC)
-    add_library(box86 SHARED ${ELFLOADER_SRC} ${WRAPPEDS} "${BOX86_ROOT}/src/git_head.h")
+    add_library(box86 SHARED ${ELFLOADER_SRC} ${WRAPPEDS})
 else()
-    add_library(${BOX86} OBJECT ${ELFLOADER_SRC} ${WRAPPEDS} "${BOX86_ROOT}/src/git_head.h")
+    add_library(${BOX86} OBJECT ${ELFLOADER_SRC} ${WRAPPEDS})
 endif()
 if(ARM_DYNAREC)
     if(ANDROID)
@@ -770,7 +759,7 @@ else(BOX86LIB)
 # out of tree from the Wine sources with box86-compatible flags; see
 # harness/island/full/BUILD.md in the port repository.
 file(GLOB MGS2_ISLAND_OBJS "${BOX86_ROOT}/src/island/*.o")
-add_executable(${BOX86} ${ELFLOADER_SRC} ${WRAPPEDS} ${MGS2_ISLAND_OBJS} "${BOX86_ROOT}/src/git_head.h")
+add_executable(${BOX86} ${ELFLOADER_SRC} ${WRAPPEDS} ${MGS2_ISLAND_OBJS})
 set_source_files_properties(${MGS2_ISLAND_OBJS} PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
 add_dependencies(${BOX86} WRAPPERS)
 add_dependencies(${BOX86} PRINTER)
