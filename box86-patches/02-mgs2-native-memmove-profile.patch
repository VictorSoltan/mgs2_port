diff --git a/src/dynarec/dynablock.c b/src/dynarec/dynablock.c
index 66a6e4ce..0411aa83 100755
--- a/src/dynarec/dynablock.c
+++ b/src/dynarec/dynablock.c
@@ -32,6 +32,79 @@
 
 KHASH_MAP_INIT_INT(dynablocks, dynablock_t*)
 
+/*
+ * MGS2 guest/native map recorder.
+ *
+ * Linux perf sees dynamically generated ARM instructions, but the standard
+ * Box86 build does not expose the x86 address that produced each block.  Keep
+ * a bounded anonymous mapping so an external reader can resolve a perf
+ * capture without adding any I/O to the emulation threads.  Keeping the
+ * records out of the executable's BSS is important: Wine uses nearby fixed
+ * 32-bit address ranges for PE modules.  Recording happens only when a block
+ * is compiled, never when it is executed, and is opt-in.
+ */
+#define MGS2_GUEST_MAP_CAPACITY 262144u
+
+typedef struct mgs2_guest_map_record_s
+{
+    uint32_t native_start;
+    uint32_t native_size;
+    uint32_t x86_start;
+    uint32_t x86_size;
+} mgs2_guest_map_record_t;
+
+__attribute__((visibility("default")))
+volatile uint32_t mgs2_guest_map_count;
+__attribute__((visibility("default")))
+volatile uint32_t mgs2_guest_map_overflow;
+__attribute__((visibility("default")))
+const uint32_t mgs2_guest_map_capacity = MGS2_GUEST_MAP_CAPACITY;
+__attribute__((visibility("default")))
+mgs2_guest_map_record_t *mgs2_guest_map;
+
+static int mgs2_guest_map_enabled;
+static pthread_once_t mgs2_guest_map_once = PTHREAD_ONCE_INIT;
+
+static void mgs2_guest_map_init(void)
+{
+    const char *value = getenv("MGS2_BOX86_GUEST_MAP");
+
+    if (!value || !value[0] || value[0] == '0')
+        return;
+
+    mgs2_guest_map = mmap(NULL,
+            sizeof(*mgs2_guest_map) * MGS2_GUEST_MAP_CAPACITY,
+            PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (mgs2_guest_map == MAP_FAILED)
+    {
+        mgs2_guest_map = NULL;
+        return;
+    }
+    mgs2_guest_map_enabled = 1;
+}
+
+static void mgs2_guest_map_record(const dynablock_t *block)
+{
+    uint32_t index;
+
+    pthread_once(&mgs2_guest_map_once, mgs2_guest_map_init);
+    if (!mgs2_guest_map_enabled || !block || !block->block || !block->x86_size)
+        return;
+
+    index = __atomic_fetch_add(&mgs2_guest_map_count, 1, __ATOMIC_RELAXED);
+    if (index >= MGS2_GUEST_MAP_CAPACITY)
+    {
+        __atomic_store_n(&mgs2_guest_map_overflow, 1, __ATOMIC_RELAXED);
+        return;
+    }
+
+    mgs2_guest_map[index].native_start = (uintptr_t)block->block;
+    mgs2_guest_map[index].native_size = block->size - sizeof(void *);
+    mgs2_guest_map[index].x86_start = (uintptr_t)block->x86_addr;
+    mgs2_guest_map[index].x86_size = block->x86_size;
+    __atomic_thread_fence(__ATOMIC_RELEASE);
+}
+
