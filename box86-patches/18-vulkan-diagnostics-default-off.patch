 CREATE(vkCreateDescriptorPool)
+static int dmc3_vk_diag_enabled(void)
+{
+    static int cached = -1;
+    int enabled = __atomic_load_n(&cached, __ATOMIC_ACQUIRE);
+    if (enabled < 0) {
+        const char *value = getenv("MGS2_BOX86_VK_DIAG");
+        enabled = value && value[0] && strcmp(value, "0");
+        __atomic_store_n(&cached, enabled, __ATOMIC_RELEASE);
+    }
+    return enabled;
+}
