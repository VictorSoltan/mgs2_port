+static void dmc3_dump_pipeline_state(const char *name, const void *state)
+{
+    const uint32_t *words = state;
+    fprintf(stderr, "DMC3VK state %-12s ptr=%p stype=%u pnext=%p words=%08x,%08x,%08x,%08x\n",
+            name, state, state ? words[0] : 0, state ? (void *)(uintptr_t)words[1] : NULL,
+            state ? words[0] : 0, state ? words[1] : 0,
+            state ? words[2] : 0, state ? words[3] : 0);
+}
+
+static void dmc3_dump_words(const char *name, const void *data, uint32_t word_count)
+{
+    const uint32_t *words = data;
+    fprintf(stderr, "DMC3VK raw %-12s ptr=%p words=%u", name, data, data ? word_count : 0);
+    for (uint32_t i = 0; data && i < word_count; ++i)
+        fprintf(stderr, " %08x", words[i]);
+    fputc('\n', stderr);
+}
+
+static void dmc3_dump_specialization(const uint32_t *stage_words, uint32_t stage)
+{
+    const uint32_t *spec = (const uint32_t *)(uintptr_t)stage_words[7];
+    if (!spec) {
+        fprintf(stderr, "DMC3VK spec stage=%u ptr=(nil)\n", stage);
+        return;
+    }
+
+    const uint32_t entry_count = spec[0];
+    const uint32_t *entries = (const uint32_t *)(uintptr_t)spec[1];
+    const uint32_t data_size = spec[2];
+    const uint8_t *data = (const uint8_t *)(uintptr_t)spec[3];
+    fprintf(stderr, "DMC3VK spec stage=%u ptr=%p entries=%u map=%p data_size=%u data=%p\n",
+            stage, spec, entry_count, entries, data_size, data);
+    for (uint32_t i = 0; entries && i < entry_count && i < 128; ++i) {
+        const uint32_t constant_id = entries[i * 3 + 0];
+        const uint32_t offset = entries[i * 3 + 1];
+        const uint32_t size = entries[i * 3 + 2];
+        uint32_t value = 0;
+        if (data && size <= sizeof(value) && offset <= data_size && size <= data_size - offset)
+            memcpy(&value, data + offset, size);
+        fprintf(stderr, "DMC3VK spec-entry stage=%u index=%u id=%u offset=%u size=%u value=%08x\n",
+                stage, i, constant_id, offset, size, value);
+    }
+}
