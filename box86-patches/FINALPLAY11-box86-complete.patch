+/*
+ * Bounded, memory-only census for the MGS2 Wine memmove bridge.  This is a
+ * diagnostic, not production telemetry: there is no I/O on the hot path and
+ * the mapping is allocated only when MGS2_BOX86_MEMMOVE_STATS is enabled.
+ * An external reader snapshots the exported mapping after a fixed-scene run.
+ */
+#define MGS2_MEMMOVE_STATS_CAPACITY 16384u
+
+typedef struct mgs2_memmove_stat_s
+{
+    uint32_t state;                 /* 0 empty, 1 claimed, 2 published */
+    uint32_t caller;
+    uint32_t size;
+    uint32_t count;
+} mgs2_memmove_stat_t;
+
+__attribute__((visibility("default")))
+volatile uint32_t mgs2_memmove_stats_overflow;
+__attribute__((visibility("default")))
+const uint32_t mgs2_memmove_stats_capacity = MGS2_MEMMOVE_STATS_CAPACITY;
+__attribute__((visibility("default")))
+mgs2_memmove_stat_t *mgs2_memmove_stats;
+
+static int mgs2_memmove_stats_enabled;
+
+static void mgs2_memmove_stats_init(void)
+{
+    const char *value = getenv("MGS2_BOX86_MEMMOVE_STATS");
+
+    if (!value || !value[0] || value[0] == '0')
+        return;
+
+    mgs2_memmove_stats = mmap(NULL,
+            sizeof(*mgs2_memmove_stats) * MGS2_MEMMOVE_STATS_CAPACITY,
+            PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (mgs2_memmove_stats == MAP_FAILED)
+    {
+        mgs2_memmove_stats = NULL;
+        return;
+    }
+    mgs2_memmove_stats_enabled = 1;
+}
+
+static void mgs2_memmove_stats_record(uint32_t caller, uint32_t size)
+{
+    uint32_t index = (caller * 2654435761u ^ size * 2246822519u)
+            & (MGS2_MEMMOVE_STATS_CAPACITY - 1);
+    uint32_t n;
+
+    if (!mgs2_memmove_stats_enabled)
+        return;
+
+    for (n = 0; n < MGS2_MEMMOVE_STATS_CAPACITY; ++n)
+    {
+        mgs2_memmove_stat_t *entry = &mgs2_memmove_stats[index];
+        uint32_t state = __atomic_load_n(&entry->state, __ATOMIC_ACQUIRE);
+
+        if (state == 2 && entry->caller == caller && entry->size == size)
+        {
+            __atomic_fetch_add(&entry->count, 1, __ATOMIC_RELAXED);
+            return;
+        }
+        if (!state)
+        {
+            uint32_t expected = 0;
+
+            if (__atomic_compare_exchange_n(&entry->state, &expected, 1, 0,
+                    __ATOMIC_ACQUIRE, __ATOMIC_RELAXED))
+            {
+                entry->caller = caller;
+                entry->size = size;
+                entry->count = 1;
+                __atomic_store_n(&entry->state, 2, __ATOMIC_RELEASE);
+                return;
+            }
+        }
+        index = (index + 1) & (MGS2_MEMMOVE_STATS_CAPACITY - 1);
+    }
+
+    __atomic_store_n(&mgs2_memmove_stats_overflow, 1, __ATOMIC_RELAXED);
+}
+
+static void mgs2_native_memmove_wrapper(x86emu_t *emu, uintptr_t fnc)
+{
+    uint32_t esp = GetESP(emu);
+    void *dst = *(void **)(esp + 4);
+    const void *src = *(const void **)(esp + 8);
+    uint32_t size = *(uint32_t *)(esp + 12);
+
+    if (!size)
+    {
+        SetEAX(emu, (uintptr_t)dst);
+        return;
+    }
+    SetEAX(emu, (uintptr_t)((void *(*)(void *, const void *, size_t))fnc)
+            (dst, src, size));
+}
+
+static void mgs2_native_memmove_stats_wrapper(x86emu_t *emu, uintptr_t fnc)
+{
+    uint32_t esp = GetESP(emu);
+
+    /* Wine's memmove tail-jumps to _sse2_memmove after restoring its frame, so
+     * the guest return address is the renderer call site we need to resolve. */
+    mgs2_memmove_stats_record(*(uint32_t *)esp, *(uint32_t *)(esp + 12));
+    mgs2_native_memmove_wrapper(emu, fnc);
+}
