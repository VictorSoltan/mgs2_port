+/* 32-bit layout shared with the companion Wine dsound candidate.  Every field
+ * is exactly one guest DWORD, including pointers and the float bit pattern, so
+ * the layout is independent of AArch64 alignment rules. */
+typedef struct mgs2_dsound_fir_job32_s
+{
+    uint32_t output;
+    uint32_t intermediate;
+    uint32_t fir_copy;
+    uint32_t fir_table;
+    uint32_t count;
+    uint32_t required_input;
+    uint32_t channels;
+    uint32_t output_channels;
+    uint32_t firstep;
+    uint32_t firgain_bits;
+    uint32_t fir_length;
+    uint32_t freq_start_low, freq_start_high;
+    uint32_t freq_num_low, freq_num_high;
+    uint32_t freq_den_low, freq_den_high;
+} mgs2_dsound_fir_job32_t;
+
+static void mgs2_native_dsound_fir_kernel(float *output,
+        const float *intermediate, float *fir_copy, const float *fir_table,
+        uint32_t count, uint32_t required_input, uint32_t channels,
+        uint32_t output_channels, uint32_t firstep, float firgain,
+        uint32_t fir_length, uint64_t freq_start, uint64_t freq_num,
+        uint64_t freq_den)
+{
+    uint32_t i;
+
+    for (i = 0; i < count; ++i)
+    {
+        uint64_t phase = freq_start + (uint64_t)i * freq_num;
+        uint32_t int_fir_steps = phase * firstep / freq_den;
+        float total_fir_steps = phase * firstep / (float)freq_den;
+        uint32_t ipos = int_fir_steps / firstep;
+        uint32_t idx = (ipos + 1) * firstep - int_fir_steps - 1;
+        float rem = int_fir_steps + 1.0 - total_fir_steps;
+        uint32_t fir_used = 0, channel;
+
+        while (idx < fir_length - 1)
+        {
+            fir_copy[fir_used++] = fir_table[idx] * (1.0 - rem)
+                    + fir_table[idx + 1] * rem;
+            idx += firstep;
+        }
+
+        for (channel = 0; channel < channels; ++channel)
+        {
+            const float *cache = intermediate + channel * required_input + ipos;
+            float sum = 0.0f;
+            uint32_t j;
+
+            for (j = 0; j < fir_used; ++j)
+                sum += fir_copy[j] * cache[j];
+            output[i * output_channels + channel] = sum * firgain;
+        }
+    }
+}
+
+__attribute__((noinline, visibility("default")))
+void mgs2_native_dsound_fir_impl(uint32_t job_address)
+{
+    mgs2_dsound_fir_job32_t job;
+    float firgain;
+
+    memcpy(&job, (const void *)(uintptr_t)job_address, sizeof(job));
+    memcpy(&firgain, &job.firgain_bits, sizeof(firgain));
+    mgs2_native_dsound_fir_kernel(
+            (float *)(uintptr_t)job.output,
+            (const float *)(uintptr_t)job.intermediate,
+            (float *)(uintptr_t)job.fir_copy,
+            (const float *)(uintptr_t)job.fir_table,
+            job.count, job.required_input, job.channels, job.output_channels,
+            job.firstep, firgain, job.fir_length,
+            ((uint64_t)job.freq_start_high << 32) | job.freq_start_low,
+            ((uint64_t)job.freq_num_high << 32) | job.freq_num_low,
+            ((uint64_t)job.freq_den_high << 32) | job.freq_den_low);
+}
+
+static int mgs2_native_dsound_fir_selftest(void)
+{
+    static const float table[] = {0.25f, 0.5f, 0.25f, 0.0f};
+    static const float input[] = {1.0f, 2.0f, 3.0f, 4.0f, 5.0f};
+    float coefficients[4] = {0};
+    float output[2] = {0};
+
+    mgs2_native_dsound_fir_kernel(output, input, coefficients, table,
+            2, 5, 1, 1, 1, 1.0f, 4, 0, 1, 1);
+    return output[0] == 1.0f && output[1] == 1.75f;
+}
