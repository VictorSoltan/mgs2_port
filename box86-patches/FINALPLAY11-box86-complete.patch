+static int mgs2_class_b_state;   /* 0 untried, 1 armed, -1 refused */
+static pthread_mutex_t mgs2_class_b_init_lock = PTHREAD_MUTEX_INITIALIZER;
+
+__attribute__((visibility("default")))
+volatile unsigned int mgs2_class_b_hits, mgs2_class_b_misses;
+
+/*
+ * ID -> ARM address, assembled by the linker.
+ *
+ * The table generated alongside this file carries symbol IDs, not addresses.
+ * Each island translation unit has a generated fragment appended to it that
+ * takes the address of every mappable function it defines and drops an
+ * (id, address) pair into the `mgs2_native_ids` section; the linker gathers
+ * them and provides the bounds. So the ARM addresses enter the binary the only
+ * way an address should -- from the linker that placed the code.
+ *
+ * This is what removed the fixpoint. The previous design read absolute ARM
+ * addresses out of a linked box86 and compiled them back into box86, so the
+ * table described a build that ceased to exist the moment anything changed. A
+ * stale entry did not fault; it landed inside a real, wrong function.
+ * `buffer_prepare_location` once resolved 16 bytes into
+ * `wined3d_buffer_destroy_object`. That whole failure mode is now unreachable:
+ * there is no address in any generated file to be stale.
+ *
