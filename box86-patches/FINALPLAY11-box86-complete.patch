+}
+/*
+ * The displayed-frame boundary, for the same-process A/B.
+ *
+ * Not eglSwapBuffers: this port does not present by swapping. winewayland's
+ * wayland_drawable_swap() reads the finished frame back with glReadPixels and
+ * copies it into a wl_shm buffer -- which is why the launcher's own stats line
+ * reports "readback 7.2 ms/f". Ticking on eglSwapBuffers produced zero ticks
+ * across a whole 480 s run, which is what pointed here.
+ *
+ * glReadPixels appears at four sites in that function but they are mutually
+ * exclusive branches (PBO or synchronous), so exactly one runs per frame. That
+ * assumption is checked rather than trusted: the A/B report carries its own tick
+ * count, so ticks per cycle must come out at the block length times four.
+ */
+EXPORT void my_glReadPixels(x86emu_t* emu, int32_t x, int32_t y, int32_t w, int32_t h,
+        uint32_t format, uint32_t type, void* pixels)
+{
+    extern int mgs2_island_ab_enabled;
+    void mgs2_island_ab_frame(void);
+    void *mgs2_island_gl_by_name(const char *name);
+    /* This file predates the generated wrapper types, so there is no `my->`
+     * table here. Resolve once through the same by-name path the island's GL
+     * translation uses -- it looks in the driver already loaded in this
+     * process, which is the one holding the context. */
+    static void (*real)(int32_t, int32_t, int32_t, int32_t, uint32_t, uint32_t, void *);
+
+    (void)emu;
+    if (!real)
+        real = mgs2_island_gl_by_name("glReadPixels");
+    if (real)
+        real(x, y, w, h, format, type, pixels);
+    if (mgs2_island_ab_enabled)
+        mgs2_island_ab_frame();
+}
