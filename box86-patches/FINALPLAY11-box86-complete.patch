+static int mgs2_native_targets_build(void)
+{
+    const struct mgs2_native_reg *r;
+    unsigned int filled = 0, dup = 0, out_of_range = 0, i;
+
+    for (r = __start_mgs2_native_ids; r < __stop_mgs2_native_ids; ++r)
+    {
+        if (r->id >= MGS2_NATIVE_ID_COUNT)
+        {
+            ++out_of_range;
+            continue;
+        }
+        if (mgs2_native_target[r->id])
+        {
+            /* Two registrations for one ID means the generator mapped a name
+             * that is defined in more than one translation unit. It rejects
+             * those, so reaching here means the registry and the table were
+             * generated from different object sets. */
+            if (mgs2_native_target[r->id] != r->addr)
+                ++dup;
+            continue;
+        }
+        mgs2_native_target[r->id] = r->addr;
+        ++filled;
+    }
+    if (out_of_range || dup)
+    {
+        printf_log(LOG_NONE, "MGS2 class-B: registry disagrees with the table"
+                " (%u out of range, %u conflicting) -- resolver OFF\n",
+                out_of_range, dup);
+        return 0;
+    }
+    if (filled != MGS2_NATIVE_ID_COUNT)
+    {
+        for (i = 0; i < MGS2_NATIVE_ID_COUNT; ++i)
+            if (!mgs2_native_target[i])
+            {
+                printf_log(LOG_NONE, "MGS2 class-B: %u of %u native IDs registered;"
+                        " first missing is %u (%s) -- resolver OFF\n",
+                        filled, (unsigned)MGS2_NATIVE_ID_COUNT, i,
+                        mgs2_native_id_name[i]);
+                break;
+            }
+        return 0;
+    }
+    printf_log(LOG_NONE, "MGS2 class-B: %u native IDs registered by the linker\n",
+            filled);
+    return 1;
+}
+
+static void mgs2_class_b_arm(void)
+{
+    unsigned int i, j;
+
+    if (!mgs2_native_targets_build())
+    {
+        __atomic_store_n(&mgs2_class_b_state, -1, __ATOMIC_RELEASE);
+        return;
+    }
+
+    for (i = 0; i < sizeof(mgs2_class_b_witness) / sizeof(mgs2_class_b_witness[0]); ++i)
+    {
+        uintptr_t a1 = mgs2_island_entry_guest(mgs2_class_b_witness[i].id);
+        uintptr_t base;
+
+        if (!a1 || a1 < mgs2_class_b_witness[i].rva)
+            continue;
+        base = a1 - mgs2_class_b_witness[i].rva;
+        for (j = i + 1; j < sizeof(mgs2_class_b_witness) / sizeof(mgs2_class_b_witness[0]); ++j)
+        {
+            uintptr_t a2 = mgs2_island_entry_guest(mgs2_class_b_witness[j].id);
+
+            if (!a2)
+                continue;
+            if (a2 != base + mgs2_class_b_witness[j].rva)
+            {
+                printf_log(LOG_NONE, "MGS2 class-B: witnesses disagree (%s %p vs %s %p"
+                        " under base %p) -- table is from a different build, resolver OFF\n",
+                        mgs2_class_b_witness[i].name, (void *)a1,
+                        mgs2_class_b_witness[j].name, (void *)a2, (void *)base);
+                __atomic_store_n(&mgs2_class_b_state, -1, __ATOMIC_RELEASE);
+                return;
+            }
+            __atomic_store_n(&mgs2_class_b_base, base, __ATOMIC_RELAXED);
+            __atomic_store_n(&mgs2_class_b_state, 1, __ATOMIC_RELEASE);
+            printf_log(LOG_NONE, "MGS2 class-B: armed, guest wined3d base %p,"
+                    " %u mappable functions, agreed by %s and %s\n",
+                    (void *)base, (unsigned)MGS2_CLASS_B_COUNT,
+                    mgs2_class_b_witness[i].name, mgs2_class_b_witness[j].name);
+            return;
+        }
+    }
+    printf_log(LOG_NONE, "MGS2 class-B: fewer than two island entries have matched,"
+            " cannot establish the guest base -- resolver OFF\n");
+    __atomic_store_n(&mgs2_class_b_state, -1, __ATOMIC_RELEASE);
+}
+
+static int mgs2_class_b_ensure(void)
+{
+    int state = __atomic_load_n(&mgs2_class_b_state, __ATOMIC_ACQUIRE);
+
+    if (!state)
+    {
+        pthread_mutex_lock(&mgs2_class_b_init_lock);
+        state = __atomic_load_n(&mgs2_class_b_state, __ATOMIC_RELAXED);
+        if (!state)
+            mgs2_class_b_arm();
+        state = __atomic_load_n(&mgs2_class_b_state, __ATOMIC_ACQUIRE);
+        pthread_mutex_unlock(&mgs2_class_b_init_lock);
+    }
+    return state;
+}
+
+/* The cold path. Binary search over RVAs; the caller is expected to cache. */
+void *mgs2_island_resolve(void *guest)
+{
+    uintptr_t g = (uintptr_t)guest;
+    unsigned int lo = 0, hi = MGS2_CLASS_B_COUNT;
+    uint32_t rva;
+
+    if (mgs2_class_b_ensure() != 1 || g < __atomic_load_n(&mgs2_class_b_base,
+            __ATOMIC_ACQUIRE))
+    {
+        MGS2_DIAG_INC(mgs2_class_b_misses);
+        return NULL;
+    }
+    rva = (uint32_t)(g - __atomic_load_n(&mgs2_class_b_base, __ATOMIC_ACQUIRE));
+    while (lo < hi)
+    {
+        unsigned int mid = lo + (hi - lo) / 2;
+
+        if (mgs2_class_b_table[mid].rva == rva)
+        {
+            MGS2_DIAG_INC(mgs2_class_b_hits);
+            return (void *)mgs2_native_target[mgs2_class_b_table[mid].id];
+        }
+        if (mgs2_class_b_table[mid].rva < rva)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    MGS2_DIAG_INC(mgs2_class_b_misses);
+    return NULL;   /* not a WineD3D function: the caller must keep the guest path */
+}
+
+/* Resolve one guest WineD3D symbol by name after the normal two-witness build
+ * pairing has armed.  This is intentionally a cold linear lookup: the batch
+ * bridge uses it once to obtain the authoritative guest mgs2_batch object,
+ * then caches the returned state pointer.  Do not call this before two witness
+ * entries have matched; an early failed class-B arm is deliberately final. */
+uintptr_t mgs2_island_guest_symbol(const char *name)
+{
+    unsigned int id, i;
+
+    if (mgs2_class_b_ensure() != 1)
+        return 0;
+
+    for (id = 0; id < MGS2_NATIVE_ID_COUNT; ++id)
+        if (!strcmp(mgs2_native_id_name[id], name))
+            for (i = 0; i < MGS2_CLASS_B_COUNT; ++i)
+                if (mgs2_class_b_table[i].id == id)
+                    return __atomic_load_n(&mgs2_class_b_base, __ATOMIC_ACQUIRE)
+                            + mgs2_class_b_table[i].rva;
+    return 0;
+}
+
+/*
+ * Class C: a GL entry point.
+ *
+ * wined3d reaches the driver through pointers it obtained from opengl32, and
+ * those come in two kinds. Most are Box86 bridges, and a bridge unwraps
+ * straight to the native driver function -- Box86 does that itself, and this
+ * code only has to ask. The rest are x86 addresses inside opengl32.dll, and for
+ * those the only route back to the driver is the NAME: opengl32's export table
+ * gives it, and dlsym against the already-loaded GL library gives the native
+ * address. That library is the same instance the island already shares a
+ * context with; the GL gate measured 4141 of 4141 probes agreeing.
+ */
+static void *mgs2_gl_lib;
+static pthread_once_t mgs2_gl_once = PTHREAD_ONCE_INIT;
+
+static void mgs2_gl_library_init(void)
+{
+    static const char *const candidates[] = {
+        "libGLESv2.so.2", "libGLESv2.so", "libmali.so.1", "libmali.so", "libGL.so.1",
+    };
+    unsigned int i;
+
+    for (i = 0; i < sizeof(candidates) / sizeof(candidates[0]); ++i)
+    {
+        /* NOLOAD on purpose: pulling in a second copy would be a second driver
+         * instance and a different context. */
+        mgs2_gl_lib = dlopen(candidates[i], RTLD_NOW | RTLD_NOLOAD);
+        if (mgs2_gl_lib)
+            return;
+    }
+    printf_log(LOG_NONE, "MGS2 class-C: no already-loaded GL library found\n");
+}
+
+static void *mgs2_gl_library(void)
+{
+    pthread_once(&mgs2_gl_once, mgs2_gl_library_init);
+    return mgs2_gl_lib;
+}
+
+static uintptr_t mgs2_opengl32_base(void)
+{
+    static uintptr_t base;
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+
+    void init(void)
+    {
+    char line[512];
+    FILE *f;
+
+    if (!(f = fopen("/proc/self/maps", "r")))
+        return;
+    while (fgets(line, sizeof(line), f))
+    {
+        unsigned long lo, hi, off;
+
+        if (!strstr(line, "opengl32.dll"))
+            continue;
+        if (sscanf(line, "%lx-%lx %*s %lx", &lo, &hi, &off) == 3 && off == 0)
+        {
+            base = lo;
+            break;
+        }
+    }
+    fclose(f);
+    if (!base)
+        printf_log(LOG_NONE, "MGS2 class-C: opengl32.dll mapping not found\n");
+    }
+
+    pthread_once(&once, init);
+    return base;
+}
+
+/*
+ * A GL entry point by name, from the driver already in this process.
+ *
+ * This replaces address matching as the primary key for class C. Matching a
+ * pointer against opengl32.dll's export table reached 88 of 493 slots at best,
+ * because the extension entries are internal wglGetProcAddress thunks that the
+ * export table does not name. The name is the durable key: wined3d's gl_ops and
+ * the island's own copy are generated from the same macro lists, so the caller
+ * can hand over the slot's name with nothing to look up.
+ *
+ * dlsym covers core GL. Extensions generally are not dynamic symbols at all on
+ * this driver, so eglGetProcAddress is tried second -- the same already-loaded
+ * EGL the GL gate proved shares the island's context. RTLD_NOLOAD throughout:
+ * a second copy would be a second driver instance.
+ */
+void *mgs2_island_gl_by_name(const char *name)
+{
+    static void *(*getproc)(const char *);
+    static pthread_once_t egl_once = PTHREAD_ONCE_INIT;
+    void *lib, *fn = NULL;
+
+    void init_egl(void)
+    {
+        static const char *const egl_names[] = { "libEGL.so.1", "libEGL.so" };
+        unsigned int i;
+
+        for (i = 0; i < sizeof(egl_names) / sizeof(egl_names[0]); ++i)
+        {
+            void *egl = dlopen(egl_names[i], RTLD_NOW | RTLD_NOLOAD);
+
+            if (egl && (getproc = dlsym(egl, "eglGetProcAddress")))
+                break;
+        }
+        if (!getproc)
+            printf_log(LOG_NONE, "MGS2 class-C: no eglGetProcAddress;"
+                    " extension entry points will not resolve by name\n");
+    }
+
+    if (!name || !*name)
+        return NULL;
+    if ((lib = mgs2_gl_library()))
+        fn = dlsym(lib, name);
+    if (fn)
+        return fn;
+    pthread_once(&egl_once, init_egl);
+    return getproc ? getproc(name) : NULL;
+}
+
+static void *mgs2_class_c_resolve(uintptr_t g)
+{
+    uintptr_t base = mgs2_opengl32_base();
+    unsigned int lo = 0, hi = MGS2_CLASS_C_COUNT;
+    uint32_t rva;
+    void *lib;
+
+    if (!base || g < base)
+        return NULL;
+    rva = (uint32_t)(g - base);
+    while (lo < hi)
+    {
+        unsigned int mid = lo + (hi - lo) / 2;
+
+        if (mgs2_class_c_table[mid].rva == rva)
+        {
+            if (!(lib = mgs2_gl_library()))
+                return NULL;
+            return dlsym(lib, mgs2_class_c_table[mid].name);
+        }
+        if (mgs2_class_c_table[mid].rva < rva)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return NULL;
+}
+
+/*
+ * The dispatch entry point the island's ops call sites use.
+ *
+ * No cache yet, on purpose. The table is a sorted array of 1721 entries, so a
+ * lookup is about eleven comparisons; at the hottest measured site, 4821.9
+ * calls a frame, that is roughly 53k comparisons a frame, which is microseconds
+ * on this part. A per-site one-entry cache would remove even that -- the census
+ * measured one target per site, so it would hit every time -- but it is two
+ * words written from more than one thread, and getting that wrong would be a
+ * memory-ordering bug in exactly the area this project has already been burned
+ * reasoning about. Measure the search first; add the cache only if it shows up.
+ *
+ * A failure to resolve is fatal and says so. Native ARM code cannot call a
+ * guest x86 address, so there is no fallback to take: continuing would jump
+ * into x86 bytes, which is how this branch spent a day being debugged.
+ */
+
+__attribute__((visibility("default")))
+volatile unsigned int mgs2_class_a, mgs2_class_b, mgs2_class_c, mgs2_class_unresolved;
+
+/* The bulk-translation variant: NULL instead of a diagnostic abort.
+ *
+ * gl_ops carries WGL entries too -- wglGetPixelFormat and friends -- which are
+ * Wine's own and have no native counterpart, because context and swapchain
+ * creation stays on the x86 side by design. Translating the table must not die
+ * on them. Leaving the slot NULL means a native call through it faults at once
+ * and legibly, instead of jumping into x86 bytes. */
+void *mgs2_island_try_resolve(void *guest)
+{
+    void *native;
+
+    if (!guest)
+        return NULL;
+    native = GetNativeFncOrFnc((uintptr_t)guest);
+    if (native != guest)
+    {
+        MGS2_DIAG_INC(mgs2_class_a);
+        return native;
+    }
+    native = mgs2_island_resolve(guest);
+    if (native)
+        MGS2_DIAG_INC(mgs2_class_b);
+    else if ((native = mgs2_class_c_resolve((uintptr_t)guest)))
+        MGS2_DIAG_INC(mgs2_class_c);
+    return native;
+}
+
+void *mgs2_island_dispatch(unsigned int site, void *guest)
+{
+#if MGS2_ISLAND_DIAGNOSTICS
+    static volatile unsigned int logged;
+#endif
+    void *native;
+
+    /* NULL in, NULL out. GL_EXTCALL is also how WineD3D TESTS for an extension,
+     * so a null pointer here is a legitimate "this driver does not have it" and
+     * must not be a diagnostic abort. A genuine call through it still faults,
+     * exactly as it would have without the island. */
+    if (!guest)
+        return NULL;
+
+    /* A: a Box86 bridge already holds the native function. Ask Box86. */
+    native = GetNativeFncOrFnc((uintptr_t)guest);
+    if (native != guest)
+    {
+        MGS2_DIAG_INC(mgs2_class_a);
+#if MGS2_ISLAND_DIAGNOSTICS
+        if (logged < 256) { ++logged;
+            printf_log(LOG_NONE, "MGS2 dispatch: site %u %p -> A bridge -> %p\n", site, guest, native); }
+#endif
+        return native;
+    }
+    /* B: a WineD3D function -- the island has its own copy. */
+    native = mgs2_island_resolve(guest);
+    if (native)
+    {
+        MGS2_DIAG_INC(mgs2_class_b);
+#if MGS2_ISLAND_DIAGNOSTICS
+        if (logged < 256) { ++logged;
+            printf_log(LOG_NONE, "MGS2 dispatch: site %u %p -> B wined3d -> %p\n", site, guest, native); }
+#endif
+    }
+    /* C: a GL entry point in opengl32 -- go straight to the driver. */
+    if (!native)
+    {
+        native = mgs2_class_c_resolve((uintptr_t)guest);
+        if (native)
+        {
+            MGS2_DIAG_INC(mgs2_class_c);
+#if MGS2_ISLAND_DIAGNOSTICS
+            if (logged < 256) { ++logged;
+                printf_log(LOG_NONE, "MGS2 dispatch: site %u %p -> C GL -> %p\n", site, guest, native); }
+#endif
+        }
+    }
+    if (!native)
+    {
+#if MGS2_ISLAND_DIAGNOSTICS
+        printf_log(LOG_NONE, "MGS2 class-B: site %u dispatches to %p, which is not a"
+                " mappable WineD3D function -- native ARM cannot call it\n",
+                site, guest);
+#endif
+        abort();
+    }
+    return native;
+}
+
+/* Bulk-translation reporting. One run must name every gap in the gl_ops table,
+ * because finding them one device run at a time is ten minutes each.
+ *
+ * The cap was 40, which defeated exactly that: with 260 slots unresolved it
+ * named 15% of them, and the arming decision needs the whole set. Raised to
+ * cover every slot gl_ops can hold.
+ *
+ * This does not breach the no-logging-from-a-measured-thread rule. gl_ops is
+ * translated ONCE per device, at initialisation -- the cache on the guest
+ * pointer makes every later call return immediately. The cost is a few hundred
+ * lines during startup and nothing at all per frame. */
+void mgs2_island_report_unresolved(unsigned int slot, void *fp)
+{
+#if MGS2_ISLAND_DIAGNOSTICS
+    static unsigned int shown;
+
+    ++mgs2_class_unresolved;
+    if (shown < 4096)
+    {
+        ++shown;
+        printf_log(LOG_NONE, "MGS2 gl_ops: slot %u unresolved %p\n", slot, fp);
+    }
+#else
+    (void)slot;
+    (void)fp;
+#endif
+}
+
+void mgs2_island_report_gl_info(unsigned int total, unsigned int null_in,
+        unsigned int resolved, unsigned int failed)
+{
+#if MGS2_ISLAND_DIAGNOSTICS
+    printf_log(LOG_NONE, "MGS2 gl_ops translated: %u slots, %u null, %u resolved"
+            " (A=%u B=%u C=%u), %u UNRESOLVED\n",
+            total, null_in, resolved, mgs2_class_a, mgs2_class_b, mgs2_class_c, failed);
+#else
+    (void)total;
+    (void)null_in;
+    (void)resolved;
+    (void)failed;
+#endif
+}
+
+/*
+ * Unresolved-GL-slot trap: name the slot instead of faulting at zero.
+ *
+ * Production leaves an unresolved slot NULL, which is correct -- a native call
+ * through it faults immediately instead of entering guest x86 bytes -- but a
+ * fault at address zero does not say which slot. Entry 34 died exactly that way
+ * on 2026-08-19 with eight candidates in its static closure.
+ *
+ * In a diagnostic build the slot gets a stub from mgs2_island_gl_trap.S instead:
+ * `movw r0, #slot; b mgs2_unresolved_gl_trap`, 8 bytes each, so the stub for a
+ * slot is base + 8 * slot with no pointer table. The handler prints the slot and
+ * its name and aborts, because there is nothing safe to return: faking a GL call
+ * would change what the renderer draws or what state it thinks it has.
+ *
+ * NOT in production. mgs2_island_gl_trap() returns NULL unless
+ * MGS2_ISLAND_DIAGNOSTICS is set, so the fail-closed NULL behaviour and the
+ * 32 KB of stubs stay out of the shipped binary.
+ */
+extern char mgs2_gl_trap_stubs[];
+extern const unsigned int mgs2_gl_trap_stub_count;
+
+/* Provided by the island's own utils.c, which owns the slot-name lists. Weak so
+ * a build without the island objects still links. */
+__attribute__((weak)) const char *mgs2_island_gl_slot_name(unsigned int slot);
+
+__attribute__((noreturn))
+void mgs2_unresolved_gl_trap(unsigned int slot)
+{
+    const char *name = (mgs2_island_gl_slot_name
+            ? mgs2_island_gl_slot_name(slot) : NULL);
+    /* The stub reaches here with `b`, not `bl`, so LR still holds the island
+     * caller's return address -- which names the function that made the call,
+     * once it is looked up in the unstripped binary. Knowing the slot without
+     * knowing the caller left the last question open for a whole run. */
+    void *caller = __builtin_return_address(0);
+
+    printf_log(LOG_NONE, "MGS2 island: called UNRESOLVED GL slot %u (%s) from %p --"
+            " this is the diagnostic trap, not a crash in the island\n",
+            slot, name ? name : "name unavailable", caller);
+    abort();
+}
+
+void *mgs2_island_gl_trap(unsigned int slot)
+{
+#if MGS2_ISLAND_DIAGNOSTICS
+    if (slot >= mgs2_gl_trap_stub_count)
+    {
+        printf_log(LOG_NONE, "MGS2 island: no trap stub for slot %u (table holds %u)"
+                " -- leaving it NULL\n", slot, mgs2_gl_trap_stub_count);
+        return NULL;
+    }
+    return mgs2_gl_trap_stubs + 8 * slot;
+#else
+    (void)slot;
+    return NULL;
+#endif
+}
+
+/*
+ * The guest module base, for anyone who needs to turn an RVA into an address.
+ *
+ * Only meaningful once two independent witnesses have agreed on it (see the top
+ * of this file); 0 means "not established yet", which callers must treat as
+ * "cannot check", not as "base 0".
+ */
+uintptr_t mgs2_island_module_base(void)
+{
+    if (__atomic_load_n(&mgs2_class_b_state, __ATOMIC_ACQUIRE) != 1)
+        return 0;
+    return __atomic_load_n(&mgs2_class_b_base, __ATOMIC_RELAXED);
+}
+
+/* A slot the island implements itself, because the driver does not have it and
+ * the guest's own path for it ends in Wine code the island cannot call. Reported
+ * separately from an unresolved slot: "substituted" and "missing" are different
+ * facts and conflating them is how a fake implementation would hide. */
+void mgs2_island_report_substitution(unsigned int slot, const char *name, const char *how)
+{
+#if MGS2_ISLAND_DIAGNOSTICS
+    printf_log(LOG_NONE, "MGS2 island: GL slot %u (%s) substituted natively: %s\n",
+            slot, name ? name : "?", how ? how : "?");
+#else
+    (void)slot;
+    (void)name;
+    (void)how;
+#endif
+}
