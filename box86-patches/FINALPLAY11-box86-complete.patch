--- a/src/mgs2_island_ab.c
+++ b/src/mgs2_island_ab.c
@@ -0,0 +1,279 @@
+/*
+ * Same-process A/B for one island entry, switched on displayed-frame boundaries.
+ *
+ * WHY THIS EXISTS
+ * ===============
+ *
+ * The first attempt to measure what routing wined3d_buffer_load natively is
+ * worth ran eight separate 180 s playthroughs, alternating the entry between
+ * runs. It answered nothing: the spread WITHIN one configuration was about
+ * 2.4 fps, against a predicted effect of 1.1-2.3 fps. The route autoloads and
+ * then walks, and where the walk ends differs every run, so each arm measured a
+ * slightly different scene.
+ *
+ * Splitting one continuous run into alternating blocks removes every one of
+ * those differences at once: same process, same Wine state, same shader and
+ * allocator state, same temperature, same continuing fight. What is left is the
+ * entry itself.
+ *
+ * THE PATTERN IS ABBA, NOT ABAB
+ * =============================
+ *
+ *   frames   0- 63   A   routed
+ *   frames  64-127   B   not routed
+ *   frames 128-191   B   not routed
+ *   frames 192-255   A   routed
+ *
+ * ABAB would confound the effect with any monotone drift across the cycle --
+ * warming, a slowly advancing fight, a governor ramp. ABBA cancels a linear
+ * trend: A sits at both ends and B in the middle, so the two A blocks bracket
+ * the two B blocks and the trend contributes equally to each arm.
+ *
+ * BOTH ARMS PASS THROUGH THE SAME GATE
+ * ====================================
+ *
+ * The comparison would be worthless if B skipped the measuring machinery. Both
+ * arms enter the same bridge, run the same wrapper, and read the same argument
+ * slots off the guest stack; only the last step differs -- native ARM function,
+ * or the guest's own body under the emulator. So the gate's own cost appears in
+ * both arms and cancels.
+ *
+ * Entry 38 is the deliberate exception. The p68 correctness run measured
+ * 4,982,735 calls across 17,832 displayed frames (279.43 calls/frame), so its
+ * guest arm's 2.854 us RunFunctionFmt() trampoline is about 0.797 ms/frame.
+ * That entry registers one tiny control block
+ * in guest WineD3D memory. The frame tick publishes route / settle there, and
+ * guest x86 chooses either the island bridge or its direct body. Both arms
+ * execute the same guest branch and counter; the guest arm never re-enters
+ * Box86 solely for measurement.
+ *
+ * Reaching the guest body from here is safe, which had to be checked rather
+ * than assumed: DynaCall sets R_EIP directly, and hasAlternate() consults only
+ * the alternates hash map, which the island's marker-matched entries were never
+ * added to. So calling the guest address does not re-enter the island bridge.
+ *
+ * WHAT IS COMPARED
+ * ================
+ *
+ * Milliseconds per frame, paired A against B within one cycle -- not fps. The
+ * predicted effect is a few ms; fps is a reciprocal and compresses exactly the
+ * region of interest. Frames are timed at the swap, which is the displayed-frame
+ * boundary, and the first frames of each block are discarded because a
+ * transition carries the cost of whatever state the switch invalidated.
+ */
+#define _GNU_SOURCE
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "debug.h"
+
+/* Block length in displayed frames, and how many to discard after a switch. */
+#define MGS2_AB_BLOCK   64
+#define MGS2_AB_SETTLE   8
+#define MGS2_AB_CYCLE   (4 * MGS2_AB_BLOCK)
+
+int mgs2_island_ab_enabled;          /* MGS2_ISLAND_AB=<entry id>, 0 = off */
+static unsigned int mgs2_ab_entry;
+static unsigned int mgs2_ab_frame;
+static uint64_t mgs2_ab_last_ns;
+
+struct mgs2_ab_arm
+{
+    uint64_t frame_ns;
+    uint64_t frames;
+    uint64_t calls;
+};
+
+static struct mgs2_ab_arm mgs2_ab_arm[2];   /* [0] = A routed, [1] = B not */
+static struct mgs2_ab_arm mgs2_ab_total[2];
+static unsigned int mgs2_ab_cycles;
+
+#define MGS2_AB_GUEST_MAGIC 0x31424154u /* TAB1 */
+
+struct mgs2_ab_guest_control
+{
+    uint32_t magic, version, size_words, signature;
+    uint32_t enabled, route, settled;
+    uint32_t calls[2];
+};
+
+static struct mgs2_ab_guest_control *mgs2_ab_guest;
+static uint32_t mgs2_ab_guest_last_calls[2];
+
+static uint64_t mgs2_now_ns(void)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+void mgs2_island_ab_init(const char *spec)
+{
+    if (!spec || !*spec)
+        return;
+    mgs2_ab_entry = (unsigned int)strtoul(spec, NULL, 0);
+    mgs2_island_ab_enabled = 1;
+    printf_log(LOG_NONE, "MGS2 A/B: island entry %u toggled every %d displayed frames,"
+            " ABBA, %d settle frames discarded per block\n",
+            mgs2_ab_entry, MGS2_AB_BLOCK, MGS2_AB_SETTLE);
+}
+
+/* Which arm the current frame belongs to: 0 = routed, 1 = not routed. */
+static unsigned int mgs2_ab_which(unsigned int frame)
+{
+    unsigned int block = (frame % MGS2_AB_CYCLE) / MGS2_AB_BLOCK;
+
+    return (block == 0 || block == 3) ? 0 : 1;
+}
+
+static int mgs2_ab_settled(unsigned int frame)
+{
+    return (frame % MGS2_AB_BLOCK) >= MGS2_AB_SETTLE;
+}
+
+/* Which entries ship a guest-side symmetric selector: 38 is the p68 draw tail,
+ * 40 the p70b draw-state phase A. Both publish the identical control layout, so
+ * one validated registration path serves them; anything else keeps the ordinary
+ * wrapper A/B. */
+static int mgs2_ab_guest_capable(unsigned int entry)
+{
+    return entry == 38 || entry == 40 || entry == 41;
+}
+
+/* Register the guest-side selector from its first routed call. The control
+ * block is statically allocated by WineD3D and remains live for the process
+ * lifetime. Validate every layout witness before publishing into it; a
+ * mismatched research DLL falls back to the ordinary wrapper A/B. */
+void mgs2_island_ab_register_guest(unsigned int entry, void *ptr)
+{
+    struct mgs2_ab_guest_control *control = ptr;
+
+    if (!mgs2_island_ab_enabled || entry != mgs2_ab_entry
+            || !mgs2_ab_guest_capable(entry) || mgs2_ab_guest)
+        return;
+    if (!control || control->magic != MGS2_AB_GUEST_MAGIC || control->version != 1
+            || control->size_words != sizeof(*control) / sizeof(uint32_t)
+            || control->signature != ~MGS2_AB_GUEST_MAGIC)
+        return;
+
+    mgs2_ab_guest = control;
+    mgs2_ab_guest_last_calls[0] = __atomic_load_n(&control->calls[0], __ATOMIC_ACQUIRE);
+    mgs2_ab_guest_last_calls[1] = __atomic_load_n(&control->calls[1], __ATOMIC_ACQUIRE);
+    __atomic_store_n(&control->route, mgs2_ab_which(mgs2_ab_frame) == 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&control->settled, mgs2_ab_settled(mgs2_ab_frame), __ATOMIC_RELEASE);
+    __atomic_store_n(&control->enabled, 1, __ATOMIC_RELEASE);
+    printf_log(LOG_NONE, "MGS2 A/B: entry %u symmetric guest selector registered at %p\n",
+            entry, control);
+}
+
+int mgs2_island_ab_guest_selector(unsigned int entry)
+{
+    return mgs2_island_ab_enabled && entry == mgs2_ab_entry
+            && mgs2_ab_guest_capable(entry) && mgs2_ab_guest;
+}
+
+/*
+ * Is this entry routed natively for the frame being drawn?
+ *
+ * Read once per call by the entry's wrapper. Everything it touches is written
+ * only by the frame tick, so a call that straddles a switch is attributed to
+ * whichever side it read -- and those calls are inside the discarded settle
+ * window anyway.
+ */
+int mgs2_island_ab_route(unsigned int entry)
+{
+    if (!mgs2_island_ab_enabled || entry != mgs2_ab_entry)
+        return 1;
+    if (mgs2_ab_settled(mgs2_ab_frame))
+        ++mgs2_ab_arm[mgs2_ab_which(mgs2_ab_frame)].calls;
+    return mgs2_ab_which(mgs2_ab_frame) == 0;
+}
+
+/*
+ * One displayed frame. Called from the eglSwapBuffers wrapper, which is the
+ * only place in this process that knows a frame actually reached the display.
+ *
+ * The report is emitted once per completed ABBA cycle -- about every 15 s at
+ * the measured frame rate -- so this is not per-frame logging on the thread
+ * being measured.
+ */
+void mgs2_island_ab_frame(void)
+{
+    uint64_t now, delta;
+    unsigned int arm;
+
+    if (!mgs2_island_ab_enabled)
+        return;
+    now = mgs2_now_ns();
+    delta = mgs2_ab_last_ns ? now - mgs2_ab_last_ns : 0;
+    mgs2_ab_last_ns = now;
+
+    if (delta && mgs2_ab_settled(mgs2_ab_frame))
+    {
+        arm = mgs2_ab_which(mgs2_ab_frame);
+        mgs2_ab_arm[arm].frame_ns += delta;
+        ++mgs2_ab_arm[arm].frames;
+    }
+    ++mgs2_ab_frame;
+
+    if (mgs2_ab_guest)
+    {
+        __atomic_store_n(&mgs2_ab_guest->route, mgs2_ab_which(mgs2_ab_frame) == 0, __ATOMIC_RELEASE);
+        __atomic_store_n(&mgs2_ab_guest->settled, mgs2_ab_settled(mgs2_ab_frame), __ATOMIC_RELEASE);
+    }
+
+    if (mgs2_ab_frame % MGS2_AB_CYCLE)
+        return;
+
+    if (mgs2_ab_guest)
+    {
+        uint32_t current;
+
+        current = __atomic_load_n(&mgs2_ab_guest->calls[0], __ATOMIC_ACQUIRE);
+        mgs2_ab_arm[0].calls = (uint32_t)(current - mgs2_ab_guest_last_calls[0]);
+        mgs2_ab_guest_last_calls[0] = current;
+        current = __atomic_load_n(&mgs2_ab_guest->calls[1], __ATOMIC_ACQUIRE);
+        mgs2_ab_arm[1].calls = (uint32_t)(current - mgs2_ab_guest_last_calls[1]);
+        mgs2_ab_guest_last_calls[1] = current;
+    }
+
+    /* One cycle closed: report the paired difference and fold into the total.
+     * Pairing inside the cycle is the whole point -- a difference of totals
+     * across a long run would carry exactly the drift this design removes. */
+    if (mgs2_ab_arm[0].frames && mgs2_ab_arm[1].frames)
+    {
+        double a = (double)mgs2_ab_arm[0].frame_ns / mgs2_ab_arm[0].frames / 1e6;
+        double b = (double)mgs2_ab_arm[1].frame_ns / mgs2_ab_arm[1].frames / 1e6;
+
+        ++mgs2_ab_cycles;
+        /* The tick count is NOT self-checkable here. An earlier version compared
+         * frames against 2 * (BLOCK - SETTLE) and called that a tick-rate check;
+         * it is circular, because the blocks are defined in ticks, so it holds
+         * whatever the tick actually counts. Removed rather than left to give
+         * false assurance.
+         *
+         * The real check is external and was run: over 51 cycles the mean
+         * interval came to 51.0 ms against 51.1 ms from the launcher's own
+         * MGS2_GL_STATS frame counter, which is produced by different code on
+         * the other side of the emulator. Cumulative ticks are printed so that
+         * comparison can be repeated from any run's log. */
+        printf_log(LOG_NONE, "MGS2 A/B cycle %u: routed %.3f ms/f (n=%llu, %llu calls),"
+                " unrouted %.3f ms/f (n=%llu, %llu calls), routed-unrouted %+.3f ms/f, ticks %llu\n",
+                mgs2_ab_cycles, a, (unsigned long long)mgs2_ab_arm[0].frames,
+                (unsigned long long)mgs2_ab_arm[0].calls,
+                b, (unsigned long long)mgs2_ab_arm[1].frames,
+                (unsigned long long)mgs2_ab_arm[1].calls, a - b,
+                (unsigned long long)mgs2_ab_frame);
+    }
+    for (arm = 0; arm < 2; ++arm)
+    {
+        mgs2_ab_total[arm].frame_ns += mgs2_ab_arm[arm].frame_ns;
+        mgs2_ab_total[arm].frames += mgs2_ab_arm[arm].frames;
+        mgs2_ab_total[arm].calls += mgs2_ab_arm[arm].calls;
+        memset(&mgs2_ab_arm[arm], 0, sizeof(mgs2_ab_arm[arm]));
+    }
+}
