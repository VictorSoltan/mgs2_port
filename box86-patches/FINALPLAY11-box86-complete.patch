+/* cdecl: three pointer arguments on the guest stack, no return value. The
+ * pointers are guest addresses, which under Box86 are directly usable by native
+ * code -- that is the whole premise the layout probes established. */
+/* Slice 1's standalone copy is superseded by the full island, which provides
+ * wined3d_ffp_get_fs_settings itself as island entry 17. */
+void mgs2_island_gl_probe_impl(unsigned int *out);
