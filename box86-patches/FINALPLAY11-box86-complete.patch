+/* ---------------------------------------------------------------------------
+ * MGS2 native RGBA dither pack -- the long load freeze.
+ *
+ * Four unattended captures agree: while the game freezes for 4-7 s after a save
+ * loads, wined3d_cs sleeps on a futex and does no GL at all, and 44.7% of the
+ * main thread's CPU sits in ONE translated block, mgs2_sse_rg353vs_port.exe
+ * +0x50dae1 -- about 4.2 s of the 14.2 s of long stalls in a 200 s capture.
+ *
+ * The block is a float RGBA -> packed 8-bit converter with a 4x4 ordered
+ * dither, written per pixel in scalar x87. Box86 emulates every x87 op, which
+ * is why it costs what it does; the arithmetic itself is trivial.
+ *
+ * Reproducing it exactly, not approximately:
+ *
+ *  - Rounding. The guest calls a helper at +0x50d5b3 that does fnstcw, ORs
+ *    0xc00 into the control word and reloads it. Bits 10-11 are RC, and 11 is
+ *    round-toward-zero, so every FISTP here TRUNCATES. Precision control is
+ *    left alone at the Windows default of 53 bits.
+ *  - Intermediate width. The loop stores each channel with FSTPS and reloads it
+ *    before FISTP, so the value is forced through float32 whatever PC says.
+ *    That makes the whole expression (float)((double)s * 255.0 + (double)d).
+ *  - The multiplier at 0x964aa8 is exactly 255.0f (read out of the image).
+ *  - Packing ORs FULL 32-bit channel values, not bytes. An out-of-range channel
+ *    bleeds into its neighbours, and that behaviour is preserved rather than
+ *    masked, because matching the original is the whole point.
+ *  - Out-of-range or NaN input makes FISTP produce the integer indefinite
+ *    0x80000000. Reproduced explicitly; C's float->int conversion is undefined
+ *    there, so it cannot be left to the compiler.
+ *
+ * The dither index is (x & 3) * 8 + (y & 3) + (i & 3) into the table at
+ * this+0x2c, which the guest computes once before the loop.
+ * ------------------------------------------------------------------------- */
+
+#define MGS2_DITHER_RVA        0x50dae1u   /* the converter itself */
+#define MGS2_DITHER_XFORM_RVA  0x50ce22u   /* the pre-transform it may call */
+
+static inline int32_t mgs2_x87_fistp_trunc(float t)
+{
+    /* FISTP with RC=11. The open interval is what truncation actually accepts:
+     * 2147483647.5 truncates to a representable value, 2147483648.0 does not. */
+    if (!(t > -2147483649.0f && t < 2147483648.0f))
+        return (int32_t)0x80000000;
+    return (int32_t)t;
+}
+
+__attribute__((noinline, visibility("default")))
+void mgs2_native_dither_kernel(uint32_t *dst, const float *src,
+        const float *dither_row, uint32_t count)
+{
+    int saved_round = fegetround();
+    uint32_t i;
+
+    /* RC=11 in the guest's control word is not "truncate on FISTP". It is the
+     * x87 rounding mode, so the FADDS and the narrowing FSTPS truncate toward
+     * zero as well. Rounding those to nearest -- the C default -- lands
+     * 127.99999991 exactly on 128.0f and returns one more than the guest.
+     * A host oracle running the real x87 sequence found 24 such cases in eight
+     * million inputs; with the mode set, zero. harness/dither/x87_oracle.c. */
+    fesetround(FE_TOWARDZERO);
+
+    for (i = 0; i < count; ++i)
+    {
+        const float d = dither_row[i & 3];
+        const float *p = src + (size_t)i * 4;
+        uint32_t v[4];
+        int k;
+
+        for (k = 0; k < 4; ++k)
+            v[k] = (uint32_t)mgs2_x87_fistp_trunc(
+                    (float)((double)p[k] * 255.0 + (double)d));
+
+        dst[i] = ((((v[3] << 8) | v[0]) << 8) | v[1]) << 8 | v[2];
+    }
+
+    fesetround(saved_round);
+}
+
+/* Set from bridge.c when the prologue matches, so the pre-transform's address
+ * can be derived from the same module base instead of being assumed. */
+uintptr_t mgs2_dither_guest_addr(void);
+
+/* Verify mode (MGS2_BOX86_NATIVE_DITHER=2).
+ *
+ * The obvious correctness test -- compare screenshots between the two arms --
+ * was tried and has no power: two runs of the SAME arm differ on exactly the
+ * same seven screenshots, because the attract loop and the scripted walk are
+ * not frame-identical. Only the five static menu screens reproduce.
+ *
+ * So the comparison has to be against the guest's own output on the guest's own
+ * data: run the original, keep what it wrote, run the native version over the
+ * same pixels, and compare the finished 32-bit words. Nothing here compares
+ * floats, and the inputs are whatever the game actually loads rather than a
+ * table of guesses. */
+static int mgs2_dither_verify;
+static unsigned int mgs2_dither_checked, mgs2_dither_bad, mgs2_dither_skipped;
+
+/* The buffer grows to whatever the game asks for. A fixed cap silently turned
+ * every call into a "skip", and a verify run that compares nothing reports zero
+ * mismatches exactly like a verify run that compares everything. */
+
+static void mgs2_native_dither_run(uint32_t self, uint32_t x, uint32_t y, uint32_t src);
+
+/* Byte offsets of the two rel32 CALLs inside the converter: the guarded
+ * pre-transform, and the helper that switches the x87 control word to truncate.
+ * Verified against the image; the copy asserts the opcode before touching it. */
+#define MGS2_DITHER_LEN        0x140u
+#define MGS2_DITHER_CALL1      0x15u
+#define MGS2_DITHER_CALL2      0x4eu
+
+static uintptr_t mgs2_dither_reference(uintptr_t guest)
+{
+    static uintptr_t copy;
+    unsigned char *c;
+    unsigned int k;
+    static const unsigned int at[2] = { MGS2_DITHER_CALL1, MGS2_DITHER_CALL2 };
+
+    if (copy)
+        return copy;
+    c = (unsigned char *)mmap(NULL, 4096, PROT_READ | PROT_WRITE | PROT_EXEC,
+            MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (c == MAP_FAILED)
+        return 0;
+    memcpy(c, (const void *)guest, MGS2_DITHER_LEN);
+    for (k = 0; k < 2; ++k)
+    {
+        int32_t disp;
+        uintptr_t target;
+
+        if (c[at[k]] != 0xe8)
+        {
+            printf_log(LOG_NONE, "MGS2 native dither: reference copy expected a "
+                    "call at +0x%x, found 0x%02x -- verify disabled\n",
+                    at[k], c[at[k]]);
+            munmap(c, 4096);
+            return 0;
+        }
+        memcpy(&disp, c + at[k] + 1, 4);
+        target = guest + at[k] + 5 + (uintptr_t)(intptr_t)disp;
+        disp = (int32_t)(intptr_t)(target - ((uintptr_t)c + at[k] + 5));
+        memcpy(c + at[k] + 1, &disp, 4);
+    }
+    copy = (uintptr_t)c;
+    printf_log(LOG_NONE, "MGS2 native dither: reference copy of %p at %p\n",
+            (void *)guest, (void *)copy);
+    return copy;
+}
+
+static void mgs2_native_dither_verify(uint32_t self, uint32_t x, uint32_t y,
+        uint32_t src)
+{
+    static uint32_t *reference;
+    static size_t reference_cap;
+    const uint32_t *f = (const uint32_t *)(uintptr_t)self;
+    uint32_t count = f[0x1058 / 4];
+    uintptr_t guest = mgs2_dither_guest_addr();
+    x86emu_t *emu = thread_get_emu();
+    uint32_t *dst;
+    unsigned int i, bad = 0;
+
+    if (mgs2_dither_checked + mgs2_dither_skipped < 4)
+        printf_log(LOG_NONE, "MGS2 native dither verify: call %u, count=%u pixels\n",
+                mgs2_dither_checked + mgs2_dither_skipped, count);
+    if (count > reference_cap)
+    {
+        uint32_t *grown = (uint32_t *)realloc(reference, (size_t)count * 4);
+
+        if (grown) { reference = grown; reference_cap = count; }
+    }
+    if (!guest || !emu || !count || count > reference_cap)
+    {
+        ++mgs2_dither_skipped;
+        mgs2_native_dither_run(self, x, y, src);
+        return;
+    }
+
+    /* Against a RELOCATED COPY of the original, not the original itself.
+     *
+     * Calling it in place defeats the test: the dynarec then owns a block for
+     * that guest address, and every later indirect call finds the block instead
+     * of asking LinkNext, so the bridge stops being consulted. The first verify
+     * run compared exactly one call for that reason and looked like a pass.
+     *
+     * The copy needs only its two rel32 calls fixed up. Everything else it
+     * touches -- the 255.0f constant, the saved control word -- is absolute and
+     * still valid, because guest and host share this address space. */
+    guest = mgs2_dither_reference(guest);
+    if (!guest)
+    {
+        ++mgs2_dither_skipped;
+        mgs2_native_dither_run(self, x, y, src);
+        return;
+    }
+    mgs2_dither_bypass = 1;
+    SetECX(emu, self);
+    /* First vararg lands nearest the return address, so this is the guest's
+     * [ebp+8], [ebp+0xc], [ebp+0x10] -- x, y, src, in that order. */
+    RunFunctionWithEmu(emu, 0, guest, 3, x, y, src);
+    SetESP(emu, GetESP(emu) - 12);   /* the guest is `ret $0xc` and popped these */
+    mgs2_dither_bypass = 0;
+
+    dst = (uint32_t *)(uintptr_t)(f[0x18 / 4] + f[0x1050 / 4] * x
+            + f[0x1054 / 4] * y);
+    memcpy(reference, dst, (size_t)count * 4);
+
+    mgs2_native_dither_run(self, x, y, src);
+
+    for (i = 0; i < count; ++i)
+        if (reference[i] != dst[i])
+        {
+            if (!bad && mgs2_dither_bad < 8)
+                printf_log(LOG_NONE, "MGS2 native dither: MISMATCH at pixel %u "
+                        "guest %08x native %08x (count %u)\n",
+                        i, reference[i], dst[i], count);
+            ++bad;
+        }
+    ++mgs2_dither_checked;
+    if (bad) ++mgs2_dither_bad;
+    if ((mgs2_dither_checked & 0x07) == 0)
+        printf_log(LOG_NONE, "MGS2 native dither verify: %u calls compared, "
+                "%u differed, %u skipped (too large or no emu)\n",
+                mgs2_dither_checked, mgs2_dither_bad, mgs2_dither_skipped);
+}
+
+__attribute__((noinline, visibility("default")))
+void mgs2_native_dither_impl(uint32_t self, uint32_t x, uint32_t y, uint32_t src)
+{
+    /* Verify a bounded prefix, then get out of the way.
+     *
+     * Each verified call runs the original as a nested guest call, and that
+     * perturbs the caller enough to end its tile loop: with verification on
+     * every call the run produced one call instead of the 16384 the same load
+     * makes normally. Bounding it keeps a real differential sample -- different
+     * textures, different content -- without turning the whole run into an
+     * artefact. */
+    if (mgs2_dither_verify && mgs2_dither_checked < 64)
+    {
+        mgs2_native_dither_verify(self, x, y, src);
+        return;
+    }
+    mgs2_native_dither_run(self, x, y, src);
+}
+
+static unsigned int mgs2_dither_calls, mgs2_dither_pixels;
+
+static void mgs2_native_dither_run(uint32_t self, uint32_t x, uint32_t y, uint32_t src)
+{
+    const uint32_t *f = (const uint32_t *)(uintptr_t)self;
+    uint32_t count = f[0x1058 / 4];
+    uint32_t dst;
+    const float *dither;
+
+    if (f[0x1048 / 4])
+    {
+        /* The rare path reorders channels through a scratch buffer, in a
+         * several-hundred-byte dispatcher with a dozen cases. It runs once per
+         * call, not once per pixel, so it is left to the guest: reimplementing
+         * it would be all of the correctness risk for none of the time. */
+        uintptr_t guest = mgs2_dither_guest_addr();
+        x86emu_t *emu = thread_get_emu();
+
+        if (!guest || !emu)
+            return;
+        SetECX(emu, self);
+        RunFunctionWithEmu(emu, 0, guest - MGS2_DITHER_RVA + MGS2_DITHER_XFORM_RVA,
+                1, src);
+        /* That callee is `ret $0x4` -- it popped its own argument, and
+         * RunFunctionWithEmu popped it a second time on the way out. */
+        SetESP(emu, GetESP(emu) - 4);
+        src = GetEAX(emu);
+    }
+
+    dst = f[0x18 / 4] + f[0x1050 / 4] * x + f[0x1054 / 4] * y;
+    dither = (const float *)(uintptr_t)(f[0x2c / 4] + (((y & 3) + (x & 3) * 8) * 4));
+
+    mgs2_native_dither_kernel((uint32_t *)(uintptr_t)dst,
+            (const float *)(uintptr_t)src, dither, count);
+
+    /* How often the bridge actually runs. Without this the A/B improvement and
+     * the verify run's silence cannot both be explained, and one of them has to
+     * be wrong. Powers of two so a long run does not flood the log. */
+    mgs2_dither_pixels += count;
+    if (!(++mgs2_dither_calls & (mgs2_dither_calls - 1)))
+        printf_log(LOG_NONE, "MGS2 native dither: %u calls, %u pixels\n",
+                mgs2_dither_calls, mgs2_dither_pixels);
+}
+
+static int mgs2_native_dither_selftest(void)
+{
+    /* Expected values computed on a host running the REAL x87 sequence, not by
+     * the same arithmetic this is testing. See harness/dither/x87_oracle.c.
+     *
+     * Probe 8 with dither 0.5 is the one that matters most: 254.5/255 * 255 is
+     * 254.49999 rather than 254.5, so truncation gives 254 while round-to-
+     * nearest gives 255. If fesetround() ever stops taking effect on this
+     * target, or the compiler hoists the arithmetic out from under it, this
+     * entry catches it -- the other ten agree under both modes. */
+    static const float probe[] = {
+        0.0f, 1.0f, -0.0f, 1.0f / 255.0f,
+        0.5f / 255.0f, 0.4999f / 255.0f, 0.5001f / 255.0f,
+        127.5f / 255.0f, 254.5f / 255.0f, -0.001f, 1.001f, 0.5f,
+    };
+    static const uint32_t expect[2][12] = {
+        /* dither 0.0 */
+        { 0, 255, 0, 1, 0, 0, 0, 127, 254, 0, 255, 127 },
+        /* dither 0.5 */
+        { 0, 255, 0, 1, 1, 0, 1, 128, 254, 0, 255, 128 },
+    };
+    static const float dither[4] = { 0.0f, 0.5f, 0.0f, 0.5f };
+    unsigned int n = (unsigned int)(sizeof(probe) / sizeof(probe[0]));
+    unsigned int i, k, bad = 0;
+
+    for (k = 0; k < 2; ++k)
+        for (i = 0; i < n; ++i)
+        {
+            float src[4];
+            uint32_t out = 0, want = expect[k][i];
+            unsigned int c;
+
+            for (c = 0; c < 4; ++c) src[c] = probe[i];
+            mgs2_native_dither_kernel(&out, src, dither + k, 1);
+            if (out != (((((want << 8) | want) << 8) | want) << 8 | want))
+            {
+                printf_log(LOG_NONE, "MGS2 native dither: self-test probe %u "
+                        "dither %u gave %08x, expected channel value %u\n",
+                        i, k, out, want);
+                ++bad;
+            }
+        }
+    return bad == 0;
+}
+
+static void mgs2_native_dither_wrapper(x86emu_t *emu, uintptr_t fnc)
+{
+    uint32_t esp = GetESP(emu);
+
+    ((void (*)(uint32_t, uint32_t, uint32_t, uint32_t))fnc)(
+            GetECX(emu),
+            *(uint32_t *)(esp + 4),
+            *(uint32_t *)(esp + 8),
+            *(uint32_t *)(esp + 12));
+}
