diff --git a/src/wrapped/wrappedlibegl.c b/src/wrapped/wrappedlibegl.c
new file mode 100644
index 00000000..3c5f74f9
--- /dev/null
+++ b/src/wrapped/wrappedlibegl.c
@@ -0,0 +1,61 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define _GNU_SOURCE
+#include <dlfcn.h>
+
+#include "wrappedlibs.h"
+
+#include "debug.h"
+#include "wrapper.h"
+#include "bridge.h"
+#include "librarian/library_private.h"
+#include "x86emu.h"
+#include "emu/x86emu_private.h"
+#include "callback.h"
+#include "librarian.h"
+#include "box86context.h"
+#include "gltools.h"
+
+const char *libeglName = "libEGL.so.1";
+#define LIBNAME libegl
+
+#include "generated/wrappedlibegltypes.h"
+
+#include "wrappercallback.h"
+
+EXPORT void *my_eglGetProcAddress(x86emu_t *emu, void *name)
+{
+    void *result;
+
+    printf_log(LOG_INFO, "MGS2DBG: eglGetProcAddress(\"%s\") native=%p\n",
+            (const char *)name, my->eglGetProcAddress);
+    result = getGLProcAddress(emu, (glprocaddress_t)my->eglGetProcAddress,
+            (const char *)name);
+    printf_log(LOG_INFO, "MGS2DBG: eglGetProcAddress(\"%s\") = %p\n",
+            (const char *)name, result);
+    return result;
+}
+
+EXPORT uint32_t my_eglInitialize(void *display, void *major, void *minor)
+{
+    uint32_t result;
+
+    printf_log(LOG_INFO, "MGS2DBG: eglInitialize(%p) native=%p\n",
+            display, my->eglInitialize);
+    result = my->eglInitialize(display, major, minor);
+    printf_log(LOG_INFO, "MGS2DBG: eglInitialize(%p) = %u version=%d.%d\n",
+            display, result, major ? *(int *)major : -1,
+            minor ? *(int *)minor : -1);
+    return result;
+}
+
+#define ALTMY my_
+
+#define CUSTOM_INIT \
+    getMy(lib);
+
+#define CUSTOM_FINI \
+    freeMy();
+
+#include "wrappedlib_init.h"
