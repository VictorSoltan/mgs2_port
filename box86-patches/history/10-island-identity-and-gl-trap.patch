--- /dev/null
+++ b/src/mgs2_island_gl_trap.S
@@ -0,0 +1,50 @@
+/*
+ * One tiny ARM stub per GL slot, so an island call through an UNRESOLVED slot
+ * names the slot instead of faulting at address zero.
+ *
+ * Leaving an unresolved slot NULL is the right production behaviour -- a call
+ * faults at once instead of entering guest x86 bytes -- but it says nothing
+ * about WHICH slot. On 2026-08-19 island entry 34 died on
+ * "SIGSEGV @(nil) for accessing (nil)" with eight candidate slots in its static
+ * closure and no way to tell them apart. This table turns that into one line.
+ *
+ * `movw` is required, not `mov`: the ARM data-processing immediate is an 8-bit
+ * value rotated by an even amount, so a slot number like 3113 is not encodable,
+ * and the assembler would either reject it or (worse, with a literal pool)
+ * change the stub's size. `movw` takes a 16-bit immediate, so every stub is
+ * exactly two instructions -- 8 bytes -- and the runtime can compute a stub
+ * address as base + 8 * slot without a table of pointers.
+ *
+ * ARM mode, deliberately: box86 is built Thumb-2-capable, and the island's
+ * callers reach these through a function pointer, so bit 0 of the address stays
+ * clear and the CPU interworks into ARM. A Thumb version would need the bit set
+ * on every address handed out, which is one more thing to get wrong.
+ *
+ * DIAGNOSTIC BUILDS ONLY. mgs2_island_gl_trap() hands out these addresses only
+ * when MGS2_ISLAND_DIAGNOSTICS is set; a production build keeps NULL and does
+ * not need the 32 KB.
+ */
+    .syntax unified
+    .arm
+    .text
+    .balign 4
+    .global mgs2_gl_trap_stubs
+    .hidden mgs2_gl_trap_stubs
+    .type mgs2_gl_trap_stubs, %function
+mgs2_gl_trap_stubs:
+    .set mgs2_trap_slot, 0
+    .rept 4096
+    movw    r0, #mgs2_trap_slot
+    b       mgs2_unresolved_gl_trap
+    .set mgs2_trap_slot, mgs2_trap_slot + 1
+    .endr
+    .size mgs2_gl_trap_stubs, . - mgs2_gl_trap_stubs
+
+    .global mgs2_gl_trap_stub_count
+    .hidden mgs2_gl_trap_stub_count
+    .section .rodata
+    .balign 4
+mgs2_gl_trap_stub_count:
+    .word 4096
+    .size mgs2_gl_trap_stub_count, 4
+    .section .note.GNU-stack,"",%progbits
