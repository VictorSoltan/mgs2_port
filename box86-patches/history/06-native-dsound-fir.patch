+        static const unsigned char signature[] = {
+            0x55, 0x89, 0xe5, 0x57, 0x89, 0xc7, 0x56, 0x53,
+            0x83, 0xe4, 0xf8, 0x83, 0xec, 0x48, 0x8b, 0x40,
+            0x2c, 0x8b, 0x57, 0x30, 0x8b, 0x4f, 0x10, 0x89,
+            0x44, 0x24, 0x28, 0x8b, 0x47, 0x34, 0x89, 0x54,
+            0x24, 0x2c, 0x8b, 0x57, 0x38, 0x89, 0x44, 0x24,
+            0x18, 0x8b, 0x47, 0x3c, 0x89, 0x54, 0x24, 0x1c,
+        };
+        uintptr_t guest = __atomic_load_n(&mgs2_dsound_fir_guest, __ATOMIC_ACQUIRE);
+
+        if (guest && (uintptr_t)addr == guest)
+            return (void *)mgs2_native_dsound_fir;
+        if (!guest && mgs2_signature_readable((uintptr_t)addr, sizeof(signature))
+                && !memcmp(addr, signature, sizeof(signature)))
+        {
+            __atomic_store_n(&mgs2_dsound_fir_guest, (uintptr_t)addr, __ATOMIC_RELEASE);
+            printf_log(LOG_INFO, "MGS2 native dsound FIR: matched guest %p -> bridge %p\n",
+                    addr, (void *)mgs2_native_dsound_fir);
+            return (void *)mgs2_native_dsound_fir;
+        }
+    }
     return addr;
