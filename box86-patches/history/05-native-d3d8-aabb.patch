+/* Exact native equivalent of Wine d3d8_mgs2_scan_aabb().  The candidate DLL
+ * keeps this one function out of line with regparm=3: buffer/left/count arrive
+ * in eax/edx/ecx and the remaining arguments stay on the guest stack. */
+__attribute__((noinline, visibility("default")))
+uint32_t mgs2_native_aabb_impl(uint32_t buffer_addr, uint32_t left,
+        uint32_t vertex_count, uint32_t stride, uint32_t position_offset,
+        float *min_value, float *max_value)
+{
+    const unsigned char *snapshot;
+    uint32_t snapshot_addr;
+    uint32_t offset = left + position_offset;
+    uint32_t i;
+
+    memcpy(&snapshot_addr, (const void *)(uintptr_t)(buffer_addr + 0x1c),
+            sizeof(snapshot_addr));
+    snapshot = (const unsigned char *)(uintptr_t)snapshot_addr;
+
+    for (i = 0; i < vertex_count; ++i, offset += stride)
+    {
+        float position[3];
+        unsigned int axis;
+
+        memcpy(position, snapshot + offset, sizeof(position));
+        if (!isfinite(position[0]) || !isfinite(position[1]) || !isfinite(position[2]))
+            return 0;
+        for (axis = 0; axis < 3; ++axis)
+        {
+            if (!i || position[axis] < min_value[axis]) min_value[axis] = position[axis];
+            if (!i || position[axis] > max_value[axis]) max_value[axis] = position[axis];
+        }
+    }
+    return 1;
+}
+
+static int mgs2_native_aabb_selftest(void)
+{
+    unsigned char buffer[0x20] = {0};
+    float vertices[12] = {
+        1.0f, 2.0f, 3.0f, 0.0f,
+        -4.0f, 5.0f, 0.5f, 0.0f,
+        2.0f, -3.0f, 9.0f, 0.0f,
+    };
+    uint32_t snapshot = (uintptr_t)vertices;
+    float min_value[3], max_value[3];
+
+    memcpy(buffer + 0x1c, &snapshot, sizeof(snapshot));
+    if (!mgs2_native_aabb_impl((uintptr_t)buffer, 0, 3, 16, 0,
+            min_value, max_value))
+        return 0;
+    return min_value[0] == -4.0f && min_value[1] == -3.0f
+            && min_value[2] == 0.5f && max_value[0] == 2.0f
+            && max_value[1] == 5.0f && max_value[2] == 9.0f;
+}
+
+static void mgs2_native_aabb_wrapper(x86emu_t *emu, uintptr_t fnc)
+{
+    uint64_t edxeax = GetEDXEAX(emu);
+    uint32_t esp = GetESP(emu);
+    uint32_t result;
+
+    result = ((uint32_t (*)(uint32_t, uint32_t, uint32_t, uint32_t,
+            uint32_t, float *, float *))fnc)(
+            (uint32_t)edxeax, (uint32_t)(edxeax >> 32), GetECX(emu),
+            *(uint32_t *)(esp + 4), *(uint32_t *)(esp + 8),
+            *(float **)(esp + 12), *(float **)(esp + 16));
+    SetEAX(emu, result);
+}
