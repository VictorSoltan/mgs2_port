+/* p71 shader witness. The p69 boundary died because native code read a shared
+ * FFP cache node's `id` 32 bytes early, so the program actually bound is the
+ * thing to watch when that boundary is tried again on an MS-layout island.
+ *
+ * Sampled, never per-draw: the caller decides the interval. Read-only, three
+ * glGetIntegerv calls plus one glGetError.
+ *
+ * out[0] resolved flag, [1] current program, [2] program pipeline,
+ * [3] draw framebuffer, [4] glGetError result. */
+void mgs2_island_shader_witness_impl(unsigned int *out)
+{
+    GLint v[4] = { 0, 0, 0, 0 };
+
+    if (!out)
+        return;
+    mgs2_island_gl_resolve();
+    out[0] = p_glGetIntegerv && p_glGetError;
+    if (!out[0])
+        return;
+    p_glGetIntegerv(GL_CURRENT_PROGRAM, v);          out[1] = (unsigned)v[0];
+    p_glGetIntegerv(GL_PROGRAM_PIPELINE_BINDING, v); out[2] = (unsigned)v[0];
+    p_glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, v); out[3] = (unsigned)v[0];
+    out[4] = (unsigned)p_glGetError();
+}
