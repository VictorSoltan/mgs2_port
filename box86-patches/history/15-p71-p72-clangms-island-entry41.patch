+    MGS2_P72_CORRECTNESS_MAGIC, 1,
+    sizeof(struct mgs2_p72_correctness_public) / sizeof(uint32_t),
+    ~MGS2_P72_CORRECTNESS_MAGIC,
+};
+
+static int mgs2_p72_correctness_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv("MGS2_P72_CORRECTNESS");
+
+        enabled = value && strcmp(value, "0");
+        mgs2_p72_correctness.enabled = enabled;
+    }
+    return enabled;
+}
