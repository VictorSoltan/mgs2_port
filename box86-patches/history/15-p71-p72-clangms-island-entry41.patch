+/* p72 entry 41. One pointer to a guest-stack argument object, no result: the
+ * only failure path in draw-state application is the framebuffer-attachment
+ * check, and that stays in the guest above this boundary. Fails closed to the
+ * guest body when the TLS guard is unavailable, exactly as entry 40 did. */
+static void mgs2_island_w41_vFp(x86emu_t *emu, uintptr_t fnc)
+{
+    struct mgs2_fused_abc_args32
+    {
+        uint32_t context, device, state, indexed, ab_control;
+    };
+    uint32_t esp = GetESP(emu);
+    void *a = *(void **)(esp + 4);
+    int routed;
+
+    /* p72b: register the guest-side selector from its first routed call. Once
+     * registered, guest x86 enters this bridge only for the routed arm and calls
+     * the transaction body directly for the control arm. */
+    mgs2_island_ab_register_guest(41,
+            (void *)(uintptr_t)((const struct mgs2_fused_abc_args32 *)a)->ab_control);
+    routed = mgs2_island_ab_guest_selector(41) ? 1 : mgs2_island_ab_route(41);
+
+    if (routed && mgs2_island_context_tls_sync() == 1)
+    {
+        if (mgs2_p72_correctness_on())
+            ++mgs2_p72_correctness.calls;
+        ((void (*)(void *))fnc)(a);
+    }
+    else
+    {
+        uintptr_t guest = mgs2_island_entry_guest(41);
+
+        if (mgs2_p72_correctness_on())
+            ++mgs2_p72_correctness.guest_fallbacks;
+        if (guest)
+            RunFunctionFmt(guest, "p", a);
+    }
+}
