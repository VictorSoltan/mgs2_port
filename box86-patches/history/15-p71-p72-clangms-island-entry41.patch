+#define MGS2_P71_WITNESS_MAGIC 0x31375750u /* PW71 */
+#define MGS2_P71_WITNESS_INTERVAL 4096u
+
+/* p71 bounded shader witness. Not per-draw: one sample every 4096 native
+ * draw-state applications, which is a few times per second at this route's call
+ * rate. It records what the driver actually has bound after the native root
+ * returns, plus how often that program was zero -- the shape a mis-read FFP
+ * cache id would produce. No stderr output at any point. */
+struct mgs2_p71_witness_public
+{
+    uint32_t magic, version, size_words, signature;
+    uint32_t enabled, samples, resolved;
+    uint32_t last_program, last_pipeline, last_framebuffer, last_gl_error;
+    uint32_t zero_program_samples, gl_error_samples;
+};
+
+__attribute__((visibility("default")))
+struct mgs2_p71_witness_public mgs2_p71_witness =
+{
+    MGS2_P71_WITNESS_MAGIC, 1,
+    sizeof(struct mgs2_p71_witness_public) / sizeof(uint32_t),
+    ~MGS2_P71_WITNESS_MAGIC,
+};
+
+void mgs2_island_shader_witness_impl(unsigned int *out);   /* mgs2_island_gl.c */
+
+static int mgs2_p71_witness_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *value = getenv("MGS2_P71_WITNESS");
+
+        enabled = value && strcmp(value, "0");
+        mgs2_p71_witness.enabled = enabled;
+    }
+    return enabled;
+}
+
+static void mgs2_p71_witness_sample(void)
+{
+    unsigned int out[5] = { 0, 0, 0, 0, 0 };
+
+    mgs2_island_shader_witness_impl(out);
+    mgs2_p71_witness.resolved = out[0];
+    if (!out[0])
+        return;
+    mgs2_p71_witness.last_program = out[1];
+    mgs2_p71_witness.last_pipeline = out[2];
+    mgs2_p71_witness.last_framebuffer = out[3];
+    mgs2_p71_witness.last_gl_error = out[4];
+    if (!out[1])
+        ++mgs2_p71_witness.zero_program_samples;
+    if (out[4])
+        ++mgs2_p71_witness.gl_error_samples;
+    ++mgs2_p71_witness.samples;
+}
