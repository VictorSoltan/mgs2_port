+/* Memory-only history for the exact production win32u display_lock call site.
+ *
+ * Rebuilding win32u.so is not a valid diagnostic in this project: two local
+ * Unix-side rebuilds hung the game.  The shipping i386 module calls pthread
+ * through this wrapper, so observe the real module here instead.  Before the
+ * target is known, match the bytes immediately after the lock call in the
+ * byte-verified win32u_glfuncs3.so.  Afterwards the hot-path cost for unrelated
+ * mutexes is one disabled/target pointer comparison.  The target's rare events
+ * are kept in a fixed memory ring and never logged from the calling thread. */
+#define MGS2_DISPLAY_LOCK_MAGIC 0x314c444du /* MDL1 */
+#define MGS2_DISPLAY_LOCK_CAPACITY 256
+#define MGS2_DISPLAY_LOCK_STACK_WORDS 16
+
+enum mgs2_display_lock_event
+{
+    MGS2_DISPLAY_LOCK_ATTEMPT = 1,
+    MGS2_DISPLAY_LOCK_ACQUIRED,
+    MGS2_DISPLAY_LOCK_RELEASED,
+};
+
+struct mgs2_display_lock_record
+{
+    uint32_t sequence, tid, event, mutex;
+    uint32_t caller, stack_pointer, lock, owner;
+    uint32_t result, stack[MGS2_DISPLAY_LOCK_STACK_WORDS];
+};
+
+struct mgs2_display_lock_public
+{
+    uint32_t magic, version, size_words, signature;
+    uint32_t enabled, capacity, record_words, write_count;
+    uint32_t target_mutex, target_caller;
+    struct mgs2_display_lock_record record[MGS2_DISPLAY_LOCK_CAPACITY];
+};
+
+EXPORT struct mgs2_display_lock_public mgs2_display_lock_history =
+{
+    MGS2_DISPLAY_LOCK_MAGIC, 1,
+    sizeof(struct mgs2_display_lock_public) / sizeof(uint32_t),
+    ~MGS2_DISPLAY_LOCK_MAGIC,
+    0, MGS2_DISPLAY_LOCK_CAPACITY,
+    sizeof(struct mgs2_display_lock_record) / sizeof(uint32_t),
+};
+
+static int mgs2_display_lock_enabled = -1;
+
+static int mgs2_display_lock_is_enabled(void)
+{
+    int enabled = __atomic_load_n(&mgs2_display_lock_enabled, __ATOMIC_ACQUIRE);
+
+    if (enabled < 0)
+    {
+        const char *value = getenv("MGS2_DISPLAY_LOCK_HISTORY");
+        int wanted = value && *value && strcmp(value, "0");
+        int expected = -1;
+
+        __atomic_compare_exchange_n(&mgs2_display_lock_enabled, &expected, wanted, 0,
+                __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+        enabled = __atomic_load_n(&mgs2_display_lock_enabled, __ATOMIC_ACQUIRE);
+        __atomic_store_n(&mgs2_display_lock_history.enabled, enabled, __ATOMIC_RELEASE);
+    }
+    return enabled;
+}
+
+/* Return address 0x...fa4a8 in the exact shipping win32u_glfuncs3.so.  This is
+ * the instruction stream immediately after lock_display_devices() calls
+ * pthread_mutex_lock(&display_lock). */
+static int mgs2_display_lock_callsite(x86emu_t *emu)
+{
+    static const unsigned char after_call[] =
+    {
+        0xc7, 0x84, 0x24, 0x40, 0x09, 0x00, 0x00, 0x00,
+        0x00, 0x00, 0x00, 0xc7, 0x84, 0x24, 0x44, 0x09,
+    };
+
+    return emu && !memcmp((const void *)(uintptr_t)R_EIP, after_call, sizeof(after_call));
+}
+
+static void mgs2_display_lock_record(unsigned int event, pthread_mutex_t *mutex, int result)
+{
+    struct mgs2_display_lock_record *record;
+    x86emu_t *emu = thread_get_emu_nocreate();
+    uint32_t ticket, i;
+
+    ticket = __atomic_fetch_add(&mgs2_display_lock_history.write_count, 1, __ATOMIC_RELAXED);
+    record = &mgs2_display_lock_history.record[ticket % MGS2_DISPLAY_LOCK_CAPACITY];
+    __atomic_store_n(&record->sequence, 0, __ATOMIC_RELAXED);
+    record->tid = GetTID();
+    record->event = event;
+    record->mutex = (uintptr_t)mutex;
+    record->caller = emu ? R_EIP : 0;
+    record->stack_pointer = emu ? R_ESP : 0;
+    record->lock = mutex ? ((uint32_t *)mutex)[0] : 0;
+    record->owner = mutex ? ((uint32_t *)mutex)[2] : 0;
+    record->result = result;
+    for (i = 0; i < MGS2_DISPLAY_LOCK_STACK_WORDS; ++i)
+        record->stack[i] = emu ? ((uint32_t *)(uintptr_t)R_ESP)[i] : 0;
+    __atomic_store_n(&record->sequence, ticket + 1, __ATOMIC_RELEASE);
+}
