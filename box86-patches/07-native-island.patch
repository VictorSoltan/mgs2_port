+        uintptr_t guest = __atomic_load_n(&mgs2_island_gl_guest, __ATOMIC_ACQUIRE);
+
+        if (guest && (uintptr_t)addr == guest)
+            return (void *)mgs2_native_island_gl;
+        if (!guest && mgs2_island_marker_at((uintptr_t)addr, marker))
+        {
+            __atomic_store_n(&mgs2_island_gl_guest, (uintptr_t)addr, __ATOMIC_RELEASE);
