+                    unsigned int v = 0;
+                    int digits = 0;
+
+                    while (*p >= '0' && *p <= '9') { v = v * 10 + (unsigned int)(*p++ - '0'); ++digits; }
+                    if (digits && v == mgs2_island_entries[i].id) { wanted = 1; break; }
