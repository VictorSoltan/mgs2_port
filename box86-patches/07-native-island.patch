diff --git a/src/island/mgs2_island_registry.h b/src/island/mgs2_island_registry.h
new file mode 100644
index 0000000..bdf0195
--- /dev/null
+++ b/src/island/mgs2_island_registry.h
@@ -0,0 +1,34 @@
+/*
+ * The native-target registry: how an island symbol ID becomes an ARM address.
+ *
+ * The address is never written down by any generator. Each translation unit
+ * gets a generated fragment appended to it that takes the address of every
+ * mappable function it defines -- 916 of them are `static` and cannot be
+ * referenced from anywhere else -- and drops an (id, address) pair into one
+ * section. The linker gathers the section; the runtime walks it once and builds
+ * the id -> address array.
+ *
+ * This is what removes the self-reference that the previous design had. The old
+ * table listed absolute ARM addresses read out of the linked binary and was then
+ * compiled back into that same binary, so any edit invalidated it and a stale
+ * entry landed inside a real, wrong function rather than faulting. IDs depend on
+ * names alone, so nothing here can go stale against a build.
+ *
+ * `used` keeps the entry when nothing references it by name; the section name is
+ * a valid C identifier so the linker provides __start_/__stop_ around it.
+ */
+#ifndef MGS2_ISLAND_REGISTRY_H
+#define MGS2_ISLAND_REGISTRY_H
+
+struct mgs2_native_reg
+{
+    unsigned int id;
+    const void *addr;
+};
+
+#define MGS2_NATIVE_REG(id, fn)                                               \
+    static const struct mgs2_native_reg mgs2_native_reg_##id                  \
+        __attribute__((used, section("mgs2_native_ids"), aligned(4))) =       \
+        { (id), (const void *)(fn) };
+
+#endif /* MGS2_ISLAND_REGISTRY_H */
