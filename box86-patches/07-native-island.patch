+            SetMGS2IslandBridge(mgs2_island_entries[i].id, bridge);
+            printf_log(LOG_NONE, "MGS2 island: armed entry %u -> bridge %p\n",
+                    mgs2_island_entries[i].id, (void *)bridge);
+            ++armed;
+        }
+        printf_log(LOG_NONE, "MGS2 island: %u of %u entries armed (only=\"%s\")\n",
