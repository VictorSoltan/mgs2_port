 	pthread_setspecific(thread_key, et);
 }
 
+/* The emu of THIS thread, or NULL -- never a freshly created one.
+ *
+ * thread_get_emu() below does not report "no emu on this thread": it makes one,
+ * with a new 2 MB stack, and publishes it. That is right for a generic callback
+ * arriving on an unknown thread and wrong for the native island, which must run
+ * against the emu it was entered with. Answering with a brand-new emulator's FS
+ * base would hand out a plausible wrong TEB, and a plausible wrong TEB corrupts
+ * silently where a null one faults legibly. */
+x86emu_t* thread_get_emu_nocreate()
+{
+	emuthread_t *et = (emuthread_t*)pthread_getspecific(thread_key);
+	return et?et->emu:NULL;
+}
+
