# MGS2 keyboard mapping for gptokeyb. Start+Select exit is armed by the
# PortMaster $GPTOKEYB command (or the launcher's explicit -1 fallback), not by
# a mapping entry in this file.
back = enter
start = tab
guide = esc

a = z
b = x
x = s
y = d

l1 = a
l2 = w
l3 = leftshift
r1 = f
r2 = e
r3 = k

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

right_analog_up = i
right_analog_down = m
right_analog_left = j
right_analog_right = l

a_hk = enter
b_hk = esc

deadzone_y = 2100
deadzone_x = 1900
deadzone_triggers = 3000
