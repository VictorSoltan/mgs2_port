# Copy this file to .env and edit it for your workstation. The real .env is
# ignored by Git. Prefer absolute paths when tools may be launched elsewhere.

# SSH destination and on-device installation directory.
MGS2_DEVICE=root@rg353vs
MGS2_GAME_DIR=/storage/roms/ports/MGS2-Substance

# Local source/build trees. The defaults used by the harness follow the sibling
# layout documented in AGENTS.md, but explicit values make a checkout portable.
WINE_SRC=/path/to/wine-11.0
WINE_TARBALL=/path/to/wine-11.0.tar.xz
WINE_BUILD=/path/to/build-wine-i386
WINE_UNIX_BUILD=/path/to/build-wine-unix32
BOX86_SRC=/path/to/box86
BOX86_BUILD=/path/to/box86/build
MINGW_BIN=/path/to/mingw/bin
MINGW_OBJDUMP=/path/to/mingw/bin/i686-w64-mingw32-objdump
WORK_DIR=/path/to/disposable/rebuild-work

# DXVK exact rebuild gate. The checkout must have its Vulkan-Headers and
# SPIRV-Headers submodules initialized. Keep the machine-specific cross-file
# and extracted/build-tool paths here rather than in tracked scripts.
DXVK_SRC=/path/to/DXVK-Sarek
DXVK_CROSS_FILE=/path/to/i686-w64-mingw32-cross-file.txt
DXVK_MESON=/path/to/meson
DXVK_NINJA=/path/to/ninja
