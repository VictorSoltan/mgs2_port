# Local configuration and credentials
.env
.env.*
!.env.example
.envrc
.direnv/
*.local
.github-token.local

# Runtime and research binaries. Keep hashes/manifests in Git; publish binary
# bundles separately or rebuild them from the pinned sources and patches.
*.dll
*.so
*.so.*
*.o
*.a
*.exe
/binaries/*
!/binaries/README.md
!/binaries/SHA256SUMS
/release/

# Source and build trees reconstructed from upstream tarballs plus patches
build-wine-*/
wine-11.0/
*.tar.xz
*.tar.gz
/_work/

# Device captures and profiler output. Curated public evidence belongs in
# docs/evidence/ and is explicitly allowed below.
/logs/
/handoff/
*.log
!docs/evidence/*.log
*.wav
*.perf
*.prof
*.trace
perf.data*
core
core.*
mgs2-perf-context-*/
mgs2-perf-context-*.tar.gz

# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editors and operating-system junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.bak
.vscode/
.idea/
