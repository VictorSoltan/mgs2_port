# Бинарники не версионируются, кроме одного каталога: binaries/ хранит ровно тот
# набор, на котором игра проверена рабочей, чтобы устройство можно было вернуть в
# играбельное состояние без тулчейна. Всё остальное пересобирается из
# wine-patches/ по рецептам в README.
*.dll
*.so
*.so.*
*.o
*.a
*.exe
!binaries/**

# Сборочные каталоги и исходники Wine — они восстанавливаются из тарбола плюс патчи.
build-wine-*/
wine-11.0/
*.tar.xz
*.tar.gz

# Логи и записи с устройства.
*.log
*.wav
__pycache__/
/handoff

# Local owner-provided GitHub credentials for this checkout. Never stage.
.github-token.local

# Collector output: machine-specific, and a PC-run copy once got mistaken for
# the console. Send the tarball, never commit it.
mgs2-perf-context-*/
mgs2-perf-context-*.tar.gz

# Local captures / profiling output
/logs/
*.perf
*.prof
*.trace
core
core.*

# Python caches / local environments
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editor / local junk
*.swp
*.swo
*~
.vscode/
.idea/

# release/ — вывод harness/make_release.sh: 28 МБ box86 и 26 МБ WineD3D на
# выпуск. В историю git они не идут по той же причине, по которой сюда не идут
# остальные бинарники: пересобираются точно, байт в байт, из закреплённых баз и
# полных патчей (device/FINALPLAY.lock, harness/verify_rebuild.sh --build).
# Манифест из каждого выпуска дублируется в device/FINALPLAY.manifest, и он
# как раз версионируется.
release/*/box86-*
release/*/*.so
