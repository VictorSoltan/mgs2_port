diff --git a/src/dxvk/dxvk_pipeline_trace.h b/src/dxvk/dxvk_pipeline_trace.h
new file mode 100644
index 0000000..fbb3c37
--- /dev/null
+++ b/src/dxvk/dxvk_pipeline_trace.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+enum MGS2DxvkPipelineTraceKind : uint32_t {
+  MGS2DxvkTraceQueue       = 1,
+  MGS2DxvkTraceWorkerBegin = 2,
+  MGS2DxvkTraceCacheEntry  = 3,
+  MGS2DxvkTraceDriverBegin = 4,
+  MGS2DxvkTraceDriverEnd   = 5,
+  MGS2DxvkTraceDrawMiss    = 6,
+  MGS2DxvkTraceDrawReady   = 7,
+  MGS2DxvkTraceWorkerEnd   = 8,
+};
+
+struct MGS2DxvkPipelineTraceEvent {
+  uint64_t tickMs;
+  uint32_t threadId;
+  uint32_t kind;
+  uint32_t sequence;
+  uint32_t pipeline;
+  uint32_t stateHash;
+  uint32_t shaderHash;
+  uint32_t auxiliary;
+  uint32_t reserved;
+};
+
+constexpr uint32_t MGS2DxvkPipelineTraceCapacity = 4096;
+
+extern "C" {
+  extern volatile uint32_t MGS2DxvkPipelineTraceWriteCount;
+  extern volatile uint32_t MGS2DxvkPipelineTraceDropped;
+  extern MGS2DxvkPipelineTraceEvent
+    MGS2DxvkPipelineTraceEvents[MGS2DxvkPipelineTraceCapacity];
+}
+
+namespace dxvk {
+
+  bool mgs2DxvkPipelineTraceEnabled();
+
+  void mgs2DxvkPipelineTraceRecord(
+          MGS2DxvkPipelineTraceKind kind,
+          uint32_t                  sequence,
+          uintptr_t                 pipeline,
+    const void*                     state,
+          size_t                    stateSize,
+          uint32_t                  shaderHash,
+          uintptr_t                 auxiliary);
+
+}
