+
+  void mgs2DxvkPipelineTraceRecord(
+          MGS2DxvkPipelineTraceKind kind,
+          uint32_t                  sequence,
+          uintptr_t                 pipeline,
+    const void*                     state,
+          size_t                    stateSize,
+          uint32_t                  shaderHash,
+          uintptr_t                 auxiliary) {
+    if (!mgs2DxvkPipelineTraceEnabled())
+      return;
+
+    uint32_t index = __atomic_fetch_add(
+      &MGS2DxvkPipelineTraceWriteCount, 1u, __ATOMIC_RELAXED);
+
+    if (index >= MGS2DxvkPipelineTraceCapacity) {
+      __atomic_fetch_add(&MGS2DxvkPipelineTraceDropped, 1u, __ATOMIC_RELAXED);
+      return;
+    }
+
+    uint32_t stateHash = 2166136261u;
+    const uint8_t* bytes = reinterpret_cast<const uint8_t*>(state);
+
+    for (size_t i = 0; i < stateSize; i++) {
+      stateHash ^= bytes[i];
+      stateHash *= 16777619u;
+    }
+
+    auto& event = MGS2DxvkPipelineTraceEvents[index];
+#ifdef _WIN32
+    event.tickMs = GetTickCount64();
+    event.threadId = GetCurrentThreadId();
+#else
+    event.tickMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+      dxvk::high_resolution_clock::now().time_since_epoch()).count();
+    event.threadId = 0;
+#endif
+    event.sequence = sequence;
+    event.pipeline = static_cast<uint32_t>(pipeline);
+    event.stateHash = stateSize ? stateHash : 0;
+    event.shaderHash = shaderHash;
+    event.auxiliary = static_cast<uint32_t>(auxiliary);
+    event.reserved = 0;
+    __atomic_store_n(&event.kind, uint32_t(kind), __ATOMIC_RELEASE);
+  }
