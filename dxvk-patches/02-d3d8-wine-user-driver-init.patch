@@ -115,6 +115,16 @@ extern "C" {
   DLLEXPORT void __stdcall DebugSetMute() {}
 
   DLLEXPORT IDirect3D8* __stdcall Direct3DCreate8(UINT nSDKVersion) {
+    // Some D3D8 games create the Direct3D interface before creating their
+    // first window. Wine's Vulkan WSI extensions are supplied by the active
+    // user driver, which is still the null driver at that point. Creating a
+    // hidden standard window forces the real user driver to load before DXVK
+    // enumerates instance extensions.
+    HWND driverWindow = CreateWindowExW(0, L"STATIC", L"", WS_POPUP,
+      0, 0, 1, 1, nullptr, nullptr, GetModuleHandleW(nullptr), nullptr);
+    if (driverWindow)
+      DestroyWindow(driverWindow);
+
     IDirect3D8* pDirect3D = nullptr;
     dxvk::CreateD3D8(&pDirect3D);
 
